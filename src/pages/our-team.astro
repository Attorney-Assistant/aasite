const slugify = (s: string) => s.toLowerCase().replace(/&/g, "and").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const departments = departmentsRaw.map((d) => ({
  ...d,
  slug: slugify(d.name),
  members: [...d.members].sort((a, b) => a.name.localeCompare(b.name)),
}));

function getInitials(name: string) {
  return name.split(" ").map(w => w[0]).join("").slice(0, 2).toUpperCase();
}

const teamSchema = leaders.map((l) => ({
  "@type": "Person",
  "name": l.name,
  "jobTitle": l.title,
  "description": l.bio,
  "image": l.image ? `https://attorneyassistant.com${l.image}` : undefined,
  "worksFor": { "@id": "https://attorneyassistant.com/#organization" },
}));
---

<BaseLayout title="Meet the Attorney Assistant Team" description="Meet the team behind Attorney Assistant — operations specialists helping law firms fix intake, follow-up, and admin so they can grow." schema={teamSchema}>

  <Hero
    badge="Our Team"
    title="Meet the people leading the way"
    subtitle="The team behind the operations infrastructure that helps law firms stop leaking revenue and start scaling."
    size="md"
    align="center"
  />

  <!-- Leadership -->
  <section class="section-padding reveal" style="transition-delay: 0.1s;">
    <div class="container-wide">
      <div class="text-center mb-12">
        <span class="badge badge-brand">Leadership</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">
          Executive Team
        </h2>
        <div class="divider-gold-center mt-5"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {leaders.map((leader) => (
          <div class="card card-hover text-center overflow-hidden border-t-4 border-t-brand-gold">
            <div class="aspect-[3/4] overflow-hidden bg-gray-100 group">
              {leader.image ? (
                <img
                  src={leader.image}
                  alt={leader.name}
                  class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-brand-100 flex items-center justify-center">
                  <span class="text-4xl font-semibold text-brand-700">{leader.initials}</span>
                </div>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-lg font-heading text-gray-900 mb-2">{leader.name}</h3>
              <span class="badge badge-gold text-xs">{leader.title}</span>
              <div class="divider-gold-center my-4"></div>
              <p class="text-sm text-gray-500 leading-relaxed">{leader.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team Filter -->
  <div class="sticky top-16 z-30 bg-white/95 backdrop-blur-md border-y border-gray-200 shadow-sm reveal" style="transition-delay: 0.15s;">
    <div class="container-wide py-3">
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar" role="tablist" aria-label="Filter team by department">
        <button
          type="button"
          class="team-filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium border border-brand-700 bg-brand-700 text-white shadow-sm transition-all duration-200"
          data-filter="all"
          aria-pressed="true"
        >
          All Teams
        </button>
        {departments.map((dept) => (
          <button
            type="button"
            class="team-filter-btn shrink-0 px-4 py-2 rounded-full text-sm font-medium border border-gray-200 bg-white text-gray-600 hover:border-brand-gold hover:text-brand-700 transition-all duration-200"
            data-filter={dept.slug}
            aria-pressed="false"
          >
            {dept.name}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Departments -->
  {departments.map((dept, di) => (
    <section
      class:list={["section-padding reveal team-section", di % 2 === 0 ? "bg-gray-50" : "bg-white"]}
      style={`transition-delay: ${0.1 + di * 0.05}s;`}
      data-team={dept.slug}
    >
      <div class="container-wide">
        <div class="flex items-center justify-between gap-4 flex-wrap mb-10">
          <div class="flex items-center gap-4">
            <div class="featured-icon featured-icon-lg featured-icon-brand">
              <img src={dept.icon} alt="" aria-hidden="true" class="w-7 h-7" />
            </div>
            <div>
              <h2 class="text-display-xs font-heading text-gray-900">{dept.name}</h2>
              <div class="divider-gold mt-2"></div>
            </div>
          </div>
          <span class="badge badge-gray">
            {dept.members.length} {dept.members.length === 1 ? "Person" : "People"}
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5 sm:gap-6">
          {dept.members.map((member: any) => (
            <div class="card card-hover overflow-hidden">
              <div class="aspect-square overflow-hidden bg-gray-100">
                {member.image ? (
                  <img
                    src={member.image}
                    alt={member.name}
                    class="w-full h-full object-cover object-top transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-brand-50">
                    <span class="text-xl font-semibold text-brand-700">{getInitials(member.name)}</span>
                  </div>
                )}
              </div>
              <div class="p-4 text-center">
                <p class="text-sm font-heading text-gray-900">{member.name}</p>
                {member.title && (
                  <span class="badge badge-gold text-[10px] px-2 py-0.5 mt-2">{member.title}</span>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".team-filter-btn");
    const sections = document.querySelectorAll<HTMLElement>(".team-section");

    const activeClasses = ["bg-brand-700", "text-white", "border-brand-700", "shadow-sm"];
    const inactiveClasses = ["bg-white", "text-gray-600", "border-gray-200"];

    function setActive(btn: HTMLButtonElement) {
      buttons.forEach((b) => {
        b.classList.remove(...activeClasses);
        b.classList.add(...inactiveClasses);
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.remove(...inactiveClasses);
      btn.classList.add(...activeClasses);
      btn.setAttribute("aria-pressed", "true");
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.dataset.filter;
        setActive(btn);
        sections.forEach((section) => {
          const matches = filter === "all" || section.dataset.team === filter;
          section.style.display = matches ? "" : "none";
        });
      });
    });
  </script>

  <CTABanner
    heading="Join Our Team"
    body="We're always looking for talented people who share our mission."
    buttonText="View Careers"
    buttonLink="/careers"
    variant="brand"
  />

  <style>
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

</BaseLayout>
