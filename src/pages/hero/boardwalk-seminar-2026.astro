---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Audit My Intake — Boardwalk Seminar 2026 | Attorney Assistant"
  description="Met us at the Boardwalk Seminar? Book your free intake audit. We'll diagnose the gaps costing your firm cases and show you exactly what to fix."
  noindex={true}
>

  <!-- ══════════════════════════════════════════════
       COMIC BOOK LANDING PAGE — BOARDWALK SEMINAR
       Styled after the AA SuperHero Issue №01 print piece
       ══════════════════════════════════════════════ -->

  <div class="comic-page">

    <!-- ─── MASTHEAD (replaces site header on this page) ─── -->
    <header class="comic-masthead">
      <div class="comic-wrap">
        <div class="masthead-inner">
          <a href="/" class="masthead-logo-link">
            <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="masthead-logo" />
          </a>
          <nav class="masthead-nav">
            <a href="/">Home</a>
            <a href="/services">Services</a>
            <a href="/blog">Blog</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/book-call" class="masthead-nav-cta">Book a Call</a>
          </nav>
          <div class="masthead-right">
            <span class="masthead-issue">BOARDWALK SEMINAR EDITION &bull; 2026</span>
            <span class="masthead-tagline">Operations problem-solvers for 200+ law firms</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ─── HERO PANEL ─── -->
    <section class="panel panel-hero">
      <div class="halftone"></div>
      <div class="comic-wrap panel-hero-wrap">
        <div class="hero-grid">
          <div class="hero-left">
            <div class="speech-bubble speech-bubble--shout hero-bubble comic-reveal">
              <span>WE OWN THE OUTCOME</span>
            </div>
            <h1 class="hero-headline comic-reveal comic-reveal--d1">
              WE EVOLVE LAW FIRMS WITH ELITE TEAMS + AI&nbsp;SOLUTIONS.
            </h1>
            <p class="hero-sub comic-reveal comic-reveal--d2">
              We own the outcome, not just the task. So your nights stop getting hijacked by missed calls, chaos, and "just one more thing."
            </p>
            <p class="hero-detail comic-reveal comic-reveal--d2">
              More control. Less fire-drilling. The kind of operation that lets you step away without everything falling apart.
            </p>
            <a href="#book" class="comic-btn comic-reveal comic-reveal--d3 comic-btn--pulse">BOOK YOUR FREE AUDIT</a>
          </div>
          <div class="hero-right comic-reveal comic-reveal--d2">
            <div class="hero-booking-panel">
              <div class="hero-booking-header">
                <span class="hero-booking-title">BOOK YOUR FREE AUDIT</span>
                <span class="hero-booking-sub">Pick a time &mdash; 30 min, no commitment</span>
              </div>
              <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/audit-my-intake-conference-attendance?embed=true"></div>
            </div>
          </div>
        </div>
      </div>
      <!-- City skyline — single clean silhouette like the print piece -->
      <div class="skyline">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="xMidYMax slice" class="skyline-svg">
          <!-- Single solid silhouette — one color, natural building shapes -->
          <path fill="#0F1B33" d="
            M0 320 L0 260 L18 260 L18 245 L30 245 L30 230 L38 230 L38 218 L48 218 L48 230 L58 230 L58 248 L72 248
