            <line x1="485" y1="132" x2="485" y2="115"/>
            <line x1="653" y1="38" x2="653" y2="15"/>
            <line x1="845" y1="118" x2="845" y2="98"/>
            <line x1="1078" y1="85" x2="1078" y2="62"/>
            <line x1="1229" y1="130" x2="1229" y2="112"/>
          </g>
          <!-- Blinking antenna lights -->
          <g class="antenna-lights">
            <circle cx="103" cy="152" r="1.5" fill="#ff3333" class="blink-2"/>
            <circle cx="177" cy="102" r="1.5" fill="#ff3333" class="blink-1"/>
            <circle cx="339" cy="55" r="2" fill="#ff3333" class="blink-2"/>
            <circle cx="485" cy="115" r="1.5" fill="#ff3333" class="blink-1"/>
            <circle cx="653" cy="15" r="2.5" fill="#ff3333" class="blink-1"/>
            <circle cx="845" cy="98" r="1.5" fill="#ff3333" class="blink-2"/>
            <circle cx="1078" cy="62" r="2" fill="#ff3333" class="blink-1"/>
            <circle cx="1229" cy="112" r="1.5" fill="#ff3333" class="blink-2"/>
          </g>
        </svg>
      </div>
    </section>

    <!-- ─── THE PROBLEM ─── -->
    <section class="panel panel-problem">
      <div class="halftone halftone--light"></div>
      <div class="comic-wrap">
        <div class="section-label section-label--accent comic-reveal">THE PROBLEM</div>
        <h2 class="comic-h2 comic-reveal comic-reveal--d1">THREE FAILURES COST YOUR FIRM MORE THAN MARKETING EVER&nbsp;COULD.</h2>
        <p class="comic-body comic-reveal comic-reveal--d2" style="max-width:680px;margin-bottom:2rem;">
          A custom combination matched to your firm's specific bottlenecks, not an off-the-shelf staffing package.
        </p>
        <div class="stat-cards">
          <div class="stat-card comic-reveal comic-reveal--pop">
            <div class="stat-card-number">20%</div>
            <h3 class="stat-card-title">Intake Failure</h3>
            <p class="stat-card-body">Of leads vanish before anyone picks up the phone. Slow callbacks, broken handoffs. No-one's watching the door every day.</p>
          </div>
          <div class="stat-card comic-reveal comic-reveal--pop comic-reveal--d1">
            <div class="stat-card-number">15<span class="stat-plus">+</span> HRS</div>
            <h3 class="stat-card-title">Admin Chaos</h3>
            <p class="stat-card-body">Wasted per attorney, per week. Filing, scheduling, chasing updates. Most expensive people are doing your cheapest work.</p>
          </div>
          <div class="stat-card comic-reveal comic-reveal--pop comic-reveal--d2">
            <div class="stat-card-number">$1–2M</div>
            <h3 class="stat-card-title">Growth Stagnation</h3>
            <p class="stat-card-body">Firms hit a revenue ceiling and can't break through without fixing operations. More marketing just multiplies the chaos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── ASSEMBLE THE TEAM ─── -->
    <section class="panel panel-team">
      <div class="comic-wrap">
        <div class="section-label section-label--dark comic-reveal">ASSEMBLE THE TEAM</div>
        <h2 class="comic-h2 comic-h2--light comic-reveal comic-reveal--d1">THE WORK YOUR FIRM NEEDS BUT HATES TO&nbsp;MANAGE.</h2>
        <p class="comic-body comic-body--light comic-reveal comic-reveal--d2" style="max-width:740px;margin-bottom:2rem;">
          A custom combination matched to your firm's specific bottlenecks, not an off-the-shelf staffing package. We take this off your plate so you can lead your firm, not babysit it.
        </p>
        <div class="service-grid">
          <div class="service-card comic-reveal comic-reveal--pop">
            <h3>Intake 360</h3>
            <p>24/7 live answering, bilingual, scripted to your practice areas. Every call captured, every detail in your CRM.</p>
          </div>
          <div class="service-card comic-reveal comic-reveal--pop comic-reveal--d1">
            <h3>Lead Follow-Up</h3>
            <p>5-minute response on every inbound lead. Speed wins cases. Consistency closes them.</p>
          </div>
          <div class="service-card comic-reveal comic-reveal--pop comic-reveal--d1">
            <h3>Admin Support</h3>
            <p>Filing, scheduling, records, status updates. The back-office work that overwhelms your attorneys, handled.</p>
          </div>
          <div class="service-card comic-reveal comic-reveal--pop comic-reveal--d2">
            <h3>Impact Assistants</h3>
            <p>A true extension of your team, not a vendor placement. The kind of support that actually lets you breathe.</p>
          </div>
          <div class="service-card comic-reveal comic-reveal--pop comic-reveal--d2">
            <h3>Executive Assistant</h3>
            <p>A virtual right hand for partners. Calendar, inbox, follow-ups, travel. The admin that runs your day, run.</p>
          </div>
          <div class="service-card comic-reveal comic-reveal--pop comic-reveal--d3">
            <h3>AI Solutions</h3>
            <p>AI-driven workflows that route, qualify, and accelerate every process on every step. Your team, multiplied.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── WHY FIRMS CHOOSE US ─── -->
    <section class="panel panel-why">
      <div class="halftone"></div>
      <div class="comic-wrap">

        <!-- Stat bubbles row -->
        <div class="bubble-row">
          <div class="stat-bubble comic-reveal comic-reveal--pop">
            <strong>200+</strong>
            <span>Law firms scaled</span>
          </div>
          <div class="stat-bubble comic-reveal comic-reveal--pop comic-reveal--d1">
            <strong>60%</strong>
            <span>Cost savings vs. in-house</span>
          </div>
          <div class="stat-bubble comic-reveal comic-reveal--pop comic-reveal--d1">
            <strong>5MIN</strong>
            <span>Window before a lead goes cold</span>
          </div>
          <div class="stat-bubble comic-reveal comic-reveal--pop comic-reveal--d2">
            <strong>78+%</strong>
            <span>Of leads go to whoever responds first</span>
          </div>
        </div>

        <div class="section-label comic-reveal">WHY FIRMS CHOOSE US</div>
        <h2 class="comic-h2 comic-reveal comic-reveal--d1">THREE FAILURES COST YOUR FIRM MORE THAN MARKETING EVER&nbsp;COULD.</h2>

        <div class="speech-grid">
          <div class="speech-card comic-reveal comic-reveal--pop">
            <div class="speech-card-inner">
              <h3>We Fix What's Broken</h3>
              <p><strong>The intake failures, follow-up gaps, and admin chaos costing your firm revenue.</strong> Diagnosed, not glossed over, every day.</p>
            </div>
            <div class="speech-card-tail"></div>
          </div>
          <div class="speech-card comic-reveal comic-reveal--pop comic-reveal--d1">
            <div class="speech-card-inner">
              <h3>Co-Managed, Not Outsourced</h3>
              <p><strong>We embed in your daily workflow.</strong> Not "set it and forget it." We co-manage operations alongside your team.</p>
            </div>
            <div class="speech-card-tail"></div>
          </div>
          <div class="speech-card comic-reveal comic-reveal--pop comic-reveal--d2">
            <div class="speech-card-inner">
              <h3>Your Win Is Our Win</h3>
              <p><strong>An extension of your team, not a vendor.</strong> The deeper we integrate, the more efficient your firm becomes.</p>
            </div>
            <div class="speech-card-tail"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── BOOK YOUR AUDIT ─── -->
    <section class="panel panel-book" id="book">
      <div class="comic-wrap">
        <div class="section-label section-label--accent comic-reveal">STOP LEAKING REVENUE</div>
        <h2 class="comic-h2 comic-reveal comic-reveal--d1">START SCALING WITH THE TEAM BEHIND <span class="text-pop">200+ FIRMS.</span></h2>
        <p class="comic-body comic-reveal comic-reveal--d2" style="max-width:680px;margin-bottom:2.5rem;">
          Book a free intake audit. We'll diagnose the specific operational gaps costing you cases, and show you exactly what to fix first.
        </p>

        <div class="booking-panel comic-reveal comic-reveal--d2">
          <!-- Start of Meetings Embed Script -->
          <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/audit-my-intake-conference-attendance?embed=true"></div>
          <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p></div>';
        });
      }
    });
    </script>
          <!-- End of Meetings Embed Script -->
        </div>

        <p class="comic-tagline">Build a firm that runs without you chasing it.<br/>Go home on time. Stay there.</p>
      </div>
    </section>

  </div><!-- .comic-page -->

  <!-- ═══════════════════════════════════════
       STYLES — TRUE COMIC BOOK AESTHETIC
       ═══════════════════════════════════════ -->
  <style is:global>
    /* ── Hide the default site header on this page ── */
    #site-header { display: none !important; }

    /* ── Reset & Page Wrapper ── */
    .comic-page {
      --orange: #F7941D;
      --orange-bright: #FBB03B;
      --orange-deep: #E8700A;
      --navy: #1B2A4A;
      --navy-deep: #0F1B33;
      --ink: #111111;
      --paper: #FFF9EE;
      --white: #FFFFFF;

      font-family: 'DM Sans', 'Segoe UI', sans-serif;
      color: var(--ink);
      line-height: 1.5;
      overflow-x: hidden;
      background: var(--paper);
    }

    /* ── Comic Typography ── */
    @import url('https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:wght@400;500;700&display=swap');

    .comic-page h1,
    .comic-page h2,
    .comic-page h3,
    .comic-h2,
    .hero-headline,
    .stat-card-number,
    .stat-card-title,
    .service-card h3,
    .speech-card h3,
    .section-label,
    .comic-btn,
    .comic-tagline,
    .masthead-issue {
      font-family: 'Anton', 'Impact', 'Arial Black', sans-serif;
      text-transform: uppercase;
    }

    .speech-bubble span,
    .stat-bubble strong {
      font-family: 'Anton', 'Impact', 'Arial Black', sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* ── Layout ── */
    .comic-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem;
      position: relative;
      z-index: 2;
    }

    /* ── Halftone Pattern ── */
    .halftone {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: radial-gradient(circle, rgba(0,0,0,0.13) 2.2px, transparent 2.2px);
      background-size: 12px 12px;
    }
    .halftone--light {
      background-image: radial-gradient(circle, rgba(0,0,0,0.07) 2px, transparent 2px);
      background-size: 10px 10px;
    }

    /* ── Panel (section) base ── */
    .panel {
      position: relative;
      overflow: hidden;
      border-bottom: 5px solid var(--ink);
    }

    /* ── Masthead ── */
    .comic-masthead {
      background: var(--navy);
      border-bottom: 5px solid var(--ink);
      padding: 0.85rem 0;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .masthead-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .masthead-logo-link {
      flex-shrink: 0;
      display: flex;
      align-items: center;
    }
    .masthead-logo {
      height: 40px;
      width: auto;
    }
    .masthead-nav {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }
    .masthead-nav a {
      font-size: 0.82rem;
      font-weight: 500;
      color: rgba(255,255,255,0.7);
      text-decoration: none;
      padding: 0.35rem 0.65rem;
      border-radius: 4px;
      transition: color 0.15s, background 0.15s;
    }
    .masthead-nav a:hover {
      color: var(--white);
      background: rgba(255,255,255,0.08);
    }
    .masthead-nav-cta {
      background: var(--orange) !important;
      color: var(--white) !important;
      font-weight: 700 !important;
      padding: 0.4rem 1rem !important;
      border-radius: 4px !important;
      margin-left: 0.25rem;
    }
    .masthead-nav-cta:hover {
      background: var(--orange-bright) !important;
    }
    .masthead-right {
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .masthead-issue {
      font-size: 0.82rem;
      letter-spacing: 0.12em;
      color: var(--orange);
    }
    .masthead-tagline {
      font-size: 0.68rem;
      color: rgba(255,255,255,0.45);
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* ── HERO ── */
    .panel-hero {
      background: var(--orange);
      padding: 4rem 0 8rem;
    }
    .panel-hero-wrap {
      position: relative;
      z-index: 3;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 520px;
      gap: 2.5rem;
      align-items: stretch;
    }
    .hero-left {
      max-width: 760px;
      position: relative;
      z-index: 3;
      background: rgba(247, 148, 29, 0.92);
      padding: 2rem 2.25rem;
      border: 4px solid var(--ink);
      box-shadow: 6px 6px 0 var(--ink);
      display: flex;
      flex-direction: column;
    }
    .hero-left .comic-btn {
      margin-top: auto;
    }
    .hero-right {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
    }
    .hero-booking-panel {
      background: var(--white);
      border: 4px solid var(--ink);
      box-shadow: 8px 8px 0 var(--ink);
      overflow: hidden;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .hero-booking-header {
      background: var(--navy);
      padding: 0.85rem 1.25rem;
      border-bottom: 3px solid var(--ink);
    }
    .hero-booking-title {
      font-family: 'Anton', 'Impact', 'Arial Black', sans-serif;
      text-transform: uppercase;
      font-size: 1.05rem;
      letter-spacing: 0.06em;
      color: var(--orange);
      display: block;
    }
    .hero-booking-sub {
      font-size: 0.78rem;
      color: rgba(255,255,255,0.55);
      display: block;
      margin-top: 0.15rem;
    }
    .hero-booking-panel .meetings-iframe-container {
      padding: 0.5rem;
      flex: 1;
    }
    .hero-booking-panel .meetings-iframe-container iframe {
      background: #fff !important;
      height: 100%;
    }

    /* Speech bubble */
    .speech-bubble {
      display: inline-block;
      background: var(--white);
      border: 4px solid var(--ink);
      border-radius: 30px;
      padding: 0.65rem 1.6rem;
      position: relative;
      margin-bottom: 1.5rem;
      box-shadow: 3px 3px 0 var(--ink);
    }
    .speech-bubble span {
      font-size: 1.3rem;
      color: var(--navy);
      letter-spacing: 0.06em;
    }
    .speech-bubble::after {
      content: '';
      position: absolute;
      bottom: -18px;
      left: 30px;
      width: 0; height: 0;
      border-left: 12px solid transparent;
      border-right: 16px solid transparent;
      border-top: 20px solid var(--ink);
    }
    .speech-bubble::before {
      content: '';
      position: absolute;
      bottom: -13px;
      left: 33px;
      width: 0; height: 0;
      border-left: 9px solid transparent;
      border-right: 13px solid transparent;
      border-top: 16px solid var(--white);
      z-index: 1;
    }

    .hero-headline {
      font-size: clamp(2.5rem, 6.5vw, 5.2rem);
      line-height: 0.95;
      color: var(--navy-deep);
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
      max-width: 700px;
    }
    .hero-sub {
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--navy);
      max-width: 580px;
      margin-bottom: 0.75rem;
      line-height: 1.55;
    }
    .hero-detail {
      font-size: 1rem;
      font-style: italic;
      color: var(--ink);
      opacity: 0.7;
      max-width: 560px;
      margin-bottom: 2rem;
    }

    /* CTA Button */
    .comic-btn {
      display: inline-block;
      background: var(--white);
      color: var(--navy-deep);
      font-size: 1.3rem;
      letter-spacing: 0.08em;
      padding: 1rem 2.5rem;
      border: 4px solid var(--ink);
      border-radius: 0;
      box-shadow: 6px 6px 0 var(--ink);
      text-decoration: none;
      position: relative;
      transition: transform 0.12s, box-shadow 0.12s, background 0.12s;
      cursor: pointer;
    }
    .comic-btn:hover {
      transform: translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--ink);
      background: var(--orange-bright);
      color: var(--navy-deep);
    }
    .comic-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 var(--ink);
    }

    /* Skyline */
    .skyline {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 45%;
      max-height: 350px;
      min-height: 200px;
      z-index: 2;
    }
    .skyline-svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    /* Blinking antenna lights */
    .blink-1 { animation: antennaBlink 2s ease-in-out infinite; }
    .blink-2 { animation: antennaBlink 2s ease-in-out 1s infinite; }
    @keyframes antennaBlink {
      0%, 40%, 100% { opacity: 1; }
      50%, 90% { opacity: 0.15; }
    }

    /* ── PROBLEM PANEL ── */
    .panel-problem {
      background: var(--paper);
      padding: 4rem 0;
    }
    .panel-problem .halftone--light {
      display: none;
    }

    .section-label {
      display: inline-block;
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      color: var(--navy);
      background: rgba(27,42,74,0.1);
      border: 3px solid var(--navy);
      padding: 0.3rem 1rem;
      margin-bottom: 1rem;
    }
    .section-label--dark {
      color: var(--orange);
      background: rgba(247,148,29,0.1);
      border-color: var(--orange);
    }
    .section-label--accent {
      color: var(--orange-deep);
      background: rgba(232,112,10,0.08);
      border-color: var(--orange-deep);
    }

    .comic-h2 {
      font-size: clamp(1.8rem, 4.5vw, 3rem);
      line-height: 1;
      color: var(--navy-deep);
      margin-bottom: 0.75rem;
      letter-spacing: -0.005em;
    }
    .comic-h2--light { color: var(--white); }

    .comic-body {
      font-size: 0.95rem;
      color: var(--ink);
      line-height: 1.6;
      opacity: 0.8;
    }
    .comic-body--light { color: rgba(255,255,255,0.7); }

    /* Stat cards */
    .stat-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .stat-card {
      background: var(--orange);
      border: 4px solid var(--ink);
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
      box-shadow: 5px 5px 0 var(--ink);
    }
    .stat-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(0,0,0,0.08) 2px, transparent 2px);
      background-size: 10px 10px;
      pointer-events: none;
    }
    .stat-card-number {
      font-size: clamp(2.2rem, 4vw, 3.2rem);
      line-height: 1;
      color: var(--navy-deep);
      margin-bottom: 0.3rem;
      position: relative;
    }
    .stat-plus {
      font-size: 0.65em;
      vertical-align: super;
    }
    .stat-card-title {
      font-size: 1rem;
      letter-spacing: 0.06em;
      color: var(--navy);
      margin-bottom: 0.35rem;
      position: relative;
    }
    .stat-card-body {
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.75;
      position: relative;
    }

    /* ── TEAM PANEL ── */
    .panel-team {
      background: var(--navy-deep);
      padding: 4rem 0;
    }
    .panel-team .skyline {
      display: none;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 0.9rem;
    }
    .service-card {
      background: var(--orange);
      border: 4px solid var(--ink);
      padding: 1.15rem;
      box-shadow: 4px 4px 0 var(--ink);
      position: relative;
      overflow: hidden;
    }
    .service-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(0,0,0,0.06) 1.5px, transparent 1.5px);
      background-size: 8px 8px;
      pointer-events: none;
    }
    .service-card h3 {
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      color: var(--navy-deep);
      margin-bottom: 0.35rem;
      position: relative;
    }
    .service-card p {
      font-size: 0.75rem;
      line-height: 1.45;
      color: var(--ink);
      opacity: 0.75;
      position: relative;
    }

    /* ── WHY PANEL ── */
    .panel-why {
      background: var(--orange);
      padding: 4rem 0;
    }

    /* Stat bubbles */
    .bubble-row {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .stat-bubble {
      background: var(--white);
      border: 4px solid var(--ink);
      border-radius: 50%;
      width: 140px;
      height: 140px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 4px 4px 0 var(--ink);
      padding: 0.5rem;
    }
    .stat-bubble strong {
      font-size: 1.85rem;
      color: var(--navy-deep);
      line-height: 1.05;
      display: block;
    }
    .stat-bubble span {
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--ink);
      opacity: 0.65;
      line-height: 1.25;
      margin-top: 0.2rem;
    }

    /* Speech cards */
    .speech-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    .speech-card {
      position: relative;
    }
    .speech-card-inner {
      background: var(--white);
      border: 4px solid var(--ink);
      border-radius: 20px;
      padding: 1.5rem;
      position: relative;
      box-shadow: 4px 4px 0 var(--ink);
    }
    .speech-card-tail {
      position: relative;
      margin-left: 30px;
      width: 0; height: 0;
      border-left: 14px solid transparent;
      border-right: 18px solid transparent;
      border-top: 22px solid var(--ink);
    }
    .speech-card-tail::after {
      content: '';
      position: absolute;
      top: -26px;
      left: -10px;
      width: 0; height: 0;
      border-left: 11px solid transparent;
      border-right: 15px solid transparent;
      border-top: 19px solid var(--white);
    }
    .speech-card h3 {
      font-family: 'Anton', 'Impact', sans-serif;
      text-transform: uppercase;
      font-size: 1.05rem;
      letter-spacing: 0.03em;
      color: var(--navy-deep);
      margin-bottom: 0.5rem;
    }
    .speech-card p {
      font-size: 0.85rem;
      line-height: 1.55;
      color: #444;
    }
    .speech-card p strong {
      color: var(--navy);
    }

    /* ── BOOKING PANEL ── */
    .panel-book {
      background: var(--paper);
      padding: 4rem 0;
      border-bottom: none;
    }
    .text-pop {
      color: var(--orange-deep);
      position: relative;
    }
    .text-pop::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -2px;
      height: 4px;
      background: var(--orange);
      border-radius: 2px;
    }

    .booking-panel {
      max-width: 780px;
      margin: 0 auto 2rem;
      background: var(--white);
      border: 5px solid var(--ink);
      box-shadow: 8px 8px 0 var(--ink);
      overflow: hidden;
      padding: 1rem;
    }
    .booking-panel .meetings-iframe-container iframe {
      background: #fff !important;
    }

    .comic-tagline {
      font-size: 1.15rem;
      letter-spacing: 0.04em;
      color: var(--navy);
      text-align: center;
      line-height: 1.45;
      max-width: 500px;
      margin: 0 auto;
    }

    /* ──────────────────────────
       RESPONSIVE
       ────────────────────────── */
    @media (max-width: 900px) {
      .service-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
      }
      .hero-right {
        max-width: 480px;
      }
    }
    @media (max-width: 700px) {
      .panel-hero { padding: 2.5rem 0 6rem; }
      .stat-cards {
        grid-template-columns: 1fr;
      }
      .speech-grid {
        grid-template-columns: 1fr;
      }
      .service-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .stat-bubble {
        width: 110px;
        height: 110px;
      }
      .stat-bubble strong { font-size: 1.3rem; }
      .stat-bubble span { font-size: 0.58rem; }
      .masthead-nav { display: none; }
      .masthead-right { display: none; }
      .footer-inner {
        flex-direction: column;
        text-align: center;
      }
      .footer-links {
        flex-direction: column;
        gap: 0.5rem;
      }
      .skyline { height: 50%; min-height: 180px; }
    }
    @media (max-width: 480px) {
      .service-grid {
        grid-template-columns: 1fr;
      }
      .bubble-row {
        gap: 0.65rem;
      }
      .stat-bubble {
        width: 95px;
        height: 95px;
      }
      .stat-bubble strong { font-size: 1.1rem; }
    }

    /* ──────────────────────────
       ANIMATIONS
       ────────────────────────── */

    /* Scroll-reveal base */
    .comic-reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .comic-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Pop-in variant (scale up from small) */
    .comic-reveal--pop {
      transform: translateY(20px) scale(0.9);
    }
    .comic-reveal--pop.is-visible {
      transform: translateY(0) scale(1);
    }

    /* Stagger delays */
    .comic-reveal--d1 { transition-delay: 0.12s; }
    .comic-reveal--d2 { transition-delay: 0.24s; }
    .comic-reveal--d3 { transition-delay: 0.36s; }

    /* CTA pulse glow after reveal */
    .comic-btn--pulse.is-visible {
      animation: ctaPulse 2s ease-in-out 0.8s 2;
    }
    @keyframes ctaPulse {
      0%, 100% { box-shadow: 6px 6px 0 var(--ink); }
      50% { box-shadow: 6px 6px 0 var(--ink), 0 0 25px rgba(247,148,29,0.5); }
    }

    /* Stat card hover lift */
    .stat-card {
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card:hover {
      transform: translate(-3px, -3px);
      box-shadow: 8px 8px 0 var(--ink);
    }

    /* Service card hover */
    .service-card {
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .service-card:hover {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 var(--ink);
    }

    /* Speech card hover */
    .speech-card-inner {
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .speech-card:hover .speech-card-inner {
      transform: translate(-2px, -3px);
      box-shadow: 6px 7px 0 var(--ink);
    }

    /* Stat bubble float */
    .stat-bubble {
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .stat-bubble:hover {
      transform: translateY(-6px) scale(1.05);
    }

    /* Booking panel border glow */
    .booking-panel {
      transition: box-shadow 0.3s;
    }
    .booking-panel:hover {
      box-shadow: 8px 8px 0 var(--ink), 0 0 30px rgba(247,148,29,0.2);
    }

    /* Reduce motion preference */
    @media (prefers-reduced-motion: reduce) {
      .comic-reveal { transition: none; opacity: 1; transform: none; }
      .comic-btn--pulse.is-visible { animation: none; }
      .blink-1, .blink-2 { animation: none; }
    }
  </style>

  <!-- Scroll-reveal observer for comic-reveal elements -->
  <script is:inline>
    (function() {
      var els = document.querySelectorAll('.comic-reveal');
      if (!els.length) return;
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });
      els.forEach(function(el) { io.observe(el); });
    })();
  </script>

  <!-- Conversion tracking -->
  <script is:inline>
    if (typeof mixpanel !== 'undefined') mixpanel.track('LP Viewed', { page: 'boardwalk-seminar-2026' });
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lp_view', lp_name: 'boardwalk-seminar-2026' });
  </script>

</BaseLayout>
