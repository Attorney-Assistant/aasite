          "/>
          <!-- Antenna spires on the tallest buildings -->
          <g stroke="#0F1B33" stroke-width="1.5" fill="none">
            <line x1="103" y1="165" x2="103" y2="152"/>
            <line x1="177" y1="118" x2="177" y2="102"/>
