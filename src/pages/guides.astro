---

<BaseLayout title="Free Guides for Law Firms" description="Download free guides on cybersecurity, intake optimization, VA management, and more. Help your law firm operate smarter and grow faster.">

  <Hero
    badge="Free Downloads"
    title="Guides"
    subtitle="Access our exclusive collection of legal guides and resources to help your firm operate smarter."
  />

  <section class="section-padding reveal" style="transition-delay: 0.1s;">
    <div class="container-wide">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {guides.map((guide) => (
          <div class="card card-hover flex flex-col p-6">
            <div class="featured-icon featured-icon-lg featured-icon-gold mb-5">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={guide.icon} />
              </svg>
            </div>
            <h2 class="text-lg font-heading text-gray-900 mb-2">
              {guide.title}
            </h2>
            <p class="text-sm text-gray-500 leading-relaxed mb-6 flex-1">
              {guide.description}
            </p>
            <a
              href={guide.pdf}
              target="_blank"
              rel="noopener"
              class="btn-primary text-sm w-full justify-center"
            >
              Download Guide
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Need Personalized Legal Assistance?"
    body="Our team is ready to help with your specific needs. Contact us today for a consultation."
    buttonText="Book a Call"
    buttonLink="/contact"
    variant="brand"
  />

</BaseLayout>
