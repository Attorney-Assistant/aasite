---
import ComicCampaignLayout from "@layouts/ComicCampaignLayout.astro";
import { MEETING_URLS } from "@/config/forms";

const SCHEDULER_URL = MEETING_URLS.greatLawFirmReset2026;
const IMG = '/images/lp/law-firm-reset';
---

<ComicCampaignLayout
  title="The Great Law Firm Reset | Attorney Assistant"
  description="We rescue law firms with elite legal staffing and AI solutions. Reserve your Intake360 demo before our opening spots fill up next week."
  image={`${IMG}/woman-hero.png`}
>
  <div id="lfr-lp">

    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="lfr-hero">
      <div class="lfr-hero-skyline" aria-hidden="true"></div>
      <div class="lfr-halftone" aria-hidden="true"></div>

      <div class="lfr-container lfr-hero-grid">
        <div class="lfr-hero-copy">
          <span class="lfr-eyebrow">The Great Law Firm Reset</span>
          <h1 class="lfr-display">
            We rescue<br />
            <span class="lfr-accent-gold">law firms.</span>
          </h1>
          <p class="lfr-lede">
            Elite <span class="lfr-pop">legal staffing</span> + built-in <span class="lfr-pop-blue">AI solutions</span>, deployed in 30 days and scaled with your firm.
          </p>

          <div class="lfr-squeeze">
            <span class="lfr-squeeze-pow">URGENT!</span>
            <p>Book A Demo Today Before Our <strong>Intake360 Spots</strong> Fill Up Next Week.</p>
          </div>

          <a href="#reserve-your-spot" class="lfr-scroll-cta">
            <span>Reserve My Spot</span>
            <span class="lfr-arrow" aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="lfr-hero-art">
          <div class="lfr-bat-stage" aria-label="The Attorney Assistant signal lighting up the sky">
            <div class="lfr-bat-glow" aria-hidden="true"></div>
            <img src={`${IMG}/bat-signal.svg`} alt="Attorney Assistant signal" class="lfr-bat" width="260" height="575" />
          </div>
          <img src={`${IMG}/woman-hero.png`} alt="A super-powered legal hero, cape flying, answering the call" class="lfr-woman" width="640" height="800" loading="eager" />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         SCHEDULER — the CTA
    ═══════════════════════════════════════════ -->
    <section id="reserve-your-spot" class="lfr-reserve">
      <div class="lfr-container">
        <div class="lfr-reserve-header">
          <span class="lfr-reserve-pow">BOOK NOW!</span>
          <h2 class="lfr-display lfr-display-md">
            <span class="lfr-reserve-line">Lock in your <span class="lfr-accent-gold">Intake360</span> demo</span>
            <span class="lfr-reserve-line">before the spots are gone.</span>
          </h2>
          <p class="lfr-reserve-sub">
            We're holding back a limited block of opening-week demo slots for The Great Law Firm Reset. Pick a time below. The calendar closes when they're filled.
          </p>
        </div>

        <div class="lfr-scheduler-frame">
          <span class="lfr-scheduler-tape lfr-scheduler-tape-tl" aria-hidden="true">★</span>
          <span class="lfr-scheduler-tape lfr-scheduler-tape-tr" aria-hidden="true">★</span>
          <div class="meetings-iframe-container" data-src={`${SCHEDULER_URL}?embed=true`}></div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         VALUE PILLARS
    ═══════════════════════════════════════════ -->
    <section class="lfr-pillars">
      <div class="lfr-container">
        <div class="lfr-pillars-header">
          <span class="lfr-eyebrow lfr-eyebrow-light">What you'll see in the demo</span>
          <h2 class="lfr-display lfr-display-md">
            <span class="lfr-pillars-line">Three powers.</span>
            <span class="lfr-pillars-line lfr-accent-gold">One rescue plan.</span>
          </h2>
        </div>

        <div class="lfr-pillars-grid">
          <article class="lfr-pillar">
            <div class="lfr-pillar-icon"><img src={`${IMG}/icon1.svg`} alt="" width="64" height="64" loading="lazy" /></div>
            <h3>Elite Legal Staffing</h3>
            <p>U.S.-managed paralegals, intake specialists, and case managers, trained on your firm's playbook, embedded in your tools, billable on day one.</p>
          </article>

          <article class="lfr-pillar">
            <div class="lfr-pillar-icon"><img src={`${IMG}/icon2.svg`} alt="" width="64" height="64" loading="lazy" /></div>
            <h3>Built-in AI Solutions</h3>
            <p>Intake360 catches every call, qualifies every lead, and routes the high-intent ones to a human in seconds. Your firm answers, every time.</p>
          </article>

          <article class="lfr-pillar">
            <div class="lfr-pillar-icon"><img src={`${IMG}/icon3.svg`} alt="" width="64" height="64" loading="lazy" /></div>
            <h3>30-Day Deployment</h3>
            <p>From kickoff to live cases in under a month. SOPs documented, team trained, AI tuned to your intake. No consulting decks, no six-month implementations.</p>
          </article>
        </div>

        <div class="lfr-pillars-cta">
          <a href="#reserve-your-spot" class="lfr-pill-cta">
            <span>Reserve My Spot</span>
            <span class="lfr-arrow" aria-hidden="true">↑</span>
          </a>
        </div>
      </div>
    </section>

  </div>

  <!-- HubSpot Meetings Embed loader (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (!allowed) {
        document.querySelectorAll('.meetings-iframe-container').forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;">This scheduler is not available from your location.</div>';
        });
        return;
      }
      var s = document.createElement('script');
      s.src = 'https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js';
      document.head.appendChild(s);
    });
  </script>

  <style is:global>
    .meetings-iframe-container iframe { background: #ffffff !important; }
  </style>

  <style is:global>
    /* ── Color tokens (comic palette) */
    #lfr-lp {
      --navy: #0e2236;
      --navy-deep: #061320;
      --navy-mid: #1a3a5c;
      --gold: #F9A630;
      --gold-bright: #FBD46D;
      --red: #E04A2C;
      --red-bright: #FF6B45;
      --blue: #5087dd;
      --steel: #c0c8d4;
      --steel-dim: #6f7a8a;
      background: var(--navy);
      color: #fff;
      font-family: 'Inter', -apple-system, sans-serif;
      line-height: 1.55;
      overflow-x: clip;
    }

    /* ── Layout */
    #lfr-lp .lfr-container { max-width: 1240px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 3; }
    @media (max-width: 720px) { #lfr-lp .lfr-container { padding: 0 20px; } }

    /* ── Typography */
    #lfr-lp .lfr-display, #lfr-lp .lfr-eyebrow, #lfr-lp .lfr-squeeze-pow, #lfr-lp .lfr-reserve-pow, #lfr-lp h1, #lfr-lp h2, #lfr-lp h3 {
      font-family: 'Bangers', 'Impact', sans-serif;
      letter-spacing: 0.04em;
    }
    #lfr-lp .lfr-display {
      letter-spacing: 0.02em;
      line-height: 0.95;
      text-transform: uppercase;
      color: #FFFFFF;
      text-shadow: 3px 3px 0 var(--red), 6px 6px 0 var(--navy-deep);
      font-size: clamp(56px, 9vw, 132px);
    }
    #lfr-lp .lfr-display-md { font-size: clamp(38px, 6vw, 80px); }
    #lfr-lp .lfr-accent-gold { color: var(--gold); }
    #lfr-lp .lfr-accent-red {
      color: var(--red-bright);
      text-shadow: 3px 3px 0 #fff, 6px 6px 0 var(--navy-deep);
    }
    #lfr-lp .lfr-pop { color: var(--gold); font-style: italic; }
    #lfr-lp .lfr-pop-blue { color: var(--blue); font-style: italic; }

    /* ── Hero */
    #lfr-lp .lfr-hero {
      position: relative;
      padding: 100px 0 80px;
      isolation: isolate;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 30% 30%, rgba(80,135,221,0.18), transparent 55%),
        radial-gradient(ellipse at 75% 70%, rgba(249,166,48,0.14), transparent 60%),
        var(--navy);
    }
    #lfr-lp .lfr-hero-skyline {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 60%;
      background-image: url('/images/lp/law-firm-reset/skyline.svg');
      background-repeat: no-repeat;
      background-position: bottom center;
      background-size: cover;
      opacity: 0.55;
      z-index: 1;
      pointer-events: none;
      mask-image: linear-gradient(to top, #000 60%, transparent 100%);
      -webkit-mask-image: linear-gradient(to top, #000 60%, transparent 100%);
    }
    #lfr-lp .lfr-halftone {
      position: absolute; inset: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0);
      background-size: 8px 8px;
      mix-blend-mode: screen;
      z-index: 2;
      pointer-events: none;
    }

    #lfr-lp .lfr-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 48px;
      align-items: center;
    }
    @media (max-width: 960px) {
      #lfr-lp .lfr-hero-grid { grid-template-columns: 1fr; gap: 32px; }
      #lfr-lp .lfr-hero { padding: 64px 0 48px; }
    }

    /* ── Hero copy */
    #lfr-lp .lfr-eyebrow {
      display: inline-block;
      background: var(--red);
      color: #fff;
      padding: 8px 16px;
      letter-spacing: 0.12em;
      font-size: 16px;
      transform: rotate(-2deg);
      margin-bottom: 24px;
      box-shadow: 4px 4px 0 var(--navy-deep);
    }
    #lfr-lp .lfr-eyebrow-light {
      background: var(--gold);
      color: var(--navy-deep);
    }
    #lfr-lp .lfr-hero-copy h1 { margin: 0 0 24px; }
    #lfr-lp .lfr-lede {
      font-family: 'Sora', sans-serif;
      font-weight: 600;
      font-size: clamp(19px, 2.2vw, 26px);
      color: var(--steel);
      line-height: 1.35;
      max-width: 540px;
      margin: 0 0 32px;
    }

    /* Urgency squeeze — blue scheme so it doesn't clash with the gold CTA below */
    #lfr-lp .lfr-squeeze {
      display: flex;
      align-items: center;
      gap: 16px;
      background: rgba(80, 135, 221, 0.12);
      border: 2px solid var(--blue);
      border-radius: 4px;
      padding: 16px 18px 16px 24px;
      box-shadow: 5px 5px 0 var(--navy-deep);
      margin: 0 0 28px;
      max-width: 580px;
      position: relative;
      transform: rotate(-0.4deg);
    }
    #lfr-lp .lfr-squeeze-pow {
      flex-shrink: 0;
      background: var(--red);
      color: #fff;
      padding: 6px 12px;
      font-size: 18px;
      letter-spacing: 0.08em;
      transform: rotate(-6deg);
      box-shadow: 2px 2px 0 var(--navy-deep);
    }
    #lfr-lp .lfr-squeeze p {
      margin: 0;
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 15px;
      color: #fff;
      line-height: 1.4;
    }
    #lfr-lp .lfr-squeeze strong { color: #8bb4f5; }

    /* Hero scroll CTA */
    #lfr-lp .lfr-scroll-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--gold);
      color: var(--navy-deep);
      padding: 18px 30px;
      font-family: 'Bangers', sans-serif;
      font-size: clamp(22px, 2.4vw, 28px);
      letter-spacing: 0.08em;
      text-decoration: none;
      border: none;
      cursor: pointer;
      box-shadow: 6px 6px 0 var(--navy-deep);
      transform: rotate(-1deg);
      transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    }
    #lfr-lp .lfr-scroll-cta:hover {
      transform: rotate(-1deg) translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--navy-deep);
      background: var(--gold-bright);
    }
    #lfr-lp .lfr-arrow {
      display: inline-block;
      animation: lfr-arrow-bob 1.6s ease-in-out infinite;
    }
    @keyframes lfr-arrow-bob {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(4px); }
    }

    /* ── Hero art (woman + bat signal) */
    #lfr-lp .lfr-hero-art {
      position: relative;
      display: flex;
      justify-content: flex-end;
      align-items: flex-end;
      min-height: 660px;
      align-self: stretch;
    }
    @media (max-width: 960px) {
      #lfr-lp .lfr-hero-art { min-height: 560px; justify-content: center; }
    }

    #lfr-lp .lfr-woman {
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: 720px;
      height: auto;
      display: block;
      margin-bottom: -80px;
      filter: drop-shadow(0 18px 44px rgba(0,0,0,0.6));
    }
    @media (max-width: 720px) {
      #lfr-lp .lfr-woman { max-width: 460px; margin-bottom: -48px; }
    }

    /* Bat signal — bottom pinned behind her back; top swings like a clock hand
       between the 11-o'clock and 2-o'clock positions. The actual beam tip in
       the SVG sits at roughly (34%, 97%) of the stage, so we pivot there to
       keep the visible bottom truly fixed. */
    #lfr-lp .lfr-bat-stage {
      position: absolute;
      top: -4%;
      right: -8%;
      width: 360px;
      height: 360px;
      z-index: 2;
      pointer-events: none;
      transform-origin: 34% 97%;
      animation: lfr-bat-pendulum 10s ease-in-out infinite;
    }
    @media (max-width: 720px) {
      #lfr-lp .lfr-bat-stage { width: 225px; height: 225px; right: -6%; top: -2%; }
    }
    @keyframes lfr-bat-pendulum {
      0%, 100% { transform: rotate(-30deg); } /* 11 o'clock */
      50%      { transform: rotate(30deg);  } /* 2 o'clock */
    }
    #lfr-lp .lfr-bat {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 0 20px rgba(249,166,48,0.65));
    }
    #lfr-lp .lfr-bat-glow {
      position: absolute;
      inset: -30%;
      background: radial-gradient(circle, rgba(249,166,48,0.55) 0%, rgba(249,166,48,0.15) 35%, transparent 65%);
      filter: blur(8px);
      animation: lfr-bat-pulse 3s ease-in-out infinite;
      z-index: -1;
    }
    @keyframes lfr-bat-pulse {
      0%, 100% { transform: scale(0.92); opacity: 0.55; }
      50%      { transform: scale(1.10); opacity: 0.95; }
    }

    /* ══════════════════════════════════════════
       RESERVE / SCHEDULER SECTION
    ══════════════════════════════════════════ */
    #lfr-lp .lfr-reserve {
      position: relative;
      padding: 96px 0 100px;
      background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
      isolation: isolate;
      overflow: hidden;
    }
    #lfr-lp .lfr-reserve::after {
      content: '';
      position: absolute; inset: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0);
      background-size: 8px 8px;
      mix-blend-mode: screen;
      pointer-events: none;
    }

    #lfr-lp .lfr-reserve-header {
      text-align: center;
      max-width: 820px;
      margin: 0 auto 48px;
      position: relative;
    }
    #lfr-lp .lfr-reserve-pow {
      display: inline-block;
      background: var(--red);
      color: #fff;
      padding: 8px 20px;
      font-size: 22px;
      letter-spacing: 0.10em;
      transform: rotate(-3deg);
      box-shadow: 4px 4px 0 var(--gold);
      margin-bottom: 24px;
    }
    #lfr-lp .lfr-reserve-header h2 {
      margin: 0 0 16px;
      font-size: clamp(34px, 5vw, 60px);
    }
    #lfr-lp .lfr-reserve-line { display: block; }
    #lfr-lp .lfr-reserve-sub {
      font-family: 'Sora', sans-serif;
      font-weight: 600;
      font-size: clamp(16px, 1.8vw, 19px);
      color: var(--steel);
      line-height: 1.5;
      max-width: 640px;
      margin: 0 auto;
    }

    #lfr-lp .lfr-scheduler-frame {
      position: relative;
      background: #fff;
      border-radius: 14px;
      border: 4px solid var(--gold);
      box-shadow:
        10px 10px 0 var(--red),
        20px 20px 0 var(--navy-deep);
      max-width: 940px;
      margin: 0 auto;
      padding: 16px;
    }
    @media (max-width: 720px) {
      #lfr-lp .lfr-scheduler-frame { box-shadow: 6px 6px 0 var(--red), 12px 12px 0 var(--navy-deep); padding: 10px; }
    }
    #lfr-lp .lfr-scheduler-tape {
      position: absolute;
      width: 44px; height: 44px;
      background: var(--red);
      color: #fff;
      font-family: 'Bangers', sans-serif;
      font-size: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      box-shadow: 2px 2px 0 var(--navy-deep);
      z-index: 2;
    }
    #lfr-lp .lfr-scheduler-tape-tl { top: -18px; left: -18px; transform: rotate(-12deg); }
    #lfr-lp .lfr-scheduler-tape-tr { top: -18px; right: -18px; transform: rotate(12deg); background: var(--gold); color: var(--navy-deep); }

    #lfr-lp .meetings-iframe-container { min-height: 720px; }

    /* ══════════════════════════════════════════
       VALUE PILLARS
    ══════════════════════════════════════════ */
    #lfr-lp .lfr-pillars {
      position: relative;
      padding: 96px 0 110px;
      background: var(--navy);
      isolation: isolate;
      overflow: hidden;
    }
    #lfr-lp .lfr-pillars::after {
      content: '';
      position: absolute; inset: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.04) 1px, transparent 0);
      background-size: 8px 8px;
      mix-blend-mode: screen;
      pointer-events: none;
    }
    #lfr-lp .lfr-pillars-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 56px;
    }
    #lfr-lp .lfr-pillars-header h2 { margin: 0; }
    #lfr-lp .lfr-pillars-line { display: block; }
    #lfr-lp .lfr-pillars-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 28px;
      max-width: 1100px;
      margin: 0 auto;
    }
    #lfr-lp .lfr-pillar {
      background:
        radial-gradient(ellipse at 50% 0%, rgba(249,166,48,0.10), transparent 70%),
        rgba(255,255,255,0.04);
      border: 2px solid rgba(255,255,255,0.10);
      padding: 32px 26px 28px;
      position: relative;
      transition: transform 0.25s, border-color 0.25s, background 0.25s;
      isolation: isolate;
    }
    #lfr-lp .lfr-pillar:nth-child(1) { transform: rotate(-0.6deg); }
    #lfr-lp .lfr-pillar:nth-child(2) { transform: rotate(0.6deg); }
    #lfr-lp .lfr-pillar:nth-child(3) { transform: rotate(-0.4deg); }
    #lfr-lp .lfr-pillar:hover {
      transform: rotate(0) translateY(-6px);
      border-color: var(--gold);
      background:
        radial-gradient(ellipse at 50% 0%, rgba(249,166,48,0.18), transparent 70%),
        rgba(249,166,48,0.06);
    }
    #lfr-lp .lfr-pillar-icon {
      width: 100px; height: 100px;
      display: flex; align-items: center; justify-content: center;
      background: var(--gold);
      border-radius: 50%;
      margin: 0 auto 28px;
      box-shadow: 4px 4px 0 var(--navy-deep);
      position: relative;
      overflow: visible;
    }
    #lfr-lp .lfr-pillar-icon img {
      width: 140px;
      height: 140px;
      display: block;
      position: relative;
      filter: drop-shadow(2px 2px 0 var(--navy-deep));
    }
    #lfr-lp .lfr-pillar h3 {
      font-size: clamp(24px, 2.6vw, 30px);
      color: #fff;
      text-shadow: 2px 2px 0 var(--navy-deep);
      margin: 0 0 12px;
      text-align: center;
      line-height: 1.1;
    }
    #lfr-lp .lfr-pillar p {
      font-family: 'Inter', sans-serif;
      font-size: 15px;
      color: var(--steel);
      line-height: 1.55;
      margin: 0;
      text-align: center;
    }

    #lfr-lp .lfr-pillars-cta { text-align: center; margin-top: 56px; }
    #lfr-lp .lfr-pill-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--red);
      color: #fff;
      padding: 18px 30px;
      font-family: 'Bangers', sans-serif;
      font-size: clamp(22px, 2.4vw, 28px);
      letter-spacing: 0.08em;
      text-decoration: none;
      border: none;
      cursor: pointer;
      box-shadow: 6px 6px 0 var(--navy-deep);
      transform: rotate(-1deg);
      transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    }
    #lfr-lp .lfr-pill-cta:hover {
      transform: rotate(-1deg) translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--navy-deep);
      background: var(--red-bright);
    }

    /* ════════════════════════════════════
       Mobile — comprehensive overrides
    ════════════════════════════════════ */
    @media (max-width: 720px) {
      /* Hero */
      #lfr-lp .lfr-hero { padding: 40px 0 24px; }
      #lfr-lp .lfr-hero-skyline { height: 42%; opacity: 0.45; }
      #lfr-lp .lfr-display { font-size: clamp(44px, 13vw, 72px); }
      #lfr-lp .lfr-eyebrow {
        font-size: 12px;
        padding: 6px 12px;
        margin-bottom: 16px;
        letter-spacing: 0.10em;
      }
      #lfr-lp .lfr-hero-copy h1 { margin-bottom: 18px; }
      #lfr-lp .lfr-lede { font-size: 17px; line-height: 1.4; margin-bottom: 24px; }

      /* Squeeze box — stack vertically, no rotation */
      #lfr-lp .lfr-squeeze {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
        padding: 14px 16px;
        margin-bottom: 24px;
        transform: none;
        box-shadow: 4px 4px 0 var(--navy-deep);
      }
      #lfr-lp .lfr-squeeze-pow { font-size: 15px; padding: 4px 10px; transform: rotate(-4deg); }
      #lfr-lp .lfr-squeeze p { font-size: 14px; }

      /* Scroll CTA */
      #lfr-lp .lfr-scroll-cta {
        padding: 14px 24px;
        font-size: 22px;
        transform: none;
        box-shadow: 5px 5px 0 var(--navy-deep);
      }
      #lfr-lp .lfr-scroll-cta:hover {
        transform: translate(-2px, -2px);
        box-shadow: 7px 7px 0 var(--navy-deep);
      }

      /* Hero art */
      #lfr-lp .lfr-hero-art {
        min-height: 440px;
        margin-top: 16px;
      }
      #lfr-lp .lfr-woman {
        max-width: 360px;
        margin-bottom: -28px;
      }

      /* Bat signal — smaller + positioned to sit behind her shoulder */
      #lfr-lp .lfr-bat-stage {
        width: 180px;
        height: 180px;
        right: 0;
        top: 0;
      }

      /* Reserve / scheduler */
      #lfr-lp .lfr-reserve { padding: 56px 0 64px; }
      #lfr-lp .lfr-reserve-header { margin-bottom: 32px; }
      #lfr-lp .lfr-reserve-pow {
        font-size: 16px;
        padding: 6px 14px;
        margin-bottom: 16px;
      }
      #lfr-lp .lfr-reserve-header h2 { font-size: clamp(24px, 7.5vw, 40px); }
      #lfr-lp .lfr-reserve-sub { font-size: 15px; line-height: 1.45; }

      #lfr-lp .lfr-scheduler-frame {
        border-width: 3px;
        border-radius: 10px;
        box-shadow: 5px 5px 0 var(--red), 10px 10px 0 var(--navy-deep);
        padding: 8px;
      }
      #lfr-lp .lfr-scheduler-tape {
        width: 32px;
        height: 32px;
        font-size: 16px;
      }
      #lfr-lp .lfr-scheduler-tape-tl { top: -12px; left: -10px; }
      #lfr-lp .lfr-scheduler-tape-tr { top: -12px; right: -10px; }
      #lfr-lp .meetings-iframe-container { min-height: 680px; }

      /* Pillars */
      #lfr-lp .lfr-pillars { padding: 56px 0 64px; }
      #lfr-lp .lfr-pillars-header { margin-bottom: 36px; }
      #lfr-lp .lfr-pillars-header h2 { font-size: clamp(28px, 9vw, 48px); }
      #lfr-lp .lfr-pillars-grid { gap: 20px; }
      #lfr-lp .lfr-pillar { padding: 26px 22px 24px; }
      /* Remove the card rotation on mobile so edges don't push out of the column */
      #lfr-lp .lfr-pillar:nth-child(1),
      #lfr-lp .lfr-pillar:nth-child(2),
      #lfr-lp .lfr-pillar:nth-child(3) { transform: none; }
      #lfr-lp .lfr-pillar-icon { width: 80px; height: 80px; margin-bottom: 18px; }
      #lfr-lp .lfr-pillar-icon img { width: 110px; height: 110px; }
      #lfr-lp .lfr-pillar h3 { font-size: 22px; margin-bottom: 10px; }
      #lfr-lp .lfr-pillar p { font-size: 14.5px; }

      #lfr-lp .lfr-pillars-cta { margin-top: 36px; }
      #lfr-lp .lfr-pill-cta {
        padding: 14px 24px;
        font-size: 22px;
        transform: none;
        box-shadow: 5px 5px 0 var(--navy-deep);
      }
    }

    /* Narrowest phones (≤420px) */
    @media (max-width: 420px) {
      #lfr-lp .lfr-display { font-size: clamp(38px, 14vw, 60px); }
      #lfr-lp .lfr-hero-art { min-height: 380px; }
      #lfr-lp .lfr-woman { max-width: 320px; margin-bottom: -22px; }
      #lfr-lp .lfr-bat-stage { width: 148px; height: 148px; }
      #lfr-lp .meetings-iframe-container { min-height: 640px; }
    }

    /* Reduced motion — kill all the swaying/pulsing */
    @media (prefers-reduced-motion: reduce) {
      #lfr-lp .lfr-bat-stage,
      #lfr-lp .lfr-bat-glow,
      #lfr-lp .lfr-arrow {
        animation: none !important;
      }
    }
  </style>

  <script is:inline>
    // Lightweight tracking — LP view + scheduler interaction
    (function() {
      function track(event, extra) {
        extra = extra || {};
        if (typeof posthog !== 'undefined') {
          posthog.capture(event, Object.assign({ lp: 'law-firm-reset' }, extra));
        }
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(Object.assign({ event: event, lp: 'law-firm-reset' }, extra));
      }
      track('law_firm_reset_lp_view');

      document.querySelectorAll('a[href="#reserve-your-spot"]').forEach(function(a) {
        a.addEventListener('click', function() {
          track('law_firm_reset_scroll_to_scheduler', { from: this.closest('section') ? this.closest('section').className : '' });
        });
      });
    })();
  </script>

</ComicCampaignLayout>
