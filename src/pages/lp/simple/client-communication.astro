---
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";
---

<SimpleCampaignLayout
  title="Client Communication Problems? Our Virtual Assistants Fix That"
  description="Stop losing clients to silence. Attorney Assistant's virtual assistants handle proactive updates, callbacks, and follow-ups so your clients always feel informed."
  image="/images/comic-client-management.webp"
  ogTitle="Client Communication Problems? We Fix That."
  ogDescription="Stop losing clients to silence. Proactive updates, callbacks, and follow-ups handled."
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[60vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10 py-20 lg:py-28 text-center">
      <div class="max-w-3xl mx-auto reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          Sound Familiar?
        </span>
        <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
          Client communication problems? <br/><span class="text-gradient-gold">Our Elite Staffing + AI Solutions fix that.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          Clients don't leave because you lost their case. They leave because no one called them back. Scroll to see the damage &mdash; then let's fix it.
        </p>
        <a href="#book-now" class="btn-primary btn-lg group inline-flex mb-8">
          Fix My Client Communication
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
        <div class="scc-scroll-hint" aria-hidden="true">
          <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2 mx-auto">
            <div class="w-1 h-2.5 bg-brand-gold rounded-full scc-scroll-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 py-20 md:py-28">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/5 rounded-full blur-[120px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">The Timeline</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          How Silence Kills Your Client Relationships
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">It's not one missed call. It's a pattern that compounds until trust is gone.</p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="scc-timeline">
          <div class="scc-timeline-line"></div>

          <div class="scc-timeline-event reveal">
            <div class="scc-timeline-dot scc-timeline-dot--gold"></div>
            <div class="scc-timeline-content">
              <p class="scc-timeline-label">Day 1</p>
              <h3 class="text-lg font-heading text-white mb-1">Client signs and feels great</h3>
              <p class="text-sm text-gray-400">They chose your firm. They're optimistic. They expect to hear from you soon about next steps.</p>
            </div>
          </div>

          <div class="scc-timeline-event reveal">
            <div class="scc-timeline-dot scc-timeline-dot--amber"></div>
            <div class="scc-timeline-content">
              <p class="scc-timeline-label">Week 2</p>
              <h3 class="text-lg font-heading text-white mb-1">They call for an update &mdash; voicemail</h3>
              <p class="text-sm text-gray-400">Nobody picks up. They leave a message. Your paralegal sees it the next day, means to call back, gets pulled into something else.</p>
            </div>
          </div>

          <div class="scc-timeline-event reveal">
            <div class="scc-timeline-dot scc-timeline-dot--red"></div>
            <div class="scc-timeline-content">
              <p class="scc-timeline-label">Week 4</p>
              <h3 class="text-lg font-heading text-white mb-1">They call again &mdash; frustrated</h3>
              <p class="text-sm text-gray-400">"I haven't heard from anyone in a month." Now you're playing defense. The attorney scrambles to pull a status together mid-call.</p>
            </div>
          </div>

          <div class="scc-timeline-event reveal">
            <div class="scc-timeline-dot scc-timeline-dot--red"></div>
            <div class="scc-timeline-content">
              <p class="scc-timeline-label">Week 6</p>
              <h3 class="text-lg font-heading text-white mb-1">They post a 1-star review</h3>
              <p class="text-sm text-gray-400">"Great attorney but impossible to get ahold of. I had to call multiple times just to get an update on my own case."</p>
            </div>
          </div>

          <div class="scc-timeline-event reveal">
            <div class="scc-timeline-dot scc-timeline-dot--big"></div>
            <div class="scc-timeline-content">
              <p class="scc-timeline-label">Ongoing</p>
              <h3 class="text-display-xs font-heading text-brand-gold mb-1">Now multiply that by every active client.</h3>
              <p class="text-sm text-gray-400">It's not one unhappy client. It's a reputation problem, a referral problem, and a retention problem &mdash; all because nobody owned the communication.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28">
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-gold/5 rounded-full blur-[100px]"></div>
    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Be Honest</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          How does your firm handle client communication today?
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Pick the one that hits closest to home.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto" id="scc-paths">
        <button class="scc-path-card reveal" data-path="reactive" style="transition-delay: 0ms">
          <div class="scc-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">We only call when clients call us</h3>
          <p class="text-sm text-gray-500">Reactive, not proactive. If they don't reach out, they don't hear from us.</p>
        </button>

        <button class="scc-path-card reveal" data-path="attorney" style="transition-delay: 100ms">
          <div class="scc-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">The attorney handles it personally</h3>
          <p class="text-sm text-gray-500">Clients expect to talk to the lawyer, but the lawyer has 80 other cases.</p>
        </button>

        <button class="scc-path-card reveal" data-path="nobody" style="transition-delay: 200ms">
          <div class="scc-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">Nobody really owns it</h3>
          <p class="text-sm text-gray-500">Updates happen when someone remembers. There's no system, no cadence, no accountability.</p>
        </button>
      </div>

      <!-- Consequence panels -->
      <div id="scc-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="p-8 rounded-2xl border border-brand-gold/20 bg-brand-gold/5 text-center">
          <p class="text-sm font-bold text-brand-gold uppercase tracking-widest mb-3" id="scc-consequence-label"></p>
          <p class="text-xl font-heading text-gray-900 mb-3" id="scc-consequence-title"></p>
          <p class="text-base text-gray-600 leading-relaxed" id="scc-consequence-body"></p>
          <a href="#book-now" class="btn-primary btn-lg group mt-6 inline-flex">
            Let's Fix This
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER REVEAL
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-20 md:py-28">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">The Difference</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          Your Process vs. <span class="text-gradient-gold">Ours</span>
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="flex justify-center mb-10 reveal">
          <div class="inline-flex rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm">
            <button class="scc-toggle-btn scc-toggle-btn--active" data-view="before" id="scc-toggle-before">Your Current Process</button>
            <button class="scc-toggle-btn" data-view="after" id="scc-toggle-after">With Attorney Assistant</button>
          </div>
        </div>

        <div id="scc-panel-before" class="scc-panel reveal">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="scc-pain-item">
              <span class="scc-pain-x">&#10005;</span>
              <div>
                <p class="text-white font-semibold text-sm">Calls go to voicemail</p>
                <p class="text-white/40 text-xs mt-0.5">Clients leave messages nobody returns for days</p>
              </div>
            </div>
            <div class="scc-pain-item">
              <span class="scc-pain-x">&#10005;</span>
              <div>
                <p class="text-white font-semibold text-sm">No proactive updates</p>
                <p class="text-white/40 text-xs mt-0.5">Clients only hear from you when they chase you down</p>
              </div>
            </div>
            <div class="scc-pain-item">
              <span class="scc-pain-x">&#10005;</span>
              <div>
                <p class="text-white font-semibold text-sm">Attorneys burned on callbacks</p>
                <p class="text-white/40 text-xs mt-0.5">$400/hr lawyers returning "what's my case status?" calls</p>
              </div>
            </div>
            <div class="scc-pain-item">
              <span class="scc-pain-x">&#10005;</span>
              <div>
                <p class="text-white font-semibold text-sm">Inconsistent follow-up</p>
                <p class="text-white/40 text-xs mt-0.5">Some clients get attention. Others go weeks without contact.</p>
              </div>
            </div>
            <div class="scc-pain-item">
              <span class="scc-pain-x">&#10005;</span>
              <div>
                <p class="text-white font-semibold text-sm">Bad reviews pile up</p>
                <p class="text-white/40 text-xs mt-0.5">"Great lawyer but I could never reach anyone"</p>
              </div>
            </div>
            <div class="scc-pain-item">
              <span class="scc-pain-x">&#10005;</span>
              <div>
                <p class="text-white font-semibold text-sm">Referrals dry up</p>
                <p class="text-white/40 text-xs mt-0.5">Unhappy clients don't send friends. They send warnings.</p>
              </div>
            </div>
          </div>
        </div>

        <div id="scc-panel-after" class="scc-panel" style="display:none">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="scc-win-item">
              <span class="scc-win-check">&#10003;</span>
              <div>
                <p class="text-white font-semibold text-sm">Every call answered live</p>
                <p class="text-white/40 text-xs mt-0.5">A real person picks up, takes notes, and routes appropriately</p>
              </div>
            </div>
            <div class="scc-win-item">
              <span class="scc-win-check">&#10003;</span>
              <div>
                <p class="text-white font-semibold text-sm">Scheduled status updates</p>
                <p class="text-white/40 text-xs mt-0.5">Clients hear from you on a cadence, not just when they complain</p>
              </div>
            </div>
            <div class="scc-win-item">
              <span class="scc-win-check">&#10003;</span>
              <div>
                <p class="text-white font-semibold text-sm">Attorneys freed up</p>
                <p class="text-white/40 text-xs mt-0.5">VAs handle routine updates so lawyers focus on legal work</p>
              </div>
            </div>
            <div class="scc-win-item">
              <span class="scc-win-check">&#10003;</span>
              <div>
                <p class="text-white font-semibold text-sm">No client left behind</p>
                <p class="text-white/40 text-xs mt-0.5">Every case gets the same communication standard, every time</p>
              </div>
            </div>
            <div class="scc-win-item">
              <span class="scc-win-check">&#10003;</span>
              <div>
                <p class="text-white font-semibold text-sm">5-star reviews increase</p>
                <p class="text-white/40 text-xs mt-0.5">"They kept me informed the entire time. I always knew where I stood."</p>
              </div>
            </div>
            <div class="scc-win-item">
              <span class="scc-win-check">&#10003;</span>
              <div>
                <p class="text-white font-semibold text-sm">Referrals come back</p>
                <p class="text-white/40 text-xs mt-0.5">Happy clients send friends, family, and colleagues</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-16 md:py-24" id="book-now">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <div class="inline-flex items-baseline gap-1 mb-4">
            <a href="/"><img src="/brand/logos/color_icon.svg" alt="Attorney Assistant" class="h-8 w-auto" /></a>
          </div>
          <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
            Let's Fix Your Client Communication
          </h2>
          <p class="text-lg text-gray-500 max-w-xl mx-auto">Book a quick call. We'll show you how a dedicated VA keeps every client informed without burning out your attorneys.</p>
        </div>

        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-gray-200 reveal scroll-mt-20" style="transition-delay: 150ms">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/simple-campaign?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-400 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Free &mdash; no commitment
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            15 minutes
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }

    .scc-scroll-hint { animation: sccFadeIn 1s ease 1.5s both; }
    @keyframes sccFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .scc-scroll-dot { animation: sccScrollBounce 1.5s ease-in-out infinite; }
    @keyframes sccScrollBounce { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(8px); opacity: 0.3; } }

    .scc-timeline { position: relative; padding-left: 2rem; }
    .scc-timeline-line { position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, rgba(249,166,48,0.4), rgba(239,68,68,0.4), rgba(249,166,48,0.6)); }
    .scc-timeline-event { position: relative; padding-bottom: 2.5rem; padding-left: 1.5rem; }
    .scc-timeline-event:last-child { padding-bottom: 0; }
    .scc-timeline-dot { position: absolute; left: -2rem; top: 0.25rem; width: 14px; height: 14px; border-radius: 50%; z-index: 1; }
    .scc-timeline-dot--gold { background: #F9A630; box-shadow: 0 0 0 4px rgba(249,166,48,0.2); }
    .scc-timeline-dot--amber { background: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,0.2); }
    .scc-timeline-dot--red { background: #ef4444; box-shadow: 0 0 0 4px rgba(239,68,68,0.2); }
    .scc-timeline-dot--big { width: 18px; height: 18px; left: calc(-2rem - 2px); background: #F9A630; box-shadow: 0 0 0 6px rgba(249,166,48,0.25); }
    .scc-timeline-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 0.25rem; }

    .scc-path-card { text-align: center; padding: 2rem 1.5rem; border: 2px solid #e5e7eb; border-radius: 1rem; background: white; cursor: pointer; transition: all 0.3s ease; }
    .scc-path-card:hover { border-color: #F9A630; transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }
    .scc-path-card.scc-path-card--active { border-color: #F9A630; background: rgba(249,166,48,0.04); box-shadow: 0 0 0 3px rgba(249,166,48,0.15); }
    .scc-path-icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(249,166,48,0.08); color: #F9A630; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; border: 1px solid rgba(249,166,48,0.15); }

    .scc-toggle-btn { padding: 0.5rem 1.25rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600; color: rgba(255,255,255,0.5); background: transparent; border: none; cursor: pointer; transition: all 0.3s; }
    .scc-toggle-btn--active { background: #F9A630; color: #1a3a5c; }

    .scc-pain-item, .scc-win-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); }
    .scc-pain-x { color: #ef4444; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(239,68,68,0.1); border-radius: 50%; }
    .scc-win-check { color: #10b981; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(16,185,129,0.1); border-radius: 50%; }

    .scc-panel { animation: sccPanelIn 0.4s ease; }
    @keyframes sccPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

    @media (prefers-reduced-motion: reduce) {
      .scc-scroll-dot, .scc-scroll-hint { animation: none !important; }
      .scc-panel { animation: none !important; }
    }
  </style>

  <script is:inline>
    (function() {
      var consequences = {
        reactive: {
          label: 'Reactive = Invisible',
          title: 'If clients only hear from you when they call first, they assume nothing is happening on their case.',
          body: 'Silence doesn\'t mean "we\'re working on it" to a client. Silence means "they forgot about me." And a client who feels forgotten doesn\'t leave a good review, send a referral, or stay patient when the case takes time.'
        },
        attorney: {
          label: 'The Bottleneck Is You',
          title: 'When the attorney is the only person clients trust to talk to, every status call costs $400/hr in lost productivity.',
          body: 'Your clients don\'t need a lawyer for a status update. They need a friendly, informed voice who knows their case and can give them confidence. That\'s exactly what a trained virtual assistant does — at a fraction of the cost.'
        },
        nobody: {
          label: 'Nobody Owns It = Nobody Does It',
          title: 'Without someone responsible for client communication, updates happen based on who remembers and who has time.',
          body: 'That means some clients get great service and others get ghosted. The experience is inconsistent, unpredictable, and impossible to scale. You need a person whose job it is to keep clients informed — every case, every week.'
        }
      };

      document.querySelectorAll('.scc-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;
          document.querySelectorAll('.scc-path-card').forEach(function(c) { c.classList.remove('scc-path-card--active'); });
          this.classList.add('scc-path-card--active');
          document.getElementById('scc-consequence-label').textContent = data.label;
          document.getElementById('scc-consequence-title').textContent = data.title;
          document.getElementById('scc-consequence-body').textContent = data.body;
          var panel = document.getElementById('scc-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none';
          panel.offsetHeight;
          panel.style.animation = 'sccPanelIn 0.4s ease';
        });
      });

      var beforeBtn = document.getElementById('scc-toggle-before');
      var afterBtn = document.getElementById('scc-toggle-after');
      var beforePanel = document.getElementById('scc-panel-before');
      var afterPanel = document.getElementById('scc-panel-after');

      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('scc-toggle-btn--active');
          afterBtn.classList.remove('scc-toggle-btn--active');
          beforePanel.style.display = 'block';
          afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none';
          beforePanel.offsetHeight;
          beforePanel.style.animation = 'sccPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('scc-toggle-btn--active');
          beforeBtn.classList.remove('scc-toggle-btn--active');
          afterPanel.style.display = 'block';
          beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none';
          afterPanel.offsetHeight;
          afterPanel.style.animation = 'sccPanelIn 0.4s ease';
        });
      }
    })();
  </script>

