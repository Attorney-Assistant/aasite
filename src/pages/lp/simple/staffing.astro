---
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";
---

<SimpleCampaignLayout
  title="Law Firm Staffing Problems? We Fix That With Co-Managed Virtual Assistants"
  description="Stop losing money to bad hires, turnover, and understaffing. Attorney Assistant's co-managed virtual assistants give your firm reliable, trained support without the hiring headaches."
  image="/images/comic-staffing.webp"
  ogTitle="Law Firm Staffing Problems? We Fix That."
  ogDescription="Bad hires, turnover, understaffing. Get reliable, trained support without the headaches."
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[60vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10 py-20 lg:py-28 text-center">
      <div class="max-w-3xl mx-auto reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          Sound Familiar?
        </span>
        <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
          Law firm staffing problems? <br/><span class="text-gradient-gold">We fix that with co-managed virtual assistants.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          Turnover. Bad hires. Positions you can't fill. Scroll to see why traditional staffing keeps failing &mdash; and what actually works.
        </p>
        <a href="#book-now" class="btn-primary btn-lg group inline-flex mb-8">
          Fix My Staffing
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
        <div class="sst-scroll-hint" aria-hidden="true">
          <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2 mx-auto">
            <div class="w-1 h-2.5 bg-brand-gold rounded-full sst-scroll-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 py-20 md:py-28">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/5 rounded-full blur-[120px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">The Timeline</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          The Hiring Cycle That Never Ends
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">You've been here before. Probably more than once.</p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="sst-timeline">
          <div class="sst-timeline-line"></div>

          <div class="sst-timeline-event reveal">
            <div class="sst-timeline-dot sst-timeline-dot--gold"></div>
            <div class="sst-timeline-content">
              <p class="sst-timeline-label">Month 1</p>
              <h3 class="text-lg font-heading text-white mb-1">You post the job and wait</h3>
              <p class="text-sm text-gray-400">Indeed, ZipRecruiter, maybe a legal staffing agency. You sort through 50 resumes, interview 8, and hire one. Three weeks gone.</p>
            </div>
          </div>

          <div class="sst-timeline-event reveal">
            <div class="sst-timeline-dot sst-timeline-dot--amber"></div>
            <div class="sst-timeline-content">
              <p class="sst-timeline-label">Month 2</p>
              <h3 class="text-lg font-heading text-white mb-1">You train them from scratch</h3>
              <p class="text-sm text-gray-400">Your firm's systems, your practice areas, your clients, your tools. You or your best paralegal spends hours onboarding someone who's still learning the basics.</p>
            </div>
          </div>

          <div class="sst-timeline-event reveal">
            <div class="sst-timeline-dot sst-timeline-dot--red"></div>
            <div class="sst-timeline-content">
              <p class="sst-timeline-label">Month 4</p>
              <h3 class="text-lg font-heading text-white mb-1">They quit &mdash; or you realize they're not the right fit</h3>
              <p class="text-sm text-gray-400">Low pay, burnout, better offer, wrong culture fit. Whatever the reason, you're back to square one with nothing to show for it.</p>
            </div>
          </div>

          <div class="sst-timeline-event reveal">
            <div class="sst-timeline-dot sst-timeline-dot--red"></div>
            <div class="sst-timeline-content">
              <p class="sst-timeline-label">Month 5</p>
              <h3 class="text-lg font-heading text-white mb-1">The surviving staff absorbs the workload</h3>
              <p class="text-sm text-gray-400">Your best people are now doing two jobs. Quality drops. Morale drops. You start the hiring cycle again.</p>
            </div>
          </div>

          <div class="sst-timeline-event reveal">
            <div class="sst-timeline-dot sst-timeline-dot--big"></div>
            <div class="sst-timeline-content">
              <p class="sst-timeline-label">Repeat</p>
              <h3 class="text-display-xs font-heading text-brand-gold mb-1">Every hire costs you $15K–$25K when it doesn't work out.</h3>
              <p class="text-sm text-gray-400">Recruiting fees, training time, lost productivity, and the opportunity cost of doing it all over again. The problem isn't finding people. It's keeping them productive and managed.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28">
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-gold/5 rounded-full blur-[100px]"></div>
    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Be Honest</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          What's your biggest staffing headache right now?
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Pick the one that fits.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto" id="sst-paths">
        <button class="sst-path-card reveal" data-path="turnover" style="transition-delay: 0ms">
          <div class="sst-path-icon"><svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg></div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">We can't keep people</h3>
          <p class="text-sm text-gray-500">Turnover is constant. We hire, train, lose, repeat.</p>
        </button>

        <button class="sst-path-card reveal" data-path="cantfind" style="transition-delay: 100ms">
          <div class="sst-path-icon"><svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg></div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">We can't find good people</h3>
          <p class="text-sm text-gray-500">The applicant pool is weak. Nobody qualified applies.</p>
        </button>

        <button class="sst-path-card reveal" data-path="cost" style="transition-delay: 200ms">
          <div class="sst-path-icon"><svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">We can't afford more in-house staff</h3>
          <p class="text-sm text-gray-500">Salary, benefits, overhead &mdash; hiring another FTE isn't in the budget.</p>
        </button>
      </div>

      <div id="sst-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="p-8 rounded-2xl border border-brand-gold/20 bg-brand-gold/5 text-center">
          <p class="text-sm font-bold text-brand-gold uppercase tracking-widest mb-3" id="sst-consequence-label"></p>
          <p class="text-xl font-heading text-gray-900 mb-3" id="sst-consequence-title"></p>
          <p class="text-base text-gray-600 leading-relaxed" id="sst-consequence-body"></p>
          <a href="#book-now" class="btn-primary btn-lg group mt-6 inline-flex">Let's Fix This <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER REVEAL
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-20 md:py-28">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">The Difference</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">Traditional Hiring vs. <span class="text-gradient-gold">Co-Managed VAs</span></h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="flex justify-center mb-10 reveal">
          <div class="inline-flex rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm">
            <button class="sst-toggle-btn sst-toggle-btn--active" id="sst-toggle-before">Traditional Hiring</button>
            <button class="sst-toggle-btn" id="sst-toggle-after">Co-Managed VAs</button>
          </div>
        </div>

        <div id="sst-panel-before" class="sst-panel reveal">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="sst-pain-item"><span class="sst-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Weeks to hire</p><p class="text-white/40 text-xs mt-0.5">Posting, screening, interviewing &mdash; a month before anyone starts</p></div></div>
            <div class="sst-pain-item"><span class="sst-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">You manage and train them</p><p class="text-white/40 text-xs mt-0.5">Onboarding, performance reviews, daily oversight &mdash; all on you</p></div></div>
            <div class="sst-pain-item"><span class="sst-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">High cost per head</p><p class="text-white/40 text-xs mt-0.5">Salary + benefits + taxes + equipment + office space</p></div></div>
            <div class="sst-pain-item"><span class="sst-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Turnover restarts the cycle</p><p class="text-white/40 text-xs mt-0.5">They leave, and everything they knew walks out with them</p></div></div>
            <div class="sst-pain-item"><span class="sst-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Can't scale quickly</p><p class="text-white/40 text-xs mt-0.5">Need more help now? Too bad &mdash; hiring takes time.</p></div></div>
            <div class="sst-pain-item"><span class="sst-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">No legal ops expertise</p><p class="text-white/40 text-xs mt-0.5">Generic hires don't understand law firm workflows</p></div></div>
          </div>
        </div>

        <div id="sst-panel-after" class="sst-panel" style="display:none">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="sst-win-item"><span class="sst-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Matched and placed fast</p><p class="text-white/40 text-xs mt-0.5">Pre-trained VAs ready to plug into your workflows in days, not months</p></div></div>
            <div class="sst-win-item"><span class="sst-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Co-managed by legal ops experts</p><p class="text-white/40 text-xs mt-0.5">We handle training, performance, QA &mdash; you give direction, we execute</p></div></div>
            <div class="sst-win-item"><span class="sst-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">60% cost savings vs. in-house</p><p class="text-white/40 text-xs mt-0.5">No benefits, no overhead, no equipment &mdash; flat monthly rate</p></div></div>
            <div class="sst-win-item"><span class="sst-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Seamless replacements</p><p class="text-white/40 text-xs mt-0.5">If someone leaves, we backfill immediately. No gap. No panic.</p></div></div>
            <div class="sst-win-item"><span class="sst-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Scale up or swap roles anytime</p><p class="text-white/40 text-xs mt-0.5">Need more help? Need a different skill? Month-to-month flexibility.</p></div></div>
            <div class="sst-win-item"><span class="sst-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Legal-industry immersed</p><p class="text-white/40 text-xs mt-0.5">Our management team is built from the ground up around law firm operations</p></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-16 md:py-24" id="book-now">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <div class="inline-flex items-baseline gap-1 mb-4"><a href="/"><img src="/brand/logos/color_icon.svg" alt="Attorney Assistant" class="h-8 w-auto" /></a></div>
          <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">Let's Fix Your Staffing</h2>
          <p class="text-lg text-gray-500 max-w-xl mx-auto">Book a quick call. We'll match the right roles to your firm's bottlenecks &mdash; no commitment.</p>
        </div>

        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-gray-200 reveal scroll-mt-20" style="transition-delay: 150ms">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/simple-campaign?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-400 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5"><svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg> Free &mdash; no commitment</div>
          <div class="flex items-center gap-1.5"><svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg> 15 minutes</div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }
    .sst-scroll-hint { animation: sstFadeIn 1s ease 1.5s both; }
    @keyframes sstFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .sst-scroll-dot { animation: sstScrollBounce 1.5s ease-in-out infinite; }
    @keyframes sstScrollBounce { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(8px); opacity: 0.3; } }
    .sst-timeline { position: relative; padding-left: 2rem; }
    .sst-timeline-line { position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, rgba(249,166,48,0.4), rgba(239,68,68,0.4), rgba(249,166,48,0.6)); }
    .sst-timeline-event { position: relative; padding-bottom: 2.5rem; padding-left: 1.5rem; }
    .sst-timeline-event:last-child { padding-bottom: 0; }
    .sst-timeline-dot { position: absolute; left: -2rem; top: 0.25rem; width: 14px; height: 14px; border-radius: 50%; z-index: 1; }
    .sst-timeline-dot--gold { background: #F9A630; box-shadow: 0 0 0 4px rgba(249,166,48,0.2); }
    .sst-timeline-dot--amber { background: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,0.2); }
    .sst-timeline-dot--red { background: #ef4444; box-shadow: 0 0 0 4px rgba(239,68,68,0.2); }
    .sst-timeline-dot--big { width: 18px; height: 18px; left: calc(-2rem - 2px); background: #F9A630; box-shadow: 0 0 0 6px rgba(249,166,48,0.25); }
    .sst-timeline-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 0.25rem; }
    .sst-path-card { text-align: center; padding: 2rem 1.5rem; border: 2px solid #e5e7eb; border-radius: 1rem; background: white; cursor: pointer; transition: all 0.3s ease; }
    .sst-path-card:hover { border-color: #F9A630; transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }
    .sst-path-card.sst-path-card--active { border-color: #F9A630; background: rgba(249,166,48,0.04); box-shadow: 0 0 0 3px rgba(249,166,48,0.15); }
    .sst-path-icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(249,166,48,0.08); color: #F9A630; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; border: 1px solid rgba(249,166,48,0.15); }
    .sst-toggle-btn { padding: 0.5rem 1.25rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600; color: rgba(255,255,255,0.5); background: transparent; border: none; cursor: pointer; transition: all 0.3s; }
    .sst-toggle-btn--active { background: #F9A630; color: #1a3a5c; }
    .sst-pain-item, .sst-win-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); }
    .sst-pain-x { color: #ef4444; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(239,68,68,0.1); border-radius: 50%; }
    .sst-win-check { color: #10b981; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(16,185,129,0.1); border-radius: 50%; }
    .sst-panel { animation: sstPanelIn 0.4s ease; }
    @keyframes sstPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .sst-scroll-dot, .sst-scroll-hint, .sst-panel { animation: none !important; } }
  </style>

  <script is:inline>
    (function() {
      var consequences = {
        turnover: {
          label: 'The Revolving Door',
          title: 'Every time someone leaves, you lose 3-6 months of productivity and $15K-$25K in sunk costs.',
          body: 'Recruiting fees, training hours, the work that didn\'t get done while the seat was empty, and the institutional knowledge that walked out the door. With co-managed VAs, we handle retention, performance, and backfill. If someone leaves, we replace them — not you.'
        },
        cantfind: {
          label: 'The Talent Desert',
          title: 'You\'re competing with every firm in town for the same small pool of qualified legal support staff.',
          body: 'The local talent market is tapped out. Salaries are climbing. Qualified candidates have options. Our model gives you access to a vetted, trained talent pool that\'s already immersed in legal operations — no bidding wars, no settling for who\'s available.'
        },
        cost: {
          label: 'The Budget Wall',
          title: 'A full-time in-house hire costs $45K-$65K+ when you add salary, benefits, taxes, and overhead.',
          body: 'A co-managed VA from Attorney Assistant delivers the same output at roughly 60% less cost. No benefits, no office space, no equipment, no HR headaches. Flat monthly rate, managed by legal ops experts, and you can scale up or down month to month.'
        }
      };

      document.querySelectorAll('.sst-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;
          document.querySelectorAll('.sst-path-card').forEach(function(c) { c.classList.remove('sst-path-card--active'); });
          this.classList.add('sst-path-card--active');
          document.getElementById('sst-consequence-label').textContent = data.label;
          document.getElementById('sst-consequence-title').textContent = data.title;
          document.getElementById('sst-consequence-body').textContent = data.body;
          var panel = document.getElementById('sst-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none'; panel.offsetHeight;
          panel.style.animation = 'sstPanelIn 0.4s ease';
        });
      });

      var beforeBtn = document.getElementById('sst-toggle-before');
      var afterBtn = document.getElementById('sst-toggle-after');
      var beforePanel = document.getElementById('sst-panel-before');
      var afterPanel = document.getElementById('sst-panel-after');
      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('sst-toggle-btn--active');
          afterBtn.classList.remove('sst-toggle-btn--active');
          beforePanel.style.display = 'block'; afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none'; beforePanel.offsetHeight;
          beforePanel.style.animation = 'sstPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('sst-toggle-btn--active');
          beforeBtn.classList.remove('sst-toggle-btn--active');
          afterPanel.style.display = 'block'; beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none'; afterPanel.offsetHeight;
          afterPanel.style.animation = 'sstPanelIn 0.4s ease';
        });
      }
    })();
  </script>

