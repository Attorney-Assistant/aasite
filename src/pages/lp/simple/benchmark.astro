---
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";
import { HUBSPOT_PORTAL_ID, HUBSPOT_REGION, FORM_IDS, MEETING_URLS, ASSET_URLS } from "@/config/forms";
---

<!-- TODO(nicole): swap for a custom Benchmark-themed OG image (1200x630 recommended) -->
<SimpleCampaignLayout
  title="The 2026 Law Firm Operations Benchmark"
  description="Take the 90-second self-assessment. See where your firm ranks on the 2026 Law Firm Operations Benchmark."
  image="/brand/logos/long_color_logo.png"
  ogTitle="The 2026 Law Firm Operations Benchmark"
  ogDescription="Take the 90-second self-assessment. See where your firm ranks."
>
  <div data-stage="intro" id="benchmark-lp">

    <!-- ═══════════════════════════════════════════
         STAGE 1: INTRO
    ═══════════════════════════════════════════ -->
    <section data-stage="intro" class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 min-h-[80vh] flex items-center">
      <div class="grain-overlay"></div>
      <!-- Floating gold orbs -->
      <div class="bm-orb bm-orb-a" style="top: -120px; left: -80px; width: 420px; height: 420px; background: rgba(249,166,48,0.18);"></div>
      <div class="bm-orb bm-orb-b" style="bottom: -100px; right: -60px; width: 360px; height: 360px; background: rgba(80,167,221,0.14);"></div>

      <div class="container-wide relative z-10 py-20 lg:py-28 text-center">
        <div class="max-w-3xl mx-auto reveal">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-gold animate-pulse"></span>
            Independent Industry Data — 2026 Edition
          </span>
          <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
            Where does your firm <span class="text-gradient-gold">rank?</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
            The 2026 Law Firm Operations Benchmark. 15 metrics. 7 operational pillars. Your firm scored against the field.
          </p>

          <!-- Auto-cycling preview band -->
          <div class="max-w-md mx-auto mb-10 p-5 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm">
            <div class="bm-cycle-stage" id="bm-cycle-stage">
              <!-- slide 1 -->
              <div class="bm-cycle-slide is-active" data-slide="0">
                <p class="text-xs font-bold text-white/40 uppercase tracking-widest mb-3 text-left">Example: voicemail rate</p>
                <div class="flex h-3 rounded-full overflow-hidden" aria-hidden="true">
                  <div style="flex: 5; background: #7EA67C"></div>
                  <div style="flex: 20; background: #D4B280"></div>
                  <div style="flex: 75; background: #E89991"></div>
                </div>
                <div class="relative mt-1" aria-hidden="true">
                  <div class="absolute -top-1" style="left: 18%; transform: translateX(-50%)">
                    <div class="w-0 h-0 border-l-4 border-r-4 border-b-4 border-l-transparent border-r-transparent border-b-white"></div>
                  </div>
                </div>
                <div class="flex justify-between text-[10px] text-white/40 mt-3">
                  <span>Top quartile</span><span>Median</span><span>Bottom quartile</span>
                </div>
              </div>
              <!-- slide 2 -->
              <div class="bm-cycle-slide" data-slide="1">
                <p class="text-xs font-bold text-white/40 uppercase tracking-widest mb-3 text-left">Example: records turnaround</p>
                <div class="flex h-3 rounded-full overflow-hidden" aria-hidden="true">
                  <div style="flex: 25; background: #7EA67C"></div>
                  <div style="flex: 25; background: #D4B280"></div>
                  <div style="flex: 50; background: #E89991"></div>
                </div>
                <div class="relative mt-1" aria-hidden="true">
                  <div class="absolute -top-1" style="left: 65%; transform: translateX(-50%)">
                    <div class="w-0 h-0 border-l-4 border-r-4 border-b-4 border-l-transparent border-r-transparent border-b-white"></div>
                  </div>
                </div>
                <div class="flex justify-between text-[10px] text-white/40 mt-3">
                  <span>0–45 days</span><span>46–90</span><span>91+</span>
                </div>
              </div>
              <!-- slide 3 -->
              <div class="bm-cycle-slide" data-slide="2">
                <p class="text-xs font-bold text-white/40 uppercase tracking-widest mb-3 text-left">Example: speed-to-lead</p>
                <div class="flex h-3 rounded-full overflow-hidden" aria-hidden="true">
                  <div style="flex: 20; background: #7EA67C"></div>
                  <div style="flex: 30; background: #D4B280"></div>
                  <div style="flex: 50; background: #E89991"></div>
                </div>
                <div class="relative mt-1" aria-hidden="true">
                  <div class="absolute -top-1" style="left: 38%; transform: translateX(-50%)">
                    <div class="w-0 h-0 border-l-4 border-r-4 border-b-4 border-l-transparent border-r-transparent border-b-white"></div>
                  </div>
                </div>
                <div class="flex justify-between text-[10px] text-white/40 mt-3">
                  <span>&lt;5 min</span><span>5–30</span><span>30+</span>
                </div>
              </div>
            </div>
          </div>

          <button type="button" class="btn-primary btn-lg group inline-flex bm-cta-pulse" data-go-stage="micro-form">
            Take the 90-second self-assessment
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </button>

          <!-- Trust strip -->
          <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-xs text-white/40">
            <span class="inline-flex items-center gap-2"><svg class="w-3.5 h-3.5 text-brand-gold" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1l2.5 5.5L18 7l-4 4 1 5.5L10 14l-5 2.5L6 11 2 7l5.5-.5L10 1z" /></svg>15 operational metrics</span>
            <span class="inline-flex items-center gap-2"><svg class="w-3.5 h-3.5 text-brand-gold" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1l2.5 5.5L18 7l-4 4 1 5.5L10 14l-5 2.5L6 11 2 7l5.5-.5L10 1z" /></svg>7 firm pillars</span>
            <span class="inline-flex items-center gap-2"><svg class="w-3.5 h-3.5 text-brand-gold" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1l2.5 5.5L18 7l-4 4 1 5.5L10 14l-5 2.5L6 11 2 7l5.5-.5L10 1z" /></svg>Instant scorecard</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 2: MICRO-FORM
    ═══════════════════════════════════════════ -->
    <section data-stage="micro-form" class="relative overflow-hidden bg-gray-950 py-20 md:py-28 min-h-screen flex items-center">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-[120px]"></div>
      <div class="grain-overlay"></div>
      <div class="container-narrow max-w-2xl relative z-10">
        <div class="text-center mb-10 reveal">
          <div class="bm-step-progress" aria-label="Step 1 of 2">
            <span class="bm-step-dot is-active">1</span>
            <span class="bm-step-track"><span class="bm-step-track-fill"></span></span>
            <span class="bm-step-dot">2</span>
          </div>
          <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">Five questions. Ninety seconds.</h2>
          <p class="text-base text-white/60 max-w-md mx-auto">Your scorecard renders instantly. No email required to see your tier.</p>
        </div>
        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal">
          <div class="bg-white rounded-xl p-6 md:p-8">
            <form id="benchmark-microform" class="bmform" novalidate>
              <div class="bmform-field">
                <label class="bmform-label" for="bm-firm-size">Firm Attorney Count <em>*</em></label>
                <select id="bm-firm-size" name="firm_attorney_count" required>
                  <option value="">Choose…</option>
                  <option value="Solo">Solo</option>
                  <option value="2-5">2-5</option>
                  <option value="6-15">6-15</option>
                  <option value="16-50">16-50</option>
                  <option value="51+">51+</option>
                </select>
              </div>

              <div class="bmform-field">
                <label class="bmform-label" for="bm-lead-volume">Monthly Lead Volume <em>*</em></label>
                <select id="bm-lead-volume" name="monthly_lead_volume" required>
                  <option value="">Choose…</option>
                  <option value="<25">Under 25</option>
                  <option value="25-75">25-75</option>
                  <option value="76-200">76-200</option>
                  <option value="201-500">201-500</option>
                  <option value="500+">500+</option>
                </select>
              </div>

              <fieldset class="bmform-field">
                <legend class="bmform-label">Practice Area <em>*</em></legend>
                <p class="bmform-help">Select all that apply.</p>
                <div class="bmform-checkboxes">
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Personal injury"> <span>Personal Injury</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Mass Tort / Class Action"> <span>Mass Tort / Class Action</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Workers' Compensation"> <span>Workers' Compensation</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Family law"> <span>Family Law</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Criminal defense"> <span>Criminal Defense</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Estate planning"> <span>Estate / Probate</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Corporate law"> <span>Business / Commercial</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Bankruptcy"> <span>Bankruptcy</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Immigration"> <span>Immigration</span></label>
                  <label class="bmform-check"><input type="checkbox" name="practice_area" value="Other"> <span>Other</span></label>
                </div>
              </fieldset>

              <div class="bmform-field">
                <label class="bmform-label" for="bm-voicemail-rate">Voicemail Rate % <em>*</em></label>
                <p class="bmform-help">Percentage of business-hour calls that hit voicemail.</p>
                <div class="bmform-slider-row">
                  <input id="bm-voicemail-rate" type="range" name="voicemail_rate_" min="0" max="100" value="15" step="1" required />
                  <output for="bm-voicemail-rate" class="bmform-slider-value" id="bm-voicemail-rate-out">15%</output>
                </div>
                <span class="bmform-tier-badge" id="bm-voicemail-rate-tier" data-tier="median">
                  <span class="bmform-tier-dot"></span>
                  <span class="bmform-tier-label">Median tier</span>
                </span>
              </div>

              <div class="bmform-field">
                <label class="bmform-label" for="bm-records-tat">Records Turnaround (days)</label>
                <p class="bmform-help">Average medical records turnaround. Skip if not PI/mass tort.</p>
                <div class="bmform-slider-row">
                  <input id="bm-records-tat" type="range" name="records_tat_days" min="0" max="180" value="60" step="1" />
                  <output for="bm-records-tat" class="bmform-slider-value" id="bm-records-tat-out">60 days</output>
                </div>
                <span class="bmform-tier-badge" id="bm-records-tat-tier" data-tier="median">
                  <span class="bmform-tier-dot"></span>
                  <span class="bmform-tier-label">Median tier</span>
                </span>
                <label class="bmform-skip"><input type="checkbox" name="records_tat_skip" id="bm-records-tat-skip"> <span>Skip — not PI/mass tort</span></label>
              </div>

              <button type="submit" class="bmform-submit">
                Show My Scorecard
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
              </button>
              <div class="bmform-error" role="alert" hidden></div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 3: SCORECARD
    ═══════════════════════════════════════════ -->
    <section data-stage="scorecard" class="relative overflow-hidden bg-gradient-to-br from-brand-950 via-brand-900 to-brand-950 py-20 md:py-28 min-h-screen">
      <div class="grain-overlay"></div>
      <div class="container-wide relative z-10">
        <div class="text-center mb-12 reveal">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Your Scorecard</span>
          <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">Here's where your firm lands.</h2>
          <p class="text-base text-white/60 max-w-xl mx-auto">2 of 15 benchmark metrics shown. The rest are in the full report.</p>
        </div>

        <!-- Quartile bars -->
        <div class="max-w-3xl mx-auto space-y-8 reveal" id="scorecard-bars">
          <!-- Populated by JS -->
        </div>

        <!-- Context cards -->
        <div class="max-w-3xl mx-auto mt-12 grid grid-cols-1 sm:grid-cols-3 gap-4 reveal" id="scorecard-context">
          <!-- Populated by JS -->
        </div>

        <!-- Unlock CTA -->
        <div class="max-w-2xl mx-auto mt-16 p-8 rounded-2xl border border-brand-gold/20 bg-brand-gold/5 text-center reveal">
          <p class="text-lg text-white mb-3">You just saw <strong class="text-brand-gold">2 of your firm's 15 benchmark scores</strong>.</p>
          <p class="text-base text-white/60 mb-6">The full 2026 Law Firm Operations Benchmark Report includes all 15 metrics, the 4-stage maturity model, and the top performer playbook.</p>
          <button type="button" class="btn-primary btn-lg group inline-flex" data-go-stage="email-gate">
            Unlock the Full Report
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 4: EMAIL GATE
    ═══════════════════════════════════════════ -->
    <section data-stage="email-gate" class="relative overflow-hidden bg-gray-950 py-20 md:py-28 min-h-screen flex items-center">
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-gold/5 rounded-full blur-[100px]"></div>
      <div class="grain-overlay"></div>
      <div class="container-narrow max-w-xl relative z-10">
        <div class="text-center mb-10 reveal">
          <div class="bm-step-progress" aria-label="Step 2 of 2">
            <span class="bm-step-dot is-complete">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.42l-7.5 7.5a1 1 0 01-1.42 0l-3.5-3.5a1 1 0 011.42-1.42L8.5 12.09l6.79-6.8a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
            </span>
            <span class="bm-step-track"><span class="bm-step-track-fill is-full"></span></span>
            <span class="bm-step-dot is-active">2</span>
          </div>
          <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">Where should we send your report?</h2>
          <p class="text-base text-white/60">The full benchmark, your scorecard data, and the top performer playbook.</p>
        </div>
        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal">
          <div class="bg-white rounded-xl p-6 md:p-8">
            <form id="benchmark-email-gate-form" class="bmform" novalidate>
              <div class="bmform-row-2">
                <div class="bmform-field">
                  <label class="bmform-label" for="bm-eg-firstname">First name <em>*</em></label>
                  <input id="bm-eg-firstname" type="text" name="firstname" required autocomplete="given-name" />
                </div>
                <div class="bmform-field">
                  <label class="bmform-label" for="bm-eg-lastname">Last name <em>*</em></label>
                  <input id="bm-eg-lastname" type="text" name="lastname" required autocomplete="family-name" />
                </div>
              </div>
              <div class="bmform-row-2">
                <div class="bmform-field">
                  <label class="bmform-label" for="bm-eg-email">Email <em>*</em></label>
                  <input id="bm-eg-email" type="email" name="email" required autocomplete="email" />
                </div>
                <div class="bmform-field">
                  <label class="bmform-label" for="bm-eg-phone">Phone number</label>
                  <input id="bm-eg-phone" type="tel" name="phone" autocomplete="tel" />
                </div>
              </div>
              <div class="bmform-field">
                <label class="bmform-label" for="bm-eg-company">Company name <em>*</em></label>
                <input id="bm-eg-company" type="text" name="company" required autocomplete="organization" />
              </div>
              <button type="submit" class="bmform-submit">
                Unlock the Full Report
                <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
              </button>
              <div class="bmform-error" role="alert" hidden></div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 5: THANK YOU
    ═══════════════════════════════════════════ -->
    <section data-stage="thank-you" class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-20 md:py-28 min-h-screen">
      <div class="grain-overlay"></div>
      <div class="container-narrow max-w-3xl relative z-10">
        <div class="text-center mb-12 reveal">
          <div class="bm-thanks-check-wrap w-16 h-16 rounded-full bg-brand-gold/10 border-2 border-brand-gold/30 flex items-center justify-center mx-auto mb-6">
            <svg class="w-8 h-8 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path class="bm-thanks-check-path" stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">You're in.</h2>
          <p class="text-lg text-white/60 mb-2">Check your inbox — the full report is on the way.</p>
          <p class="text-base text-white/40">While you're here, book your Operations Review and we'll walk through your scorecard together.</p>
        </div>

        <!-- Meeting widget -->
        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal mb-12">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/simple-campaign-operations-review?embed=true"></div>
          </div>
        </div>

        <!-- PDF preview thumbnails -->
        <p class="text-center text-xs font-bold text-white/40 uppercase tracking-widest mb-6">A glimpse inside the report</p>
        <div class="grid grid-cols-3 gap-4 reveal" id="benchmark-pdf-previews">
          <!-- TODO(nicole): swap these gradient placeholders for actual page screenshots (pages 4, 7, 11 of the benchmark report PDF) -->
          <div class="aspect-[8.5/11] rounded-lg bg-gradient-to-br from-brand-gold/20 via-brand-navy/40 to-brand-950 border border-white/10 flex items-center justify-center">
            <span class="text-white/30 text-sm font-heading">p. 4</span>
          </div>
          <div class="aspect-[8.5/11] rounded-lg bg-gradient-to-br from-brand-gold/20 via-brand-navy/40 to-brand-950 border border-white/10 flex items-center justify-center">
            <span class="text-white/30 text-sm font-heading">p. 7</span>
          </div>
          <div class="aspect-[8.5/11] rounded-lg bg-gradient-to-br from-brand-gold/20 via-brand-navy/40 to-brand-950 border border-white/10 flex items-center justify-center">
            <span class="text-white/30 text-sm font-heading">p. 11</span>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- HubSpot Meetings Embed loader (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (!allowed) {
        document.querySelectorAll('.meetings-iframe-container').forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;">This form is not available from your location.</div>';
        });
        return;
      }
      var s = document.createElement('script');
      s.src = 'https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js';
      document.head.appendChild(s);
    });
  </script>

  <!-- OpenAI Q Pixel -->
  <script is:inline>!function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");oaiq("init",{pixelId:"Kik3Z6qPWhURPiYR6S4NhN",debug:true});</script>

  <style is:global>
    .meetings-iframe-container iframe { background: #ffffff !important; }
  </style>

  <style is:global>
    #benchmark-lp[data-stage="intro"] [data-stage]:not([data-stage="intro"]) { display: none; }
    #benchmark-lp[data-stage="micro-form"] [data-stage]:not([data-stage="micro-form"]) { display: none; }
    #benchmark-lp[data-stage="scorecard"] [data-stage]:not([data-stage="scorecard"]) { display: none; }
    #benchmark-lp[data-stage="email-gate"] [data-stage]:not([data-stage="email-gate"]) { display: none; }
    #benchmark-lp[data-stage="thank-you"] [data-stage]:not([data-stage="thank-you"]) { display: none; }
  </style>

  <style is:global>
    /* ─────────────────────────────────────────────────────────
       Form fonts — Inter (body font) throughout; no DM fonts
       ───────────────────────────────────────────────────────── */
    .bmform { display: flex; flex-direction: column; gap: 20px; font-family: 'Inter', -apple-system, Segoe UI, sans-serif; }
    .bmform-row-2 { display: grid; grid-template-columns: 1fr; gap: 18px; }
    @media (min-width: 560px) {
      .bmform-row-2 { grid-template-columns: 1fr 1fr; }
    }
    .bmform-field { display: flex; flex-direction: column; gap: 6px; }
    .bmform-label { font-family: inherit; font-size: 13px; font-weight: 600; color: #1a3a5c; letter-spacing: 0.01em; }
    .bmform-label em { color: #ef4444; font-style: normal; }
    .bmform-help { font-family: inherit; font-size: 12px; color: #6f7a8a; margin: -2px 0 4px; }
    .bmform input[type="text"],
    .bmform input[type="email"],
    .bmform input[type="tel"],
    .bmform select {
      width: 100%;
      padding: 12px 14px;
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      font-family: inherit;
      font-size: 15px;
      color: #1a3a5c;
      background: #fff;
      transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }
    .bmform input:focus,
    .bmform select:focus {
      outline: none;
      border-color: #F9A630;
      box-shadow: 0 0 0 4px rgba(249,166,48,0.15);
      transform: translateY(-1px);
    }
    .bmform input:invalid:not(:placeholder-shown) { border-color: #ef4444; }

    /* ─────────────────────────────────────────────────────────
       Practice-area chips — hover lift, selected glow
       ───────────────────────────────────────────────────────── */
    .bmform-checkboxes { display: grid; grid-template-columns: 1fr; gap: 8px; max-height: 260px; overflow-y: auto; padding-right: 4px; }
    @media (min-width: 560px) { .bmform-checkboxes { grid-template-columns: 1fr 1fr; } }
    .bmform-check {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 12px;
      border: 1.5px solid #e5e7eb;
      border-radius: 10px;
      cursor: pointer;
      background: #fff;
      transition: border-color 0.18s ease, background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
    }
    .bmform-check:hover {
      border-color: #F9A630;
      background: rgba(249,166,48,0.04);
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(26,58,92,0.06);
    }
    .bmform-check input[type="checkbox"] { width: 16px; height: 16px; accent-color: #F9A630; cursor: pointer; flex-shrink: 0; }
    .bmform-check span { font-family: inherit; font-size: 14px; font-weight: 500; color: #1a3a5c; }
    .bmform-check:has(input:checked) {
      border-color: #F9A630;
      background: rgba(249,166,48,0.08);
      box-shadow: 0 4px 14px rgba(249,166,48,0.18);
    }

    /* ─────────────────────────────────────────────────────────
       Slider row — live tier badge, gradient track
       ───────────────────────────────────────────────────────── */
    .bmform-slider-row { display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: center; }
    .bmform-slider-row input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      height: 8px;
      background: linear-gradient(to right, #7EA67C 0%, #7EA67C 5%, #D4B280 5%, #D4B280 25%, #E89991 25%, #E89991 100%);
      border-radius: 999px;
      outline: none;
    }
    .bmform-slider-row input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 22px; height: 22px;
      border-radius: 50%;
      background: #fff;
      border: 3px solid #F9A630;
      box-shadow: 0 2px 8px rgba(26,58,92,0.25);
      cursor: grab;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .bmform-slider-row input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.15); box-shadow: 0 4px 14px rgba(249,166,48,0.4); }
    .bmform-slider-row input[type="range"]::-webkit-slider-thumb:active { cursor: grabbing; transform: scale(1.05); }
    .bmform-slider-row input[type="range"]::-moz-range-thumb {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: #fff;
      border: 3px solid #F9A630;
      box-shadow: 0 2px 8px rgba(26,58,92,0.25);
      cursor: grab;
    }
    .bmform-slider-value { font-family: inherit; font-size: 15px; font-weight: 700; color: #1a3a5c; min-width: 76px; text-align: right; font-variant-numeric: tabular-nums; }
    .bmform-tier-badge {
      display: inline-flex; align-items: center; gap: 6px;
      margin-top: 8px;
      padding: 6px 10px;
      border-radius: 999px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.02em;
      transition: background 0.25s ease, color 0.25s ease;
    }
    .bmform-tier-badge .bmform-tier-dot { width: 8px; height: 8px; border-radius: 50%; }
    .bmform-tier-badge[data-tier="top"]    { background: rgba(126,166,124,0.14); color: #4f7e4d; }
    .bmform-tier-badge[data-tier="top"]    .bmform-tier-dot { background: #7EA67C; box-shadow: 0 0 0 4px rgba(126,166,124,0.2); }
    .bmform-tier-badge[data-tier="median"] { background: rgba(212,178,128,0.16); color: #8a6b2c; }
    .bmform-tier-badge[data-tier="median"] .bmform-tier-dot { background: #D4B280; box-shadow: 0 0 0 4px rgba(212,178,128,0.22); }
    .bmform-tier-badge[data-tier="bottom"] { background: rgba(232,153,145,0.16); color: #b6483d; }
    .bmform-tier-badge[data-tier="bottom"] .bmform-tier-dot { background: #E89991; box-shadow: 0 0 0 4px rgba(232,153,145,0.22); }

    .bmform-skip { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; cursor: pointer; font-family: inherit; font-size: 13px; color: #6f7a8a; }
    .bmform-skip input[type="checkbox"] { accent-color: #F9A630; cursor: pointer; }

    /* ─────────────────────────────────────────────────────────
       Submit button — matches site .btn-primary, shimmer, arrow
       ───────────────────────────────────────────────────────── */
    .bmform-submit {
      position: relative;
      overflow: hidden;
      margin-top: 6px;
      padding: 14px 24px;
      background: #F9A630;
      color: #1a3a5c;
      font-family: 'Inter', -apple-system, Segoe UI, sans-serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.02em;
      border: none;
      border-radius: 10px;
      cursor: pointer;
      transition: background 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    }
    .bmform-submit::after {
      content: '';
      position: absolute;
      top: 0; left: -75%;
      width: 50%; height: 100%;
      background: linear-gradient(120deg, transparent, rgba(255,255,255,0.55), transparent);
      transform: skewX(-20deg);
      transition: left 0.7s ease;
    }
    .bmform-submit:hover:not(:disabled) {
      background: #d98a00;
      transform: translateY(-1px);
      box-shadow: 0 8px 22px rgba(249,166,48,0.35);
    }
    .bmform-submit:hover:not(:disabled)::after { left: 125%; }
    .bmform-submit:disabled { opacity: 0.6; cursor: not-allowed; }
    .bmform-submit svg { transition: transform 0.18s ease; }
    .bmform-submit:hover:not(:disabled) svg { transform: translateX(3px); }

    .bmform-error {
      margin-top: 8px;
      padding: 12px 14px;
      background: rgba(239,68,68,0.08);
      border: 1px solid rgba(239,68,68,0.4);
      border-radius: 8px;
      font-family: 'Inter', -apple-system, Segoe UI, sans-serif;
      font-size: 13px;
      color: #ef4444;
    }

    /* ─────────────────────────────────────────────────────────
       Step progress bar (above form)
       ───────────────────────────────────────────────────────── */
    .bm-step-progress {
      max-width: 320px;
      margin: 0 auto 22px;
      display: flex; align-items: center; gap: 10px;
    }
    .bm-step-dot {
      width: 28px; height: 28px;
      border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      font-family: 'Inter', -apple-system, Segoe UI, sans-serif;
      font-size: 12px; font-weight: 700;
      background: rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.5);
      border: 1.5px solid rgba(255,255,255,0.15);
      transition: all 0.25s ease;
    }
    .bm-step-dot.is-active {
      background: #F9A630;
      color: #1a3a5c;
      border-color: #F9A630;
      box-shadow: 0 0 0 6px rgba(249,166,48,0.18);
    }
    .bm-step-dot.is-complete {
      background: rgba(126,166,124,0.2);
      color: #7EA67C;
      border-color: #7EA67C;
    }
    .bm-step-track {
      flex: 1; height: 3px;
      background: rgba(255,255,255,0.1);
      border-radius: 999px;
      overflow: hidden;
    }
    .bm-step-track-fill {
      height: 100%;
      background: linear-gradient(to right, #F9A630, #d98a00);
      width: 0%;
      transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .bm-step-track-fill.is-half  { width: 50%; }
    .bm-step-track-fill.is-full  { width: 100%; }

    /* ─────────────────────────────────────────────────────────
       Background ambience — floating gold orbs
       ───────────────────────────────────────────────────────── */
    .bm-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      opacity: 0.5;
      pointer-events: none;
      will-change: transform;
    }
    @keyframes bm-orb-drift-a {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(40px, -30px); }
    }
    @keyframes bm-orb-drift-b {
      0%, 100% { transform: translate(0, 0); }
      50% { transform: translate(-50px, 40px); }
    }
    .bm-orb-a { animation: bm-orb-drift-a 14s ease-in-out infinite; }
    .bm-orb-b { animation: bm-orb-drift-b 18s ease-in-out infinite; }

    /* ─────────────────────────────────────────────────────────
       Hero cycling preview
       ───────────────────────────────────────────────────────── */
    .bm-cycle-stage { position: relative; min-height: 92px; }
    .bm-cycle-slide {
      position: absolute; inset: 0;
      opacity: 0; transform: translateY(8px);
      transition: opacity 0.5s ease, transform 0.5s ease;
      pointer-events: none;
    }
    .bm-cycle-slide.is-active {
      opacity: 1; transform: translateY(0);
    }

    /* ─────────────────────────────────────────────────────────
       Scorecard bar — animated fill (CSS transition driven by JS)
       ───────────────────────────────────────────────────────── */
    .bm-bar-marker, .bm-bar-aa-marker {
      transition: left 1s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .bm-bar-card {
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .bm-bar-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 36px rgba(0,0,0,0.25);
    }

    /* ─────────────────────────────────────────────────────────
       Thank-you animated check
       ───────────────────────────────────────────────────────── */
    @keyframes bm-check-pop {
      0%   { transform: scale(0.2); opacity: 0; }
      60%  { transform: scale(1.15); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes bm-check-draw {
      to { stroke-dashoffset: 0; }
    }
    .bm-thanks-check-wrap { animation: bm-check-pop 0.6s cubic-bezier(0.22, 1, 0.36, 1) both; }
    .bm-thanks-check-path {
      stroke-dasharray: 30;
      stroke-dashoffset: 30;
      animation: bm-check-draw 0.45s ease-out 0.35s forwards;
    }

    /* Pulse glow on primary hero CTA */
    @keyframes bm-cta-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(249,166,48,0.45); }
      50%      { box-shadow: 0 0 0 14px rgba(249,166,48,0); }
    }
    .bm-cta-pulse { animation: bm-cta-pulse 2.4s ease-in-out infinite; }

    @media (prefers-reduced-motion: reduce) {
      .bm-orb-a, .bm-orb-b, .bm-cta-pulse, .bm-thanks-check-wrap, .bm-thanks-check-path { animation: none !important; }
      .bm-cycle-slide { transition: none !important; }
    }
  </style>

  <script is:inline define:vars={{
    HS_PORTAL_ID: HUBSPOT_PORTAL_ID,
    HS_REGION: HUBSPOT_REGION,
    HS_FORM_BENCHMARK_MICRO: FORM_IDS.benchmarkMicroForm,
    HS_FORM_BENCHMARK_EMAILGATE: FORM_IDS.benchmarkEmailGate
  }}>
    const LP_NAME = 'Benchmark';
    const main = document.querySelector('#benchmark-lp');

    const state = {
      benchmark: null,  // populated after micro-form submit
    };

    const FIRM_SIZE_HS_VALUES = {
      'Solo': 'solo',
      '2-5': '2_5',
      '6-15': '6_15',
      '16-50': '16_50',
      '51+': '51_plus'
    };
    const LEAD_VOLUME_HS_VALUES = {
      '<25': 'lt_25',
      '25-75': '25_75',
      '76-200': '76_200',
      '201-500': '201_500',
      '500+': '500_plus'
    };

    // ── Benchmark thresholds + interpretation copy
    const BENCHMARKS = {
      voicemail_rate_: {
        metric: 'Voicemail rate during business hours',
        max: 100,
        bands: [
          { label: 'Top quartile',    upTo: 5,   color: '#7EA67C', range: '0–5%' },
          { label: 'Median',          upTo: 25,  color: '#D4B280', range: '6–25%' },
          { label: 'Bottom quartile', upTo: 100, color: '#E89991', range: '26–100%' }
        ],
        aaBenchmark: 1,
        suffix: '%',
        interpretation: function(v) {
          if (v <= 5)  return 'Top quartile — your firm answers nearly every business-hour call.';
          if (v <= 25) return 'Median tier — top performers operate below 5%.';
          return 'Bottom quartile — every percentage point above 25% is leaving signed cases on the table.';
        }
      },
      records_tat_days: {
        metric: 'Average medical records turnaround',
        max: 180,
        bands: [
          { label: 'Top quartile',    upTo: 45,  color: '#7EA67C', range: '0–45 days' },
          { label: 'Median',          upTo: 90,  color: '#D4B280', range: '46–90 days' },
          { label: 'Bottom quartile', upTo: 180, color: '#E89991', range: '91–180 days' }
        ],
        aaBenchmark: 30,
        suffix: ' days',
        interpretation: function(v) {
          if (v <= 45) return 'Top quartile — your records process is among the fastest in the industry.';
          if (v <= 90) return 'Median tier — most firms accept 60-90 days as normal. The top quartile doesn\'t.';
          return 'Bottom quartile — at 90+ days, settlement velocity is being held hostage by hospitals.';
        }
      }
    };

    function renderQuartileBar(metricKey, value, idx) {
      const cfg = BENCHMARKS[metricKey];
      const userPct = Math.min(100, Math.max(0, (value / cfg.max) * 100));
      const aaPct = Math.min(100, Math.max(0, (cfg.aaBenchmark / cfg.max) * 100));
      const bandSpans = cfg.bands.map(function(b, i) {
        const prev = i === 0 ? 0 : cfg.bands[i - 1].upTo;
        return { label: b.label, color: b.color, flex: b.upTo - prev, range: b.range };
      });
      return [
        '<div class="bm-bar-card p-6 rounded-2xl border border-white/10 bg-white/5" style="opacity: 0; transform: translateY(16px); transition: opacity 0.5s ease, transform 0.5s ease; transition-delay: ' + (idx * 0.12) + 's;">',
          '<div class="flex items-baseline justify-between mb-1">',
            '<h3 class="text-base font-heading text-white">' + cfg.metric + '</h3>',
            '<span class="text-2xl font-heading text-brand-gold" data-bm-count data-bm-target="' + value + '" data-bm-suffix="' + cfg.suffix + '">0' + cfg.suffix + '</span>',
          '</div>',
          '<p class="text-xs text-white/40 uppercase tracking-widest mb-4">Your firm</p>',
          '<div class="relative">',
            '<div class="flex h-4 rounded-full overflow-hidden">',
              bandSpans.map(function(b) {
                return '<div style="flex: ' + b.flex + '; background: ' + b.color + '"></div>';
              }).join(''),
            '</div>',
            '<div class="bm-bar-marker absolute -top-2" data-bm-target-pct="' + userPct + '" style="left: 0%; transform: translateX(-50%)">',
              '<div class="w-0 h-0 border-l-[6px] border-r-[6px] border-b-[8px] border-l-transparent border-r-transparent border-b-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.5)]"></div>',
            '</div>',
            '<div class="bm-bar-aa-marker absolute -bottom-2" data-bm-target-pct="' + aaPct + '" style="left: 0%; transform: translateX(-50%)">',
              '<div class="w-0 h-0 border-l-[6px] border-r-[6px] border-t-[8px] border-l-transparent border-r-transparent border-t-brand-gold drop-shadow-[0_-2px_4px_rgba(249,166,48,0.5)]"></div>',
            '</div>',
          '</div>',
          '<div class="flex justify-between text-[10px] text-white/40 mt-5">',
            bandSpans.map(function(b) { return '<span>' + b.range + '</span>'; }).join(''),
          '</div>',
          '<div class="flex items-center gap-4 mt-5 text-xs">',
            '<div class="flex items-center gap-1.5"><div class="w-0 h-0 border-l-[4px] border-r-[4px] border-b-[6px] border-l-transparent border-r-transparent border-b-white"></div><span class="text-white/60">Your firm</span></div>',
            '<div class="flex items-center gap-1.5"><div class="w-0 h-0 border-l-[4px] border-r-[4px] border-t-[6px] border-l-transparent border-r-transparent border-t-brand-gold"></div><span class="text-white/60">AA-supported target (' + cfg.aaBenchmark + cfg.suffix + ')</span></div>',
          '</div>',
          '<p class="text-sm text-white/80 mt-4 leading-relaxed">' + cfg.interpretation(value) + '</p>',
        '</div>'
      ].join('');
    }

    // Animate bar markers from 0% → final position + count number 0 → value
    function animateScorecard() {
      const cards = document.querySelectorAll('#scorecard-bars .bm-bar-card');
      cards.forEach(function(card) {
        card.style.opacity = '1';
        card.style.transform = 'translateY(0)';
      });
      // Stagger marker fly-in
      setTimeout(function() {
        document.querySelectorAll('#scorecard-bars [data-bm-target-pct]').forEach(function(m) {
          m.style.left = m.getAttribute('data-bm-target-pct') + '%';
        });
      }, 250);
      // Number count-up
      document.querySelectorAll('#scorecard-bars [data-bm-count]').forEach(function(el) {
        const target = parseFloat(el.getAttribute('data-bm-target')) || 0;
        const suffix = el.getAttribute('data-bm-suffix') || '';
        const dur = 1100;
        const start = performance.now();
        function tick(now) {
          const t = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(1 - t, 3);
          const val = target * eased;
          el.textContent = (target % 1 === 0 ? Math.round(val) : val.toFixed(1)) + suffix;
          if (t < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    }

    function renderContextCard(label, value) {
      return [
        '<div class="p-5 rounded-xl border border-white/10 bg-white/5 text-center">',
          '<p class="text-[10px] font-bold text-white/40 uppercase tracking-widest mb-2">' + label + '</p>',
          '<p class="text-lg font-heading text-white">' + value + '</p>',
        '</div>'
      ].join('');
    }

    function renderScorecard() {
      const bars = document.getElementById('scorecard-bars');
      const ctx = document.getElementById('scorecard-context');
      if (!state.benchmark) return;

      const barsHtml = [renderQuartileBar('voicemail_rate_', state.benchmark.voicemail_rate_, 0)];
      if (state.benchmark.records_tat_days !== null && state.benchmark.records_tat_days !== undefined) {
        barsHtml.push(renderQuartileBar('records_tat_days', state.benchmark.records_tat_days, 1));
      }
      bars.innerHTML = barsHtml.join('');

      ctx.innerHTML = [
        renderContextCard('Firm size',     state.benchmark.firm_attorney_count || '—'),
        renderContextCard('Monthly leads', state.benchmark.monthly_lead_volume || '—'),
        renderContextCard('Practice area', Array.isArray(state.benchmark.practice_area) ? (state.benchmark.practice_area.length > 1 ? state.benchmark.practice_area.length + ' areas' : (state.benchmark.practice_area[0] || '—')) : (state.benchmark.practice_area || '—')),
      ].join('');

      requestAnimationFrame(function() {
        setTimeout(animateScorecard, 120);
      });
    }

    const utms = (function() {
      const p = new URLSearchParams(location.search);
      return ['utm_source','utm_medium','utm_campaign','utm_content','utm_term']
        .reduce(function(acc, k) { acc[k] = p.get(k) || ''; return acc; }, {});
    })();

    function trackStage(lp, stage, extra) {
      extra = extra || {};
        window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(Object.assign({ event: lp.toLowerCase() + '_lp_stage', stage: stage }, extra));
    }

    function setStage(name) {
      var target = document.querySelector('[data-stage="' + name + '"]');
      if (!target) { console.warn('setStage: unknown stage "' + name + '"'); return; }
      main.setAttribute('data-stage', name);
      trackStage(LP_NAME, name);
      if (name === 'scorecard')  renderScorecard();
      requestAnimationFrame(function() { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    }

    document.querySelectorAll('[data-go-stage]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        setStage(this.getAttribute('data-go-stage'));
      });
    });

    trackStage(LP_NAME, 'intro');

    // ── Hero auto-cycling preview band
    (function() {
      const slides = document.querySelectorAll('#bm-cycle-stage .bm-cycle-slide');
      if (slides.length < 2) return;
      let i = 0;
      setInterval(function() {
        slides[i].classList.remove('is-active');
        i = (i + 1) % slides.length;
        slides[i].classList.add('is-active');
      }, 4000);
    })();

    // ── Live tier badge under each slider
    (function() {
      function tierFor(metricKey, value) {
        if (metricKey === 'voicemail_rate_') {
          if (value <= 5)  return { tier: 'top',    label: 'Top quartile' };
          if (value <= 25) return { tier: 'median', label: 'Median tier' };
          return { tier: 'bottom', label: 'Bottom quartile' };
        }
        if (metricKey === 'records_tat_days') {
          if (value <= 45) return { tier: 'top',    label: 'Top quartile' };
          if (value <= 90) return { tier: 'median', label: 'Median tier' };
          return { tier: 'bottom', label: 'Bottom quartile' };
        }
        return { tier: 'median', label: 'Median tier' };
      }
      function bindSlider(inputId, metricKey, badgeId) {
        const input = document.getElementById(inputId);
        const badge = document.getElementById(badgeId);
        if (!input || !badge) return;
        function update() {
          const v = parseFloat(input.value) || 0;
          const t = tierFor(metricKey, v);
          badge.setAttribute('data-tier', t.tier);
          badge.querySelector('.bmform-tier-label').textContent = t.label;
        }
        input.addEventListener('input', update);
        update();
      }
      bindSlider('bm-voicemail-rate', 'voicemail_rate_', 'bm-voicemail-rate-tier');
      bindSlider('bm-records-tat',    'records_tat_days', 'bm-records-tat-tier');
    })();

    // ── Benchmark micro-form handler (vanilla; advances to scorecard on submit)
    (function() {
      const microForm = document.getElementById('benchmark-microform');
      if (!microForm) return;
      const errorEl = microForm.querySelector('.bmform-error');
      const submitBtn = microForm.querySelector('.bmform-submit');
      const vrInput = document.getElementById('bm-voicemail-rate');
      const vrOut = document.getElementById('bm-voicemail-rate-out');
      const rtInput = document.getElementById('bm-records-tat');
      const rtOut = document.getElementById('bm-records-tat-out');
      const rtSkip = document.getElementById('bm-records-tat-skip');

      // Live slider value display
      if (vrInput && vrOut) {
        vrInput.addEventListener('input', function() { vrOut.textContent = vrInput.value + '%'; });
      }
      if (rtInput && rtOut) {
        rtInput.addEventListener('input', function() { rtOut.textContent = rtInput.value + ' days'; });
      }
      if (rtSkip && rtInput) {
        rtSkip.addEventListener('change', function() {
          rtInput.disabled = rtSkip.checked;
          rtInput.style.opacity = rtSkip.checked ? '0.4' : '1';
        });
      }

      microForm.addEventListener('submit', function(e) {
        e.preventDefault();
        errorEl.hidden = true;
        errorEl.textContent = '';

        const formData = new FormData(microForm);
        const firmSize = formData.get('firm_attorney_count') || '';
        const leadVolume = formData.get('monthly_lead_volume') || '';
        const practiceAreas = formData.getAll('practice_area');
        const voicemailRate = parseFloat(formData.get('voicemail_rate_')) || 0;
        const recordsSkipped = !!formData.get('records_tat_skip');
        const recordsTat = recordsSkipped ? null : parseInt(formData.get('records_tat_days'), 10);

        if (!firmSize || !leadVolume || practiceAreas.length === 0) {
          errorEl.textContent = 'Please fill in all required fields.';
          errorEl.hidden = false;
          return;
        }

        state.benchmark = {
          firm_attorney_count: firmSize,
          monthly_lead_volume: leadVolume,
          practice_area: practiceAreas,
          voicemail_rate_: voicemailRate,
          records_tat_days: recordsTat
        };

        trackStage(LP_NAME, 'micro-form-submitted', { firm_attorney_count: firmSize, monthly_lead_volume: leadVolume, voicemail_rate_: voicemailRate });
        setStage('scorecard');
      });
    })();

    // ── Benchmark email-gate submission (direct POST to HubSpot Submissions API)
    (function() {
      const egForm = document.getElementById('benchmark-email-gate-form');
      if (!egForm) return;
      const errorEl = egForm.querySelector('.bmform-error');
      const submitBtn = egForm.querySelector('.bmform-submit');

      egForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        errorEl.hidden = true;
        errorEl.textContent = '';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting…';

        const formData = new FormData(egForm);
        const fields = [
          { name: 'firstname', value: formData.get('firstname') || '' },
          { name: 'lastname',  value: formData.get('lastname')  || '' },
          { name: 'email',     value: formData.get('email')     || '' },
          { name: 'phone',     value: formData.get('phone')     || '' },
          { name: 'company',   value: formData.get('company')   || '' }
        ];

        if (state.benchmark) {
          fields.push({ name: 'firm_attorney_count', value: FIRM_SIZE_HS_VALUES[state.benchmark.firm_attorney_count] || '' });
          fields.push({ name: 'monthly_lead_volume', value: LEAD_VOLUME_HS_VALUES[state.benchmark.monthly_lead_volume] || '' });
          if (Array.isArray(state.benchmark.practice_area)) {
            fields.push({ name: 'practice_area', value: state.benchmark.practice_area.join(';') });
          } else if (state.benchmark.practice_area) {
            fields.push({ name: 'practice_area', value: state.benchmark.practice_area });
          }
          if (state.benchmark.voicemail_rate_ !== undefined && state.benchmark.voicemail_rate_ !== null) {
            fields.push({ name: 'voicemail_rate_', value: String(state.benchmark.voicemail_rate_) });
          }
          if (state.benchmark.records_tat_days !== undefined && state.benchmark.records_tat_days !== null) {
            fields.push({ name: 'records_tat_days', value: String(state.benchmark.records_tat_days) });
          }
        }

        Object.keys(utms).forEach(function(k) {
          if (utms[k]) fields.push({ name: k, value: utms[k] });
        });

        const hutk = (document.cookie.match(/(^|;)\s*hubspotutk\s*=\s*([^;]+)/) || [])[2] || '';

        const payload = {
          fields: fields,
          context: {
            hutk: hutk,
            pageUri: window.location.href,
            pageName: document.title
          }
        };

        try {
          const res = await fetch('https://api.hsforms.com/submissions/v3/integration/submit/' + HS_PORTAL_ID + '/' + HS_FORM_BENCHMARK_EMAILGATE, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!res.ok) {
            const errText = await res.text();
            throw new Error('Submission failed: ' + res.status + ' — ' + errText);
          }
          trackStage(LP_NAME, 'email-gate-submitted');

          // ─── Meta conversion event (Lead) — fires browser Pixel + server-side CAPI
          //     with deduplication and hashed PII matching (email / phone / name).
          //     `window.__metaCAPI.track` is provided by src/components/MetaCAPI.astro,
          //     loaded by SimpleCampaignLayout on every benchmark page view.
          try {
            var leadCustomData = {
              content_name: '2026 Benchmark Report',
              content_category: 'benchmark_lp',
              value: 100,
              currency: 'USD'
            };
            var leadUserData = {
              em: formData.get('email')     || '',
              ph: formData.get('phone')     || '',
              fn: formData.get('firstname') || '',
              ln: formData.get('lastname')  || ''
            };
            if (typeof window.__metaCAPI !== 'undefined' && typeof window.__metaCAPI.track === 'function') {
              window.__metaCAPI.track('Lead', leadCustomData, leadUserData);
            } else if (typeof fbq !== 'undefined') {
              // Fallback: browser Pixel only (CAPI not loaded)
              fbq('track', 'Lead', leadCustomData);
            }
          } catch (e) { console.warn('Meta Lead fire failed:', e); }

          // ─── LinkedIn Insight Tag conversion
          try {
            if (typeof window.lintrk !== 'undefined') {
              window.lintrk('track', { conversion_id: 27919129 });
            }
          } catch (e) { console.warn('LinkedIn lintrk fire failed:', e); }

          // ─── GTM / GA4 conversion (generate_lead)
          try {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'generate_lead',
              form_name: 'benchmark_email_gate',
              form_id: HS_FORM_BENCHMARK_EMAILGATE,
              lp_name: 'Benchmark',
              value: 100,
              currency: 'USD'
            });
          } catch (e) { console.warn('dataLayer push failed:', e); }

          setStage('thank-you');

          // ─── OpenAI Q: appointment_scheduled
          try {
            if (typeof oaiq !== 'undefined') {
              oaiq("measure", "appointment_scheduled", { type: "customer_action" });
            }
          } catch (e) { console.warn('oaiq fire failed:', e); }
        } catch (err) {
          errorEl.textContent = 'Something went wrong. Please try again or email us directly at info@attorneyassistant.com.';
          errorEl.hidden = false;
          console.error('Benchmark email gate submission error:', err);
          submitBtn.disabled = false;
          submitBtn.textContent = 'Unlock the Full Report';
        }
      });
    })();
  </script>

</SimpleCampaignLayout>
