---
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";
---

<SimpleCampaignLayout
  title="Our Virtual Assistants and AI Solutions Rescue Firms From Chaos | Attorney Assistant"
  description="Missed deadlines, buried tasks, overwhelmed staff — law firm chaos is costing you cases and revenue. Attorney Assistant's virtual assistants and AI solutions fix it."
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[60vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10 py-20 lg:py-28 text-center">
      <div class="max-w-3xl mx-auto reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          Sound Familiar?
        </span>
        <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
          Law firm running on chaos? <br/><span class="text-gradient-gold">Our Virtual Assistants and AI Solutions rescue firms from chaos.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          Everyone's busy. Nothing gets done right. The owner holds it all together with willpower. Scroll to see the real cost &mdash; then let's fix it.
        </p>
        <a href="#book-now" class="btn-primary btn-lg group inline-flex mb-8">
          Fix My Firm's Operations
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
        <div class="slfc-scroll-hint" aria-hidden="true">
          <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2 mx-auto">
            <div class="w-1 h-2.5 bg-brand-gold rounded-full slfc-scroll-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 py-20 md:py-28">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/5 rounded-full blur-[120px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">The Timeline</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          A Day in the Life of a Chaotic Law Firm
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">This isn't an exaggeration. It's a Tuesday.</p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="slfc-timeline">
          <div class="slfc-timeline-line"></div>

          <div class="slfc-timeline-event reveal">
            <div class="slfc-timeline-dot slfc-timeline-dot--gold"></div>
            <div class="slfc-timeline-content">
              <p class="slfc-timeline-label">8:30 AM</p>
              <h3 class="text-lg font-heading text-white mb-1">You walk in to 47 unread emails and a stack of unsigned documents</h3>
              <p class="text-sm text-gray-400">Three are urgent. Two are from clients you forgot to call back. One is a deadline you're learning about now.</p>
            </div>
          </div>

          <div class="slfc-timeline-event reveal">
            <div class="slfc-timeline-dot slfc-timeline-dot--amber"></div>
            <div class="slfc-timeline-content">
              <p class="slfc-timeline-label">10:00 AM</p>
              <h3 class="text-lg font-heading text-white mb-1">Your paralegal asks you the same question for the third time this week</h3>
              <p class="text-sm text-gray-400">There's no SOP. No documented process. Everyone does things differently. You're the walking instruction manual.</p>
            </div>
          </div>

          <div class="slfc-timeline-event reveal">
            <div class="slfc-timeline-dot slfc-timeline-dot--red"></div>
            <div class="slfc-timeline-content">
              <p class="slfc-timeline-label">1:00 PM</p>
              <h3 class="text-lg font-heading text-white mb-1">A deadline nearly blows up</h3>
              <p class="text-sm text-gray-400">SOL filing was due today. Nobody flagged it. You catch it by accident while looking for something else. Crisis averted &mdash; this time.</p>
            </div>
          </div>

          <div class="slfc-timeline-event reveal">
            <div class="slfc-timeline-dot slfc-timeline-dot--red"></div>
            <div class="slfc-timeline-content">
              <p class="slfc-timeline-label">4:00 PM</p>
              <h3 class="text-lg font-heading text-white mb-1">You realize you haven't done any actual legal work today</h3>
              <p class="text-sm text-gray-400">The entire day was spent putting out fires, answering questions, chasing people, and checking everyone else's work.</p>
            </div>
          </div>

          <div class="slfc-timeline-event reveal">
            <div class="slfc-timeline-dot slfc-timeline-dot--big"></div>
            <div class="slfc-timeline-content">
              <p class="slfc-timeline-label">Every Day</p>
              <h3 class="text-display-xs font-heading text-brand-gold mb-1">This isn't a bad week. This is the system.</h3>
              <p class="text-sm text-gray-400">The chaos isn't caused by bad people. It's caused by no structure, no delegation, and no one owning the operational backbone of the firm.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28">
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-gold/5 rounded-full blur-[100px]"></div>
    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Be Honest</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          Where is the chaos hitting hardest?
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Pick the one that keeps you up at night.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto" id="slfc-paths">
        <button class="slfc-path-card reveal" data-path="admin" style="transition-delay: 0ms">
          <div class="slfc-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">Admin is drowning us</h3>
          <p class="text-sm text-gray-500">Filing, scheduling, records, data entry &mdash; the back office is a bottleneck.</p>
        </button>

        <button class="slfc-path-card reveal" data-path="leads" style="transition-delay: 100ms">
          <div class="slfc-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">Leads and intake are leaking</h3>
          <p class="text-sm text-gray-500">Calls missed, follow-up late, new cases slipping through the cracks.</p>
        </button>

        <button class="slfc-path-card reveal" data-path="owner" style="transition-delay: 200ms">
          <div class="slfc-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">I'm holding everything together alone</h3>
          <p class="text-sm text-gray-500">If I step away, things fall apart. I can't take a day off without worrying.</p>
        </button>
      </div>

      <div id="slfc-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="p-8 rounded-2xl border border-brand-gold/20 bg-brand-gold/5 text-center">
          <p class="text-sm font-bold text-brand-gold uppercase tracking-widest mb-3" id="slfc-consequence-label"></p>
          <p class="text-xl font-heading text-gray-900 mb-3" id="slfc-consequence-title"></p>
          <p class="text-base text-gray-600 leading-relaxed" id="slfc-consequence-body"></p>
          <a href="#book-now" class="btn-primary btn-lg group mt-6 inline-flex">
            Let's Fix This
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER REVEAL
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-20 md:py-28">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">The Difference</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          Chaos vs. <span class="text-gradient-gold">Control</span>
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="flex justify-center mb-10 reveal">
          <div class="inline-flex rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm">
            <button class="slfc-toggle-btn slfc-toggle-btn--active" id="slfc-toggle-before">The Chaos</button>
            <button class="slfc-toggle-btn" id="slfc-toggle-after">With Attorney Assistant</button>
          </div>
        </div>

        <div id="slfc-panel-before" class="slfc-panel reveal">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="slfc-pain-item"><span class="slfc-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">No SOPs, no processes</p><p class="text-white/40 text-xs mt-0.5">Everyone does things differently. Training is "figure it out."</p></div></div>
            <div class="slfc-pain-item"><span class="slfc-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Owner does everything</p><p class="text-white/40 text-xs mt-0.5">Can't delegate because there's nobody reliable to delegate to</p></div></div>
            <div class="slfc-pain-item"><span class="slfc-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Fires all day, every day</p><p class="text-white/40 text-xs mt-0.5">Reactive mode from 8AM to 8PM. No time for strategy or growth.</p></div></div>
            <div class="slfc-pain-item"><span class="slfc-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Staff overwhelmed and undertrained</p><p class="text-white/40 text-xs mt-0.5">Good people drowning in bad systems. Turnover is high.</p></div></div>
            <div class="slfc-pain-item"><span class="slfc-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Revenue plateau</p><p class="text-white/40 text-xs mt-0.5">Can't grow because operations can't support more volume</p></div></div>
            <div class="slfc-pain-item"><span class="slfc-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Clients feel the dysfunction</p><p class="text-white/40 text-xs mt-0.5">Slow responses, lost documents, missed updates &mdash; they notice.</p></div></div>
          </div>
        </div>

        <div id="slfc-panel-after" class="slfc-panel" style="display:none">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="slfc-win-item"><span class="slfc-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Systems and structure in place</p><p class="text-white/40 text-xs mt-0.5">Documented workflows, clear ownership, repeatable processes</p></div></div>
            <div class="slfc-win-item"><span class="slfc-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Owner leads, doesn't babysit</p><p class="text-white/40 text-xs mt-0.5">Delegation works because the ops backbone holds</p></div></div>
            <div class="slfc-win-item"><span class="slfc-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Proactive, not reactive</p><p class="text-white/40 text-xs mt-0.5">Issues caught before they become crises. Time opens up for growth.</p></div></div>
            <div class="slfc-win-item"><span class="slfc-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Trained, managed team</p><p class="text-white/40 text-xs mt-0.5">VAs embedded in your workflow, managed by legal ops experts</p></div></div>
            <div class="slfc-win-item"><span class="slfc-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Capacity to grow</p><p class="text-white/40 text-xs mt-0.5">Operations scale with volume. More cases, same calm.</p></div></div>
            <div class="slfc-win-item"><span class="slfc-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Clients feel the difference</p><p class="text-white/40 text-xs mt-0.5">Fast responses, organized files, proactive updates. 5-star experience.</p></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-16 md:py-24" id="book-now">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <div class="inline-flex items-baseline gap-1 mb-4">
            <img src="/brand/logos/color_icon.svg" alt="" class="h-8 w-auto" />
          </div>
          <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
            Let's Rescue Your Firm From the Chaos
          </h2>
          <p class="text-lg text-gray-500 max-w-xl mx-auto">Book a quick call. We'll diagnose what's broken and show you how to build the ops backbone your firm is missing.</p>
        </div>

        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-gray-200 reveal scroll-mt-20" style="transition-delay: 150ms">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/simple-campaign?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-400 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Free &mdash; no commitment
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            15 minutes
          </div>
        </div>
      </div>
    </div>
  </section>

  <footer class="py-6 bg-gray-50 border-t border-gray-200">
    <div class="container-wide flex items-center justify-between">
      <img src="/brand/logos/long_color_logo.svg" alt="Attorney Assistant" class="h-7 w-auto opacity-50" />
      <p class="text-xs text-gray-400">&copy; {new Date().getFullYear()} Attorney Assistant LLC</p>
    </div>
  </footer>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }
    .slfc-scroll-hint { animation: slfcFadeIn 1s ease 1.5s both; }
    @keyframes slfcFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .slfc-scroll-dot { animation: slfcScrollBounce 1.5s ease-in-out infinite; }
    @keyframes slfcScrollBounce { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(8px); opacity: 0.3; } }
    .slfc-timeline { position: relative; padding-left: 2rem; }
    .slfc-timeline-line { position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, rgba(249,166,48,0.4), rgba(239,68,68,0.4), rgba(249,166,48,0.6)); }
    .slfc-timeline-event { position: relative; padding-bottom: 2.5rem; padding-left: 1.5rem; }
    .slfc-timeline-event:last-child { padding-bottom: 0; }
    .slfc-timeline-dot { position: absolute; left: -2rem; top: 0.25rem; width: 14px; height: 14px; border-radius: 50%; z-index: 1; }
    .slfc-timeline-dot--gold { background: #F9A630; box-shadow: 0 0 0 4px rgba(249,166,48,0.2); }
    .slfc-timeline-dot--amber { background: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,0.2); }
    .slfc-timeline-dot--red { background: #ef4444; box-shadow: 0 0 0 4px rgba(239,68,68,0.2); }
    .slfc-timeline-dot--big { width: 18px; height: 18px; left: calc(-2rem - 2px); background: #F9A630; box-shadow: 0 0 0 6px rgba(249,166,48,0.25); }
    .slfc-timeline-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 0.25rem; }
    .slfc-path-card { text-align: center; padding: 2rem 1.5rem; border: 2px solid #e5e7eb; border-radius: 1rem; background: white; cursor: pointer; transition: all 0.3s ease; }
    .slfc-path-card:hover { border-color: #F9A630; transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }
    .slfc-path-card.slfc-path-card--active { border-color: #F9A630; background: rgba(249,166,48,0.04); box-shadow: 0 0 0 3px rgba(249,166,48,0.15); }
    .slfc-path-icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(249,166,48,0.08); color: #F9A630; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; border: 1px solid rgba(249,166,48,0.15); }
    .slfc-toggle-btn { padding: 0.5rem 1.25rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600; color: rgba(255,255,255,0.5); background: transparent; border: none; cursor: pointer; transition: all 0.3s; }
    .slfc-toggle-btn--active { background: #F9A630; color: #1a3a5c; }
    .slfc-pain-item, .slfc-win-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); }
    .slfc-pain-x { color: #ef4444; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(239,68,68,0.1); border-radius: 50%; }
    .slfc-win-check { color: #10b981; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(16,185,129,0.1); border-radius: 50%; }
    .slfc-panel { animation: slfcPanelIn 0.4s ease; }
    @keyframes slfcPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .slfc-scroll-dot, .slfc-scroll-hint, .slfc-panel { animation: none !important; } }
  </style>

  <script is:inline>
    (function() {
      var consequences = {
        admin: {
          label: 'Admin Avalanche',
          title: 'Your attorneys are spending 15+ hours a week on work that doesn\'t require a law degree.',
          body: 'Filing, scheduling, records requests, data entry — this is the work that buries your most expensive people in your cheapest tasks. A trained virtual assistant handles all of it at a fraction of the cost, giving your attorneys back the hours they need to actually practice law.'
        },
        leads: {
          label: 'Leaking Revenue',
          title: 'Every missed call and late follow-up is a case that signed with someone else.',
          body: '78% of leads hire the first firm that responds. If your intake is inconsistent — missed calls, slow callbacks, no after-hours coverage — you\'re paying for leads and handing them to competitors. That\'s not a marketing problem. It\'s an operations problem.'
        },
        owner: {
          label: 'The Owner Trap',
          title: 'If the firm can\'t run without you checking everything, you don\'t have a business — you have a job you can\'t leave.',
          body: 'You built this firm to have freedom, not to be chained to it. But without operational structure — people, processes, accountability — delegation fails and you become the single point of failure. We build the backbone so you can step back and lead.'
        }
      };

      document.querySelectorAll('.slfc-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;
          document.querySelectorAll('.slfc-path-card').forEach(function(c) { c.classList.remove('slfc-path-card--active'); });
          this.classList.add('slfc-path-card--active');
          document.getElementById('slfc-consequence-label').textContent = data.label;
          document.getElementById('slfc-consequence-title').textContent = data.title;
          document.getElementById('slfc-consequence-body').textContent = data.body;
          var panel = document.getElementById('slfc-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none'; panel.offsetHeight;
          panel.style.animation = 'slfcPanelIn 0.4s ease';
        });
      });

      var beforeBtn = document.getElementById('slfc-toggle-before');
      var afterBtn = document.getElementById('slfc-toggle-after');
      var beforePanel = document.getElementById('slfc-panel-before');
      var afterPanel = document.getElementById('slfc-panel-after');
      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('slfc-toggle-btn--active');
          afterBtn.classList.remove('slfc-toggle-btn--active');
          beforePanel.style.display = 'block'; afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none'; beforePanel.offsetHeight;
          beforePanel.style.animation = 'slfcPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('slfc-toggle-btn--active');
          beforeBtn.classList.remove('slfc-toggle-btn--active');
          afterPanel.style.display = 'block'; beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none'; afterPanel.offsetHeight;
          afterPanel.style.animation = 'slfcPanelIn 0.4s ease';
        });
      }
    })();
  </script>

