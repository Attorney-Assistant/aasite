---
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";
---

<SimpleCampaignLayout
  title="Intake Problems at Your Law Firm? Our Elite Staffing + AI Solutions Fix That | Attorney Assistant"
  description="Stop losing leads to slow intake, missed calls, and broken follow-up. Attorney Assistant's elite staffing and AI solutions turn every lead into an opportunity."
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[60vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10 py-20 lg:py-28 text-center">
      <div class="max-w-3xl mx-auto reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          Sound Familiar?
        </span>
        <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
          Intake problems at your law firm? <br/><span class="text-gradient-gold">Our Elite Staffing + AI Solutions fix that.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          Leads call. Nobody answers. Follow-up is late. Cases never get signed. Scroll to see the real cost &mdash; then let's fix it.
        </p>
        <a href="#book-now" class="btn-primary btn-lg group inline-flex mb-8">
          Fix My Intake
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
        <div class="sin-scroll-hint" aria-hidden="true">
          <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2 mx-auto">
            <div class="w-1 h-2.5 bg-brand-gold rounded-full sin-scroll-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 py-20 md:py-28">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/5 rounded-full blur-[120px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">The Timeline</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          How a Single Lead Dies at Your Firm
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">This happens every day. Most firms never even know.</p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="sin-timeline">
          <div class="sin-timeline-line"></div>

          <div class="sin-timeline-event reveal">
            <div class="sin-timeline-dot sin-timeline-dot--gold"></div>
            <div class="sin-timeline-content">
              <p class="sin-timeline-label">9:14 AM</p>
              <h3 class="text-lg font-heading text-white mb-1">A new lead calls your firm</h3>
              <p class="text-sm text-gray-400">Car accident. Needs representation. Found you on Google. This is the lead your marketing dollars paid for.</p>
            </div>
          </div>

          <div class="sin-timeline-event reveal">
            <div class="sin-timeline-dot sin-timeline-dot--amber"></div>
            <div class="sin-timeline-content">
              <p class="sin-timeline-label">9:14 AM</p>
              <h3 class="text-lg font-heading text-white mb-1">Nobody picks up</h3>
              <p class="text-sm text-gray-400">Your team is on another line. The call rolls to voicemail. The lead hangs up without leaving a message.</p>
            </div>
          </div>

          <div class="sin-timeline-event reveal">
            <div class="sin-timeline-dot sin-timeline-dot--red"></div>
            <div class="sin-timeline-content">
              <p class="sin-timeline-label">9:15 AM</p>
              <h3 class="text-lg font-heading text-white mb-1">They call the next firm on the list</h3>
              <p class="text-sm text-gray-400">Somebody answers. They ask a few questions. They feel heard. They schedule a consultation.</p>
            </div>
          </div>

          <div class="sin-timeline-event reveal">
            <div class="sin-timeline-dot sin-timeline-dot--red"></div>
            <div class="sin-timeline-content">
              <p class="sin-timeline-label">9:27 AM</p>
              <h3 class="text-lg font-heading text-white mb-1">They sign with your competitor</h3>
              <p class="text-sm text-gray-400">12 minutes. That's all it took. You'll never know they called. The lead is gone forever.</p>
            </div>
          </div>

          <div class="sin-timeline-event reveal">
            <div class="sin-timeline-dot sin-timeline-dot--big"></div>
            <div class="sin-timeline-content">
              <p class="sin-timeline-label">Every Week</p>
              <h3 class="text-display-xs font-heading text-brand-gold mb-1">This happens multiple times per week at most firms.</h3>
              <p class="text-sm text-gray-400">78% of personal injury leads hire the first firm that responds. If your intake is slow, you're funding your competitor's caseload.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28">
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-gold/5 rounded-full blur-[100px]"></div>
    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Be Honest</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          What does intake look like at your firm right now?
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Pick the one that's closest. No judgment.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto" id="sin-paths">
        <button class="sin-path-card reveal" data-path="inhouse" style="transition-delay: 0ms">
          <div class="sin-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">Our front desk handles it</h3>
          <p class="text-sm text-gray-500">Whoever's at the desk picks up when they can. After hours, it goes to voicemail.</p>
        </button>

        <button class="sin-path-card reveal" data-path="service" style="transition-delay: 100ms">
          <div class="sin-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">We have an answering service</h3>
          <p class="text-sm text-gray-500">They pick up but just take a message. No qualification, no warm transfer, no follow-up.</p>
        </button>

        <button class="sin-path-card reveal" data-path="gaps" style="transition-delay: 200ms">
          <div class="sin-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">We have major gaps</h3>
          <p class="text-sm text-gray-500">Nights, weekends, lunch breaks, busy periods &mdash; calls get missed constantly.</p>
        </button>
      </div>

      <!-- Consequence panels -->
      <div id="sin-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="p-8 rounded-2xl border border-brand-gold/20 bg-brand-gold/5 text-center">
          <p class="text-sm font-bold text-brand-gold uppercase tracking-widest mb-3" id="sin-consequence-label"></p>
          <p class="text-xl font-heading text-gray-900 mb-3" id="sin-consequence-title"></p>
          <p class="text-base text-gray-600 leading-relaxed" id="sin-consequence-body"></p>
          <a href="#book-now" class="btn-primary btn-lg group mt-6 inline-flex">
            Let's Fix This
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER REVEAL
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-20 md:py-28">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">The Difference</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          Your Intake vs. <span class="text-gradient-gold">Ours</span>
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="flex justify-center mb-10 reveal">
          <div class="inline-flex rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm">
            <button class="sin-toggle-btn sin-toggle-btn--active" data-view="before" id="sin-toggle-before">Your Current Intake</button>
            <button class="sin-toggle-btn" data-view="after" id="sin-toggle-after">With Attorney Assistant</button>
          </div>
        </div>

        <div id="sin-panel-before" class="sin-panel reveal">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="sin-pain-item"><span class="sin-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Calls go to voicemail</p><p class="text-white/40 text-xs mt-0.5">Nights, weekends, lunch — leads hit a dead end</p></div></div>
            <div class="sin-pain-item"><span class="sin-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Slow follow-up</p><p class="text-white/40 text-xs mt-0.5">Web leads wait hours or days for a callback</p></div></div>
            <div class="sin-pain-item"><span class="sin-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">No qualification</p><p class="text-white/40 text-xs mt-0.5">Everyone gets the same treatment — good leads and junk alike</p></div></div>
            <div class="sin-pain-item"><span class="sin-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Follow-up stops after one try</p><p class="text-white/40 text-xs mt-0.5">If the lead doesn't answer, nobody calls back</p></div></div>
            <div class="sin-pain-item"><span class="sin-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">No after-hours coverage</p><p class="text-white/40 text-xs mt-0.5">40% of leads come in outside business hours and get nothing</p></div></div>
            <div class="sin-pain-item"><span class="sin-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Marketing dollars wasted</p><p class="text-white/40 text-xs mt-0.5">You pay for the lead, then let it die in your own pipeline</p></div></div>
          </div>
        </div>

        <div id="sin-panel-after" class="sin-panel" style="display:none">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="sin-win-item"><span class="sin-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Every call answered live</p><p class="text-white/40 text-xs mt-0.5">24/7 coverage, bilingual, scripted to your practice areas</p></div></div>
            <div class="sin-win-item"><span class="sin-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Speed to lead under 5 minutes</p><p class="text-white/40 text-xs mt-0.5">Web leads get an immediate callback, not a next-day voicemail</p></div></div>
            <div class="sin-win-item"><span class="sin-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Leads qualified on the call</p><p class="text-white/40 text-xs mt-0.5">Good cases get flagged, junk gets filtered, attorneys only see quality</p></div></div>
            <div class="sin-win-item"><span class="sin-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Persistent follow-up (5 attempts)</p><p class="text-white/40 text-xs mt-0.5">No lead left behind — structured outreach until contact is made</p></div></div>
            <div class="sin-win-item"><span class="sin-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Nights, weekends, overflow covered</p><p class="text-white/40 text-xs mt-0.5">Every hour, every day — no gaps in coverage</p></div></div>
            <div class="sin-win-item"><span class="sin-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Marketing ROI multiplied</p><p class="text-white/40 text-xs mt-0.5">Same ad spend, more signed cases — because nothing leaks</p></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-16 md:py-24" id="book-now">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <div class="inline-flex items-baseline gap-1 mb-4">
            <img src="/brand/logos/color_icon.svg" alt="" class="h-8 w-auto" />
          </div>
          <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
            Let's Fix Your Intake
          </h2>
          <p class="text-lg text-gray-500 max-w-xl mx-auto">Book a quick call. We'll show you exactly where leads are slipping and how to plug the gaps &mdash; no commitment.</p>
        </div>

        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-gray-200 reveal scroll-mt-20" style="transition-delay: 150ms">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/simple-campaign?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-400 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Free &mdash; no commitment
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            15 minutes
          </div>
        </div>
      </div>
    </div>
  </section>

  <footer class="py-6 bg-gray-50 border-t border-gray-200">
    <div class="container-wide flex items-center justify-between">
      <img src="/brand/logos/long_color_logo.svg" alt="Attorney Assistant" class="h-7 w-auto opacity-50" />
      <p class="text-xs text-gray-400">&copy; {new Date().getFullYear()} Attorney Assistant LLC</p>
    </div>
  </footer>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }
    .sin-scroll-hint { animation: sinFadeIn 1s ease 1.5s both; }
    @keyframes sinFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .sin-scroll-dot { animation: sinScrollBounce 1.5s ease-in-out infinite; }
    @keyframes sinScrollBounce { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(8px); opacity: 0.3; } }
    .sin-timeline { position: relative; padding-left: 2rem; }
    .sin-timeline-line { position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, rgba(249,166,48,0.4), rgba(239,68,68,0.4), rgba(249,166,48,0.6)); }
    .sin-timeline-event { position: relative; padding-bottom: 2.5rem; padding-left: 1.5rem; }
    .sin-timeline-event:last-child { padding-bottom: 0; }
    .sin-timeline-dot { position: absolute; left: -2rem; top: 0.25rem; width: 14px; height: 14px; border-radius: 50%; z-index: 1; }
    .sin-timeline-dot--gold { background: #F9A630; box-shadow: 0 0 0 4px rgba(249,166,48,0.2); }
    .sin-timeline-dot--amber { background: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,0.2); }
    .sin-timeline-dot--red { background: #ef4444; box-shadow: 0 0 0 4px rgba(239,68,68,0.2); }
    .sin-timeline-dot--big { width: 18px; height: 18px; left: calc(-2rem - 2px); background: #F9A630; box-shadow: 0 0 0 6px rgba(249,166,48,0.25); }
    .sin-timeline-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 0.25rem; }
    .sin-path-card { text-align: center; padding: 2rem 1.5rem; border: 2px solid #e5e7eb; border-radius: 1rem; background: white; cursor: pointer; transition: all 0.3s ease; }
    .sin-path-card:hover { border-color: #F9A630; transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }
    .sin-path-card.sin-path-card--active { border-color: #F9A630; background: rgba(249,166,48,0.04); box-shadow: 0 0 0 3px rgba(249,166,48,0.15); }
    .sin-path-icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(249,166,48,0.08); color: #F9A630; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; border: 1px solid rgba(249,166,48,0.15); }
    .sin-toggle-btn { padding: 0.5rem 1.25rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600; color: rgba(255,255,255,0.5); background: transparent; border: none; cursor: pointer; transition: all 0.3s; }
    .sin-toggle-btn--active { background: #F9A630; color: #1a3a5c; }
    .sin-pain-item, .sin-win-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); }
    .sin-pain-x { color: #ef4444; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(239,68,68,0.1); border-radius: 50%; }
    .sin-win-check { color: #10b981; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(16,185,129,0.1); border-radius: 50%; }
    .sin-panel { animation: sinPanelIn 0.4s ease; }
    @keyframes sinPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .sin-scroll-dot, .sin-scroll-hint, .sin-panel { animation: none !important; } }
  </style>

  <script is:inline>
    (function() {
      var consequences = {
        inhouse: {
          label: 'Front Desk Reality',
          title: 'Your front desk is already doing 10 jobs. Intake shouldn\'t be the 11th.',
          body: 'When the receptionist is juggling walk-ins, transfers, and admin while also trying to qualify a new PI lead, something gives. Usually it\'s the lead. They get rushed, put on hold, or sent to voicemail — and they never call back.'
        },
        service: {
          label: 'Answering ≠ Intake',
          title: 'An answering service takes a message. That\'s not intake — that\'s a Post-It note with a delay.',
          body: 'If nobody qualifies the lead, nobody schedules the consultation, and nobody follows up within 5 minutes, the answering service is just a more expensive voicemail. Real intake means the lead is worked, not just logged.'
        },
        gaps: {
          label: 'Gaps = Lost Revenue',
          title: '40% of leads come in outside business hours. If nobody\'s there, that\'s 40% of your marketing budget going to your competitors.',
          body: 'Lunch breaks, after-hours, weekends, busy periods — every gap is an open door for leads to walk through and never come back. Coverage isn\'t a luxury. It\'s the minimum requirement to protect the money you\'re already spending.'
        }
      };

      document.querySelectorAll('.sin-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;
          document.querySelectorAll('.sin-path-card').forEach(function(c) { c.classList.remove('sin-path-card--active'); });
          this.classList.add('sin-path-card--active');
          document.getElementById('sin-consequence-label').textContent = data.label;
          document.getElementById('sin-consequence-title').textContent = data.title;
          document.getElementById('sin-consequence-body').textContent = data.body;
          var panel = document.getElementById('sin-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none';
          panel.offsetHeight;
          panel.style.animation = 'sinPanelIn 0.4s ease';
        });
      });

      var beforeBtn = document.getElementById('sin-toggle-before');
      var afterBtn = document.getElementById('sin-toggle-after');
      var beforePanel = document.getElementById('sin-panel-before');
      var afterPanel = document.getElementById('sin-panel-after');
      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('sin-toggle-btn--active');
          afterBtn.classList.remove('sin-toggle-btn--active');
          beforePanel.style.display = 'block';
          afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none'; beforePanel.offsetHeight;
          beforePanel.style.animation = 'sinPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('sin-toggle-btn--active');
          beforeBtn.classList.remove('sin-toggle-btn--active');
          afterPanel.style.display = 'block';
          beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none'; afterPanel.offsetHeight;
          afterPanel.style.animation = 'sinPanelIn 0.4s ease';
        });
      }
    })();
  </script>

  <script is:inline>
    if (typeof posthog !== 'undefined') posthog.capture('LP Viewed', { page: 'intake' });
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lp_view', lp_name: 'intake' });
  </script>

