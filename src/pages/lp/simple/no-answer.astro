---
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";
---

<SimpleCampaignLayout
  title="$250K Case Called at 8PM. No One Answered. | Attorney Assistant"
  description="How many cases has your firm lost after hours? Attorney Assistant's elite staffing and AI solutions ensure every call gets answered — 24/7."
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[60vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10 py-20 lg:py-28 text-center">
      <div class="max-w-3xl mx-auto reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          This Happened Last Night
        </span>
        <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
          $250K case called at 8PM. <br/><span class="text-gradient-gold">No one answered.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-300 mb-4 max-w-2xl mx-auto leading-relaxed">
          They called the next firm. Someone picked up. They signed 12 minutes later. You'll never know they called.
        </p>
        <p class="text-base text-brand-gold font-heading mb-8">Our Elite Staffing + AI Solutions fix that.</p>
        <div class="sna-scroll-hint" aria-hidden="true">
          <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2 mx-auto">
            <div class="w-1 h-2.5 bg-brand-gold rounded-full sna-scroll-dot"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 py-20 md:py-28">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/5 rounded-full blur-[120px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-6">The Timeline</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          What Happened Last Night at 8PM
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">A real scenario. Playing out at firms across the country. Every single night.</p>
      </div>

      <div class="max-w-2xl mx-auto">
        <div class="sna-timeline">
          <div class="sna-timeline-line"></div>

          <div class="sna-timeline-event reveal">
            <div class="sna-timeline-dot sna-timeline-dot--gold"></div>
            <div class="sna-timeline-content">
              <p class="sna-timeline-label">8:02 PM</p>
              <h3 class="text-lg font-heading text-white mb-1">A car accident victim searches "best injury lawyer near me"</h3>
              <p class="text-sm text-gray-400">They're in pain, scared, and looking for help right now. Your Google ad shows up first. They click. They call.</p>
            </div>
          </div>

          <div class="sna-timeline-event reveal">
            <div class="sna-timeline-dot sna-timeline-dot--amber"></div>
            <div class="sna-timeline-content">
              <p class="sna-timeline-label">8:02 PM</p>
              <h3 class="text-lg font-heading text-white mb-1">Your phone rings four times &mdash; then voicemail</h3>
              <p class="text-sm text-gray-400">Your office closed at 5. The answering service takes a message. "Someone will call you back tomorrow."</p>
            </div>
          </div>

          <div class="sna-timeline-event reveal">
            <div class="sna-timeline-dot sna-timeline-dot--red"></div>
            <div class="sna-timeline-content">
              <p class="sna-timeline-label">8:04 PM</p>
              <h3 class="text-lg font-heading text-white mb-1">They call the next firm</h3>
              <p class="text-sm text-gray-400">Someone answers live. Asks the right questions. Empathizes. Schedules a consultation for tomorrow morning.</p>
            </div>
          </div>

          <div class="sna-timeline-event reveal">
            <div class="sna-timeline-dot sna-timeline-dot--red"></div>
            <div class="sna-timeline-content">
              <p class="sna-timeline-label">8:14 PM</p>
              <h3 class="text-lg font-heading text-white mb-1">They sign a retainer &mdash; with your competitor</h3>
              <p class="text-sm text-gray-400">$250K case. Gone in 12 minutes. Your firm paid for the click. Your competitor got the case.</p>
            </div>
          </div>

          <div class="sna-timeline-event reveal">
            <div class="sna-timeline-dot sna-timeline-dot--big"></div>
            <div class="sna-timeline-content">
              <p class="sna-timeline-label">9:00 AM Next Day</p>
              <h3 class="text-display-xs font-heading text-brand-gold mb-1">Your team sees the missed call. Too late.</h3>
              <p class="text-sm text-gray-400">They call back. No answer. The lead is already signed, already represented, already someone else's revenue. You'll never know what you lost.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-20 md:py-28">
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-gold/5 rounded-full blur-[100px]"></div>
    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Be Honest</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          What happens at your firm after 5PM?
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Pick the one that's closest.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-4xl mx-auto" id="sna-paths">
        <button class="sna-path-card reveal" data-path="voicemail" style="transition-delay: 0ms">
          <div class="sna-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 9v.906a2.25 2.25 0 01-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 001.183 1.981l6.478 3.488m8.839 2.51l-4.66-2.51m0 0l-1.023-.55a2.25 2.25 0 00-2.134 0l-1.022.55m0 0l-4.661 2.51m16.5 1.615a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V8.844a2.25 2.25 0 011.183-1.98l7.5-4.04a2.25 2.25 0 012.134 0l7.5 4.04a2.25 2.25 0 011.183 1.98V18" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">Everything goes to voicemail</h3>
          <p class="text-sm text-gray-500">Phones roll over at 5. We check messages in the morning.</p>
        </button>

        <button class="sna-path-card reveal" data-path="answering" style="transition-delay: 100ms">
          <div class="sna-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">We have an answering service</h3>
          <p class="text-sm text-gray-500">They pick up but just take a name and number. No intake, no qualification.</p>
        </button>

        <button class="sna-path-card reveal" data-path="oncall" style="transition-delay: 200ms">
          <div class="sna-path-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 0012 18z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mb-2">The attorney is "on call"</h3>
          <p class="text-sm text-gray-500">Which means they sometimes pick up, sometimes don't, and they're burning out.</p>
        </button>
      </div>

      <div id="sna-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="p-8 rounded-2xl border border-brand-gold/20 bg-brand-gold/5 text-center">
          <p class="text-sm font-bold text-brand-gold uppercase tracking-widest mb-3" id="sna-consequence-label"></p>
          <p class="text-xl font-heading text-gray-900 mb-3" id="sna-consequence-title"></p>
          <p class="text-base text-gray-600 leading-relaxed" id="sna-consequence-body"></p>
          <a href="#book-now" class="btn-primary btn-lg group mt-6 inline-flex">
            Let's Fix This
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER REVEAL
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-20 md:py-28">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">The Difference</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          After Hours Now vs. <span class="text-gradient-gold">After Hours With Us</span>
        </h2>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="flex justify-center mb-10 reveal">
          <div class="inline-flex rounded-full border border-white/10 bg-white/5 p-1 backdrop-blur-sm">
            <button class="sna-toggle-btn sna-toggle-btn--active" id="sna-toggle-before">After 5PM Now</button>
            <button class="sna-toggle-btn" id="sna-toggle-after">After 5PM With Us</button>
          </div>
        </div>

        <div id="sna-panel-before" class="sna-panel reveal">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="sna-pain-item"><span class="sna-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Phones go dark at 5PM</p><p class="text-white/40 text-xs mt-0.5">Every call after hours hits voicemail or a dead line</p></div></div>
            <div class="sna-pain-item"><span class="sna-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Weekends = zero coverage</p><p class="text-white/40 text-xs mt-0.5">Accidents happen on Saturday. Your firm doesn't exist on Saturday.</p></div></div>
            <div class="sna-pain-item"><span class="sna-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Leads sign elsewhere overnight</p><p class="text-white/40 text-xs mt-0.5">By the time you call back at 9AM, they've already retained someone</p></div></div>
            <div class="sna-pain-item"><span class="sna-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">No way to know what you missed</p><p class="text-white/40 text-xs mt-0.5">Lost leads don't leave a trace. You can't fix what you can't see.</p></div></div>
            <div class="sna-pain-item"><span class="sna-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Attorneys burned from being on call</p><p class="text-white/40 text-xs mt-0.5">Personal phone ringing at dinner, on vacation, at their kid's game</p></div></div>
            <div class="sna-pain-item"><span class="sna-pain-x">&#10005;</span><div><p class="text-white font-semibold text-sm">Competitors pick up what you drop</p><p class="text-white/40 text-xs mt-0.5">78% of PI leads hire the first firm that responds</p></div></div>
          </div>
        </div>

        <div id="sna-panel-after" class="sna-panel" style="display:none">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="sna-win-item"><span class="sna-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Live answer 24/7/365</p><p class="text-white/40 text-xs mt-0.5">Real people, trained on your intake, picking up at 8PM, midnight, Sunday</p></div></div>
            <div class="sna-win-item"><span class="sna-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Full weekends and holidays covered</p><p class="text-white/40 text-xs mt-0.5">Your firm never sleeps. Every call gets handled.</p></div></div>
            <div class="sna-win-item"><span class="sna-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Leads qualified on the spot</p><p class="text-white/40 text-xs mt-0.5">Not just answered — screened, documented, and routed to the right next step</p></div></div>
            <div class="sna-win-item"><span class="sna-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Every call logged and recorded</p><p class="text-white/40 text-xs mt-0.5">Full visibility into what came in overnight — no blind spots</p></div></div>
            <div class="sna-win-item"><span class="sna-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">Attorneys off the hook</p><p class="text-white/40 text-xs mt-0.5">No more personal phone ringing at dinner. Your team handles it.</p></div></div>
            <div class="sna-win-item"><span class="sna-win-check">&#10003;</span><div><p class="text-white font-semibold text-sm">You respond first &mdash; every time</p><p class="text-white/40 text-xs mt-0.5">Speed to lead wins cases. Now you're the firm that picks up.</p></div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white py-16 md:py-24" id="book-now">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>
    <div class="container-wide relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <div class="inline-flex items-baseline gap-1 mb-4">
            <img src="/brand/logos/color_icon.svg" alt="" class="h-8 w-auto" />
          </div>
          <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
            Stop Losing Cases After Hours
          </h2>
          <p class="text-lg text-gray-500 max-w-xl mx-auto">Book a quick call. We'll show you how 24/7 coverage works and what it costs &mdash; no commitment.</p>
        </div>

        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-gray-200 reveal scroll-mt-20" style="transition-delay: 150ms">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/simple-campaign?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-400 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Free &mdash; no commitment
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            15 minutes
          </div>
        </div>
      </div>
    </div>
  </section>

  <footer class="py-6 bg-gray-50 border-t border-gray-200">
    <div class="container-wide flex items-center justify-between">
      <img src="/brand/logos/long_color_logo.svg" alt="Attorney Assistant" class="h-7 w-auto opacity-50" />
      <p class="text-xs text-gray-400">&copy; {new Date().getFullYear()} Attorney Assistant LLC</p>
    </div>
  </footer>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }
    .sna-scroll-hint { animation: snaFadeIn 1s ease 1.5s both; }
    @keyframes snaFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .sna-scroll-dot { animation: snaScrollBounce 1.5s ease-in-out infinite; }
    @keyframes snaScrollBounce { 0%, 100% { transform: translateY(0); opacity: 1; } 50% { transform: translateY(8px); opacity: 0.3; } }
    .sna-timeline { position: relative; padding-left: 2rem; }
    .sna-timeline-line { position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, rgba(249,166,48,0.4), rgba(239,68,68,0.4), rgba(249,166,48,0.6)); }
    .sna-timeline-event { position: relative; padding-bottom: 2.5rem; padding-left: 1.5rem; }
    .sna-timeline-event:last-child { padding-bottom: 0; }
    .sna-timeline-dot { position: absolute; left: -2rem; top: 0.25rem; width: 14px; height: 14px; border-radius: 50%; z-index: 1; }
    .sna-timeline-dot--gold { background: #F9A630; box-shadow: 0 0 0 4px rgba(249,166,48,0.2); }
    .sna-timeline-dot--amber { background: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,0.2); }
    .sna-timeline-dot--red { background: #ef4444; box-shadow: 0 0 0 4px rgba(239,68,68,0.2); }
    .sna-timeline-dot--big { width: 18px; height: 18px; left: calc(-2rem - 2px); background: #F9A630; box-shadow: 0 0 0 6px rgba(249,166,48,0.25); }
    .sna-timeline-label { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); margin-bottom: 0.25rem; }
    .sna-path-card { text-align: center; padding: 2rem 1.5rem; border: 2px solid #e5e7eb; border-radius: 1rem; background: white; cursor: pointer; transition: all 0.3s ease; }
    .sna-path-card:hover { border-color: #F9A630; transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }
    .sna-path-card.sna-path-card--active { border-color: #F9A630; background: rgba(249,166,48,0.04); box-shadow: 0 0 0 3px rgba(249,166,48,0.15); }
    .sna-path-icon { width: 56px; height: 56px; border-radius: 16px; background: rgba(249,166,48,0.08); color: #F9A630; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; border: 1px solid rgba(249,166,48,0.15); }
    .sna-toggle-btn { padding: 0.5rem 1.25rem; border-radius: 9999px; font-size: 0.8125rem; font-weight: 600; color: rgba(255,255,255,0.5); background: transparent; border: none; cursor: pointer; transition: all 0.3s; }
    .sna-toggle-btn--active { background: #F9A630; color: #1a3a5c; }
    .sna-pain-item, .sna-win-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.08); background: rgba(255,255,255,0.03); }
    .sna-pain-x { color: #ef4444; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(239,68,68,0.1); border-radius: 50%; }
    .sna-win-check { color: #10b981; font-weight: 700; font-size: 0.875rem; width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background: rgba(16,185,129,0.1); border-radius: 50%; }
    .sna-panel { animation: snaPanelIn 0.4s ease; }
    @keyframes snaPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .sna-scroll-dot, .sna-scroll-hint, .sna-panel { animation: none !important; } }
  </style>

  <script is:inline>
    (function() {
      var consequences = {
        voicemail: {
          label: 'Voicemail = Goodbye',
          title: 'A lead who reaches voicemail after hours doesn\'t leave a message. They call the next firm.',
          body: 'Studies show that less than 20% of callers leave a voicemail when they reach a law firm after hours. The other 80% hang up and call someone else. You\'re not losing leads to bad marketing — you\'re losing them to a phone that no one answers.'
        },
        answering: {
          label: 'Message ≠ Intake',
          title: 'Taking a message at 8PM and calling back at 9AM means the lead had 13 hours to sign with someone else.',
          body: 'An answering service that just collects a name and number is a speed bump, not a solution. Real after-hours intake means qualifying the lead, scheduling the consultation, and making them feel like they\'ve already found their lawyer — all on that first call.'
        },
        oncall: {
          label: 'Unsustainable',
          title: 'An attorney answering their cell at dinner isn\'t a coverage strategy — it\'s a burnout strategy.',
          body: 'When the partner is the after-hours safety net, they never truly clock out. That\'s not sustainable, and it doesn\'t scale. You need a team that handles after-hours intake professionally so your attorneys can rest and your firm still converts.'
        }
      };

      document.querySelectorAll('.sna-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;
          document.querySelectorAll('.sna-path-card').forEach(function(c) { c.classList.remove('sna-path-card--active'); });
          this.classList.add('sna-path-card--active');
          document.getElementById('sna-consequence-label').textContent = data.label;
          document.getElementById('sna-consequence-title').textContent = data.title;
          document.getElementById('sna-consequence-body').textContent = data.body;
          var panel = document.getElementById('sna-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none'; panel.offsetHeight;
          panel.style.animation = 'snaPanelIn 0.4s ease';
        });
      });

      var beforeBtn = document.getElementById('sna-toggle-before');
      var afterBtn = document.getElementById('sna-toggle-after');
      var beforePanel = document.getElementById('sna-panel-before');
      var afterPanel = document.getElementById('sna-panel-after');
      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('sna-toggle-btn--active');
          afterBtn.classList.remove('sna-toggle-btn--active');
          beforePanel.style.display = 'block'; afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none'; beforePanel.offsetHeight;
          beforePanel.style.animation = 'snaPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('sna-toggle-btn--active');
          beforeBtn.classList.remove('sna-toggle-btn--active');
          afterPanel.style.display = 'block'; beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none'; afterPanel.offsetHeight;
          afterPanel.style.animation = 'snaPanelIn 0.4s ease';
        });
      }
    })();
  </script>

