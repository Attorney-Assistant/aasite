    @keyframes lpFloat3 {
      0% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(-40px, 30px) scale(1.2); }
      66% { transform: translate(50px, -40px) scale(0.9); }
      100% { transform: translate(0, 0) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
