    .lp-orb--2 {
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(249,166,45,0.3) 0%, rgba(249,166,45,0) 70%);
      bottom: -20%;
      left: -8%;
      animation: lpFloat2 12s ease-in-out infinite;
