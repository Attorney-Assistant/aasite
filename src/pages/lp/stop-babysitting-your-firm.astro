  <style>
    .meetings-iframe-container iframe {
      background: #ffffff !important;
    }

    /* Section spacing */
    .lp-section {
      padding: 4rem 0;
    }
    @media (min-width: 768px) {
      .lp-section { padding: 5rem 0; }
    }

    /* Hero orbs */
    .lp-orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      will-change: transform;
      z-index: 1;
    }
    .lp-orb--1 {
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(80,167,221,0.3) 0%, rgba(80,167,221,0) 70%);
      top: -25%;
      right: -10%;
      animation: lpFloat1 10s ease-in-out infinite;
    }
    .lp-orb--2 {
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(249,166,48,0.25) 0%, rgba(249,166,48,0) 70%);
      bottom: -20%;
      left: -8%;
      animation: lpFloat2 12s ease-in-out infinite;
    }
    @keyframes lpFloat1 {
      0% { transform: translate(0, 0) scale(1); }
      20% { transform: translate(-100px, 50px) scale(1.25); }
      40% { transform: translate(-30px, -60px) scale(0.85); }
      60% { transform: translate(80px, 25px) scale(1.15); }
      80% { transform: translate(30px, -40px) scale(0.9); }
      100% { transform: translate(0, 0) scale(1); }
    }
    @keyframes lpFloat2 {
      0% { transform: translate(0, 0) scale(1); }
      25% { transform: translate(90px, -45px) scale(1.3); }
      50% { transform: translate(30px, 60px) scale(0.8); }
      75% { transform: translate(-60px, -20px) scale(1.15); }
      100% { transform: translate(0, 0) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .lp-orb { animation: none; }
    }

    /* Gap grid */
    .lp-gap-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    .lp-gap-card {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1rem;
      background: white;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
    }
    .lp-gap-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      background: rgba(239,68,68,0.08);
      color: #ef4444;
      border: 1px solid rgba(239,68,68,0.12);
    }

    /* Cost rows */
    .lp-cost-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem;
      background: #fafafa;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
    }
    .lp-cost-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .lp-cost-icon--red {
      background: rgba(239,68,68,0.08);
      color: #ef4444;
      border: 1px solid rgba(239,68,68,0.12);
    }
    .lp-cost-icon--amber {
      background: rgba(249,166,48,0.08);
      color: #F9A630;
      border: 1px solid rgba(249,166,48,0.15);
    }
    .lp-cost-icon--navy {
      background: rgba(26,58,92,0.08);
      color: #1a3a5c;
      border: 1px solid rgba(26,58,92,0.12);
    }

    /* What we do cards (dark section) */
    .lp-what-card {
      display: flex;
