    /* =============================================
       FLOATING ANIMATION (CTA orbs)
    ============================================= */
    .lp-float-slow {
      animation: lpFloatSlow 8s ease-in-out infinite;
    }
    .lp-float-slow-reverse {
      animation: lpFloatSlowReverse 10s ease-in-out infinite;
    }
    @keyframes lpFloatSlow {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-30px); }
    }
    @keyframes lpFloatSlowReverse {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(25px); }
    }
  </style>

  <!-- Count-up animation script -->
  <script is:inline>
  (function() {
    var counted = false;
    function countUp() {
      if (counted) return;
      counted = true;
      document.querySelectorAll('.lp-count').forEach(function(el) {
        var target = parseInt(el.getAttribute('data-target'), 10);
        var duration = 1500;
        var startTime = null;
        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          var progress = Math.min((timestamp - startTime) / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }
    if ('IntersectionObserver' in window) {
      var el = document.querySelector('.lp-count');
      if (el) {
        new IntersectionObserver(function(entries) {
          if (entries[0].isIntersecting) countUp();
        }, { threshold: 0.5 }).observe(el);
      }
    } else {
      countUp();
    }
  })();
  </script>

