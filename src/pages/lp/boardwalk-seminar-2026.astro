      <div class="comic-wrap">
        <div class="masthead-inner">
          <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="masthead-logo" />
          <div class="masthead-right">
            <span class="masthead-issue">BOARDWALK SEMINAR EDITION &bull; 2026</span>
            <span class="masthead-tagline">Operations problem-solvers for 200+ law firms</span>
