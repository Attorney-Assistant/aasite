---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Audit My Intake — Boardwalk Seminar 2026 | Attorney Assistant"
  description="Met us at the Boardwalk Seminar? Book your free intake audit. We'll diagnose the gaps costing your firm cases and show you exactly what to fix."
  noindex={true}
>

  <!-- ══════════════════════════════════════════════
       COMIC BOOK LANDING PAGE — BOARDWALK SEMINAR
       Styled after the AA SuperHero Issue №01 print piece
       ══════════════════════════════════════════════ -->

  <div class="comic-page">

    <!-- ─── MASTHEAD ─── -->
    <header class="comic-masthead">
      <div class="comic-wrap">
        <div class="masthead-inner">
          <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="masthead-logo" />
          <div class="masthead-right">
            <span class="masthead-issue">BOARDWALK SEMINAR EDITION &bull; 2026</span>
            <span class="masthead-tagline">Operations problem-solvers for 200+ law firms</span>
          </div>
        </div>
      </div>
    </header>

    <!-- ─── HERO PANEL ─── -->
    <section class="panel panel-hero">
      <div class="halftone"></div>
      <div class="comic-wrap panel-hero-wrap">
        <div class="hero-left">
          <div class="speech-bubble speech-bubble--shout hero-bubble">
            <span>WE OWN THE OUTCOME</span>
          </div>
          <h1 class="hero-headline">
            WE EVOLVE LAW FIRMS WITH ELITE TEAMS + AI&nbsp;SOLUTIONS.
          </h1>
          <p class="hero-sub">
            We own the outcome, not just the task. So your nights stop getting hijacked by missed calls, chaos, and "just one more thing."
          </p>
          <p class="hero-detail">
            More control. Less fire-drilling. The kind of operation that lets you step away without everything falling apart.
          </p>
          <a href="#book" class="comic-btn">BOOK YOUR FREE AUDIT</a>
        </div>
      </div>
      <div class="skyline"></div>
    </section>

    <!-- ─── THE PROBLEM ─── -->
    <section class="panel panel-problem">
      <div class="halftone halftone--light"></div>
      <div class="comic-wrap">
        <div class="section-label">THE PROBLEM</div>
        <h2 class="comic-h2">THREE FAILURES COST YOUR FIRM MORE THAN MARKETING EVER&nbsp;COULD.</h2>
        <p class="comic-body" style="max-width:680px;margin-bottom:2rem;">
          A custom combination matched to your firm's specific bottlenecks, not an off-the-shelf staffing package.
        </p>
        <div class="stat-cards">
          <div class="stat-card">
            <div class="stat-card-number">20%</div>
            <h3 class="stat-card-title">Intake Failure</h3>
            <p class="stat-card-body">Of leads vanish before anyone picks up the phone. Slow callbacks, broken handoffs. No-one's watching the door every day.</p>
          </div>
          <div class="stat-card">
            <div class="stat-card-number">15<span class="stat-plus">+</span> HRS</div>
            <h3 class="stat-card-title">Admin Chaos</h3>
            <p class="stat-card-body">Wasted per attorney, per week. Filing, scheduling, chasing updates. Most expensive people are doing your cheapest work.</p>
          </div>
          <div class="stat-card">
            <div class="stat-card-number">$1–2M</div>
            <h3 class="stat-card-title">Growth Stagnation</h3>
            <p class="stat-card-body">Firms hit a revenue ceiling and can't break through without fixing operations. More marketing just multiplies the chaos.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── ASSEMBLE THE TEAM ─── -->
    <section class="panel panel-team">
      <div class="comic-wrap">
        <div class="section-label section-label--dark">ASSEMBLE THE TEAM</div>
        <h2 class="comic-h2 comic-h2--light">THE WORK YOUR FIRM NEEDS BUT HATES TO&nbsp;MANAGE.</h2>
        <p class="comic-body comic-body--light" style="max-width:740px;margin-bottom:2rem;">
          A custom combination matched to your firm's specific bottlenecks, not an off-the-shelf staffing package. We take this off your plate so you can lead your firm, not babysit it.
        </p>
        <div class="service-grid">
          <div class="service-card">
            <h3>Intake 360</h3>
            <p>24/7 live answering, bilingual, scripted to your practice areas. Every call captured, every detail in your CRM.</p>
          </div>
          <div class="service-card">
            <h3>Lead Follow-Up</h3>
            <p>5-minute response on every inbound lead. Speed wins cases. Consistency closes them.</p>
          </div>
          <div class="service-card">
            <h3>Admin Support</h3>
            <p>Filing, scheduling, records, status updates. The back-office work that overwhelms your attorneys, handled.</p>
          </div>
          <div class="service-card">
            <h3>Impact Assistants</h3>
            <p>A true extension of your team, not a vendor placement. The kind of support that actually lets you breathe.</p>
          </div>
          <div class="service-card">
            <h3>Executive Assistant</h3>
            <p>A virtual right hand for partners. Calendar, inbox, follow-ups, travel. The admin that runs your day, run.</p>
          </div>
          <div class="service-card">
            <h3>AI Solutions</h3>
            <p>AI-driven workflows that route, qualify, and accelerate every process on every step. Your team, multiplied.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── WHY FIRMS CHOOSE US ─── -->
    <section class="panel panel-why">
      <div class="halftone"></div>
      <div class="comic-wrap">

        <!-- Stat bubbles row -->
        <div class="bubble-row">
          <div class="stat-bubble">
            <strong>200+</strong>
            <span>Law firms scaled</span>
          </div>
          <div class="stat-bubble">
            <strong>60%</strong>
            <span>Cost savings vs. in-house</span>
          </div>
          <div class="stat-bubble">
            <strong>5MIN</strong>
            <span>Window before a lead goes cold</span>
          </div>
          <div class="stat-bubble">
            <strong>78+%</strong>
            <span>Of leads go to whoever responds first</span>
          </div>
        </div>

        <div class="section-label">WHY FIRMS CHOOSE US</div>
        <h2 class="comic-h2">THREE FAILURES COST YOUR FIRM MORE THAN MARKETING EVER&nbsp;COULD.</h2>

        <div class="speech-grid">
          <div class="speech-card">
            <div class="speech-card-inner">
              <h3>We Fix What's Broken</h3>
              <p><strong>The intake failures, follow-up gaps, and admin chaos costing your firm revenue.</strong> Diagnosed, not glossed over, every day.</p>
            </div>
            <div class="speech-card-tail"></div>
          </div>
          <div class="speech-card">
            <div class="speech-card-inner">
              <h3>Co-Managed, Not Outsourced</h3>
              <p><strong>We embed in your daily workflow.</strong> Not "set it and forget it." We co-manage operations alongside your team.</p>
            </div>
            <div class="speech-card-tail"></div>
          </div>
          <div class="speech-card">
            <div class="speech-card-inner">
              <h3>Your Win Is Our Win</h3>
              <p><strong>An extension of your team, not a vendor.</strong> The deeper we integrate, the more efficient your firm becomes.</p>
            </div>
            <div class="speech-card-tail"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── BOOK YOUR AUDIT ─── -->
    <section class="panel panel-book" id="book">
      <div class="comic-wrap">
        <div class="section-label section-label--accent">STOP LEAKING REVENUE</div>
        <h2 class="comic-h2">START SCALING WITH THE TEAM BEHIND <span class="text-pop">200+ FIRMS.</span></h2>
        <p class="comic-body" style="max-width:680px;margin-bottom:2.5rem;">
          Book a free intake audit. We'll diagnose the specific operational gaps costing you cases, and show you exactly what to fix first.
        </p>

        <div class="booking-panel">
          <!-- Start of Meetings Embed Script -->
          <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/audit-my-intake-conference-attendance?embed=true"></div>
          <script type="text/javascript" src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"></script>
          <!-- End of Meetings Embed Script -->
        </div>

        <p class="comic-tagline">Build a firm that runs without you chasing it.<br/>Go home on time. Stay there.</p>
      </div>
    </section>

    <!-- ─── CONTACT BAR ─── -->
    <footer class="comic-footer">
      <div class="comic-wrap footer-inner">
        <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="footer-logo" loading="lazy" />
        <div class="footer-links">
          <a href="tel:+12153372677">Call: +1 (215) 337-2677</a>
          <a href="mailto:info@attorneyassistant.com">Email: info@attorneyassistant.com</a>
          <span>21 East 5th Ave, Suite 102, Conshohocken, PA 19428</span>
        </div>
        <span class="footer-url">attorneyassistant.com</span>
      </div>
    </footer>

  </div><!-- .comic-page -->

  <!-- ═══════════════════════════════════════
       STYLES — TRUE COMIC BOOK AESTHETIC
       ═══════════════════════════════════════ -->
  <style is:global>
    /* ── Reset & Page Wrapper ── */
    .comic-page {
      --orange: #F7941D;
      --orange-bright: #FBB03B;
      --orange-deep: #E8700A;
      --navy: #1B2A4A;
      --navy-deep: #0F1B33;
      --ink: #111111;
      --paper: #FFF9EE;
      --white: #FFFFFF;

      font-family: 'DM Sans', 'Segoe UI', sans-serif;
      color: var(--ink);
      line-height: 1.5;
      overflow-x: hidden;
      background: var(--paper);
    }

    /* ── Comic Typography ── */
    @import url('https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=DM+Sans:wght@400;500;700&display=swap');

    .comic-page h1,
    .comic-page h2,
    .comic-page h3,
    .comic-h2,
    .hero-headline,
    .stat-card-number,
    .stat-card-title,
    .service-card h3,
    .speech-card h3,
    .section-label,
    .comic-btn,
    .comic-tagline,
    .masthead-issue {
      font-family: 'Anton', 'Impact', 'Arial Black', sans-serif;
      text-transform: uppercase;
    }

    .speech-bubble span,
    .stat-bubble strong {
      font-family: 'Permanent Marker', cursive;
    }

    /* ── Layout ── */
    .comic-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem;
      position: relative;
      z-index: 2;
    }

    /* ── Halftone Pattern ── */
    .halftone {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: radial-gradient(circle, rgba(0,0,0,0.13) 2.2px, transparent 2.2px);
      background-size: 12px 12px;
    }
    .halftone--light {
      background-image: radial-gradient(circle, rgba(0,0,0,0.07) 2px, transparent 2px);
      background-size: 10px 10px;
    }

    /* ── Panel (section) base ── */
    .panel {
      position: relative;
      overflow: hidden;
      border-bottom: 5px solid var(--ink);
    }

    /* ── Masthead ── */
    .comic-masthead {
      background: var(--navy);
      border-bottom: 5px solid var(--ink);
      padding: 0.75rem 0;
    }
    .masthead-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .masthead-logo {
      height: 30px;
      width: auto;
    }
    .masthead-right {
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .masthead-issue {
      font-size: 0.85rem;
      letter-spacing: 0.12em;
      color: var(--orange);
    }
    .masthead-tagline {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.55);
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* ── HERO ── */
    .panel-hero {
      background: var(--orange);
      padding: 4rem 0 8rem;
    }
    .panel-hero-wrap {
      position: relative;
      z-index: 2;
    }
    .hero-left {
      max-width: 760px;
    }

    /* Speech bubble */
    .speech-bubble {
      display: inline-block;
      background: var(--white);
      border: 4px solid var(--ink);
      border-radius: 30px;
      padding: 0.65rem 1.6rem;
      position: relative;
      margin-bottom: 1.5rem;
      box-shadow: 3px 3px 0 var(--ink);
    }
    .speech-bubble span {
      font-size: 1.15rem;
      color: var(--navy);
    }
    .speech-bubble::after {
      content: '';
      position: absolute;
      bottom: -18px;
      left: 30px;
      width: 0; height: 0;
      border-left: 12px solid transparent;
      border-right: 16px solid transparent;
      border-top: 20px solid var(--ink);
    }
    .speech-bubble::before {
      content: '';
      position: absolute;
      bottom: -13px;
      left: 33px;
      width: 0; height: 0;
      border-left: 9px solid transparent;
      border-right: 13px solid transparent;
      border-top: 16px solid var(--white);
      z-index: 1;
    }

    .hero-headline {
      font-size: clamp(2.5rem, 6.5vw, 5.2rem);
      line-height: 0.95;
      color: var(--navy-deep);
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
      max-width: 700px;
    }
    .hero-sub {
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--navy);
      max-width: 580px;
      margin-bottom: 0.75rem;
      line-height: 1.55;
    }
    .hero-detail {
      font-size: 1rem;
      font-style: italic;
      color: var(--ink);
      opacity: 0.7;
      max-width: 560px;
      margin-bottom: 2rem;
    }

    /* CTA Button */
    .comic-btn {
      display: inline-block;
      background: var(--navy);
      color: var(--orange);
      font-size: 1.3rem;
      letter-spacing: 0.08em;
      padding: 1rem 2.5rem;
      border: 4px solid var(--ink);
      border-radius: 0;
      box-shadow: 6px 6px 0 var(--ink);
      text-decoration: none;
      position: relative;
      transition: transform 0.12s, box-shadow 0.12s;
      cursor: pointer;
    }
    .comic-btn:hover {
      transform: translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--ink);
      color: var(--orange-bright);
    }
    .comic-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 2px 2px 0 var(--ink);
    }

    /* Skyline */
    .skyline {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 160px;
      z-index: 1;
      background: var(--navy-deep);
      clip-path: polygon(
        0% 100%, 0% 70%,
        2% 70%, 2% 55%, 3.5% 55%, 3.5% 40%, 5% 40%, 5% 55%, 6% 55%, 6% 70%,
        7% 70%, 7% 45%, 8% 45%, 8% 30%, 9.5% 30%, 9.5% 20%, 10.5% 20%, 10.5% 35%, 11.5% 35%, 11.5% 50%, 13% 50%, 13% 65%,
        14% 65%, 14% 50%, 15% 50%, 15% 35%, 16.5% 35%, 16.5% 15%, 18% 15%, 18% 10%, 19% 10%, 19% 25%, 20% 25%, 20% 40%, 21.5% 40%, 21.5% 55%,
        23% 55%, 23% 40%, 24.5% 40%, 24.5% 25%, 26% 25%, 26% 45%, 27.5% 45%, 27.5% 60%,
        29% 60%, 29% 45%, 30% 45%, 30% 30%, 31.5% 30%, 31.5% 12%, 33% 12%, 33% 5%, 34% 5%, 34% 18%, 35.5% 18%, 35.5% 35%, 37% 35%, 37% 50%,
        38.5% 50%, 38.5% 38%, 40% 38%, 40% 55%, 42% 55%, 42% 42%, 43.5% 42%, 43.5% 28%, 45% 28%, 45% 15%, 46% 15%, 46% 8%, 47% 8%, 47% 22%, 48.5% 22%, 48.5% 38%,
        50% 38%, 50% 55%, 52% 55%, 52% 45%, 53.5% 45%, 53.5% 30%, 55% 30%, 55% 48%, 57% 48%, 57% 60%,
        59% 60%, 59% 50%, 60.5% 50%, 60.5% 35%, 62% 35%, 62% 20%, 63% 20%, 63% 10%, 64% 10%, 64% 25%, 65.5% 25%, 65.5% 42%, 67% 42%, 67% 55%,
        69% 55%, 69% 42%, 70.5% 42%, 70.5% 30%, 72% 30%, 72% 48%, 74% 48%, 74% 58%,
        76% 58%, 76% 45%, 77.5% 45%, 77.5% 32%, 79% 32%, 79% 18%, 80% 18%, 80% 8%, 81% 8%, 81% 22%, 82.5% 22%, 82.5% 38%, 84% 38%, 84% 52%,
        86% 52%, 86% 40%, 87.5% 40%, 87.5% 55%, 89% 55%, 89% 45%, 91% 45%, 91% 58%,
        93% 58%, 93% 48%, 94.5% 48%, 94.5% 35%, 96% 35%, 96% 50%, 98% 50%, 98% 65%,
        100% 65%, 100% 100%
      );
    }

    /* ── PROBLEM PANEL ── */
    .panel-problem {
      background: var(--orange);
      padding: 4rem 0;
    }

    .section-label {
      display: inline-block;
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      color: var(--navy);
      background: rgba(27,42,74,0.1);
      border: 3px solid var(--navy);
      padding: 0.3rem 1rem;
      margin-bottom: 1rem;
    }
    .section-label--dark {
      color: var(--orange);
      background: rgba(247,148,29,0.1);
      border-color: var(--orange);
    }
    .section-label--accent {
      color: var(--orange-deep);
      background: rgba(232,112,10,0.08);
      border-color: var(--orange-deep);
    }

    .comic-h2 {
      font-size: clamp(1.8rem, 4.5vw, 3rem);
      line-height: 1;
      color: var(--navy-deep);
      margin-bottom: 0.75rem;
      letter-spacing: -0.005em;
    }
    .comic-h2--light { color: var(--white); }

    .comic-body {
      font-size: 0.95rem;
      color: var(--ink);
      line-height: 1.6;
      opacity: 0.8;
    }
    .comic-body--light { color: rgba(255,255,255,0.7); }

    /* Stat cards */
    .stat-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
    .stat-card {
      background: var(--orange);
      border: 4px solid var(--ink);
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
      box-shadow: 5px 5px 0 var(--ink);
    }
    .stat-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(0,0,0,0.08) 2px, transparent 2px);
      background-size: 10px 10px;
      pointer-events: none;
    }
    .stat-card-number {
      font-size: clamp(2.2rem, 4vw, 3.2rem);
      line-height: 1;
      color: var(--navy-deep);
      margin-bottom: 0.3rem;
      position: relative;
    }
    .stat-plus {
      font-size: 0.65em;
      vertical-align: super;
    }
    .stat-card-title {
      font-size: 1rem;
      letter-spacing: 0.06em;
      color: var(--navy);
      margin-bottom: 0.35rem;
      position: relative;
    }
    .stat-card-body {
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--ink);
      opacity: 0.75;
      position: relative;
    }

    /* ── TEAM PANEL ── */
    .panel-team {
      background: var(--navy-deep);
      padding: 4rem 0;
    }
    .panel-team .skyline {
      display: none;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 0.9rem;
    }
    .service-card {
      background: var(--orange);
      border: 4px solid var(--ink);
      padding: 1.15rem;
      box-shadow: 4px 4px 0 var(--ink);
      position: relative;
      overflow: hidden;
    }
    .service-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(0,0,0,0.06) 1.5px, transparent 1.5px);
      background-size: 8px 8px;
      pointer-events: none;
    }
    .service-card h3 {
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      color: var(--navy-deep);
      margin-bottom: 0.35rem;
      position: relative;
    }
    .service-card p {
      font-size: 0.75rem;
      line-height: 1.45;
      color: var(--ink);
      opacity: 0.75;
      position: relative;
    }

    /* ── WHY PANEL ── */
    .panel-why {
      background: var(--orange);
      padding: 4rem 0;
    }

    /* Stat bubbles */
    .bubble-row {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }
    .stat-bubble {
      background: var(--white);
      border: 4px solid var(--ink);
      border-radius: 50%;
      width: 140px;
      height: 140px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      box-shadow: 4px 4px 0 var(--ink);
      padding: 0.5rem;
    }
    .stat-bubble strong {
      font-size: 1.65rem;
      color: var(--navy-deep);
      line-height: 1.1;
      display: block;
    }
    .stat-bubble span {
      font-size: 0.65rem;
      font-weight: 600;
      color: var(--ink);
      opacity: 0.65;
      line-height: 1.25;
      margin-top: 0.2rem;
    }

    /* Speech cards */
    .speech-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    .speech-card {
      position: relative;
    }
    .speech-card-inner {
      background: var(--white);
      border: 4px solid var(--ink);
      border-radius: 20px;
      padding: 1.5rem;
      position: relative;
      box-shadow: 4px 4px 0 var(--ink);
    }
    .speech-card-tail {
      position: relative;
      margin-left: 30px;
      width: 0; height: 0;
      border-left: 14px solid transparent;
      border-right: 18px solid transparent;
      border-top: 22px solid var(--ink);
    }
    .speech-card-tail::after {
      content: '';
      position: absolute;
      top: -26px;
      left: -10px;
      width: 0; height: 0;
      border-left: 11px solid transparent;
      border-right: 15px solid transparent;
      border-top: 19px solid var(--white);
    }
    .speech-card h3 {
      font-family: 'Anton', 'Impact', sans-serif;
      text-transform: uppercase;
      font-size: 1.05rem;
      letter-spacing: 0.03em;
      color: var(--navy-deep);
      margin-bottom: 0.5rem;
    }
    .speech-card p {
      font-size: 0.85rem;
      line-height: 1.55;
      color: #444;
    }
    .speech-card p strong {
      color: var(--navy);
    }

    /* ── BOOKING PANEL ── */
    .panel-book {
      background: var(--paper);
      padding: 4rem 0;
      border-bottom: none;
    }
    .text-pop {
      color: var(--orange-deep);
      position: relative;
    }
