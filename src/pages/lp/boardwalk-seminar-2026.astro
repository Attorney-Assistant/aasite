  <!-- ═══════════════════════════════════════
       STYLES — TRUE COMIC BOOK AESTHETIC
       ═══════════════════════════════════════ -->
  <style is:global>
    /* ── Reset & Page Wrapper ── */
    .comic-page {
      --orange: #F7941D;
      --orange-bright: #FBB03B;
      --orange-deep: #E8700A;
      --navy: #1B2A4A;
      --navy-deep: #0F1B33;
      --ink: #111111;
      --paper: #FFF9EE;
      --white: #FFFFFF;

      font-family: 'DM Sans', 'Segoe UI', sans-serif;
      color: var(--ink);
      line-height: 1.5;
      overflow-x: hidden;
      background: var(--paper);
    }

    /* ── Comic Typography ── */
    @import url('https://fonts.googleapis.com/css2?family=Anton&family=Bangers&family=DM+Sans:wght@400;500;700&display=swap');

    .comic-page h1,
    .comic-page h2,
    .comic-page h3,
    .comic-h2,
    .hero-headline,
    .stat-card-number,
    .stat-card-title,
    .service-card h3,
    .speech-card h3,
    .section-label,
    .comic-btn,
    .comic-tagline,
    .masthead-issue {
      font-family: 'Anton', 'Impact', 'Arial Black', sans-serif;
      text-transform: uppercase;
    }

    .speech-bubble span,
    .stat-bubble strong {
      font-family: 'Bangers', cursive;
      letter-spacing: 0.04em;
    }

    /* ── Layout ── */
    .comic-wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 1.5rem;
      position: relative;
      z-index: 2;
    }

    /* ── Halftone Pattern ── */
    .halftone {
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image: radial-gradient(circle, rgba(0,0,0,0.13) 2.2px, transparent 2.2px);
      background-size: 12px 12px;
    }
    .halftone--light {
      background-image: radial-gradient(circle, rgba(0,0,0,0.07) 2px, transparent 2px);
      background-size: 10px 10px;
    }

    /* ── Panel (section) base ── */
    .panel {
      position: relative;
      overflow: hidden;
      border-bottom: 5px solid var(--ink);
    }

    /* ── Masthead ── */
    .comic-masthead {
      background: var(--navy);
      border-bottom: 5px solid var(--ink);
      padding: 0.75rem 0;
    }
    .masthead-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .masthead-logo {
      height: 30px;
      width: auto;
    }
    .masthead-right {
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .masthead-issue {
      font-size: 0.85rem;
      letter-spacing: 0.12em;
      color: var(--orange);
    }
    .masthead-tagline {
      font-size: 0.72rem;
      color: rgba(255,255,255,0.55);
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* ── HERO ── */
    .panel-hero {
      background: var(--orange);
      padding: 4rem 0 8rem;
    }
    .panel-hero-wrap {
      position: relative;
      z-index: 2;
    }
    .hero-left {
      max-width: 760px;
    }

    /* Speech bubble */
    .speech-bubble {
      display: inline-block;
      background: var(--white);
      border: 4px solid var(--ink);
      border-radius: 30px;
      padding: 0.65rem 1.6rem;
      position: relative;
      margin-bottom: 1.5rem;
      box-shadow: 3px 3px 0 var(--ink);
    }
    .speech-bubble span {
      font-size: 1.15rem;
      color: var(--navy);
    }
    .speech-bubble::after {
      content: '';
      position: absolute;
      bottom: -18px;
      left: 30px;
      width: 0; height: 0;
      border-left: 12px solid transparent;
      border-right: 16px solid transparent;
      border-top: 20px solid var(--ink);
    }
    .speech-bubble::before {
      content: '';
      position: absolute;
      bottom: -13px;
      left: 33px;
      width: 0; height: 0;
      border-left: 9px solid transparent;
      border-right: 13px solid transparent;
      border-top: 16px solid var(--white);
      z-index: 1;
    }

    .hero-headline {
      font-size: clamp(2.5rem, 6.5vw, 5.2rem);
      line-height: 0.95;
      color: var(--navy-deep);
      margin-bottom: 1.25rem;
      letter-spacing: -0.01em;
      max-width: 700px;
    }
    .hero-sub {
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--navy);
      max-width: 580px;
