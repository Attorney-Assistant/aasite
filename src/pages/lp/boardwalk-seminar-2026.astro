---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Audit My Intake — Boardwalk Seminar 2026 | Attorney Assistant"
  description="Met us at the Boardwalk Seminar? Book your free intake audit. We'll diagnose the gaps costing your firm cases and show you exactly what to fix."
  noindex={true}
>

