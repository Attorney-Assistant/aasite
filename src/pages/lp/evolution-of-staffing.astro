      bottom: -0.5rem;
      width: 2px;
      background: linear-gradient(to bottom, rgba(249,166,48,0.3), rgba(249,166,48,0.05));
    }
    .evo-story-beat:last-child .evo-story-line { display: none; }
    .evo-story-beat:last-child .evo-story-dot {
      width: 14px;
      height: 14px;
      left: -2px;
      box-shadow: 0 0 0 6px rgba(249, 166, 48, 0.2);
    }

    /* Shift cards */
    .evo-shift-card {
