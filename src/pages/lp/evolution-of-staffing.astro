    /* ── Page-specific animations ── */

    /* Floating orbs */
    .evo-float { animation: evoFloat 8s ease-in-out infinite; }
    .evo-float-delayed { animation: evoFloat 8s ease-in-out 4s infinite; }
    @keyframes evoFloat {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-30px) scale(1.05); }
    }

    /* Hero staggered fade-ups (no IntersectionObserver needed — immediate on load) */
    .evo-fade-up {
      opacity: 0;
      transform: translateY(24px);
      animation: evoFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .evo-d1 { animation-delay: 0.15s; }
    .evo-d2 { animation-delay: 0.3s; }
    .evo-d3 { animation-delay: 0.45s; }
    .evo-d4 { animation-delay: 0.6s; }
    @keyframes evoFadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    /* Story timeline beats */
    .evo-story-beat {
      position: relative;
      padding-left: 0;
      padding-bottom: 0.5rem;
    }
    .evo-story-dot {
      position: absolute;
      left: 0;
      top: 0.45rem;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #F9A630;
      box-shadow: 0 0 0 4px rgba(249, 166, 48, 0.15);
      z-index: 1;
    }
    .evo-story-line {
      position: absolute;
      left: 4px;
