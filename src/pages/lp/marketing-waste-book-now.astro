---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Book Your Marketing Waste Review | Attorney Assistant"
  description="Schedule a call to review your marketing waste audit results or request a secret shopper to test your firm's intake process."
  noindex={true}
  schema={{
    "@type": "WebPage",
    "name": "Book Your Marketing Waste Review",
    "description": "Schedule a call to review your marketing waste audit or secret shop your intake.",
    "publisher": {
      "@type": "Organization",
      "name": "Attorney Assistant"
    }
  }}
>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gray-900">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-gray-900 to-brand-800"></div>
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10 py-20 lg:py-28">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal">
          <span class="badge bg-white/10 text-white/80 border-white/10 mb-4">Free Consultation</span>
          <h1 class="text-display-lg md:text-display-xl font-heading text-white leading-tight mb-6">
            Stop Wasting<br />
            <span class="text-gradient-gold">Marketing Dollars.</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-8 leading-relaxed">
            Book a call and we'll either walk through your marketing waste audit results together, or send a secret shopper to test your firm's intake process &mdash; your choice.
          </p>

          <!-- Two options -->
          <div class="space-y-4 mb-8">
            <div class="flex items-start gap-4 p-4 rounded-xl border border-white/10 bg-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/15 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
              </div>
              <div>
                <p class="text-sm font-heading text-white">Review Your Marketing Waste Audit</p>
                <p class="text-xs text-gray-400 mt-0.5">We'll walk through your results, identify the biggest leaks, and show you exactly how to fix them.</p>
              </div>
            </div>

            <div class="flex items-start gap-4 p-4 rounded-xl border border-white/10 bg-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-blue/15 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-blue" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
              </div>
              <div>
                <p class="text-sm font-heading text-white">Secret Shopper Test</p>
                <p class="text-xs text-gray-400 mt-0.5">We'll have a specialist pose as a prospective client and test your firm's intake &mdash; then report back with exactly what happened.</p>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-400">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Free &mdash; no commitment
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              30-minute call
            </span>
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Actionable next steps
            </span>
          </div>
        </div>

        <!-- Booking Widget -->
        <div class="bg-white rounded-2xl p-6 md:p-8 shadow-2xl reveal" style="transition-delay: 150ms" id="book-now">
          <div class="flex items-center gap-3 mb-4">
            <div class="featured-icon featured-icon-md featured-icon-gold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
            </div>
            <div>
              <h2 class="text-xl font-heading text-gray-900">Pick a Time</h2>
              <p class="text-sm text-gray-500">Free &mdash; 30 minutes</p>
            </div>
          </div>
          <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/rr?embed=true&parentPageBackgroundColor=ffffff"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-navy via-brand-800 to-brand-navy grain-overlay">
    <div class="absolute inset-0">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-brand-gold/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-1/3 w-80 h-80 bg-brand-blue/15 rounded-full blur-3xl"></div>
    </div>
    <div class="container-wide relative py-16 md:py-20">
      <div class="max-w-2xl mx-auto text-center reveal">
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          Your Marketing Budget Deserves Better
        </h2>
        <div class="divider-gold-center mb-6"></div>
        <p class="text-lg text-white/60 mb-8">
          Every day without fixing these gaps is another day of wasted spend. Book your free call now.
        </p>
        <a href="#book-now" class="btn-primary btn-lg group inline-flex">
          Book Your Call
          <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- HubSpot Meetings Embed Script -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p><p style="margin:0.75rem 0 0;font-size:0.8rem;">If you are seeking employment, please visit <a href="/careers" style="color:#f9a62d;text-decoration:underline;">attorneyassistant.com/careers</a> or email <a href="mailto:talent@attorneyassistant.com" style="color:#f9a62d;text-decoration:underline;">talent@attorneyassistant.com</a></p></div>';
        });
      }
    });
    </script>

  <style>
    .meetings-iframe-container iframe {
      background: #ffffff !important;
    }
  </style>

</BaseLayout>
