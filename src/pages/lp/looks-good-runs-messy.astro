  <!-- Count-up animation script -->
  <script is:inline>
  (function() {
    var counted = false;
    function countUp() {
      if (counted) return;
      counted = true;
      document.querySelectorAll('.lp-count').forEach(function(el) {
        var target = parseInt(el.getAttribute('data-target'), 10);
        var duration = 1500;
        var start = 0;
        var startTime = null;
        function step(timestamp) {
          if (!startTime) startTime = timestamp;
          var progress = Math.min((timestamp - startTime) / duration, 1);
          var eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target);
          if (progress < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }
    if ('IntersectionObserver' in window) {
      var el = document.querySelector('.lp-count');
      if (el) {
        new IntersectionObserver(function(entries) {
          if (entries[0].isIntersecting) countUp();
        }, { threshold: 0.5 }).observe(el);
      }
    } else {
      countUp();
    }
  })();
  </script>

  <!-- Toggle script -->
  <script is:inline>
  (function() {
    var btnBefore = document.getElementById('toggle-before');
    var btnAfter = document.getElementById('toggle-after');
    var slider = document.getElementById('toggle-slider');
    var panelBefore = document.getElementById('panel-before');
    var panelAfter = document.getElementById('panel-after');
    var bgBefore = document.getElementById('toggle-bg-before');
    var bgAfter = document.getElementById('toggle-bg-after');

    function positionSlider(btn) {
      slider.style.left = btn.offsetLeft + 'px';
      slider.style.width = btn.offsetWidth + 'px';
    }

    // Set initial position after layout
    requestAnimationFrame(function() { positionSlider(btnBefore); });
    window.addEventListener('resize', function() {
      var activeBtn = btnBefore.classList.contains('lp-toggle-btn--active') ? btnBefore : btnAfter;
      positionSlider(activeBtn);
    });

    function showBefore() {
      btnBefore.classList.add('lp-toggle-btn--active');
      btnAfter.classList.remove('lp-toggle-btn--active');
      slider.classList.remove('is-after');
      positionSlider(btnBefore);
      panelBefore.classList.add('lp-toggle-panel--visible');
      panelAfter.classList.remove('lp-toggle-panel--visible');
      bgBefore.classList.remove('inactive');
      bgAfter.classList.remove('active');
    }

    function showAfter() {
      btnAfter.classList.add('lp-toggle-btn--active');
      btnBefore.classList.remove('lp-toggle-btn--active');
      slider.classList.add('is-after');
      positionSlider(btnAfter);
      panelAfter.classList.add('lp-toggle-panel--visible');
      panelBefore.classList.remove('lp-toggle-panel--visible');
      bgBefore.classList.add('inactive');
      bgAfter.classList.add('active');
    }

    btnBefore.addEventListener('click', showBefore);
    btnAfter.addEventListener('click', showAfter);
  })();
  </script>

