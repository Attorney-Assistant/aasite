---
import ComicCampaignLayout from "@layouts/ComicCampaignLayout.astro";
---

<ComicCampaignLayout
  title="Mail, Data Entry, and File Openings Are Crushing Your Team | Attorney Assistant"
  description="We rescue your attorneys from admin so they can get back to lawyering. Deploy Attorney Assistant's elite back-office support."
  image="/images/lp/admin-header.jpg"
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="cmc-hero relative overflow-hidden min-h-[60vh] md:min-h-[70vh] flex items-center">
    <!-- Background image -->
    <picture class="absolute inset-0 z-0 block">
      <source srcset="/images/lp/admin-header.webp" type="image/webp" />
      <img src="/images/lp/admin-header.jpg" alt="" aria-hidden="true" class="w-full h-full object-cover" width="1920" height="1080" loading="eager" fetchpriority="high" />
    </picture>
    <!-- Slight dark overlay for text legibility -->
    <div class="absolute inset-0 z-[1]" aria-hidden="true" style="background: linear-gradient(to bottom, rgba(10,22,40,0.55) 0%, rgba(10,22,40,0.55) 60%, rgba(10,22,40,1) 100%);"></div>
    <!-- Atmospheric glow orbs (above the overlay) -->
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-brand-gold/[0.06] rounded-full blur-[150px] z-[2]" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-brand-blue/[0.05] rounded-full blur-[120px] z-[2]" aria-hidden="true"></div>

    <div class="comic-container relative z-10 py-16 md:py-24 w-full">
      <div class="text-center reveal">
        <h1 class="comic-title text-4xl md:text-6xl lg:text-7xl text-white leading-none mb-4" style="text-shadow: 0 4px 24px rgba(10,22,40,0.85);">
          Admin crushing your team? <br/><span class="comic-gold">We rescue law firms with elite staffing + AI solutions.</span>
        </h1>
        <p class="comic-sub text-lg md:text-xl text-gray-100 font-semibold max-w-2xl mx-auto mb-8" style="text-shadow: 0 2px 12px rgba(10,22,40,0.8);">
          Mail, data entry, file openings, scheduling &mdash; your attorneys are drowning in work that doesn't require a law degree. Scroll to see the damage.
        </p>
        <a href="#book-now" class="cmc-btn cmc-btn--gold group inline-flex">
          Deploy Attorney Assistant
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/[0.04] rounded-full blur-[120px]"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14">
        <span class="comic-pow comic-pow--red mb-4 inline-block">THE TIMELINE!</span>
        <h2 class="comic-section-title mb-4">
          How Admin Work <span class="comic-gold">Buries Your Attorneys</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">15+ hours per attorney, per week. Here's where it goes.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        <div class="comic-panel cmc-timeline-panel reveal">
          <div class="cmc-panel-header cmc-panel-header--gold">
            <span class="cmc-panel-num">01</span>
            <span class="cmc-panel-day">8:30 AM</span>
          </div>
          <div class="p-5">
            <h3 class="comic-title text-xl text-white mb-2">Inbox Avalanche</h3>
            <p class="text-sm text-gray-400">47 emails. Half need action. Your attorney spends 45 minutes sorting instead of preparing for court.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel reveal" style="transition-delay: 100ms">
          <div class="cmc-panel-header cmc-panel-header--amber">
            <span class="cmc-panel-num">02</span>
            <span class="cmc-panel-day">10:00 AM</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--amber text-xs mb-2 inline-block">BURIED!</span>
            <h3 class="comic-title text-xl text-white mb-2">File Openings Stack Up</h3>
            <p class="text-sm text-gray-400">6 new matters waiting to be opened. Conflict checks, engagement letters, CRM entries &mdash; all manual, all on the paralegal who's already maxed out.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel reveal" style="transition-delay: 200ms">
          <div class="cmc-panel-header cmc-panel-header--red">
            <span class="cmc-panel-num">03</span>
            <span class="cmc-panel-day">1:00 PM</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--red text-xs mb-2 inline-block">CRUSHED!</span>
            <h3 class="comic-title text-xl text-white mb-2">Data Entry Piles Up</h3>
            <p class="text-sm text-gray-400">Case notes, status updates, billing entries, document indexing. Nobody's current. The CRM is two weeks behind reality.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel reveal" style="transition-delay: 300ms">
          <div class="cmc-panel-header cmc-panel-header--red">
            <span class="cmc-panel-num">04</span>
            <span class="cmc-panel-day">3:00 PM</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--red text-xs mb-2 inline-block">STALLED!</span>
            <h3 class="comic-title text-xl text-white mb-2">Mail &amp; Docs Sit Unprocessed</h3>
            <p class="text-sm text-gray-400">Physical mail scanned but not filed. Documents received but not indexed. Discovery responses waiting for someone to prep them.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel md:col-span-2 lg:col-span-2 reveal" style="transition-delay: 400ms">
          <div class="cmc-panel-header cmc-panel-header--gold">
            <span class="cmc-panel-num">05</span>
            <span class="cmc-panel-day">5:00 PM</span>
          </div>
          <div class="p-6">
            <span class="comic-pow comic-pow--gold text-sm mb-3 inline-block">KA-BOOM!</span>
            <h3 class="comic-title text-2xl md:text-3xl comic-gold mb-2">Your $400/hr Attorney Spent the Day Doing $15/hr Work.</h3>
            <p class="text-base text-gray-400">No depositions prepped. No case strategy. No client calls. Just admin. And tomorrow it starts again.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#111b2e]/50 to-transparent"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="comic-pow comic-pow--amber mb-4 inline-block">CHOOSE!</span>
        <h2 class="comic-section-title mb-4">
          Who's Handling the <span class="comic-gold">Back Office?</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">Pick the one that's closest to your firm.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 max-w-4xl mx-auto" id="cma-paths">
        <button class="cmc-path-card reveal" data-path="attorneys">
          <span class="comic-pow comic-pow--red text-xs mb-3 inline-block">POW!</span>
          <h3 class="comic-title text-2xl text-white mb-2">The Attorneys</h3>
          <p class="text-sm text-gray-400">They do their own scheduling, filing, and data entry because "it's faster than explaining it."</p>
        </button>

        <button class="cmc-path-card reveal" data-path="paralegal" style="transition-delay: 100ms">
          <span class="comic-pow comic-pow--amber text-xs mb-3 inline-block">BAM!</span>
          <h3 class="comic-title text-2xl text-white mb-2">One Overwhelmed Paralegal</h3>
          <p class="text-sm text-gray-400">They're doing the work of three people. Quality is slipping and they're thinking about quitting.</p>
        </button>

        <button class="cmc-path-card reveal" data-path="nobody" style="transition-delay: 200ms">
          <span class="comic-pow comic-pow--blue text-xs mb-3 inline-block">ZAP!</span>
          <h3 class="comic-title text-2xl text-white mb-2">Nobody, Really</h3>
          <p class="text-sm text-gray-400">It gets done when it gets done. Files are incomplete, data is stale, things slip.</p>
        </button>
      </div>

      <div id="cma-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="comic-panel p-8 text-center" style="border-color: rgba(249,166,48,0.4);">
          <p class="comic-eyebrow mb-3" id="cma-consequence-label"></p>
          <p class="comic-title text-2xl md:text-3xl text-white mb-3" id="cma-consequence-title"></p>
          <p class="text-base text-gray-400 leading-relaxed" id="cma-consequence-body"></p>
          <a href="#book-now" class="cmc-btn cmc-btn--gold group inline-flex mt-6">
            Deploy the Fix
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/[0.06] rounded-full blur-[120px]"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="comic-pow comic-pow--blue mb-4 inline-block">VS!</span>
        <h2 class="comic-section-title mb-4">
          Your Back Office <span class="comic-gold">vs. Ours</span>
        </h2>
      </div>

      <div class="flex justify-center mb-10 reveal">
        <div class="inline-flex rounded-lg border-2 border-white/15 bg-white/5 p-1">
          <button class="cmc-toggle cmc-toggle--active" id="cma-toggle-before">
            <span class="comic-pow comic-pow--red text-[10px] mr-1.5">&#10005;</span> Your Back Office
          </button>
          <button class="cmc-toggle" id="cma-toggle-after">
            <span class="comic-pow comic-pow--gold text-[10px] mr-1.5">&#10003;</span> With Us
          </button>
        </div>
      </div>

      <div id="cma-panel-before" class="cmc-compare-panel max-w-4xl mx-auto reveal">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Attorneys do their own admin</p><p class="text-white/40 text-xs mt-0.5">$400/hr lawyers sorting mail and entering data</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">File openings take days</p><p class="text-white/40 text-xs mt-0.5">New matters sit in a queue while the team catches up</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">CRM is weeks behind</p><p class="text-white/40 text-xs mt-0.5">Case notes, statuses, and contacts are stale or missing</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Documents pile up unprocessed</p><p class="text-white/40 text-xs mt-0.5">Mail scanned but not filed. Discovery waiting to be prepped.</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Staff burning out</p><p class="text-white/40 text-xs mt-0.5">Everyone's doing too much. Turnover is constant.</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">No capacity to grow</p><p class="text-white/40 text-xs mt-0.5">Can't take more cases because the back office can't keep up</p></div></div>
        </div>
      </div>

      <div id="cma-panel-after" class="cmc-compare-panel max-w-4xl mx-auto" style="display:none">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">Attorneys back to lawyering</p><p class="text-white/40 text-xs mt-0.5">Depositions, strategy, client work &mdash; the stuff they went to law school for</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">File openings same-day</p><p class="text-white/40 text-xs mt-0.5">New matters opened, conflicts cleared, CRM updated immediately</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">CRM always current</p><p class="text-white/40 text-xs mt-0.5">Data entry, status updates, and notes handled daily by your VA</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">Documents processed on arrival</p><p class="text-white/40 text-xs mt-0.5">Mail sorted, scanned, filed, indexed. Nothing sits.</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">Team breathing room</p><p class="text-white/40 text-xs mt-0.5">Low-leverage work offloaded. Morale up. Turnover down.</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">Ready to scale</p><p class="text-white/40 text-xs mt-0.5">Back office keeps pace with caseload. Grow without the growing pains.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative py-16 md:py-24 overflow-hidden" id="book-now">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#111b2e] to-[#0a1628]"></div>
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>

    <div class="comic-container relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="comic-pow comic-pow--gold text-lg mb-4 inline-block px-6 py-1">DEPLOY!</span>
          <h2 class="comic-section-title mb-4">
            Get Your Attorneys <span class="comic-gold">Back to Lawyering</span>
          </h2>
          <p class="text-lg text-gray-400 max-w-xl mx-auto">Book a quick call. We'll show you exactly which admin tasks to offload first &mdash; no commitment.</p>
        </div>

        <div class="comic-panel p-1 reveal scroll-mt-20" style="border-color: rgba(249,166,48,0.3); transition-delay: 150ms">
          <div class="bg-white rounded-[9px] p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/comic?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-500 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Free &mdash; no commitment
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            15 minutes
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid rgba(255,255,255,0.1);border-radius:0.75rem;background:rgba(255,255,255,0.03);"><p style="margin:0;color:#94a3b8;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }
    .cmc-hero { padding-bottom: 0; }
    .cmc-btn { display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; border: none; cursor: pointer; transition: all 0.3s; text-decoration: none; }
    .cmc-btn--gold { background: linear-gradient(135deg, #F9A630, #e8901a); color: #0a1628; box-shadow: 0 4px 20px rgba(249,166,48,0.3); }
    .cmc-btn--gold:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(249,166,48,0.4); }
    .cmc-timeline-panel { transition: transform 0.3s, box-shadow 0.3s; }
    .cmc-timeline-panel:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
    .cmc-panel-header { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .cmc-panel-header--gold { background: rgba(249,166,48,0.08); }
    .cmc-panel-header--amber { background: rgba(245,158,11,0.08); }
    .cmc-panel-header--red { background: rgba(239,68,68,0.08); }
    .cmc-panel-num { font-family: 'Bangers', cursive; font-size: 1.5rem; color: rgba(255,255,255,0.2); }
    .cmc-panel-day { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); }
    .cmc-path-card { text-align: center; padding: 2rem 1.5rem; border: 3px solid rgba(255,255,255,0.1); border-radius: 12px; background: rgba(255,255,255,0.03); backdrop-filter: blur(4px); cursor: pointer; transition: all 0.3s; }
    .cmc-path-card:hover { border-color: rgba(249,166,48,0.4); transform: translateY(-4px); }
    .cmc-path-card.cmc-path-card--active { border-color: #F9A630; background: rgba(249,166,48,0.06); box-shadow: 0 0 0 3px rgba(249,166,48,0.15), 0 12px 40px rgba(0,0,0,0.3); }
    .cmc-toggle { display: inline-flex; align-items: center; padding: 0.625rem 1.25rem; border-radius: 6px; font-family: 'Sora', sans-serif; font-size: 0.8125rem; font-weight: 700; color: rgba(255,255,255,0.5); background: transparent; border: none; cursor: pointer; transition: all 0.3s; }
    .cmc-toggle--active { background: #F9A630; color: #0a1628; }
    .cmc-item { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem; border-radius: 10px; border: 2px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02); transition: border-color 0.3s; }
    .cmc-item--bad:hover { border-color: rgba(239,68,68,0.3); }
    .cmc-item--good:hover { border-color: rgba(16,185,129,0.3); }
    .cmc-item-icon { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem; flex-shrink: 0; }
    .cmc-item-icon--red { background: rgba(239,68,68,0.15); color: #ef4444; }
    .cmc-item-icon--green { background: rgba(16,185,129,0.15); color: #10b981; }
    .cmc-compare-panel { animation: cmaPanelIn 0.4s ease; }
    @keyframes cmaPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .cmc-timeline-panel, .cmc-path-card, .cmc-btn, .cmc-item { transition: none !important; } .cmc-compare-panel { animation: none !important; } }
  </style>

  <script is:inline>
    (function() {
      var consequences = {
        attorneys: {
          label: 'Expensive Admin',
          title: 'Every hour your attorney spends on admin is an hour of billable work — or case strategy — that doesn\'t happen.',
          body: 'At $400/hr, an attorney spending 15 hours a week on admin represents $6,000 in lost productivity every single week. That\'s $312,000 a year per attorney. A trained VA handles that work for a fraction of the cost and frees your lawyers to do what they were hired to do.'
        },
        paralegal: {
          label: 'The Breaking Point',
          title: 'Your best paralegal is one bad week away from updating their LinkedIn.',
          body: 'When one person carries the admin load for the entire firm, quality drops, deadlines get tight, and burnout is inevitable. You don\'t need to hire another full-time paralegal — you need to offload the repetitive work so your existing team can focus on the high-value tasks only they can do.'
        },
        nobody: {
          label: 'Death by Default',
          title: 'When nobody owns the back office, everything is always almost done but never actually done.',
          body: 'Files half-opened. Data half-entered. Documents half-filed. The firm looks busy but nothing is truly complete. That compounding incompleteness creates errors, missed deadlines, and client experiences that erode trust. You need a person whose entire job is keeping the operational engine running.'
        }
      };

      document.querySelectorAll('.cmc-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;
          document.querySelectorAll('.cmc-path-card').forEach(function(c) { c.classList.remove('cmc-path-card--active'); });
          this.classList.add('cmc-path-card--active');
          document.getElementById('cma-consequence-label').textContent = data.label;
          document.getElementById('cma-consequence-title').textContent = data.title;
          document.getElementById('cma-consequence-body').textContent = data.body;
          var panel = document.getElementById('cma-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none'; panel.offsetHeight;
          panel.style.animation = 'cmaPanelIn 0.4s ease';
        });
      });

      var beforeBtn = document.getElementById('cma-toggle-before');
      var afterBtn = document.getElementById('cma-toggle-after');
      var beforePanel = document.getElementById('cma-panel-before');
      var afterPanel = document.getElementById('cma-panel-after');
      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('cmc-toggle--active');
          afterBtn.classList.remove('cmc-toggle--active');
          beforePanel.style.display = 'block'; afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none'; beforePanel.offsetHeight;
          beforePanel.style.animation = 'cmaPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('cmc-toggle--active');
          beforeBtn.classList.remove('cmc-toggle--active');
          afterPanel.style.display = 'block'; beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none'; afterPanel.offsetHeight;
          afterPanel.style.animation = 'cmaPanelIn 0.4s ease';
        });
      }
    })();
  </script>

  <script is:inline>
        window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'lp_view', lp_name: 'comic-admin' });
  </script>

</ComicCampaignLayout>
