---
import ComicCampaignLayout from "@layouts/ComicCampaignLayout.astro";
---

<ComicCampaignLayout
  title="120 Days for Records Is Killing Your Settlements | Attorney Assistant"
  description="Stop losing settlements to slow medical records. Deploy Attorney Assistant — records delivered in 30 days, not 120."
  image="/images/comic-medical-record-landingpage.png"
>

  <!-- ═══════════════════════════════════════════
       HERO — Comic splash panel
  ═══════════════════════════════════════════ -->
  <section class="cmc-hero relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a1628] via-[#0f1d32] to-[#0a1628]"></div>
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-brand-gold/[0.06] rounded-full blur-[150px]" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-brand-blue/[0.05] rounded-full blur-[120px]" aria-hidden="true"></div>

    <div class="comic-container relative z-10 py-12 md:py-16">
      <!-- Top bar -->
      <div class="flex items-center justify-between mb-8 reveal">
        <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="h-8 md:h-10 w-auto" />
        <span class="comic-eyebrow hidden sm:block">Issue №01 · Medical Records</span>
      </div>

      <!-- Hero image panel -->
      <div class="comic-panel p-0 mb-10 reveal" style="border-width: 4px;">
        <img
          src="/images/comic-medical-record-landingpage.png"
          alt="Problem: 120 days for records is killing your settlements. Solution: Deploy Attorney Assistant — records delivered in 30 days."
          class="w-full h-auto block rounded-[9px]"
          width="1200"
          height="600"
          loading="eager"
        />
      </div>

      <!-- Headline under image -->
      <div class="text-center reveal" style="transition-delay: 150ms">
        <h1 class="comic-title text-4xl md:text-6xl lg:text-7xl text-white leading-none mb-4">
          Medical record problem? <br/><span class="comic-gold">We fix that.</span>
        </h1>
        <p class="comic-sub text-lg md:text-xl text-gray-300 font-semibold max-w-2xl mx-auto mb-8">
          Your settlements are dying in a records queue. Scroll to see the damage &mdash; then deploy the fix.
        </p>
        <a href="#book-now" class="cmc-btn cmc-btn--gold group inline-flex">
          Deploy Attorney Assistant
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE (Comic Panels)
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/[0.04] rounded-full blur-[120px]"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="comic-pow comic-pow--red mb-4 inline-block">THE TIMELINE!</span>
        <h2 class="comic-section-title mb-4">
          This Is What Happens to <span class="comic-gold">Your Records</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">Every week. On repeat. Panel by panel.</p>
      </div>

      <!-- Comic panel timeline -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        <div class="comic-panel cmc-timeline-panel reveal" style="transition-delay: 0ms">
          <div class="cmc-panel-header cmc-panel-header--gold">
            <span class="cmc-panel-num">01</span>
            <span class="cmc-panel-day">Day 1</span>
          </div>
          <div class="p-5">
            <h3 class="comic-title text-xl text-white mb-2">Request Sent</h3>
            <p class="text-sm text-gray-400">Your paralegal sends the records request. Fax, mail, or portal. Clock starts.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel reveal" style="transition-delay: 100ms">
          <div class="cmc-panel-header cmc-panel-header--amber">
            <span class="cmc-panel-num">02</span>
            <span class="cmc-panel-day">Week 2</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--amber text-xs mb-2 inline-block">CRICKETS!</span>
            <h3 class="comic-title text-xl text-white mb-2">Radio Silence</h3>
            <p class="text-sm text-gray-400">Nothing arrived. Voicemails ignored. Added to the follow-up pile that never shrinks.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel reveal" style="transition-delay: 200ms">
          <div class="cmc-panel-header cmc-panel-header--red">
            <span class="cmc-panel-num">03</span>
            <span class="cmc-panel-day">Week 4</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--red text-xs mb-2 inline-block">INCOMPLETE!</span>
            <h3 class="comic-title text-xl text-white mb-2">Half the Pages</h3>
            <p class="text-sm text-gray-400">Records arrive missing imaging, wrong date range, no surgical notes. Back to square one.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel reveal" style="transition-delay: 300ms">
          <div class="cmc-panel-header cmc-panel-header--red">
            <span class="cmc-panel-num">04</span>
            <span class="cmc-panel-day">Week 6</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--red text-xs mb-2 inline-block">STALLED!</span>
            <h3 class="comic-title text-xl text-white mb-2">Case Goes Cold</h3>
            <p class="text-sm text-gray-400">Can't evaluate. Can't negotiate. Can't move forward. Client starts calling.</p>
          </div>
        </div>

        <div class="comic-panel cmc-timeline-panel md:col-span-2 lg:col-span-2 reveal" style="transition-delay: 400ms">
          <div class="cmc-panel-header cmc-panel-header--gold">
            <span class="cmc-panel-num">05</span>
            <span class="cmc-panel-day">Week 8+</span>
          </div>
          <div class="p-6">
            <span class="comic-pow comic-pow--gold text-sm mb-3 inline-block">KA-BOOM!</span>
            <h3 class="comic-title text-2xl md:text-3xl comic-gold mb-2">Multiply This by Every Open Case.</h3>
            <p class="text-base text-gray-400">It's not one record. It's the compounding drag on your entire caseload, your settlements, and your sanity.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH (Comic cards)
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#111b2e]/50 to-transparent"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="comic-pow comic-pow--amber mb-4 inline-block">CHOOSE!</span>
        <h2 class="comic-section-title mb-4">
          How Does Your Firm Handle <span class="comic-gold">Medical Records?</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">Pick your path. We won't judge.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 max-w-4xl mx-auto" id="cmc-paths">
        <button class="cmc-path-card reveal" data-path="inhouse" style="transition-delay: 0ms">
          <span class="comic-pow comic-pow--red text-xs mb-3 inline-block">POW!</span>
          <h3 class="comic-title text-2xl text-white mb-2">In-House</h3>
          <p class="text-sm text-gray-400">Paralegals handle it all. Requests, follow-ups, tracking.</p>
        </button>

        <button class="cmc-path-card reveal" data-path="service" style="transition-delay: 100ms">
          <span class="comic-pow comic-pow--amber text-xs mb-3 inline-block">BAM!</span>
          <h3 class="comic-title text-2xl text-white mb-2">Slow Service</h3>
          <p class="text-sm text-gray-400">We outsourced it. Still takes forever. Records still incomplete.</p>
        </button>

        <button class="cmc-path-card reveal" data-path="nosystem" style="transition-delay: 200ms">
          <span class="comic-pow comic-pow--blue text-xs mb-3 inline-block">ZAP!</span>
          <h3 class="comic-title text-2xl text-white mb-2">No System</h3>
          <p class="text-sm text-gray-400">Honestly? It's chaos. Things fall through the cracks constantly.</p>
        </button>
      </div>

      <!-- Consequence panel -->
      <div id="cmc-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="comic-panel p-8 text-center" style="border-color: rgba(249,166,48,0.4);">
          <p class="comic-eyebrow mb-3" id="cmc-consequence-label"></p>
          <p class="comic-title text-2xl md:text-3xl text-white mb-3" id="cmc-consequence-title"></p>
          <p class="text-base text-gray-400 leading-relaxed" id="cmc-consequence-body"></p>
          <a href="#book-now" class="cmc-btn cmc-btn--gold group inline-flex mt-6">
            Deploy the Fix
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER (Comic comparison)
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/[0.06] rounded-full blur-[120px]"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="comic-pow comic-pow--blue mb-4 inline-block">VS!</span>
        <h2 class="comic-section-title mb-4">
          Your Process <span class="comic-gold">vs. Ours</span>
        </h2>
      </div>

      <!-- Toggle -->
      <div class="flex justify-center mb-10 reveal">
        <div class="inline-flex rounded-lg border-2 border-white/15 bg-white/5 p-1">
          <button class="cmc-toggle cmc-toggle--active" data-view="before" id="cmc-toggle-before">
            <span class="comic-pow comic-pow--red text-[10px] mr-1.5">&#10005;</span> Your Process
          </button>
          <button class="cmc-toggle" data-view="after" id="cmc-toggle-after">
            <span class="comic-pow comic-pow--gold text-[10px] mr-1.5">&#10003;</span> With Us
          </button>
        </div>
      </div>

      <!-- Before panel -->
      <div id="cmc-panel-before" class="cmc-compare-panel max-w-4xl mx-auto reveal">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="cmc-item cmc-item--bad">
            <span class="cmc-item-icon cmc-item-icon--red">&#10005;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Manual tracking</p>
              <p class="text-white/40 text-xs mt-0.5">Spreadsheets, sticky notes, memory</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--bad">
            <span class="cmc-item-icon cmc-item-icon--red">&#10005;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Weeks of phone tag</p>
              <p class="text-white/40 text-xs mt-0.5">Providers who never call back</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--bad">
            <span class="cmc-item-icon cmc-item-icon--red">&#10005;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Incomplete records</p>
              <p class="text-white/40 text-xs mt-0.5">Missing pages, wrong dates, no imaging</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--bad">
            <span class="cmc-item-icon cmc-item-icon--red">&#10005;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Cases idle for months</p>
              <p class="text-white/40 text-xs mt-0.5">Can't evaluate, negotiate, or move</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--bad">
            <span class="cmc-item-icon cmc-item-icon--red">&#10005;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Paralegal time burned</p>
              <p class="text-white/40 text-xs mt-0.5">Chasing records instead of building cases</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--bad">
            <span class="cmc-item-icon cmc-item-icon--red">&#10005;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Clients lose confidence</p>
              <p class="text-white/40 text-xs mt-0.5">"Why is my case taking so long?"</p>
            </div>
          </div>
        </div>
      </div>

      <!-- After panel -->
      <div id="cmc-panel-after" class="cmc-compare-panel max-w-4xl mx-auto" style="display:none">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="cmc-item cmc-item--good">
            <span class="cmc-item-icon cmc-item-icon--green">&#10003;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">We send the requests</p>
              <p class="text-white/40 text-xs mt-0.5">Correct formatting, right the first time</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--good">
            <span class="cmc-item-icon cmc-item-icon--green">&#10003;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">We do the follow-up</p>
              <p class="text-white/40 text-xs mt-0.5">Persistent outreach until records arrive</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--good">
            <span class="cmc-item-icon cmc-item-icon--green">&#10003;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Completeness verified</p>
              <p class="text-white/40 text-xs mt-0.5">Missing pages flagged and re-requested</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--good">
            <span class="cmc-item-icon cmc-item-icon--green">&#10003;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Cases move faster</p>
              <p class="text-white/40 text-xs mt-0.5">Complete records, not stuck in a queue</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--good">
            <span class="cmc-item-icon cmc-item-icon--green">&#10003;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Your team stays focused</p>
              <p class="text-white/40 text-xs mt-0.5">Paralegals work on cases, not phone tag</p>
            </div>
          </div>
          <div class="cmc-item cmc-item--good">
            <span class="cmc-item-icon cmc-item-icon--green">&#10003;</span>
            <div>
              <p class="text-white font-bold text-sm comic-sub">Clients see progress</p>
              <p class="text-white/40 text-xs mt-0.5">Faster resolution, better reviews</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative py-16 md:py-24 overflow-hidden" id="book-now">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#111b2e] to-[#0a1628]"></div>
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>

    <div class="comic-container relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="comic-pow comic-pow--gold text-lg mb-4 inline-block px-6 py-1">DEPLOY!</span>
          <h2 class="comic-section-title mb-4">
            Let's Fix Your <span class="comic-gold">Records Problem</span>
          </h2>
          <p class="text-lg text-gray-400 max-w-xl mx-auto">Book a quick call. No commitment, no sales pitch &mdash; just a plan to stop the bleeding.</p>
        </div>

        <div class="comic-panel p-1 reveal scroll-mt-20" style="border-color: rgba(249,166,48,0.3); transition-delay: 150ms">
          <div class="bg-white rounded-[9px] p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/comic?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-500 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Free &mdash; no commitment
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            15 minutes
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Minimal footer -->
  <footer class="py-6 border-t border-white/10">
    <div class="comic-container flex items-center justify-between">
      <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="h-7 w-auto opacity-30" />
      <p class="text-xs text-gray-600">&copy; {new Date().getFullYear()} Attorney Assistant LLC</p>
    </div>
  </footer>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid rgba(255,255,255,0.1);border-radius:0.75rem;background:rgba(255,255,255,0.03);"><p style="margin:0;color:#94a3b8;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }

    /* ── Hero ── */
    .cmc-hero { padding-bottom: 0; }

    /* ── Button ── */
    .cmc-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1rem;
      padding: 0.875rem 2rem; border-radius: 8px; border: none; cursor: pointer;
      transition: all 0.3s; text-decoration: none;
    }
    .cmc-btn--gold {
      background: linear-gradient(135deg, #F9A630, #e8901a); color: #0a1628;
      box-shadow: 0 4px 20px rgba(249,166,48,0.3);
    }
    .cmc-btn--gold:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(249,166,48,0.4); }

    /* ── Timeline panels ── */
    .cmc-timeline-panel { transition: transform 0.3s, box-shadow 0.3s; }
    .cmc-timeline-panel:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
    .cmc-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.75rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .cmc-panel-header--gold { background: rgba(249,166,48,0.08); }
    .cmc-panel-header--amber { background: rgba(245,158,11,0.08); }
    .cmc-panel-header--red { background: rgba(239,68,68,0.08); }
    .cmc-panel-num { font-family: 'Bangers', cursive; font-size: 1.5rem; color: rgba(255,255,255,0.2); }
    .cmc-panel-day { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); }

    /* ── Path cards ── */
    .cmc-path-card {
      text-align: center; padding: 2rem 1.5rem;
      border: 3px solid rgba(255,255,255,0.1); border-radius: 12px;
      background: rgba(255,255,255,0.03); backdrop-filter: blur(4px);
      cursor: pointer; transition: all 0.3s;
    }
    .cmc-path-card:hover { border-color: rgba(249,166,48,0.4); transform: translateY(-4px); }
    .cmc-path-card.cmc-path-card--active {
      border-color: #F9A630; background: rgba(249,166,48,0.06);
      box-shadow: 0 0 0 3px rgba(249,166,48,0.15), 0 12px 40px rgba(0,0,0,0.3);
    }

    /* ── Toggle ── */
    .cmc-toggle {
      display: inline-flex; align-items: center;
      padding: 0.625rem 1.25rem; border-radius: 6px;
      font-family: 'Sora', sans-serif; font-size: 0.8125rem; font-weight: 700;
      color: rgba(255,255,255,0.5); background: transparent;
      border: none; cursor: pointer; transition: all 0.3s;
    }
    .cmc-toggle--active { background: #F9A630; color: #0a1628; }

    /* ── Comparison items ── */
    .cmc-item {
      display: flex; align-items: flex-start; gap: 0.75rem;
      padding: 1rem; border-radius: 10px;
      border: 2px solid rgba(255,255,255,0.06); background: rgba(255,255,255,0.02);
      transition: border-color 0.3s;
    }
    .cmc-item--bad:hover { border-color: rgba(239,68,68,0.3); }
    .cmc-item--good:hover { border-color: rgba(16,185,129,0.3); }
    .cmc-item-icon {
      width: 28px; height: 28px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.8rem; flex-shrink: 0;
    }
    .cmc-item-icon--red { background: rgba(239,68,68,0.15); color: #ef4444; }
    .cmc-item-icon--green { background: rgba(16,185,129,0.15); color: #10b981; }

    /* ── Panel animation ── */
    .cmc-compare-panel { animation: cmcPanelIn 0.4s ease; }
    @keyframes cmcPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

    @media (prefers-reduced-motion: reduce) {
      .cmc-timeline-panel, .cmc-path-card, .cmc-btn, .cmc-item { transition: none !important; }
      .cmc-compare-panel { animation: none !important; }
    }
  </style>

  <!-- Interactive logic -->
  <script is:inline>
    (function() {
      /* ── Choose Your Path ── */
      var consequences = {
        inhouse: {
          label: 'In-House Reality',
          title: 'Your paralegal is spending 30%+ of their time chasing records instead of building cases.',
          body: 'Every hour on hold with a provider is an hour not spent on intake, client communication, or case prep. The hidden cost isn\'t the records — it\'s the opportunity cost of your best people doing low-leverage work.'
        },
        service: {
          label: 'Outsourced, Not Solved',
          title: 'You\'re paying for a service that still leaves you waiting and following up.',
          body: 'If your records service doesn\'t proactively chase, verify completeness, and flag gaps — you\'re just paying someone else to be slow. The bottleneck moved, but it didn\'t disappear.'
        },
        nosystem: {
          label: 'The Honest Answer',
          title: 'Without a system, every record request is a gamble on someone remembering to follow up.',
          body: 'No one is dropping the ball on purpose. But without a structured process, records get lost in inboxes, follow-ups get missed, and cases sit idle. It\'s not a people problem — it\'s a system problem.'
        }
      };

      document.querySelectorAll('.cmc-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;

          document.querySelectorAll('.cmc-path-card').forEach(function(c) { c.classList.remove('cmc-path-card--active'); });
          this.classList.add('cmc-path-card--active');

          document.getElementById('cmc-consequence-label').textContent = data.label;
          document.getElementById('cmc-consequence-title').textContent = data.title;
          document.getElementById('cmc-consequence-body').textContent = data.body;
          var panel = document.getElementById('cmc-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none';
          panel.offsetHeight;
          panel.style.animation = 'cmcPanelIn 0.4s ease';
        });
      });

      /* ── Before/After Toggle ── */
      var beforeBtn = document.getElementById('cmc-toggle-before');
      var afterBtn = document.getElementById('cmc-toggle-after');
      var beforePanel = document.getElementById('cmc-panel-before');
      var afterPanel = document.getElementById('cmc-panel-after');

      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('cmc-toggle--active');
          afterBtn.classList.remove('cmc-toggle--active');
          beforePanel.style.display = 'block';
          afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none';
          beforePanel.offsetHeight;
          beforePanel.style.animation = 'cmcPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('cmc-toggle--active');
          beforeBtn.classList.remove('cmc-toggle--active');
          afterPanel.style.display = 'block';
          beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none';
          afterPanel.offsetHeight;
          afterPanel.style.animation = 'cmcPanelIn 0.4s ease';
        });
      }
    })();
  </script>

