---
import ComicCampaignLayout from "@layouts/ComicCampaignLayout.astro";
---

<ComicCampaignLayout
  title="Your Paralegals Are Drowning in Pleadings, Demands, and Liens | Attorney Assistant"
  description="We draft. We file. We follow up. They focus on the case. Deploy Attorney Assistant to rescue your paralegals from case management chaos."
  image="/images/lp/case-management-header.jpg"
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="cmc-hero relative overflow-hidden min-h-[60vh] md:min-h-[70vh] flex items-center">
    <!-- Background image -->
    <picture class="absolute inset-0 z-0 block">
      <source srcset="/images/lp/case-management-header.webp" type="image/webp" />
      <img src="/images/lp/case-management-header.jpg" alt="" aria-hidden="true" class="w-full h-full object-cover" width="1920" height="1080" loading="eager" fetchpriority="high" />
    </picture>
    <!-- Slight dark overlay for text legibility -->
    <div class="absolute inset-0 z-[1]" aria-hidden="true" style="background: linear-gradient(to bottom, rgba(10,22,40,0.55) 0%, rgba(10,22,40,0.55) 60%, rgba(10,22,40,1) 100%);"></div>
    <!-- Atmospheric glow orbs (above the overlay) -->
    <div class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-brand-gold/[0.06] rounded-full blur-[150px] z-[2]" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-brand-blue/[0.05] rounded-full blur-[120px] z-[2]" aria-hidden="true"></div>

    <div class="comic-container relative z-10 py-16 md:py-24 w-full">
      <div class="text-center reveal">
        <h1 class="comic-title text-4xl md:text-6xl lg:text-7xl text-white leading-none mb-4" style="text-shadow: 0 4px 24px rgba(10,22,40,0.85);">
          Paralegals drowning in paperwork? <br/><span class="comic-gold">We rescue law firms with elite staffing + AI solutions.</span>
        </h1>
        <p class="comic-sub text-lg md:text-xl text-gray-100 font-semibold max-w-2xl mx-auto mb-8" style="text-shadow: 0 2px 12px rgba(10,22,40,0.8);">
          Pleadings, demands, liens, filings &mdash; we draft, file, and follow up so your team can focus on the case. Scroll to see the damage.
        </p>
        <a href="#book-now" class="cmc-btn cmc-btn--gold group inline-flex">
          Deploy Attorney Assistant
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 1 — SCROLLYTELLING TIMELINE
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-red-500/[0.04] rounded-full blur-[120px]"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14">
        <span class="comic-pow comic-pow--red mb-4 inline-block">THE TIMELINE!</span>
        <h2 class="comic-section-title mb-4">
          How Case Work <span class="comic-gold">Buries Your Team</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">Every case adds more. The pile never shrinks.</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        <div class="comic-panel cmcm-timeline-panel reveal">
          <div class="cmcm-panel-header cmcm-panel-header--gold">
            <span class="cmcm-panel-num">01</span>
            <span class="cmcm-panel-day">New Case Signed</span>
          </div>
          <div class="p-5">
            <h3 class="comic-title text-xl text-white mb-2">The Pile Grows</h3>
            <p class="text-sm text-gray-400">Demand letter needs drafting. Medical records need requesting. Liens need identifying. Your paralegal adds it to the list &mdash; which is already 30 items deep.</p>
          </div>
        </div>

        <div class="comic-panel cmcm-timeline-panel reveal" style="transition-delay: 100ms">
          <div class="cmcm-panel-header cmcm-panel-header--amber">
            <span class="cmcm-panel-num">02</span>
            <span class="cmcm-panel-day">Week 2</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--amber text-xs mb-2 inline-block">SWAMPED!</span>
            <h3 class="comic-title text-xl text-white mb-2">Pleadings Stack Up</h3>
            <p class="text-sm text-gray-400">Discovery responses due. Interrogatories need answering. Motions need filing. Each one takes hours and the deadlines don't care that you're understaffed.</p>
          </div>
        </div>

        <div class="comic-panel cmcm-timeline-panel reveal" style="transition-delay: 200ms">
          <div class="cmcm-panel-header cmcm-panel-header--red">
            <span class="cmcm-panel-num">03</span>
            <span class="cmcm-panel-day">Week 4</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--red text-xs mb-2 inline-block">MISSED!</span>
            <h3 class="comic-title text-xl text-white mb-2">Follow-Up Falls Off</h3>
            <p class="text-sm text-gray-400">Lien resolutions go cold. Demands sent but never followed up on. Opposing counsel stops getting responses on time. The attorney notices when the judge does.</p>
          </div>
        </div>

        <div class="comic-panel cmcm-timeline-panel reveal" style="transition-delay: 300ms">
          <div class="cmcm-panel-header cmcm-panel-header--red">
            <span class="cmcm-panel-num">04</span>
            <span class="cmcm-panel-day">Week 6</span>
          </div>
          <div class="p-5">
            <span class="comic-pow comic-pow--red text-xs mb-2 inline-block">DROWNING!</span>
            <h3 class="comic-title text-xl text-white mb-2">Quality Drops</h3>
            <p class="text-sm text-gray-400">Rushed filings. Copy-paste errors. Wrong dates. Your paralegal isn't careless &mdash; they're doing the work of three people with the bandwidth of one.</p>
          </div>
        </div>

        <div class="comic-panel cmcm-timeline-panel md:col-span-2 lg:col-span-2 reveal" style="transition-delay: 400ms">
          <div class="cmcm-panel-header cmcm-panel-header--gold">
            <span class="cmcm-panel-num">05</span>
            <span class="cmcm-panel-day">Every Month</span>
          </div>
          <div class="p-6">
            <span class="comic-pow comic-pow--gold text-sm mb-3 inline-block">KA-BOOM!</span>
            <h3 class="comic-title text-2xl md:text-3xl comic-gold mb-2">Cases Stall. Settlements Shrink. Good People Quit.</h3>
            <p class="text-base text-gray-400">When the case work outpaces the team, everything suffers &mdash; case outcomes, client experience, and the people who keep showing up every day to a job that's getting harder.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 2 — CHOOSE YOUR PATH
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#111b2e]/50 to-transparent"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="comic-pow comic-pow--amber mb-4 inline-block">CHOOSE!</span>
        <h2 class="comic-section-title mb-4">
          Who's Handling the <span class="comic-gold">Case Work?</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">Pick the one that fits your firm.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5 max-w-4xl mx-auto" id="cmcm-paths">
        <button class="cmc-path-card reveal" data-path="paralegal">
          <span class="comic-pow comic-pow--red text-xs mb-3 inline-block">POW!</span>
          <h3 class="comic-title text-2xl text-white mb-2">One Paralegal Does It All</h3>
          <p class="text-sm text-gray-400">Drafting, filing, follow-up, lien resolution &mdash; all on one person who's maxed out.</p>
        </button>

        <button class="cmc-path-card reveal" data-path="attorney" style="transition-delay: 100ms">
          <span class="comic-pow comic-pow--amber text-xs mb-3 inline-block">BAM!</span>
          <h3 class="comic-title text-2xl text-white mb-2">Attorneys Fill the Gaps</h3>
          <p class="text-sm text-gray-400">When the paralegal can't keep up, the attorney drafts their own pleadings and chases their own liens.</p>
        </button>

        <button class="cmc-path-card reveal" data-path="behind" style="transition-delay: 200ms">
          <span class="comic-pow comic-pow--blue text-xs mb-3 inline-block">ZAP!</span>
          <h3 class="comic-title text-2xl text-white mb-2">We're Just Behind</h3>
          <p class="text-sm text-gray-400">Everything gets done eventually. But "eventually" is costing us cases and credibility.</p>
        </button>
      </div>

      <div id="cmcm-consequence" class="max-w-2xl mx-auto mt-10" style="display:none">
        <div class="comic-panel p-8 text-center" style="border-color: rgba(249,166,48,0.4);">
          <p class="comic-eyebrow mb-3" id="cmcm-consequence-label"></p>
          <p class="comic-title text-2xl md:text-3xl text-white mb-3" id="cmcm-consequence-title"></p>
          <p class="text-base text-gray-400 leading-relaxed" id="cmcm-consequence-body"></p>
          <a href="#book-now" class="cmc-btn cmc-btn--gold group inline-flex mt-6">
            Deploy the Fix
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 3 — BEFORE / AFTER
  ═══════════════════════════════════════════ -->
  <section class="relative py-20 md:py-28 overflow-hidden">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/[0.06] rounded-full blur-[120px]"></div>

    <div class="comic-container relative z-10">
      <div class="text-center mb-14 reveal">
        <span class="comic-pow comic-pow--blue mb-4 inline-block">VS!</span>
        <h2 class="comic-section-title mb-4">
          Your Case Work <span class="comic-gold">vs. Ours</span>
        </h2>
      </div>

      <div class="flex justify-center mb-10 reveal">
        <div class="inline-flex rounded-lg border-2 border-white/15 bg-white/5 p-1">
          <button class="cmc-toggle cmc-toggle--active" id="cmcm-toggle-before">
            <span class="comic-pow comic-pow--red text-[10px] mr-1.5">&#10005;</span> Your Process
          </button>
          <button class="cmc-toggle" id="cmcm-toggle-after">
            <span class="comic-pow comic-pow--gold text-[10px] mr-1.5">&#10003;</span> With Us
          </button>
        </div>
      </div>

      <div id="cmcm-panel-before" class="cmcm-compare-panel max-w-4xl mx-auto reveal">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Pleadings drafted last-minute</p><p class="text-white/40 text-xs mt-0.5">Rushed work, copy-paste errors, deadline scrambles</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Demands sit unsent for weeks</p><p class="text-white/40 text-xs mt-0.5">Every day a demand waits is a day settlement is delayed</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Liens unresolved for months</p><p class="text-white/40 text-xs mt-0.5">Medicare, Medicaid, health insurance &mdash; nobody's chasing them</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Filings done by overwhelmed staff</p><p class="text-white/40 text-xs mt-0.5">Wrong court, wrong format, missing exhibits &mdash; because they're rushing</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Follow-up is inconsistent</p><p class="text-white/40 text-xs mt-0.5">Some cases get attention. Others go dark for weeks.</p></div></div>
          <div class="cmc-item cmc-item--bad"><span class="cmc-item-icon cmc-item-icon--red">&#10005;</span><div><p class="text-white font-bold text-sm comic-sub">Paralegals burning out</p><p class="text-white/40 text-xs mt-0.5">Good people doing impossible workloads. Turnover is coming.</p></div></div>
        </div>
      </div>

      <div id="cmcm-panel-after" class="cmcm-compare-panel max-w-4xl mx-auto" style="display:none">
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">We draft pleadings and demands</p><p class="text-white/40 text-xs mt-0.5">Accurate, on-time, formatted correctly &mdash; ready for attorney review</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">We file on schedule</p><p class="text-white/40 text-xs mt-0.5">Court deadlines tracked and met. No last-minute scrambles.</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">We chase lien resolutions</p><p class="text-white/40 text-xs mt-0.5">Persistent follow-up until every lien is identified and resolved</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">We handle the follow-up</p><p class="text-white/40 text-xs mt-0.5">Opposing counsel, adjusters, providers &mdash; nothing goes cold</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">Your team focuses on the case</p><p class="text-white/40 text-xs mt-0.5">Strategy, depositions, negotiations &mdash; the work that wins</p></div></div>
          <div class="cmc-item cmc-item--good"><span class="cmc-item-icon cmc-item-icon--green">&#10003;</span><div><p class="text-white font-bold text-sm comic-sub">Cases move faster to settlement</p><p class="text-white/40 text-xs mt-0.5">No bottlenecks. No backlogs. Faster resolution, higher value.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4 — BOOKING CTA
  ═══════════════════════════════════════════ -->
  <section class="relative py-16 md:py-24 overflow-hidden" id="book-now">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#111b2e] to-[#0a1628]"></div>
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-brand-gold/30 to-transparent"></div>

    <div class="comic-container relative z-10">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-10 reveal">
          <span class="comic-pow comic-pow--gold text-lg mb-4 inline-block px-6 py-1">DEPLOY!</span>
          <h2 class="comic-section-title mb-4">
            Free Your Team From the <span class="comic-gold">Paperwork Flood</span>
          </h2>
          <p class="text-lg text-gray-400 max-w-xl mx-auto">Book a quick call. We'll show you which case work to offload first &mdash; no commitment.</p>
        </div>

        <div class="comic-panel p-1 reveal scroll-mt-20" style="border-color: rgba(249,166,48,0.3); transition-delay: 150ms">
          <div class="bg-white rounded-[9px] p-4 md:p-5">
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/comic?embed=true"></div>
          </div>
        </div>

        <div class="flex justify-center gap-6 mt-8 text-sm text-gray-500 reveal" style="transition-delay: 250ms">
          <div class="flex items-center gap-1.5"><svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg> Free &mdash; no commitment</div>
          <div class="flex items-center gap-1.5"><svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg> 15 minutes</div>
        </div>
      </div>
    </div>
  </section>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid rgba(255,255,255,0.1);border-radius:0.75rem;background:rgba(255,255,255,0.03);"><p style="margin:0;color:#94a3b8;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe { background: #ffffff !important; }
    .cmc-hero { padding-bottom: 0; }
    .cmc-btn { display: inline-flex; align-items: center; gap: 0.5rem; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px; border: none; cursor: pointer; transition: all 0.3s; text-decoration: none; }
    .cmc-btn--gold { background: linear-gradient(135deg, #F9A630, #e8901a); color: #0a1628; box-shadow: 0 4px 20px rgba(249,166,48,0.3); }
    .cmc-btn--gold:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(249,166,48,0.4); }
    .cmcm-timeline-panel { transition: transform 0.3s, box-shadow 0.3s; }
    .cmcm-timeline-panel:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.3); }
    .cmcm-panel-header { display: flex; align-items: center; justify-content: space-between; padding: 0.75rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .cmcm-panel-header--gold { background: rgba(249,166,48,0.08); }
    .cmcm-panel-header--amber { background: rgba(245,158,11,0.08); }
    .cmcm-panel-header--red { background: rgba(239,68,68,0.08); }
    .cmcm-panel-num { font-family: 'Bangers', cursive; font-size: 1.5rem; color: rgba(255,255,255,0.2); }
    .cmcm-panel-day { font-size: 0.6875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.4); }
    .cmcm-compare-panel { animation: cmcmPanelIn 0.4s ease; }
    @keyframes cmcmPanelIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { .cmcm-timeline-panel, .cmc-path-card, .cmc-btn, .cmc-item { transition: none !important; } .cmcm-compare-panel { animation: none !important; } }
  </style>

  <script is:inline>
    (function() {
      var consequences = {
        paralegal: {
          label: 'The One-Person Army',
          title: 'Your paralegal is drafting, filing, chasing liens, and managing 40+ cases. Something is going to break.',
          body: 'It\'s not a question of if — it\'s when. Deadlines slip, quality drops, and eventually they burn out or leave. You don\'t need to replace them. You need to take the repetitive drafting, filing, and follow-up off their plate so they can focus on the high-judgment work only they can do.'
        },
        attorney: {
          label: 'Expensive Gap-Filling',
          title: 'Every hour your attorney spends drafting pleadings is an hour they\'re not strategizing, negotiating, or in court.',
          body: 'Attorneys filling paralegal gaps is the most expensive way to handle case work. A trained legal VA drafts under attorney supervision at a fraction of the cost — same output, right oversight, no $400/hr price tag on work that doesn\'t need a bar card.'
        },
        behind: {
          label: 'The Slow Bleed',
          title: '"Eventually" is the most expensive word in case management.',
          body: 'Every day a demand sits unsent, a lien goes unchased, or a filing gets delayed — the case loses value. Opposing counsel gets more time. Clients lose patience. Settlements shrink. The work gets done eventually, but by then the damage is already done.'
        }
      };

      document.querySelectorAll('.cmc-path-card').forEach(function(card) {
        card.addEventListener('click', function() {
          var path = this.dataset.path;
          var data = consequences[path];
          if (!data) return;
          document.querySelectorAll('.cmc-path-card').forEach(function(c) { c.classList.remove('cmc-path-card--active'); });
          this.classList.add('cmc-path-card--active');
          document.getElementById('cmcm-consequence-label').textContent = data.label;
          document.getElementById('cmcm-consequence-title').textContent = data.title;
          document.getElementById('cmcm-consequence-body').textContent = data.body;
          var panel = document.getElementById('cmcm-consequence');
          panel.style.display = 'block';
          panel.style.animation = 'none'; panel.offsetHeight;
          panel.style.animation = 'cmcmPanelIn 0.4s ease';
        });
      });

      var beforeBtn = document.getElementById('cmcm-toggle-before');
      var afterBtn = document.getElementById('cmcm-toggle-after');
      var beforePanel = document.getElementById('cmcm-panel-before');
      var afterPanel = document.getElementById('cmcm-panel-after');
      if (beforeBtn && afterBtn) {
        beforeBtn.addEventListener('click', function() {
          beforeBtn.classList.add('cmc-toggle--active');
          afterBtn.classList.remove('cmc-toggle--active');
          beforePanel.style.display = 'block'; afterPanel.style.display = 'none';
          beforePanel.style.animation = 'none'; beforePanel.offsetHeight;
          beforePanel.style.animation = 'cmcmPanelIn 0.4s ease';
        });
        afterBtn.addEventListener('click', function() {
          afterBtn.classList.add('cmc-toggle--active');
          beforeBtn.classList.remove('cmc-toggle--active');
          afterPanel.style.display = 'block'; beforePanel.style.display = 'none';
          afterPanel.style.animation = 'none'; afterPanel.offsetHeight;
