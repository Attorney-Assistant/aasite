  .sc-meta-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 1.5rem; font-family: "IBM Plex Mono", monospace; font-size: 0.8125rem; color: var(--lt26-hero-body); text-transform: uppercase; letter-spacing: 0.06em; }
  .sc-meta-dot { color: rgba(255,255,255,0.3); }

  .sc-hero-badges { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 1.75rem; }
  .sc-pill { display: inline-flex; align-items: center; padding: 0.4rem 0.9rem; border-radius: 9999px; font-family: "IBM Plex Mono", monospace; font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: #fff; border: 1px solid rgba(255,255,255,0.25); background: rgba(255,255,255,0.06); }

  /* ── Sticky progress ── */
  .sc-progress { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,0.96); backdrop-filter: blur(8px); border-bottom: 1px solid #eaecf0; opacity: 0; transform: translateY(-8px); pointer-events: none; transition: opacity 0.25s ease, transform 0.25s ease; }
  .sc-progress.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
  .sc-progress-track { height: 3px; background: #eaecf0; }
  .sc-progress-fill { height: 100%; width: 0%; background: var(--lt26-orange); transition: width 0.15s linear; }
  .sc-progress-steps { max-width: 1100px; margin: 0 auto; padding: 0.6rem 1.25rem; display: flex; gap: 1.5rem; overflow-x: auto; }
  .sc-progress-step { display: flex; align-items: center; gap: 0.4rem; background: none; border: none; padding: 0.15rem 0; font-family: "IBM Plex Mono", monospace; font-size: 0.6875rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: #98a2b3; white-space: nowrap; cursor: pointer; }
  .sc-progress-step.is-active { color: var(--lt26-orange-ink); }
  .sc-progress-check { width: 14px; height: 14px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: transparent; border: 1.5px solid #d0d5dd; flex-shrink: 0; }
  .sc-progress-check svg { width: 9px; height: 9px; }
  .sc-progress-step.is-done .sc-progress-check { color: #fff; background: var(--lt26-orange); border-color: var(--lt26-orange); }
  .sc-progress-step:focus-visible, .sc-rank-btn:focus-visible, .sc-option input:focus-visible + .sc-option-mark, button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible {
    outline: 2px solid var(--lt26-blue); outline-offset: 2px;
  }

  /* ── Quiz ── */
  .sc-quiz { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  .sc-question { border: none; padding: 0; margin: 0; }
  .sc-question legend { font-family: "Sora", system-ui, sans-serif; font-weight: 700; font-size: 1rem; color: #101828; margin-bottom: 0.75rem; padding: 0; }
  .sc-options { display: grid; gap: 0.5rem; }
  .sc-option { position: relative; display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; border: 1px solid #eaecf0; border-left: 3px solid transparent; border-radius: 10px; background: #fff; cursor: pointer; font-size: 0.9375rem; color: #344054; transition: background 0.15s ease, border-color 0.15s ease; }
