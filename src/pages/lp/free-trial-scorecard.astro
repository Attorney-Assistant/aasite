  .sc-accent-light { color: var(--lt26-orange-ink); font-style: italic; }

  .sc-h2 { font-family: "Sora", system-ui, sans-serif; font-weight: 800; font-size: clamp(1.6rem, 3.4vw, 2.4rem); line-height: 1.2; letter-spacing: -0.01em; color: #101828; }
  .sc-h2--dark { color: #fff; }
  .sc-section-head { max-width: 680px; }
  .sc-intro { margin-top: 1rem; font-size: 1rem; line-height: 1.65; color: #475467; max-width: 640px; }
