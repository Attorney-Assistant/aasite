  .sc-option.is-selected { background: var(--lt26-cream); border-left-color: var(--lt26-orange); border-color: rgba(245,159,38,0.35); }
  .sc-option.is-selected .sc-option-mark { border-color: var(--lt26-orange); }
  .sc-option.is-selected .sc-option-mark::after { content: ""; position: absolute; inset: 3px; border-radius: 50%; background: var(--lt26-orange); }
  .sc-option:hover { background: #fcfcfd; }

  .sc-score-card { margin-top: 3rem; padding: 2.25rem; text-align: center; background: #fff; border: 1px solid #eaecf0; border-radius: 1rem; box-shadow: 0 4px 16px -6px rgba(13,36,61,0.08); }
  .sc-score-num-wrap { display: flex; align-items: baseline; justify-content: center; gap: 0.35rem; }
  .sc-score-num { font-family: "Bangers", "Sora", cursive; font-size: clamp(3.5rem, 9vw, 5.5rem); color: var(--lt26-orange); line-height: 1; }
  .sc-score-max { font-family: "Sora", system-ui, sans-serif; font-weight: 700; font-size: 1.25rem; color: #98a2b3; }
  .sc-score-band { margin-top: 0.5rem; font-family: "Sora", system-ui, sans-serif; font-weight: 800; font-size: 1.5rem; color: #101828; }
  .sc-score-text { margin-top: 0.75rem; font-size: 1rem; line-height: 1.6; color: #475467; max-width: 42rem; margin-left: auto; margin-right: auto; }
  .sc-score-line { margin-top: 1.25rem; padding-top: 1.25rem; border-top: 1px solid #eaecf0; font-weight: 700; color: var(--lt26-orange-ink); }

  /* ── Calculator ── */
  .sc-calc-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; margin-top: 3rem; align-items: center; }
  @media (max-width: 900px) { .sc-calc-grid { grid-template-columns: 1fr; } }
  .sc-calc-controls { display: grid; gap: 1.75rem; }
