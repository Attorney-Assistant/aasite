  <!-- Law-Firm Qualifying Gate -->
  <script is:inline>
    (function () {
      "use strict";

      function initLeadRescueGate() {
        var STORAGE_KEY = "aa_lawfirm_gate_lost-lead-rescue";

        function getState() {
          try { return localStorage.getItem(STORAGE_KEY); } catch (e) { return null; }
        }
        function setState(v) {
          try { localStorage.setItem(STORAGE_KEY, v); } catch (e) {}
        }
        function stripSchedulerSources() {
          document.querySelectorAll(".meetings-iframe-container[data-src]").forEach(function (el) {
            el.removeAttribute("data-src");
          });
        }
        function trackGate(answer) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: "gate_response", gate_type: "law_firm_qualifier", answer: answer, source: "lost-lead-rescue" });
        }

        var GATE_HTML =
          '<div class="gate-inner">' +
            '<p class="gate-question">Are you a lawyer or law firm with lost leads that need rescuing?</p>' +
            '<div class="gate-buttons">' +
              '<button type="button" class="gate-btn-yes" data-gate-yes>Yes</button>' +
              '<button type="button" class="gate-btn-no" data-gate-no>No</button>' +
            "</div>" +
          "</div>";

        var DECLINE_HTML =
          '<div class="gate-inner">' +
            '<p class="gate-decline">Thanks for stopping by! This offer may not be the best fit for you right now, but you\'re welcome to explore what we do at <a href="https://attorneyassistant.com" class="gate-link">attorneyassistant.com</a>. Not a law firm? Our sister company, Turnkey Ops, brings the same follow-up and support model to businesses outside the legal space. Visit <a href="https://turnkeyops.io" target="_blank" rel="noopener" class="gate-link">turnkeyops.io</a>.</p>' +
          "</div>";

        var state = getState();

        if (state === "no") stripSchedulerSources();
        if (state === "yes") return;

        var target = document.getElementById("book-now");
        if (!target) return;

        target.style.position = "relative";
        var overlay = document.createElement("div");
        overlay.className = "lawfirm-gate-overlay";
        overlay.innerHTML = state === "no" ? DECLINE_HTML : GATE_HTML;
        target.appendChild(overlay);

        if (state === "no") return;

        overlay.querySelector("[data-gate-yes]").addEventListener("click", function () {
          setState("yes");
          trackGate("yes");
          overlay.remove();
        });
        overlay.querySelector("[data-gate-no]").addEventListener("click", function () {
          setState("no");
          trackGate("no");
          stripSchedulerSources();
          overlay.innerHTML = DECLINE_HTML;
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initLeadRescueGate);
      } else {
        initLeadRescueGate();
      }
    })();
  </script>

