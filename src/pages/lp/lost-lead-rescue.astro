---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Lost Lead Rescue: Free Results on Leads You Already Paid For"
  description="Send up to 1,000 unsigned leads from the last 6 months. Our Frontline team calls each one up to 8 times. Get your first results free. No credit card. No contract to start."
  noindex={true}
  schema={{
    "@type": "WebPage",
    "name": "Lost Lead Rescue",
    "description": "A free rescue of up to 1,000 unsigned leads from the last 6 months, worked by Attorney Assistant's Frontline team.",
    "publisher": {
      "@type": "Organization",
      "name": "Attorney Assistant"
    }
  }}
>

  <!-- ══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[90vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="lp-orb lp-orb--1" aria-hidden="true"></div>
    <div class="lp-orb lp-orb--2" aria-hidden="true"></div>
    <div class="lp-orb lp-orb--3" aria-hidden="true"></div>
    <div class="grain-overlay"></div>

    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <div class="container-wide relative z-10 py-20 lg:py-28">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal">
          <div class="mb-5">
            <span class="lp-pulse-badge">
              <span class="lp-pulse-dot"></span>
              For Law Firm Owners
            </span>
          </div>
          <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
            Rescue the Leads <br/><span class="text-gradient-gold">You Already Paid For.</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-8 leading-relaxed">
            Send us up to 1,000 leads from the last 6 months that never signed. Our Frontline team calls each one up to 8 times. You keep every signed case and booked consult. Your first results are free.
          </p>

          <!-- Stat ticker -->
          <div class="grid grid-cols-3 gap-4 mb-10">
            <div class="lp-hero-stat">
              <span class="lp-hero-stat-prefix">Up To</span>
              <span class="lp-hero-stat-num lp-count" data-target="1000">0</span>
              <span class="lp-hero-stat-label">old or new leads worked for free</span>
            </div>
            <div class="lp-hero-stat">
              <span class="lp-hero-stat-num lp-count" data-target="8">0</span>
              <span class="lp-hero-stat-label">call attempts before we call a lead dead</span>
            </div>
            <div class="lp-hero-stat">
              <span class="lp-hero-stat-num">$</span><span class="lp-hero-stat-num lp-count" data-target="10">0</span><span class="lp-hero-stat-num">K</span>
              <span class="lp-hero-stat-label">value, done at no cost to you</span>
            </div>
          </div>

          <!-- What the call covers -->
          <div class="space-y-4 mb-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">On Your Call We'll Cover</p>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
              </div>
              <div>
                <p class="text-base font-semibold text-white">How many of your old leads are still worth working</p>
                <p class="text-sm text-gray-500 mt-0.5">We'll show you the math on 1 to 3 attempts versus 8.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <p class="text-base font-semibold text-white">What results look like for your type of firm</p>
                <p class="text-sm text-gray-500 mt-0.5">Signed CFAs for contingency firms. Booked consults for everyone else.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" /></svg>
              </div>
              <div>
                <p class="text-base font-semibold text-white">How to export your leads into our template</p>
                <p class="text-sm text-gray-500 mt-0.5">No integration. No setup. Just a file.</p>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              No credit card
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              No contract to start
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              English and Español
            </div>
          </div>
        </div>

        <!-- Booking Widget + Qualifying Gate -->
        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal lp-widget-glow" style="transition-delay: 150ms" id="book-now">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="flex items-center gap-3 mb-3">
              <div class="featured-icon featured-icon-md featured-icon-gold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
              </div>
              <div>
                <h2 class="text-lg font-heading text-gray-900">Book Your Rescue Call</h2>
                <p class="text-xs text-gray-500">Free. No credit card. No contract to start.</p>
              </div>
            </div>
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/lost-lead-rescue?embed=true"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 lp-scroll-hint" aria-hidden="true">
      <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2">
        <div class="w-1 h-2.5 bg-brand-gold rounded-full lp-scroll-dot"></div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       KEY MESSAGE
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 lp-section-lg">
    <div class="absolute inset-0">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-red-500/3 rounded-full blur-[100px]"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-narrow relative z-10 text-center">
      <span class="badge bg-brand-gold/15 text-brand-gold border-brand-gold/20 mb-6 reveal">The Math You're Ignoring</span>
      <h2 class="text-display-sm md:text-display-md font-heading text-white mb-5 leading-tight reveal">
        You already paid for these leads.
      </h2>
      <p class="text-lg text-gray-400 leading-relaxed mb-4 max-w-2xl mx-auto reveal">
        Every lead that came in over the last six months cost you money. Ad spend, referral fees, marketing budget. You paid for all of it already.
      </p>
      <p class="text-lg text-gray-400 leading-relaxed mb-10 max-w-2xl mx-auto reveal">
        Most firms call a lead one to three times and stop. Signing a case usually takes more attempts than that. The leads you wrote off are still sitting in your CRM.
      </p>
      <div class="lp-quote-banner max-w-2xl mx-auto reveal">
        "You're sitting on cases you already paid for."
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       HOW IT WORKS
  ═══════════════════════════════════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-brand">How It Works</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">Five steps. You export. We chase.</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-4 max-w-6xl mx-auto">
        {[
          { step: "1", title: "Export", desc: "Pull your unsigned leads from the last 6 months into our template." },
          { step: "2", title: "Clean", desc: "We remove duplicates and drop anyone already signed, represented, declined, or marked do not contact." },
          { step: "3", title: "Chase", desc: "Frontline works each lead up to 8 times." },
          { step: "4", title: "Deliver", desc: "Signed CFAs or booked consults go straight to you, with notes on every lead we touched." },
          { step: "5", title: "Decide", desc: "Once you see results on your own leads, you decide if you want Frontline on new leads." },
        ].map((s, i) => (
          <div class="relative text-center reveal" style={`transition-delay: ${i * 80}ms`}>
            <div class={`w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-lg border-2 ${i === 4 ? 'bg-brand-gold border-brand-gold text-brand-navy' : 'bg-white border-brand-navy text-brand-navy'}`}>
              {s.step}
            </div>
            <h3 class="text-xs font-heading text-gray-900 uppercase tracking-wide mb-2">{s.title}</h3>
            <p class="text-xs text-gray-500 leading-snug">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       WHAT YOU GET
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-50 lp-section-lg">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge bg-brand-gold/10 text-brand-gold border-brand-gold/20 mb-4">Your First Results, Free</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          A $10,000 value. Yours at no cost.
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          We used to charge $10 per lead for this work. Your first rescue is free, and what you get depends on how your firm works.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 reveal mb-8 max-w-4xl mx-auto">
        <div class="lp-diff-card">
          <div class="lp-diff-card-num">Contingency Firms</div>
          <div class="lp-diff-card-icon">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <h3 class="text-xl font-heading text-gray-900 mt-5 mb-2">3 fully done intakes</h3>
          <p class="text-gray-500">For PI, mass tort, and any CFA practice. If the case can be signed on the call, we sign the CFA too.</p>
        </div>
        <div class="lp-diff-card lp-diff-card--highlight">
          <div class="lp-diff-card-num lp-diff-card-num--gold">Non-Contingency Firms</div>
          <div class="lp-diff-card-icon lp-diff-card-icon--gold">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
          </div>
          <h3 class="text-xl font-heading text-gray-900 mt-5 mb-2">5 qualified consults booked</h3>
          <p class="text-gray-500">For flat fee, hourly, and retainer firms. Set straight on your calendar.</p>
        </div>
      </div>

      <div class="lp-rule-box max-w-3xl mx-auto reveal mb-10">
        <span class="lp-rule-box-label">Some Practice Areas Need Your Review First</span>
        <p class="text-base font-semibold text-gray-900">
          Medical malpractice and similar practice areas need attorney review before anyone signs. There, we deliver a complete intake ready for your decision. We never promise a signed CFA for those cases.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-8 text-center reveal mb-10">
        <p class="text-base font-heading text-gray-900">Clients sign with your firm. Your CFA, your name. We never take the case.</p>
        <span class="hidden sm:block w-px h-6 bg-gray-300"></span>
        <p class="text-base font-heading text-gray-900">Our team is bilingual. English and Español.</p>
      </div>

      <div class="text-center reveal">
        <a href="#book-now" class="btn-primary btn-lg group inline-flex">
          Rescue My Leads
          <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       PRICING AFTER FREE RESULTS
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden lp-section-lg">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-blue/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-12 reveal">
        <span class="badge bg-brand-gold/15 text-brand-gold border-brand-gold/20 mb-4">After Your Free Results</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-5">
          Keep Frontline on new leads, <span class="text-gradient-gold">if it's a fit.</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">Your free results need no contract. A plan only starts if you choose one afterward.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto reveal mb-8">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur-sm relative overflow-hidden">
          <p class="text-[0.625rem] font-bold tracking-[0.15em] uppercase text-white/50 mb-1">Starter</p>
          <p class="text-xs text-white/40 mb-4">Best for lower lead volume</p>
          <div class="text-display-xs font-heading text-white">$497</div>
          <p class="text-xs text-white/40 mb-4">/month &middot; 30 credits included</p>
          <p class="text-xs text-white/60">Overage at $12/credit</p>
        </div>
        <div class="bg-white/5 border border-brand-gold/20 rounded-2xl p-6 backdrop-blur-sm relative overflow-hidden">
          <div class="absolute top-0 inset-x-0 h-[3px] bg-gradient-to-r from-brand-gold to-brand-gold-light"></div>
          <p class="text-[0.625rem] font-bold tracking-[0.15em] uppercase text-brand-gold/80 mb-1">Pro</p>
          <p class="text-xs text-white/40 mb-4">Best for higher lead volume</p>
          <div class="text-display-xs font-heading text-white">$997</div>
          <p class="text-xs text-white/40 mb-4">/month &middot; 75 credits included</p>
          <p class="text-xs text-white/60">Overage at $10/credit</p>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-7 backdrop-blur-sm max-w-3xl mx-auto reveal">
        <p class="text-[0.625rem] font-bold tracking-[0.15em] uppercase text-brand-gold/80 mb-1">Credit Schedule</p>
        <p class="text-xs text-white/40 mb-4">You pay for outcomes, never idle time</p>
        <div class="space-y-2.5 text-sm border-t border-white/10 pt-4">
          <div class="flex justify-between text-white/60">
            <span>Signed CFA</span>
            <span class="font-semibold text-white">8 credits</span>
          </div>
          <div class="flex justify-between text-white/60">
            <span>Full intake completed (not signed)</span>
            <span class="font-semibold text-white">4 credits</span>
          </div>
          <div class="flex justify-between text-white/60">
            <span>Appointment set</span>
            <span class="font-semibold text-white">2 credits</span>
          </div>
          <div class="flex justify-between text-white/60">
            <span>Unsuccessful outbound attempt</span>
            <span class="font-semibold text-white">1 credit</span>
          </div>
          <div class="flex justify-between text-white/60">
            <span>Inbound call answered</span>
            <span class="font-semibold text-white">0.5 credits</span>
          </div>
        </div>
        <p class="text-[0.625rem] text-white/30 mt-4">Plans run on a 6-month contract, billed monthly. Unused credits expire at month end.</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FAQ
  ═══════════════════════════════════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-narrow">
      <div class="text-center mb-10 reveal">
        <span class="badge badge-brand">FAQ</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Questions firms ask before they rescue a list</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {[
          { q: "We already followed up on those.", a: "How many times? Most firms stop at 1 to 3. We do 8, on a set schedule." },
          { q: "Those leads are dead.", a: "Some are. Many never got a second call. We find out at no cost to you." },
          { q: "What's the catch?", a: "We want you to see how our team performs on your own leads before you spend a dollar." },
          { q: "Who do the clients sign with?", a: "Your firm. Your CFA, your name. We never take the case." },
          { q: "Is my data safe?", a: "We only ask for the fields we need to make the call. We skip anyone marked do not contact." },
          { q: "Isn't this just an answering service?", a: "Taking a message is not intake. Our team qualifies and closes." },
          { q: "What happens after the free results?", a: "You pick a plan. $497 or $997 a month, based on your volume. You pay for outcomes, not hours." },
        ].map((f, i) => (
          <details class="group rounded-xl border border-gray-200 bg-white p-5 md:p-6 reveal" style={`transition-delay: ${i * 50}ms`}>
            <summary class="flex items-center justify-between cursor-pointer text-base font-heading text-gray-900 list-none">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0 ml-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="text-sm text-gray-600 leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FINAL CTA
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-navy via-brand-800 to-brand-navy grain-overlay">
    <div class="absolute inset-0">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-brand-gold/15 rounded-full blur-3xl lp-float-slow"></div>
      <div class="absolute bottom-10 right-1/3 w-80 h-80 bg-brand-blue/15 rounded-full blur-3xl lp-float-slow-reverse"></div>
    </div>
    <div class="container-wide relative py-20 md:py-28">
      <div class="max-w-3xl mx-auto text-center reveal">
        <span class="badge bg-white/10 text-white/80 border-white/10 mb-6">Up to 1,000 Leads, Free</span>
        <h2 class="text-display-sm md:text-display-lg font-heading text-white mb-6">
          Stop writing off <span class="text-gradient-gold">cases you already paid for.</span>
        </h2>
        <div class="divider-gold-center mb-8"></div>
        <p class="text-xl text-white/60 mb-10">
