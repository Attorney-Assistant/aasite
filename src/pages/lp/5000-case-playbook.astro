---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="The 5,000 Case Playbook — Free Intake Strategy Call for Law Firm Owners"
  description="How Ethen Ostroff Law signed 5,000+ cases without attorneys ever touching intake. Five systems, one pay plan, and a follow-up cadence that gets to call 14. Book a 20-minute call."
  noindex={true}
  schema={{
    "@type": "WebPage",
    "name": "The 5,000 Case Playbook",
    "description": "A 20-minute intake strategy call for law firm owners, based on the five-system build behind 5,000+ signed cases.",
    "publisher": {
      "@type": "Organization",
      "name": "Attorney Assistant"
    }
  }}
>

  <!-- ══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[90vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="lp-orb lp-orb--1" aria-hidden="true"></div>
    <div class="lp-orb lp-orb--2" aria-hidden="true"></div>
    <div class="lp-orb lp-orb--3" aria-hidden="true"></div>
    <div class="grain-overlay"></div>

    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <div class="container-wide relative z-10 py-20 lg:py-28">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal">
          <div class="mb-5">
            <span class="lp-pulse-badge">
              <span class="lp-pulse-dot"></span>
              The Operations Playbook Series &middot; No. 01
            </span>
          </div>
          <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
            The 5,000 Case <br/><span class="text-gradient-gold">Playbook.</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-8 leading-relaxed">
            How Ethen Ostroff Law signed volume without the attorneys ever touching intake. Five systems, one pay plan, and a follow-up cadence most firms quit on by call three. Book a call and we'll show you how to copy them.
          </p>

          <!-- Stat ticker -->
          <div class="grid grid-cols-3 gap-4 mb-10">
            <div class="lp-hero-stat">
              <span class="lp-hero-stat-num lp-count" data-target="5000">0</span><span class="lp-hero-stat-num">+</span>
              <span class="lp-hero-stat-label">cases handled in a handful of years</span>
            </div>
            <div class="lp-hero-stat">
              <span class="lp-hero-stat-num lp-count" data-target="22">0</span>
              <span class="lp-hero-stat-label">contact attempts before a lead is closed</span>
            </div>
            <div class="lp-hero-stat">
              <span class="lp-hero-stat-num lp-count" data-target="15">0</span>
              <span class="lp-hero-stat-label">touches in the first 72 hours</span>
            </div>
          </div>

          <!-- What the call covers -->
          <div class="space-y-4 mb-10">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest">On Your Call We'll Cover</p>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
              </div>
              <div>
                <p class="text-base font-semibold text-white">Which of the five systems you're missing</p>
                <p class="text-sm text-gray-500 mt-0.5">Split role, graded leads, the cadence, the pay plan, or hour coverage.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
              </div>
              <div>
                <p class="text-base font-semibold text-white">What an attorney answering intake is costing you</p>
                <p class="text-sm text-gray-500 mt-0.5">The math on 5 non-billable hours a day, every day.</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center mt-0.5">
                <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
              </div>
              <div>
                <p class="text-base font-semibold text-white">The cadence that gets to call 14</p>
                <p class="text-sm text-gray-500 mt-0.5">Most firms stop at call three. Here's why that's the leak.</p>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Free &mdash; 20 minutes
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              No commitment
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Built inside a working law firm
            </div>
          </div>
        </div>

        <!-- Booking Widget -->
        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal lp-widget-glow" style="transition-delay: 150ms" id="book-now">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="flex items-center gap-3 mb-3">
              <div class="featured-icon featured-icon-md featured-icon-gold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
              </div>
              <div>
                <h2 class="text-lg font-heading text-gray-900">Book Your Ops Call</h2>
                <p class="text-xs text-gray-500">Free &mdash; 20 minutes</p>
              </div>
            </div>
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/magnet-5000-case-playbook?embed=true"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 lp-scroll-hint" aria-hidden="true">
      <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2">
        <div class="w-1 h-2.5 bg-brand-gold rounded-full lp-scroll-dot"></div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       OPENING — you do not have a lead problem
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 lp-section-lg">
    <div class="absolute inset-0">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-red-500/3 rounded-full blur-[100px]"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <!-- Left: Story -->
        <div class="reveal">
          <span class="badge bg-brand-gold/15 text-brand-gold border-brand-gold/20 mb-6">Why You Are Reading This</span>
          <h2 class="text-display-sm md:text-display-md font-heading text-white mb-5 leading-tight">
            You do not have a lead problem.
          </h2>
          <p class="text-base text-gray-400 leading-relaxed mb-5">
            Pull last month's leads. Count how many you actually reached, not how many you called once. Count how many got a second call on a Saturday. Count how many are sitting in a status called "no answer" that nobody has touched in nine days.
          </p>
          <p class="text-base text-gray-400 leading-relaxed mb-5">
            That pile is not a marketing failure. Your marketing worked. It put the lead in the building. What happened next is an operations problem, and operations problems get solved with roles, cadence, coverage and a pay plan, not a bigger ad budget.
          </p>
          <p class="text-base text-gray-400 leading-relaxed mb-6">
            Ethen Ostroff Law handled 5,000 cases in a handful of years with a simple rule underneath it: attorneys practice law, and a trained intake department does intake. Not "mostly." Not "when things get busy." Never.
          </p>
          <div class="lp-rule-box lp-rule-box--dark">
            <span class="lp-rule-box-label">What An Attorney Costs You On A Dial</span>
            <p class="text-sm text-gray-200 leading-relaxed mb-2">The average lawyer bills 3 of 8 hours. That's 38% utilization, and roughly 5 hours a day going to work that doesn't bill.</p>
            <p class="text-xs text-gray-400 mb-2">Source: Clio 2025 Legal Trends Report</p>
            <p class="text-sm font-semibold text-white">Every one of those 5 hours an attorney spends on a lead who won't answer is an hour no one is billing, and the lead still doesn't answer.</p>
          </div>
        </div>

        <!-- Right: who it's for / not for -->
        <div class="reveal space-y-6" style="transition-delay: 150ms">
          <div>
            <p class="text-xs font-bold text-brand-gold uppercase tracking-widest mb-4">Who This Is For</p>
            <div class="space-y-3">
              {[
                "You spend $5,000 a month or more on leads and can't tell which ones died of neglect",
                "Your intake is “whoever picks up”",
                "Your best closer is also your best lawyer, which means you're paying settlement rates for dialing",
                "You've been told to buy more leads to fix a conversion problem",
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-brand-gold flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/></svg>
                  <p class="text-sm text-gray-300 leading-snug">{item}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="border-t border-white/10 pt-6">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4">Who This Is Not For</p>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-gray-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              <p class="text-sm text-gray-400 leading-snug">Firms with no lead flow. Fix demand first, then come back. This playbook makes existing leads convert. It does not create them.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       FIVE SYSTEMS
  ═══════════════════════════════════════════════ -->
  <section class="section-padding bg-white">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-brand">The Playbook At A Glance</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Five systems. That's the whole thing.</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto mt-6">None of these are clever. All five are boring, written down, and enforced. That's why they work.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-5 max-w-4xl mx-auto mb-8">
        {[
          { num: "01", title: "Split the Role", desc: "Stop asking one person to answer, chase and close. Three jobs, three skill levels, three pay plans." },
          { num: "02", title: "Grade the Lead", desc: "Four lead types. They don't convert the same, so they don't get routed the same or paid the same." },
          { num: "03", title: "Run the Cadence", desc: "15 contact attempts in 3 days. Attorney review at 15. Up to 22 when the injury justifies it. Then close it." },
          { num: "04", title: "Pay for the 14th Call", desc: "A case closed on call 14 pays the dialer more than a case closed on call 2. That's the entire reason call 14 happens." },
        ].map((s, i) => (
          <div class="card p-6 md:p-7 reveal" style={`transition-delay: ${i * 60}ms`}>
            <div class="font-heading text-3xl text-brand-gold mb-3">{s.num}</div>
            <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide mb-2">{s.title}</h3>
            <p class="text-sm text-gray-500 leading-snug">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="card p-6 md:p-7 max-w-4xl mx-auto reveal" style="transition-delay: 240ms">
        <div class="font-heading text-3xl text-brand-gold mb-3">05</div>
        <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide mb-2">Cover the Hours Leads Actually Arrive</h3>
        <p class="text-sm text-gray-500 leading-snug">Nights and weekends aren't overflow. For PI, they're prime time.</p>
      </div>

      <div class="lp-quote-banner mt-10 max-w-3xl mx-auto reveal mb-10">
        Underneath all five: the attorney sets the criteria once and never touches a lead.
      </div>

      <div class="text-center reveal">
        <a href="#book-now" class="btn-primary btn-lg group inline-flex">
          Book Your Ops Call
          <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       THE CADENCE & PAY PLAN
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden lp-section-lg">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-brand-blue/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-10 reveal">
        <span class="badge bg-brand-gold/15 text-brand-gold border-brand-gold/20 mb-4">Systems 03 &amp; 04</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-5">
          15 touches in 3 days. <span class="text-gradient-gold">Then a decision.</span>
        </h2>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto">Ask a firm owner how many times they follow up. The answer is almost always five or six. Pull the activity log and the real number is two, maybe three, then the lead quietly moves to a status nobody reads.</p>
      </div>

      <div class="max-w-3xl mx-auto reveal mb-10 rounded-2xl border border-white/10 overflow-hidden">
        <div class="bg-white/5 text-white/70 text-xs font-bold uppercase tracking-widest px-5 py-3 grid grid-cols-3 gap-2">
          <span>Stage</span>
          <span>Window</span>
          <span>Attempts</span>
        </div>
        <div class="divide-y divide-white/10 text-sm">
          {[
            { stage: "Blitz", window: "First 72 hours", attempts: "15 minimum" },
            { stage: "Attorney review gate", window: "At attempt 15", attempts: "1 decision" },
            { stage: "Extended chase", window: "After the gate, if approved", attempts: "Up to 22 total" },
            { stage: "Close out", window: "After 22", attempts: "Stop" },
          ].map((row) => (
            <div class="grid grid-cols-3 gap-2 px-5 py-3 text-gray-300">
              <span class="font-semibold text-white">{row.stage}</span>
              <span>{row.window}</span>
              <span>{row.attempts}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="lp-quote-banner lp-quote-banner--gold max-w-2xl mx-auto reveal mb-6">
        "One more call can pay for your intake department."
      </div>
      <p class="text-center text-sm text-gray-500 mb-10 reveal">&mdash; Ethen Ostroff</p>

      <p class="text-base text-gray-400 max-w-2xl mx-auto text-center mb-14 reveal">
        A car crash lead came in from social. Two follow-up attempts, no answer, marked non-responsive. Ethen called it himself. Four passengers, catastrophic injuries. The file was worth roughly $500,000. Two attempts is what almost every firm runs. The difference between two and fifteen isn't effort. It's whether somebody's job and paycheck depend on attempt fifteen happening.
      </p>

      <div class="grid sm:grid-cols-2 gap-5 max-w-3xl mx-auto reveal">
        <div class="lp-fix-card-v2" style="border-color: rgba(239,68,68,0.25);">
          <p class="text-xs font-bold text-red-400 uppercase tracking-widest mb-3">Comp Plan That Fails</p>
          <ul class="space-y-2 text-sm text-gray-300">
            <li>Flat bonus per signed case</li>
            <li>Same payout for every lead type</li>
            <li>Paid on calls made</li>
            <li>Manager chases the cadence</li>
          </ul>
        </div>
        <div class="lp-fix-card-v2">
          <p class="text-xs font-bold text-brand-gold uppercase tracking-widest mb-3">Comp Plan That Works</p>
          <ul class="space-y-2 text-sm text-gray-300">
            <li>Bonus scales with attempt number</li>
            <li>Payout weighted by lead difficulty</li>
            <li>Paid on contact made and cases signed</li>
            <li>The pay plan chases the cadence</li>
          </ul>
        </div>
      </div>

      <div class="lp-rule-box max-w-3xl mx-auto reveal mt-8">
        <span class="lp-rule-box-label">Warning</span>
        <p class="text-base font-semibold text-gray-900">Do not pay on dials. You will get 200 two-second calls a day and no conversations. Pay on contacts made and cases signed.</p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       THE MATH
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white lp-section-lg">
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 via-brand-gold to-brand-blue"></div>
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge bg-brand-navy/10 text-brand-navy border-brand-navy/15 mb-4">The Staffing Math</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          One additional intake staff member for every 250 leads a month.
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          Every firm wants the industry average. Use your own number instead.
        </p>
      </div>

      <div class="max-w-2xl mx-auto reveal mb-10 rounded-2xl border border-gray-200 overflow-hidden">
        <div class="bg-brand-navy text-white text-xs font-bold uppercase tracking-widest px-5 py-3 flex justify-between">
          <span>Run Your Number</span>
          <span class="text-white/60 normal-case font-normal">Illustration: 100 leads/mo, $8,000 avg. fee</span>
        </div>
        <div class="divide-y divide-gray-100">
          {[
            { label: "Leads last month", val: "100" },
            { label: "Leads reached by a human at least once", val: "60" },
            { label: "Leads never reached", val: "40" },
            { label: "Sign rate on reached leads", val: "20%" },
            { label: "More leads reached at 15 touches instead of 3", val: "13" },
            { label: "New cases per month", val: "2.6" },
            { label: "Average fee per case", val: "$8,000" },
          ].map((row) => (
            <div class="flex items-center justify-between px-5 py-3 text-sm">
              <span class="text-gray-600">{row.label}</span>
              <span class="font-semibold text-gray-900">{row.val}</span>
            </div>
          ))}
          <div class="flex items-center justify-between px-5 py-4 bg-brand-gold/10">
            <span class="font-heading text-gray-900">Annual revenue sitting in the gap</span>
            <span class="font-heading text-2xl text-brand-navy">$249,600</span>
          </div>
        </div>
      </div>

      <div class="lp-rule-box max-w-3xl mx-auto reveal">
        <span class="lp-rule-box-label">The Same Math At Scale</span>
        <p class="text-base font-semibold text-gray-900">
          1,000 leads a month with 20% mishandled puts millions at risk per month. 50 leads a month with 20% mishandled puts tens of thousands at risk. The percentage doesn't care how big you are.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       THE SCOREBOARD
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 lp-section-lg">
    <div class="absolute inset-0">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-gold/5 rounded-full blur-[120px]"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-14 reveal">
