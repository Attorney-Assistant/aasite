---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Free Intake Review for Law Firms Under $250K | Attorney Assistant"
  description="Your firm doesn't need more chaos. It needs intake that actually gets handled. Book a free intake review and see where leads are slipping through."
  noindex={true}
>

  <!-- ═══════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[90vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="smb-orb smb-orb--1" aria-hidden="true"></div>
    <div class="smb-orb smb-orb--2" aria-hidden="true"></div>
    <div class="grain-overlay"></div>
    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <div class="container-wide relative z-10 py-20 lg:py-28">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal">
          <div class="mb-5">
            <span class="smb-pulse-badge">
              <span class="smb-pulse-dot"></span>
              For Law Firm Owners Under $250K
            </span>
          </div>
          <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
            Your Firm Doesn't Need More Chaos. <br/><span class="text-gradient-gold">It Needs Intake That Gets Handled.</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-4 leading-relaxed">
            Missed calls. Slow follow-up. Weak intake. Leads that disappear before they ever become signed cases.
          </p>
          <p class="text-base text-gray-400 mb-8 leading-relaxed">
            Attorney Assistant helps law firms build the team, coverage, and systems needed to stop wasting the opportunities they already have.
          </p>

          <!-- Animated stat ticker -->
          <div class="grid grid-cols-3 gap-4 mb-10">
            <div class="smb-hero-stat">
              <span class="smb-hero-stat-num smb-count" data-target="78">0</span><span class="smb-hero-stat-num">%</span>
              <span class="smb-hero-stat-label">of clients sign with the first firm that responds</span>
            </div>
            <div class="smb-hero-stat">
              <span class="smb-hero-stat-num smb-count" data-target="5">0</span><span class="smb-hero-stat-num">min</span>
              <span class="smb-hero-stat-label">before a lead goes cold</span>
            </div>
            <div class="smb-hero-stat">
              <span class="smb-hero-stat-num smb-count" data-target="40">0</span><span class="smb-hero-stat-num">%</span>
              <span class="smb-hero-stat-label">of calls to law firms go unanswered</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-4 text-sm text-gray-400">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Free intake review
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              No commitment
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
              Free secret shop included
            </div>
          </div>
        </div>

        <!-- Booking Widget -->
        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal smb-widget-glow" style="transition-delay: 150ms" id="book-now">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="flex items-center gap-3 mb-3">
              <div class="featured-icon featured-icon-md featured-icon-gold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
              </div>
              <div>
                <h2 class="text-lg font-heading text-gray-900">Book Your Free Intake Review</h2>
                <p class="text-xs text-gray-500">Free &mdash; 30 minutes &mdash; includes secret shop</p>
              </div>
            </div>
            <div class="meetings-iframe-container" data-src="https://meet.attorneyassistant.com/meetings/attorney-assistant/review?embed=true"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 smb-scroll-hint" aria-hidden="true">
      <div class="w-6 h-10 rounded-full border-2 border-white/20 flex justify-center pt-2">
        <div class="w-1 h-2.5 bg-brand-gold rounded-full smb-scroll-dot"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       THE LEAK — Before you spend more on marketing
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 smb-section-lg">
    <div class="absolute inset-0">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-red-500/3 rounded-full blur-[100px]"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="reveal">
          <span class="badge bg-red-500/10 text-red-400 border-red-500/20 mb-6">Before You Spend More</span>
          <h2 class="text-display-sm md:text-display-md font-heading text-white mb-5 leading-tight">
            Before You Spend More on Marketing, <span class="text-gradient-gold">Fix the Leak.</span>
          </h2>
          <p class="text-lg text-gray-400 leading-relaxed mb-6">
            Most small law firms don't lose money because they lack ambition. They lose money because the firm is still depending on the owner to check everything, chase everyone, answer after-hours gaps, follow up with leads, and somehow run the business too.
          </p>
          <p class="text-base text-gray-500 leading-relaxed mb-6">
            When leads come in and no one responds fast enough, they move on. When follow-up is inconsistent, cases go cold. When intake is messy, marketing dollars get wasted.
          </p>
          <p class="text-xl font-heading text-brand-gold">
            Attorney Assistant helps you clean that up.
          </p>
        </div>

        <!-- Simulated phone scenario -->
        <div class="reveal" style="transition-delay: 150ms">
          <div class="smb-phone-sim">
            <div class="smb-phone-header">
              <div class="smb-phone-header-left">
                <svg class="w-4 h-4 text-red-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.694.198-.983 1.03-.503 1.576a12.07 12.07 0 005.147 3.834c.595.23 1.26-.092 1.392-.719l.236-1.12a1.5 1.5 0 011.667-1.172l3.361.56A1.5 1.5 0 0116 12.69v1.81A1.5 1.5 0 0114.5 16h-.628a12.565 12.565 0 01-11.757-8.142A12.49 12.49 0 012 3.5z" clip-rule="evenodd" /></svg>
                <span>What Happens When Someone Calls</span>
              </div>
              <div class="smb-phone-status">
                <span class="smb-phone-status-dot"></span>
                Simulated
              </div>
            </div>
            <div class="smb-phone-body">
              <div class="smb-phone-event smb-phone-event--ring">
                <div class="smb-phone-time">9:14 AM</div>
                <div class="smb-phone-msg">
                  <div class="smb-phone-msg-row">
                    <span class="smb-phone-msg-title">Incoming Call &mdash; New Lead</span>
                    <span class="smb-phone-badge smb-phone-badge--ring">Ringing</span>
                  </div>
                  <p class="smb-phone-msg-desc">Car accident. Needs representation. Found you on Google.</p>
                </div>
              </div>
              <div class="smb-phone-event smb-phone-event--miss">
                <div class="smb-phone-time">9:14 AM</div>
                <div class="smb-phone-msg">
                  <div class="smb-phone-msg-row">
                    <span class="smb-phone-msg-title">Call Missed</span>
                    <span class="smb-phone-badge smb-phone-badge--miss">Voicemail</span>
                  </div>
                  <p class="smb-phone-msg-desc">Team was on the other line. No overflow coverage.</p>
                </div>
              </div>
              <div class="smb-phone-event smb-phone-event--gone">
                <div class="smb-phone-time">9:15 AM</div>
                <div class="smb-phone-msg">
                  <div class="smb-phone-msg-row">
                    <span class="smb-phone-msg-title">Lead Called Next Firm</span>
                    <span class="smb-phone-badge smb-phone-badge--gone">Lost</span>
                  </div>
                  <p class="smb-phone-msg-desc">Signed with a competitor 12 minutes later. You'll never know they called.</p>
                </div>
              </div>
            </div>
            <div class="smb-phone-footer">
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" /></svg>
              <span>This happens multiple times per week at most firms.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT WE FIX — 5 problem cards
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white smb-section-lg">
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 via-brand-gold to-brand-blue"></div>
    <div class="container-wide">
      <div class="text-center mb-14 reveal">
        <span class="badge bg-brand-navy/10 text-brand-navy border-brand-navy/15 mb-4">What We Help Fix</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          Five problems quietly killing your growth.
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal">
        <div class="smb-fix-card">
          <div class="smb-fix-icon smb-fix-icon--red">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mt-4 mb-2">Missed Calls</h3>
          <p class="text-sm text-gray-500">If prospects can't reach your firm, they're not waiting patiently. They're calling someone else.</p>
          <div class="smb-fix-bar"><div class="smb-fix-bar-fill smb-fix-bar-fill--red" style="width: 20%"></div></div>
          <p class="text-xs text-red-500 font-medium mt-2">Critical gap</p>
        </div>
        <div class="smb-fix-card">
          <div class="smb-fix-icon smb-fix-icon--amber">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mt-4 mb-2">Slow Lead Response</h3>
          <p class="text-sm text-gray-500">Speed matters. The faster your firm responds, the better chance you have of turning interest into signed cases.</p>
          <div class="smb-fix-bar"><div class="smb-fix-bar-fill smb-fix-bar-fill--amber" style="width: 35%"></div></div>
          <p class="text-xs text-amber-600 font-medium mt-2">Inconsistent</p>
        </div>
        <div class="smb-fix-card">
          <div class="smb-fix-icon smb-fix-icon--amber">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mt-4 mb-2">Inconsistent Follow-Up</h3>
          <p class="text-sm text-gray-500">One call is not a follow-up system. It's a wish with a voicemail attached.</p>
          <div class="smb-fix-bar"><div class="smb-fix-bar-fill smb-fix-bar-fill--amber" style="width: 40%"></div></div>
          <p class="text-xs text-amber-600 font-medium mt-2">Weak cadence</p>
        </div>
        <div class="smb-fix-card">
          <div class="smb-fix-icon smb-fix-icon--red">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mt-4 mb-2">Intake That Doesn't Convert</h3>
          <p class="text-sm text-gray-500">Leads are only valuable if your firm has a process to move them from "interested" to "signed."</p>
          <div class="smb-fix-bar"><div class="smb-fix-bar-fill smb-fix-bar-fill--red" style="width: 25%"></div></div>
          <p class="text-xs text-red-500 font-medium mt-2">Revenue leak</p>
        </div>
        <div class="smb-fix-card">
          <div class="smb-fix-icon smb-fix-icon--red">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
          </div>
          <h3 class="text-lg font-heading text-gray-900 mt-4 mb-2">Nights, Weekends &amp; Overflow</h3>
          <p class="text-sm text-gray-500">Your firm still gets opportunities when your team is busy, closed, or buried. Those leads still need coverage.</p>
          <div class="smb-fix-bar"><div class="smb-fix-bar-fill smb-fix-bar-fill--red" style="width: 15%"></div></div>
          <p class="text-xs text-red-500 font-medium mt-2">Major exposure</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECRET SHOP — unique differentiator
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 smb-section-lg">
    <div class="absolute top-20 right-0 w-[500px] h-[500px] bg-brand-gold/8 rounded-full blur-[100px]"></div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="reveal">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" /></svg>
            Included Free With Your Review
          </span>
          <h2 class="text-display-sm md:text-display-md font-heading text-white mb-6 leading-tight">
            We'll Secret Shop <span class="text-gradient-gold">Your Firm.</span>
          </h2>
          <p class="text-lg text-gray-300 leading-relaxed mb-4">
            Before your call, we'll have a specialist pose as a prospective client and test your intake process &mdash; calls, forms, after-hours. The works.
          </p>
          <p class="text-base text-gray-400 leading-relaxed mb-8">
            Then we'll walk you through exactly what happened. No guesswork. Just a real-world look at what your prospects actually experience when they try to hire you.
          </p>
          <p class="text-sm text-gray-500 italic">Most firms are shocked by what they find. And that's exactly why it's valuable.</p>
        </div>

        <div class="reveal" style="transition-delay: 200ms">
          <div class="space-y-4">
            <div class="smb-shop-step">
              <div class="smb-shop-num">1</div>
              <div>
                <p class="text-base font-semibold text-white">We call your firm</p>
                <p class="text-sm text-gray-400 mt-0.5">During business hours, after hours, and on a weekend.</p>
              </div>
            </div>
            <div class="smb-shop-step">
              <div class="smb-shop-num">2</div>
              <div>
                <p class="text-base font-semibold text-white">We submit a lead through your website</p>
                <p class="text-sm text-gray-400 mt-0.5">And time how long it takes to get a response.</p>
              </div>
            </div>
            <div class="smb-shop-step">
              <div class="smb-shop-num">3</div>
              <div>
                <p class="text-base font-semibold text-white">We document everything</p>
                <p class="text-sm text-gray-400 mt-0.5">Response time, professionalism, follow-up cadence, gaps.</p>
              </div>
            </div>
            <div class="smb-shop-step">
              <div class="smb-shop-num">4</div>
              <div>
                <p class="text-base font-semibold text-white">We walk you through the results</p>
                <p class="text-sm text-gray-400 mt-0.5">On your free intake review call. No sugar-coating.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       WHAT WE DO
  ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-white smb-section-lg">
    <div class="container-wide">
      <div class="text-center mb-14 reveal">
        <span class="badge bg-brand-gold/10 text-brand-gold border-brand-gold/20 mb-4">What We Do</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          We own the outcome, not just the task.
        </h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
          We're not here to toss another tool at your firm and wish you luck. We help build the structure behind the work so things actually get done.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal">
        <div class="p-6 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-gold/30 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-heading text-gray-900 mb-2">Answer more calls</h3>
          <p class="text-sm text-gray-500">No more leads going to voicemail. Every call gets handled.</p>
        </div>
        <div class="p-6 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-gold/30 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-heading text-gray-900 mb-2">Respond faster to new leads</h3>
          <p class="text-sm text-gray-500">Speed to lead under 5 minutes. Not hours. Not days.</p>
        </div>
        <div class="p-6 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-gold/30 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-heading text-gray-900 mb-2">Follow up consistently</h3>
          <p class="text-sm text-gray-500">Persistent, structured outreach until the lead converts or disqualifies.</p>
        </div>
        <div class="p-6 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-gold/30 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-heading text-gray-900 mb-2">Reduce the owner's burden</h3>
          <p class="text-sm text-gray-500">Stop being the one who checks everything. Get your time back.</p>
        </div>
        <div class="p-6 rounded-xl bg-gray-50 border border-gray-100 hover:border-brand-gold/30 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
          <h3 class="font-heading text-gray-900 mb-2">Create a cleaner intake process</h3>
          <p class="text-sm text-gray-500">From first contact to signed retainer, nothing falls through the cracks.</p>
        </div>
