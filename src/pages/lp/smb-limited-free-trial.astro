---
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";

/**
 * SMB Team exclusive: free 30-day Staffline trial.
 * Unlinked page, reached only via direct URL. Excluded from the sitemap in
 * astro.config.mjs and noindexed by the layout default. Staffline only:
 * never mention Frontline or Backline here.
 */

const SMB_LOGO = "https://smbteam.com/wp-content/uploads/2026/03/header-logo-300x61.png";

// Base embed URL carries the fixed SMB attribution UTMs. Any query params on
// the page URL itself (per-client or per-rep codes) are forwarded onto this
// by the inline script in the booking section.
const BOOKING_SRC =
  "https://meet.attorneyassistant.com/meetings/attorney-assistant/smb-free-trial-offer?embed=true&utm_source=smb_referral&utm_medium=landing_page&utm_campaign=smb_free_trial";

const wRows = [
  { label: "Who", body: "Attorney Assistant, SMB Team's sister company and the law firm operations problem solvers behind intake, follow-up, and back office for firms like yours." },
  { label: "What", body: "A free 30-day trial of a live virtual assistant, a trained specialist who takes on the work your firm needs to grow but hates to manage." },
  { label: "When", body: "For a limited time, and only the first 30 SMB Team clients who book get in." },
  { label: "Where", body: "A quick virtual meeting with one of our account executives, booked right on this page, no need to go anywhere else." },
  { label: "Why", body: "Because missed calls are missed cases, and one month with a real assistant on your team will prove exactly how much revenue you've been leaking." },
];

const steps = [
  { step: "1", title: "Find the leak", desc: "We look at where your firm is losing time and money." },
  { step: "2", title: "Place the team", desc: "A specialist gets matched to your firm." },
  { step: "3", title: "You direct the work", desc: "It's your systems, your priorities." },
  { step: "4", title: "We co-manage it", desc: "QA and support the whole 30 days." },
];
---

<SimpleCampaignLayout
  title="Free 30-Day Trial: Attorney Assistant for SMB Team Clients"
  description="An exclusive for SMB Team clients: a free 30-day trial of a dedicated Attorney Assistant virtual assistant. Only 30 spots. Book your trial meeting on this page."
  minimalHeader={true}
  headerCtaHref="#booking"
  headerCtaLabel="Book your free trial"
  hideFooter={true}
>

  <!-- Bangers for the comic display headline (loaded by ComicCampaignLayout elsewhere; this page loads it itself) -->
  <link slot="above-header" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="above-header" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap" rel="stylesheet" />

  <!-- Co-brand bar: SMB Team presents, dark background for their light logo -->
  <div slot="above-header" class="bg-brand-950 border-b border-white/10">
    <div class="container-wide flex items-center justify-center gap-4 py-2.5">
      <img src={SMB_LOGO} alt="SMB Team" class="h-6 md:h-7 w-auto" loading="eager" />
      <span class="text-white/40 text-xs font-semibold uppercase tracking-[0.2em]">presents</span>
      <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="h-6 md:h-7 w-auto" loading="eager" />
    </div>
  </div>

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-16 md:py-24">
    <div class="grain-overlay"></div>
    <div class="smb-orb smb-orb--gold" aria-hidden="true"></div>
    <div class="smb-orb smb-orb--blue" aria-hidden="true"></div>
    <div class="container-wide relative z-10">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-10 items-center">

        <div class="text-center lg:text-left">
          <div class="reveal">
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-gold">An exclusive for SMB Team clients</span>
            <div class="divider-gold mt-4 mx-auto lg:mx-0"></div>
          </div>

          <h1 class="smb-comic-display text-white mt-8 reveal" style="transition-delay: 80ms;">
            One meeting.<br /> <span class="text-brand-gold">One free month.</span>
          </h1>

          <div class="mt-6 reveal" style="transition-delay: 140ms;">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-bold uppercase tracking-wide bg-brand-gold/10 text-brand-gold border border-brand-gold/25">
              <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
              Only 30 spots
            </span>
          </div>

          <p class="mt-6 text-base md:text-lg text-white/80 leading-relaxed max-w-2xl mx-auto lg:mx-0 reveal" style="transition-delay: 200ms;">
            SMB Team fills your funnel. Our sister company Attorney Assistant makes sure those leads become signed cases.
          </p>

          <div class="mt-8 reveal" style="transition-delay: 260ms;">
            <a href="#booking" class="btn-primary btn-lg group">
              Book your free trial
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
            </a>
            <p class="mt-3 text-sm text-white/50">For a limited time. No pitch deck, no pressure.</p>
          </div>
        </div>

        <!-- The assistant's queue: real Staffline work, cleared while you watch -->
        <div class="reveal-scale" style="transition-delay: 200ms;">
          <div class="smb-queue-card" id="smb-queue">
            <div class="smb-queue-head">
              <span class="smb-queue-eyebrow">Your assistant's queue</span>
              <span class="smb-queue-count" data-queue-count>Handled: 0 of 6</span>
            </div>
            <ul class="smb-queue-list">
              {[
                "Open the new case file, send the letter of rep",
                "Request medical records on the Ramirez matter",
                "Check bill balances and lien status",
                "Clear the intake inbox, log every lead",
                "Update the CRM, move 12 stalled matters",
                "Confirm tomorrow's client appointments",
              ].map((task) => (
                <li class="smb-queue-item" data-queue-item>
                  <span class="smb-queue-box" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path class="smb-queue-tick" d="M3 8.5l3.2 3.2L13 4.8" /></svg>
                  </span>
                  <span class="smb-queue-label">{task}</span>
                  <span class="smb-queue-chip" aria-hidden="true">Done</span>
                </li>
              ))}
            </ul>
            <div class="smb-queue-stamp" data-queue-stamp>
              <span class="smb-queue-stamp-title">All clear.</span>
              <span class="smb-queue-stamp-sub">Your week, handled by your assistant.</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════ WHO / WHAT / WHEN / WHERE / WHY ═══════════════ -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="max-w-3xl mx-auto divide-y divide-gray-200">
        {wRows.map((row, i) => (
          <div class="grid grid-cols-[5.5rem_1fr] md:grid-cols-[7rem_1fr] gap-4 md:gap-8 py-6 reveal" style={`transition-delay: ${i * 60}ms`}>
            <span class="text-xs font-bold uppercase tracking-[0.15em] text-brand-gold-dark pt-1">{row.label}</span>
            <p class="text-base md:text-lg text-gray-700 leading-relaxed">{row.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ STAT STRIP ═══════════════ -->
  <section class="section-padding bg-brand-gold-light">
    <div class="container-wide">
      <div class="text-center mb-10 md:mb-12 reveal">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-gold-dark">The offer, by the numbers</span>
        <div class="divider-gold-center mt-4"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        <div class="card p-8 text-center reveal">
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-brand-navy leading-none">1</p>
          <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-gray-600 leading-snug">Person, your firm only. Never shared.</p>
        </div>
        <div class="card p-8 text-center reveal" style="transition-delay: 80ms">
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-brand-navy leading-none"><span data-countup="40">40</span> <span class="text-2xl align-top">hrs</span></p>
          <p class="mt-4 text-sm font-semibold uppercase tracking-wide text-gray-600 leading-snug">A week on your matters, trained and co-managed by us</p>
        </div>
        <div class="smb-shine rounded-2xl p-8 text-center bg-brand-gold shadow-lg reveal-scale" style="transition-delay: 160ms">
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-brand-navy leading-none">$0</p>
          <p class="mt-4 text-sm font-bold uppercase tracking-wide text-brand-navy leading-snug">Your first 30 days, on us</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ HOW IT WORKS ═══════════════ -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-gold-dark">How it works</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">From first meeting to a working assistant</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {steps.map((s, i) => (
          <div class="text-center reveal" style={`transition-delay: ${i * 80}ms`}>
            <div class={`w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-lg border-2 ${i === steps.length - 1 ? 'bg-brand-gold border-brand-gold text-brand-navy' : 'bg-white border-brand-navy text-brand-navy'}`}>
              {s.step}
            </div>
            <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide mb-2">{s.title}</h3>
            <p class="text-sm text-gray-500 leading-snug">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════ BOOKING ═══════════════ -->
  <section class="section-padding bg-gray-25 scroll-mt-20" id="booking">
    <div class="container-narrow">
      <div class="text-center mb-8 reveal">
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900">Grab one of the 30 spots</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="mt-5 text-lg text-gray-500">Pick a time below, it takes two minutes.</p>
      </div>

      <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-gray-200 reveal" style="transition-delay: 100ms">
        <div class="bg-white rounded-xl p-4 md:p-5">
          <div class="meetings-iframe-container" data-src={BOOKING_SRC} style="min-height: 660px;"></div>

          <script is:inline>
          (function () {
            // Forward any params on the page URL (per-client or per-rep codes)
            // onto the widget embed URL. The three SMB attribution UTMs
            // (utm_source / utm_medium / utm_campaign) are fixed for this
            // offer and never overridden.
            var el = document.querySelector('#booking .meetings-iframe-container');
            if (!el) return;
            var url = new URL(el.getAttribute('data-src'));
            var q = new URLSearchParams(window.location.search);
            q.forEach(function (v, k) {
              if (k === 'utm_source' || k === 'utm_medium' || k === 'utm_campaign') return;
              url.searchParams.set(k, v);
            });
            el.setAttribute('data-src', url.toString());
          })();
          </script>
        </div>
      </div>
    </div>
  </section>

  <!-- HubSpot Meetings Embed Script (geo-gated) -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p></div>';
        });
      }
    });
  </script>

  <!-- ═══════════════ FINAL CTA / CLOSING ═══════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-16 md:py-24">
    <div class="grain-overlay"></div>
    <div class="smb-orb smb-orb--gold" aria-hidden="true"></div>
    <div class="container-narrow relative z-10 text-center">
      <h2 class="text-display-sm md:text-display-md font-heading text-white reveal">
        Ready to see what one month buys you?
      </h2>
      <div class="mt-8 reveal" style="transition-delay: 100ms">
        <a href="#booking" class="btn-primary btn-lg group">
          Book your free trial
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
      </div>

      <img src="/brand/logos/long_white_logo.svg" alt="Attorney Assistant" class="h-9 w-auto mx-auto mt-14 reveal" style="transition-delay: 160ms" />

      <div class="mt-8 reveal" style="transition-delay: 220ms">
        <p class="text-xs text-white/40 mb-4">This offer is exclusive to SMB Team clients. Please don't forward this page.</p>
        <p class="text-sm text-white/60 leading-relaxed">
          (215) 337-2677 &nbsp;&middot;&nbsp; info@attorneyassistant.com<br />
          21 East 5th Ave., Suite 102, Conshohocken, PA 19428
        </p>
      </div>

      <p class="smb-closing-line text-brand-gold mt-10 reveal" style="transition-delay: 280ms">Find us where law firms need rescuing</p>
    </div>
  </section>

  <style>
    /* Comic display headline: Bangers, all caps, per the campaign display pattern */
    .smb-comic-display {
      font-family: 'Bangers', var(--font-heading), cursive;
      font-size: clamp(3rem, 8vw, 5.5rem);
      line-height: 1.05;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .smb-closing-line {
      font-family: 'Bangers', var(--font-heading), cursive;
      font-size: 1.25rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* ── Ambient floating orbs (brand dark-section recipe) ── */
    .smb-orb {
      position: absolute;
      width: 480px;
      height: 480px;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
    }
    .smb-orb--gold {
      top: -18%;
      right: -10%;
      background: radial-gradient(circle, rgba(249, 166, 45, 0.12) 0%, transparent 65%);
      animation: smb-drift 12s ease-in-out infinite alternate;
    }
    .smb-orb--blue {
      bottom: -22%;
      left: -12%;
      background: radial-gradient(circle, rgba(81, 166, 220, 0.14) 0%, transparent 65%);
      animation: smb-drift 15s ease-in-out infinite alternate-reverse;
    }
    @keyframes smb-drift {
      from { transform: translate(0, 0); }
      to { transform: translate(-40px, 32px); }
    }

    /* ── The assistant's queue card ── */
    .smb-queue-card {
      background: #ffffff;
      border-radius: 1rem;
      box-shadow: 0 24px 60px -12px rgba(9, 22, 43, 0.55);
      padding: 1.5rem;
      transform: rotate(-1deg);
      position: relative;
    }
    @media (min-width: 1024px) {
      .smb-queue-card { padding: 1.75rem; }
    }
    .smb-queue-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding-bottom: 0.875rem;
      border-bottom: 1px solid #EAECF0;
    }
    .smb-queue-eyebrow {
      font-size: 0.6875rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #d98a00;
    }
    .smb-queue-count {
      font-size: 0.6875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #667085;
      font-variant-numeric: tabular-nums;
    }
    .smb-queue-list {
      margin: 0.5rem 0 0;
      padding: 0;
      list-style: none;
    }
    .smb-queue-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0;
      border-bottom: 1px solid #F2F4F7;
      transition: opacity 0.45s ease;
    }
    .smb-queue-item:last-child { border-bottom: 0; }
    .smb-queue-box {
      flex-shrink: 0;
      width: 1.375rem;
      height: 1.375rem;
      border-radius: 0.375rem;
      border: 2px solid #D0D5DD;
      background: #ffffff;
      color: #15385f;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.35s ease, border-color 0.35s ease;
    }
    .smb-queue-box svg { width: 0.875rem; height: 0.875rem; }
    .smb-queue-tick {
      stroke-dasharray: 20;
      stroke-dashoffset: 20;
      transition: stroke-dashoffset 0.4s ease 0.1s;
    }
    .smb-queue-label {
      flex: 1;
      min-width: 0;
      font-size: 0.875rem;
      font-weight: 500;
      color: #344054;
      position: relative;
      transition: color 0.45s ease;
    }
    .smb-queue-label::after {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      height: 1.5px;
      width: 0;
      background: #98A2B3;
      transition: width 0.45s ease 0.15s;
    }
    .smb-queue-chip {
      flex-shrink: 0;
      font-size: 0.625rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #d98a00;
      background: #fef6e8;
      border: 1px solid rgba(249, 166, 45, 0.25);
      border-radius: 999px;
      padding: 0.125rem 0.5rem;
      opacity: 0;
      transform: translateY(3px);
      transition: opacity 0.35s ease 0.35s, transform 0.35s ease 0.35s;
    }
    .smb-queue-item.is-done { opacity: 0.55; }
    .smb-queue-item.is-done .smb-queue-box {
      background: #f9a62d;
      border-color: #f9a62d;
    }
    .smb-queue-item.is-done .smb-queue-tick { stroke-dashoffset: 0; }
    .smb-queue-item.is-done .smb-queue-label { color: #667085; }
    .smb-queue-item.is-done .smb-queue-label::after { width: 100%; }
    .smb-queue-item.is-done .smb-queue-chip { opacity: 1; transform: translateY(0); }
    .smb-queue-card.is-resetting .smb-queue-item,
    .smb-queue-card.is-resetting .smb-queue-item * { transition: none; }
    .smb-queue-stamp {
      display: flex;
      align-items: baseline;
      gap: 0.625rem;
      margin-top: 0.875rem;
      padding-top: 0.875rem;
      border-top: 1px solid #EAECF0;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .smb-queue-stamp.is-visible { opacity: 1; transform: translateY(0); }
    .smb-queue-stamp-title {
      font-family: 'Bangers', var(--font-heading), cursive;
      font-size: 1.375rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #15385f;
    }
    .smb-queue-stamp-sub { font-size: 0.8125rem; color: #667085; }

    /* ── One-time shine sweep on the $0 emphasis card ── */
    .smb-shine { position: relative; overflow: hidden; }
    .smb-shine::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: -75%;
      width: 50%;
      background: linear-gradient(105deg, transparent 0%, rgba(255, 255, 255, 0.45) 50%, transparent 100%);
      transform: skewX(-20deg);
    }
    .smb-shine.is-visible::after { animation: smb-shine-sweep 1.1s ease 0.5s 1 both; }
    @keyframes smb-shine-sweep {
      from { left: -75%; }
      to { left: 125%; }
    }

    @media (prefers-reduced-motion: reduce) {
      .smb-orb--gold, .smb-orb--blue { animation: none; }
      .smb-shine.is-visible::after { animation: none; }
      .smb-queue-card { transform: none; }
      .smb-queue-item, .smb-queue-item *, .smb-queue-stamp { transition: none; }
    }
  </style>

  <!-- Queue check-off loop, stat count-up -->
  <script is:inline>
    (function () {
      'use strict';
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── The assistant's queue ──
      var card = document.getElementById('smb-queue');
      if (card) {
        var items = Array.prototype.slice.call(card.querySelectorAll('[data-queue-item]'));
        var count = card.querySelector('[data-queue-count]');
        var stamp = card.querySelector('[data-queue-stamp]');
        var total = items.length;

        var setDone = function (n) {
          items.forEach(function (el, i) { el.classList.toggle('is-done', i < n); });
          if (count) count.textContent = 'Handled: ' + n + ' of ' + total;
          if (stamp) stamp.classList.toggle('is-visible', n === total);
        };

        if (reduceMotion) {
          // Static end state: everything handled, no loop.
          setDone(total);
        } else {
          var idx = 0;
          var running = false;
          var timer = null;

          var step = function () {
            if (!running) return;
            if (idx < total) {
              idx++;
              setDone(idx);
              timer = setTimeout(step, idx === total ? 3200 : 1300);
            } else {
              // Reset instantly (transitions suppressed), then start over.
              card.classList.add('is-resetting');
              idx = 0;
              setDone(0);
              // Force a reflow so the reset paints without transitions.
              void card.offsetWidth;
              card.classList.remove('is-resetting');
              timer = setTimeout(step, 900);
            }
          };

          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting && !running) {
                running = true;
                timer = setTimeout(step, 800);
              } else if (!entry.isIntersecting && running) {
                running = false;
                clearTimeout(timer);
              }
            });
          }, { threshold: 0.35 });
          io.observe(card);
        }
      }

      // ── Stat count-up ──
      var counters = document.querySelectorAll('[data-countup]');
      if (counters.length && !reduceMotion && 'IntersectionObserver' in window) {
        var cio = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            cio.unobserve(entry.target);
            var el = entry.target;
            var target = parseInt(el.getAttribute('data-countup'), 10) || 0;
            var start = null;
            var tick = function (ts) {
              if (start === null) start = ts;
              var p = Math.min((ts - start) / 900, 1);
              var eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(eased * target));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        }, { threshold: 0.5 });
        counters.forEach(function (el) { cio.observe(el); });
      }
    })();
  </script>

</SimpleCampaignLayout>
