---
import BaseLayout from "@layouts/BaseLayout.astro";
import { MEETING_URLS } from "@/config/forms";

const SCHEDULER_URL = MEETING_URLS.smbReferral;
---

<BaseLayout
  title="SMB Referral Scheduler"
  description="Internal scheduling page for the SMB team to book referral calls."
  noindex={true}
>

  <section class="section-padding bg-gray-50">
    <div class="container-narrow">
      <div class="max-w-xl mx-auto text-center mb-10 reveal">
        <h1 class="text-display-sm md:text-display-md font-heading text-gray-900">SMB Referral Scheduler</h1>
        <div class="divider-gold-center mt-4"></div>
      </div>

      <div class="max-w-xl mx-auto mb-8 reveal" style="transition-delay: 0.05s;">
        <div class="card p-6 sm:p-7 border-l-4 border-l-brand-gold">
          <div class="flex items-start gap-3.5 mb-5">
            <div class="featured-icon featured-icon-md featured-icon-gold flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </div>
            <p class="font-heading text-gray-900 pt-1.5 leading-snug">This page is for use by the members of SMB Team only.</p>
          </div>
          <ul class="space-y-3 text-sm text-gray-600 leading-relaxed">
            <li class="flex gap-2.5">
              <span class="text-brand-gold mt-1.5 flex-shrink-0">&bull;</span>
              <span>Put your name in the <strong class="text-gray-900 font-semibold">SMB Referrer</strong> field after selecting a time.</span>
            </li>
            <li class="flex gap-2.5">
              <span class="text-brand-gold mt-1.5 flex-shrink-0">&bull;</span>
              <span>You're booking this call on your referral's behalf. Enter <strong class="text-gray-900 font-semibold">their</strong> name, email, phone, and company, not yours.</span>
            </li>
            <li class="flex gap-2.5">
              <span class="text-brand-gold mt-1.5 flex-shrink-0">&bull;</span>
              <span><strong class="text-gray-900 font-semibold">30 minutes</strong> is our default, but you can choose <strong class="text-gray-900 font-semibold">15</strong> if the client would prefer it short.</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-xl mx-auto mb-8 reveal" style="transition-delay: 0.08s;">
        <div class="rounded-xl border border-warning-300 bg-warning-50 p-4 flex items-start gap-3">
          <svg class="w-5 h-5 text-warning-700 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
          <p class="text-sm font-semibold text-warning-700">Do not send this link to referrals. Book for them.</p>
        </div>
      </div>

      <div class="reveal" style="transition-delay: 0.1s;">
        <div class="card p-2 sm:p-3">
          <div class="meetings-iframe-container" data-src={`${SCHEDULER_URL}?embed=true&parentPageBackgroundColor=ffffff`} style="min-height: 660px;"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- HubSpot Meetings Embed Script -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;">This scheduler is not available from your location.</div>';
        });
      }
    });
  </script>

  <style>
    .meetings-iframe-container iframe {
      background: #ffffff !important;
    }
    .meetings-iframe-container {
      background: #ffffff !important;
    }
  </style>

</BaseLayout>
