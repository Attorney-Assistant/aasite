---
import ComicCampaignLayout from "@layouts/ComicCampaignLayout.astro";

const IMG = '/images/lp/law-firm-reset';
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/xgobjarr';

/**
 * Note on PandaDoc variable names: the field paths the user provided differ
 * between the two products (single vs double underscore in `_r` / `__r`).
 * Preserve them verbatim so PandaDoc actually receives the prefill.
 */
const PRODUCTS = [
  {
    slug: 'intake360',
    name: 'Intake360',
    tagline: 'AI + human intake',
    description: "AI answers, qualifies, and follows up on every lead, with our human team backing it up the moment a case needs a person. Live in 30 days.",
    eformUrl: 'https://eform.pandadoc.com/?eform=b20a0367-0585-4ee1-a8ac-df066e039c51',
    /* Eform primary recipient label: "Client Signer". 'Client' confirmed to work; including both. */
    recipientRoles: ['Client Signer', 'Client'],
    askTitle: true,
    /* Per Josiah's source: single `_r` on FirstName/LastName/Title,
       double `__r` only on MobilePhone. */
    variableMap: {
      firstname: 'Client_Contact_r.FirstName',
      lastname:  'Client_Contact_r.LastName',
      phone:     'Client_Contact__r.MobilePhone',
      title:     'Client_Contact_r.Title',
      company:   'Account.Name',
      street:    'Account.BillingStreet',
      city:      'Account.BillingCity',
      state:     'Account.BillingState',
      zip:       'Account.BillingPostalCode'
    }
  },
  {
    slug: 'impact',
    name: 'Impact Assistant',
    tagline: 'On-staff humans',
    description: "A dedicated team on our payroll, embedded in your firm. Trained on your playbook, working in your tools, billable on day one.",
    /* No direct eform — selecting Impact Assistant prompts for one of the four
       support types below, each with its own PandaDoc Nashville agreement. */
    eformUrl: null,
    /* Same recipient role as Intake360. PandaDoc ignores recipient keys whose
       role doesn't match the eform, so listing both candidates is safe. */
    recipientRoles: ['Client Signer', 'Client'],
    askTitle: false,
    variableMap: {
      firstname: 'Client_Contact__r.FirstName',
      lastname:  'Client_Contact__r.LastName',
      phone:     'Client_Contact__r.MobilePhone',
      company:   'Account.Name',
      street:    'Account.BillingStreet',
      city:      'Account.BillingCity',
      state:     'Account.BillingState',
      zip:       'Account.BillingPostalCode'
    },
    /* Impact Assistant support types — each maps to its own Nashville eform.
       They share the variableMap / recipientRoles / askTitle above. */
    types: [
      {
        slug: 'admin-support',
        name: 'Admin Support',
        tagline: 'Day-to-day ops',
        description: 'Calendars, files, data entry, and the everyday admin load — handled.',
        eformUrl: 'https://eform.pandadoc.com/?eform=bb43a17e-1d0c-46a7-9df6-ec0ecf790c7d'
      },
      {
        slug: 'executive-assistant',
        name: 'Executive Assistant',
        tagline: 'Right-hand support',
        description: 'High-level support for partners — inbox, scheduling, and priorities.',
        eformUrl: 'https://eform.pandadoc.com/?eform=69d8ee34-1f14-413c-bcb5-8745753b6f9e'
      },
      {
        slug: 'intake-reception',
        name: 'Intake Reception',
        tagline: 'Front line',
        description: 'Answer, qualify, and route every new lead and caller.',
        eformUrl: 'https://eform.pandadoc.com/?eform=bf778c51-aab7-4eaa-adb4-b197bce9be87'
      },
      {
        slug: 'marketing-support',
        name: 'Marketing Support',
        tagline: 'Growth engine',
        description: 'Content, campaigns, and the marketing follow-through your firm needs.',
        eformUrl: 'https://eform.pandadoc.com/?eform=f44fdf62-5420-489c-95c5-5e215c16b6a3'
      }
    ]
  }
];
---

<ComicCampaignLayout
  title="Nashville Contract Signing | Attorney Assistant"
  description="Lock in your Nashville pricing. Pick your product, sign your contract, get deployed."
  image={`${IMG}/woman-hero.png`}
>
  <div id="nash-lp" data-stage="select">

    <!-- ═══════════════════════════════════════════
         HERO
    ═══════════════════════════════════════════ -->
    <section class="nash-hero">
      <div class="nash-hero-skyline" aria-hidden="true"></div>
      <div class="nash-halftone" aria-hidden="true"></div>

      <div class="nash-container nash-hero-grid">
        <div class="nash-hero-copy">
          <span class="nash-eyebrow">Nashville · Special Pricing</span>
          <h1 class="nash-display">
            Lock in<br />
            <span class="nash-accent-gold">your rate.</span>
          </h1>
          <p class="nash-lede">
            Reserved for the firms we met in Nashville. Pick your product, fill in your firm's info, and sign before the conference rate sunsets.
          </p>

          <div class="nash-squeeze">
            <span class="nash-squeeze-pow">URGENT!</span>
            <p>Conference pricing locks in <strong>only while spots remain</strong>. Reserve yours today.</p>
          </div>

          <a href="#start" class="nash-scroll-cta">
            <span>Pick Your Contract</span>
            <span class="nash-arrow" aria-hidden="true">↓</span>
          </a>
        </div>

        <div class="nash-hero-art">
          <div class="nash-bat-stage" aria-label="The Attorney Assistant signal">
            <div class="nash-bat-glow" aria-hidden="true"></div>
            <img src={`${IMG}/bat-signal.svg`} alt="Attorney Assistant signal" class="nash-bat" width="260" height="575" />
          </div>
          <img src={`${IMG}/woman-hero.png`} alt="The Attorney Assistant legal hero" class="nash-woman" width="640" height="800" loading="eager" />
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 1: PRODUCT SELECTION
    ═══════════════════════════════════════════ -->
    <section id="start" data-stage="select" class="nash-stage nash-select">
      <div class="nash-container">
        <div class="nash-stage-header">
          <span class="nash-stage-pow">STEP 1</span>
          <h2 class="nash-display nash-display-md">
            <span class="nash-stage-line">Pick your</span>
            <span class="nash-stage-line nash-accent-gold">contract.</span>
          </h2>
          <p class="nash-stage-sub">Choose what your firm is signing for. We'll route you to the right paperwork.</p>
        </div>

        <div class="nash-products">
          {PRODUCTS.map((p, i) => (
            <button type="button" class={`nash-product nash-product-${p.slug}`} data-select-product={p.slug}>
              <span class="nash-product-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.name}</h3>
              <p class="nash-product-tagline">{p.tagline}</p>
              <p class="nash-product-desc">{p.description}</p>
              <span class="nash-product-cta">Select <span aria-hidden="true">→</span></span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 1b: IMPACT ASSISTANT — SUPPORT TYPE
    ═══════════════════════════════════════════ -->
    <section data-stage="impact-type" class="nash-stage nash-select">
      <div class="nash-container">
        <div class="nash-stage-header">
          <span class="nash-stage-pow">STEP 1</span>
          <h2 class="nash-display nash-display-md">
            <span class="nash-stage-line">Pick your</span>
            <span class="nash-stage-line nash-accent-gold">support type.</span>
          </h2>
          <p class="nash-stage-sub">Which Impact Assistant role is your firm signing for? We'll route you to the right agreement.</p>
        </div>

        <div class="nash-back-row">
          <button type="button" class="nash-back-light" data-go-stage="select">← Change product</button>
        </div>

        <div class="nash-products">
          {PRODUCTS.find((p) => p.slug === 'impact')?.types?.map((t, i) => (
            <button type="button" class="nash-product nash-product-impact-type" data-select-impact-type={t.slug}>
              <span class="nash-product-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t.name}</h3>
              <p class="nash-product-tagline">{t.tagline}</p>
              <p class="nash-product-desc">{t.description}</p>
              <span class="nash-product-cta">Select <span aria-hidden="true">→</span></span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 2: INFO FORM
    ═══════════════════════════════════════════ -->
    <section data-stage="info" class="nash-stage nash-info">
      <div class="nash-container">
        <div class="nash-stage-header">
          <span class="nash-stage-pow">STEP 2</span>
          <h2 class="nash-display nash-display-md">
            <span class="nash-stage-line">Your firm's</span>
            <span class="nash-stage-line nash-accent-gold">info.</span>
          </h2>
          <p class="nash-stage-sub" id="nash-info-sub">We'll pre-fill the contract so you don't have to re-type a thing.</p>
        </div>

        <div class="nash-form-frame">
          <button type="button" class="nash-back" id="nash-info-back" data-go-stage="select">← Change product</button>

          <form id="nash-form" class="nash-form" novalidate>
            <input type="hidden" name="product" id="nash-form-product" value="" />

            <div class="nash-row nash-row-2">
              <label class="nash-field">
                <span class="nash-label">First name <em>*</em></span>
                <input type="text" name="firstname" required autocomplete="given-name" />
              </label>
              <label class="nash-field">
                <span class="nash-label">Last name <em>*</em></span>
                <input type="text" name="lastname" required autocomplete="family-name" />
              </label>
            </div>

            <div class="nash-row nash-row-2">
              <label class="nash-field">
                <span class="nash-label">Email <em>*</em></span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
              <label class="nash-field">
                <span class="nash-label">Mobile phone <em>*</em></span>
                <input type="tel" name="phone" required autocomplete="tel" />
              </label>
            </div>

            <label class="nash-field nash-field-title" data-title-field>
              <span class="nash-label">Title <em>*</em></span>
              <input type="text" name="title" autocomplete="organization-title" placeholder="e.g. Managing Partner" />
            </label>

            <label class="nash-field">
              <span class="nash-label">Firm / Company name <em>*</em></span>
              <input type="text" name="company" required autocomplete="organization" />
            </label>

            <label class="nash-field">
              <span class="nash-label">Street address <em>*</em></span>
              <input type="text" name="street" required autocomplete="street-address" />
            </label>

            <div class="nash-row nash-row-3">
              <label class="nash-field">
                <span class="nash-label">City <em>*</em></span>
                <input type="text" name="city" required autocomplete="address-level2" />
              </label>
              <label class="nash-field">
                <span class="nash-label">State <em>*</em></span>
                <input type="text" name="state" required autocomplete="address-level1" maxlength="2" placeholder="TN" />
              </label>
              <label class="nash-field">
                <span class="nash-label">Zip <em>*</em></span>
                <input type="text" name="zip" required autocomplete="postal-code" inputmode="numeric" />
              </label>
            </div>

            <button type="submit" class="nash-submit">
              <span>Continue to Contract</span>
              <span aria-hidden="true">→</span>
            </button>
            <div class="nash-error" role="alert" hidden></div>
          </form>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         STAGE 3: CONTRACT EMBED
    ═══════════════════════════════════════════ -->
    <section data-stage="contract" class="nash-stage nash-contract">
      <div class="nash-container">
        <div class="nash-stage-header">
          <span class="nash-stage-pow">STEP 3</span>
          <h2 class="nash-display nash-display-md">
            <span class="nash-stage-line">Sign your</span>
            <span class="nash-stage-line nash-accent-gold" id="nash-contract-product">contract.</span>
          </h2>
          <p class="nash-stage-sub">Everything's pre-filled. Review, sign, and you're locked in at the Nashville rate.</p>
        </div>

        <div class="nash-embed-frame">
          <span class="nash-embed-tape nash-embed-tape-tl" aria-hidden="true">★</span>
          <span class="nash-embed-tape nash-embed-tape-tr" aria-hidden="true">★</span>
          <div id="nash-embed-host"></div>
        </div>
      </div>
    </section>

  </div>

  <style is:global>
    /* ── Color tokens (reuse comic palette) */
    #nash-lp {
      --navy: #0e2236;
      --navy-deep: #061320;
      --navy-mid: #1a3a5c;
      --gold: #F9A630;
      --gold-bright: #FBD46D;
      --red: #E04A2C;
      --red-bright: #FF6B45;
      --blue: #5087dd;
      --steel: #c0c8d4;
      --steel-dim: #6f7a8a;
      background: var(--navy);
      color: #fff;
      font-family: 'Inter', -apple-system, sans-serif;
      line-height: 1.55;
      overflow-x: clip;
    }

    /* ── Stage state machine: hide every stage except the active one. */
    #nash-lp section[data-stage] { display: none; }
    #nash-lp[data-stage="select"]      section[data-stage="select"],
    #nash-lp[data-stage="impact-type"] section[data-stage="impact-type"],
    #nash-lp[data-stage="info"]        section[data-stage="info"],
    #nash-lp[data-stage="contract"]    section[data-stage="contract"] {
      display: block;
    }

    /* ── Layout */
    #nash-lp .nash-container { max-width: 1240px; margin: 0 auto; padding: 0 32px; position: relative; z-index: 3; }
    @media (max-width: 720px) { #nash-lp .nash-container { padding: 0 20px; } }

    /* ── Typography */
    #nash-lp .nash-display, #nash-lp .nash-eyebrow, #nash-lp .nash-squeeze-pow, #nash-lp .nash-stage-pow,
    #nash-lp h1, #nash-lp h2, #nash-lp h3 {
      font-family: 'Bangers', 'Impact', sans-serif;
      letter-spacing: 0.04em;
    }
    #nash-lp .nash-display {
      letter-spacing: 0.02em;
      line-height: 0.95;
      text-transform: uppercase;
      color: #FFFFFF;
      text-shadow: 3px 3px 0 var(--red), 6px 6px 0 var(--navy-deep);
      font-size: clamp(56px, 9vw, 132px);
    }
    #nash-lp .nash-display-md { font-size: clamp(34px, 5vw, 60px); }
    #nash-lp .nash-display-sm { font-size: clamp(28px, 4vw, 44px); }
    #nash-lp .nash-accent-gold { color: var(--gold); }
    #nash-lp .nash-accent-red {
      color: var(--red-bright);
      text-shadow: 3px 3px 0 #fff, 6px 6px 0 var(--navy-deep);
    }

    /* ── Hero */
    #nash-lp .nash-hero {
      position: relative;
      padding: 100px 0 80px;
      isolation: isolate;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 30% 30%, rgba(80,135,221,0.18), transparent 55%),
        radial-gradient(ellipse at 75% 70%, rgba(249,166,48,0.14), transparent 60%),
        var(--navy);
    }
    #nash-lp .nash-hero-skyline {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      height: 60%;
      background-image: url('/images/lp/law-firm-reset/skyline.svg');
      background-repeat: no-repeat;
      background-position: bottom center;
      background-size: cover;
      opacity: 0.55;
      z-index: 1;
      pointer-events: none;
      mask-image: linear-gradient(to top, #000 60%, transparent 100%);
      -webkit-mask-image: linear-gradient(to top, #000 60%, transparent 100%);
    }
    #nash-lp .nash-halftone {
      position: absolute; inset: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0);
      background-size: 8px 8px;
      mix-blend-mode: screen;
      z-index: 2;
      pointer-events: none;
    }

    #nash-lp .nash-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 48px;
      align-items: center;
    }
    @media (max-width: 960px) {
      #nash-lp .nash-hero-grid { grid-template-columns: 1fr; gap: 32px; }
      #nash-lp .nash-hero { padding: 64px 0 48px; }
    }

    #nash-lp .nash-eyebrow {
      display: inline-block;
      background: var(--red);
      color: #fff;
      padding: 8px 16px;
      letter-spacing: 0.12em;
      font-size: 16px;
      transform: rotate(-2deg);
      margin-bottom: 24px;
      box-shadow: 4px 4px 0 var(--navy-deep);
    }
    #nash-lp .nash-hero-copy h1 { margin: 0 0 24px; }
    #nash-lp .nash-lede {
      font-family: 'Sora', sans-serif;
      font-weight: 600;
      font-size: clamp(19px, 2.2vw, 26px);
      color: var(--steel);
      line-height: 1.35;
      max-width: 540px;
      margin: 0 0 32px;
    }

    #nash-lp .nash-squeeze {
      display: flex;
      align-items: center;
      gap: 16px;
      background: rgba(80, 135, 221, 0.12);
      border: 2px solid var(--blue);
      border-radius: 4px;
      padding: 16px 18px 16px 24px;
      box-shadow: 5px 5px 0 var(--navy-deep);
      margin: 0 0 28px;
      max-width: 580px;
      position: relative;
      transform: rotate(-0.4deg);
    }
    #nash-lp .nash-squeeze-pow {
      flex-shrink: 0;
      background: var(--red);
      color: #fff;
      padding: 6px 12px;
      font-size: 18px;
      letter-spacing: 0.08em;
      transform: rotate(-6deg);
      box-shadow: 2px 2px 0 var(--navy-deep);
    }
    #nash-lp .nash-squeeze p {
      margin: 0;
      font-family: 'Sora', sans-serif;
      font-weight: 700;
      font-size: 15px;
      color: #fff;
      line-height: 1.4;
    }
    #nash-lp .nash-squeeze strong { color: #8bb4f5; }

    #nash-lp .nash-scroll-cta {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      background: var(--gold);
      color: var(--navy-deep);
      padding: 18px 30px;
      font-family: 'Bangers', sans-serif;
      font-size: clamp(22px, 2.4vw, 28px);
      letter-spacing: 0.08em;
      text-decoration: none;
      border: none;
      cursor: pointer;
      box-shadow: 6px 6px 0 var(--navy-deep);
      transform: rotate(-1deg);
      transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    }
    #nash-lp .nash-scroll-cta:hover {
      transform: rotate(-1deg) translate(-3px, -3px);
      box-shadow: 9px 9px 0 var(--navy-deep);
      background: var(--gold-bright);
    }
    #nash-lp .nash-arrow {
      display: inline-block;
      animation: nash-arrow-bob 1.6s ease-in-out infinite;
    }
    @keyframes nash-arrow-bob {
      0%, 100% { transform: translateY(0); }
      50%      { transform: translateY(4px); }
    }

    /* Hero art */
    #nash-lp .nash-hero-art {
      position: relative;
      display: flex;
      justify-content: flex-end;
      align-items: flex-end;
      min-height: 660px;
      align-self: stretch;
    }
    @media (max-width: 960px) {
      #nash-lp .nash-hero-art { min-height: 560px; justify-content: center; }
    }
    #nash-lp .nash-woman {
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: 720px;
      height: auto;
      display: block;
      margin-bottom: -80px;
      filter: drop-shadow(0 18px 44px rgba(0,0,0,0.6));
    }
    #nash-lp .nash-bat-stage {
      position: absolute;
      top: -4%;
      right: -8%;
      width: 360px;
      height: 360px;
      z-index: 2;
      pointer-events: none;
      transform-origin: 34% 97%;
      animation: nash-bat-pendulum 10s ease-in-out infinite;
    }
    @keyframes nash-bat-pendulum {
      0%, 100% { transform: rotate(-30deg); }
      50%      { transform: rotate(30deg);  }
    }
    #nash-lp .nash-bat {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: contain;
      filter: drop-shadow(0 0 20px rgba(249,166,48,0.65));
    }
    #nash-lp .nash-bat-glow {
      position: absolute; inset: -30%;
      background: radial-gradient(circle, rgba(249,166,48,0.55) 0%, rgba(249,166,48,0.15) 35%, transparent 65%);
      filter: blur(8px);
      animation: nash-bat-pulse 3s ease-in-out infinite;
      z-index: -1;
    }
    @keyframes nash-bat-pulse {
      0%, 100% { transform: scale(0.92); opacity: 0.55; }
      50%      { transform: scale(1.10); opacity: 0.95; }
    }

    /* ══════════════════════════════════════════
       STAGES (select / info / contract)
    ══════════════════════════════════════════ */
    #nash-lp .nash-stage {
      position: relative;
      padding: 96px 0 100px;
      isolation: isolate;
      overflow: hidden;
    }
    #nash-lp .nash-stage::after {
      content: '';
      position: absolute; inset: 0;
      background-image: radial-gradient(circle at 1px 1px, rgba(255,255,255,0.05) 1px, transparent 0);
      background-size: 8px 8px;
      mix-blend-mode: screen;
      pointer-events: none;
    }
    #nash-lp .nash-select {
      background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
    }
    #nash-lp .nash-info {
      background: var(--navy);
    }
    #nash-lp .nash-contract {
      background: linear-gradient(180deg, var(--navy-deep) 0%, var(--navy) 100%);
    }

    #nash-lp .nash-stage-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 48px;
      position: relative;
      z-index: 3;
    }
    #nash-lp .nash-stage-pow {
      display: inline-block;
      background: var(--red);
      color: #fff;
      padding: 6px 16px;
      font-size: 16px;
      letter-spacing: 0.16em;
      transform: rotate(-3deg);
      box-shadow: 3px 3px 0 var(--gold);
      margin-bottom: 20px;
    }
    #nash-lp .nash-stage-header h2 { margin: 0 0 14px; }
    #nash-lp .nash-stage-line { display: block; }
    #nash-lp .nash-stage-sub {
      font-family: 'Sora', sans-serif;
      font-weight: 600;
      font-size: clamp(15px, 1.7vw, 18px);
      color: var(--steel);
      line-height: 1.5;
      max-width: 620px;
      margin: 0 auto;
    }

    /* ── Product cards */
    #nash-lp .nash-products {
      display: grid;
