  </style>

  <script is:inline define:vars={{ FORMSPREE_ENDPOINT, PRODUCTS }}>
    (function () {
      const main = document.getElementById('nash-lp');
      const productById = Object.fromEntries(PRODUCTS.map(function (p) { return [p.slug, p]; }));
      const form = document.getElementById('nash-form');
      const errorEl = form.querySelector('.nash-error');
      const submitBtn = form.querySelector('.nash-submit');
      const productHidden = document.getElementById('nash-form-product');
      const titleField = form.querySelector('[data-title-field]');
      const titleInput = titleField ? titleField.querySelector('input') : null;
      const embedHost = document.getElementById('nash-embed-host');
      const contractProductEl = document.getElementById('nash-contract-product');
      const infoSub = document.getElementById('nash-info-sub');
      const infoBack = document.getElementById('nash-info-back');
      let currentProduct = null;

      // Track UTMs from the URL and default to "nashville" so attribution is clear.
      const UTM_DEFAULTS = {
        utm_source: 'nashville',
        utm_medium: 'landing-page',
        utm_campaign: 'nashville',
        utm_content: '',
        utm_term: ''
      };
      const utms = (function () {
        const p = new URLSearchParams(location.search);
        return ['utm_source','utm_medium','utm_campaign','utm_content','utm_term']
          .reduce(function (acc, k) { acc[k] = p.get(k) || UTM_DEFAULTS[k] || ''; return acc; }, {});
      })();

      function track(event, extra) {
        extra = extra || {};
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(Object.assign({ event: event, lp: 'nashville' }, extra));
      }

      function setStage(name) {
        main.setAttribute('data-stage', name);
        const target = document.querySelector('section[data-stage="' + name + '"]');
        if (target) requestAnimationFrame(function () { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
        track('nashville_stage', { stage: name });
      }

      // Apply a chosen product (or Impact support-type) to the info + contract
      // stages: Title-field visibility, pre-fill copy, and the hidden slug.
      function applyProductToInfo(product) {
        productHidden.value = product.slug;
        if (titleField) {
          if (product.askTitle) {
            titleField.hidden = false;
            if (titleInput) titleInput.required = true;
          } else {
            titleField.hidden = true;
            if (titleInput) { titleInput.required = false; titleInput.value = ''; }
          }
        }
        if (infoSub) {
          infoSub.textContent = "We'll pre-fill the " + product.name + " contract so you don't have to re-type a thing.";
        }
        if (contractProductEl) contractProductEl.textContent = product.name + '.';
      }

      // Product selection ----------------------------------------------------
      document.querySelectorAll('[data-select-product]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const slug = this.getAttribute('data-select-product');
          const product = productById[slug];
          if (!product) return;
          track('nashville_product_selected', { product: slug });

          // Impact Assistant branches into four support types before the form.
          if (product.types && product.types.length) {
            if (infoBack) infoBack.setAttribute('data-go-stage', 'impact-type');
            setStage('impact-type');
            return;
          }

          currentProduct = product;
          applyProductToInfo(product);
          if (infoBack) infoBack.setAttribute('data-go-stage', 'select');
          setStage('info');
        });
      });

      // Impact Assistant support-type selection -------------------------------
      document.querySelectorAll('[data-select-impact-type]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const typeSlug = this.getAttribute('data-select-impact-type');
          const base = productById['impact'];
          const type = base && base.types ? base.types.find(function (t) { return t.slug === typeSlug; }) : null;
          if (!type) return;
          // Effective product = the Impact category config with this type's eform.
          currentProduct = Object.assign({}, base, {
            slug: 'impact-' + type.slug,
            name: base.name + ' – ' + type.name,
            eformUrl: type.eformUrl
          });
          track('nashville_impact_type_selected', { type: typeSlug });
          applyProductToInfo(currentProduct);
          if (infoBack) infoBack.setAttribute('data-go-stage', 'impact-type');
          setStage('info');
        });
      });

      // Wire any data-go-stage buttons (e.g. Back)
      document.querySelectorAll('[data-go-stage]').forEach(function (btn) {
        btn.addEventListener('click', function () { setStage(this.getAttribute('data-go-stage')); });
      });

      // Build a PandaDoc embed exactly like their snippet does — pass the
      // payload as &key=URL-encoded-JSON for each top-level key in `data`.
      function buildEmbedIframe(opts) {
        const dataQs = opts.data ? Object.keys(opts.data).map(function (k) {
          return '&' + k + '=' + encodeURIComponent(JSON.stringify(opts.data[k]));
        }).join('') : '';
        const iframe = document.createElement('iframe');
        iframe.frameBorder = 0;
        iframe.src = opts.url + dataQs;
        iframe.width = '100%';
        iframe.height = '100%';
        iframe.style.border = '0';
        iframe.style.minHeight = '720px';
        iframe.style.background = '#fff';
        return iframe;
      }

      function loadContract(product, values) {
        // Map our form values into the product's PandaDoc variable names.
        const variables = {};
        Object.keys(product.variableMap).forEach(function (formKey) {
          const pdKey = product.variableMap[formKey];
          variables[pdKey] = values[formKey] || '';
        });

        // Prefill the PandaDoc signer dialog (Email / First / Last). PandaDoc
        // silently ignores recipient keys whose role names don't match the
        // eform, so it's safe to list multiple candidates per product —
        // whichever matches will fire.
        const signerInfo = {
          Email:     values.email     || '',
          FirstName: values.firstname || '',
          LastName:  values.lastname  || ''
        };
        const roleList = product.recipientRoles || ['Client'];
        const recipients = {};
        roleList.forEach(function (role) { recipients[role] = signerInfo; });

        // Keep payload minimal — match Josiah's original embed snippet shape.
        // Extra custom metadata keys can trigger 400s from PandaDoc validation.
        const data = {
          recipients: recipients,
          variables: variables,
          metadata: {
            lead_source: 'Website Form',
            utm_campaign: utms.utm_campaign || 'nashville'
          }
        };

        const host = document.getElementById('nash-embed-host');
        host.innerHTML = '';
        const iframe = buildEmbedIframe({ url: product.eformUrl, data: data });
        host.style.height = '720px';
        host.style.width = '100%';
        host.appendChild(iframe);
      }

      // Form submission ------------------------------------------------------
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        errorEl.hidden = true;
        errorEl.textContent = '';

        const formData = new FormData(form);
        const values = {
          product:   String(formData.get('product')   || ''),
          firstname: String(formData.get('firstname') || '').trim(),
          lastname:  String(formData.get('lastname')  || '').trim(),
          email:     String(formData.get('email')     || '').trim(),
          phone:     String(formData.get('phone')     || '').trim(),
          title:     String(formData.get('title')     || '').trim(),
          company:   String(formData.get('company')   || '').trim(),
          street:    String(formData.get('street')    || '').trim(),
          city:      String(formData.get('city')      || '').trim(),
          state:     String(formData.get('state')     || '').trim().toUpperCase(),
          zip:       String(formData.get('zip')       || '').trim()
        };

        const product = currentProduct || productById[values.product];
        if (!product || !product.eformUrl) {
          errorEl.textContent = 'Please pick a contract before continuing.';
          errorEl.hidden = false;
          return;
        }

        submitBtn.disabled = true;
        const originalBtnText = submitBtn.querySelector('span').textContent;
        submitBtn.querySelector('span').textContent = 'Saving…';

        // Build Formspree payload — every product type lands in the same inbox,
        // distinguished by `product`.
        const formspreePayload = Object.assign({}, values, utms, {
          landing_page: 'nashville',
          product_name: product.name,
          _subject: 'Nashville LP — ' + product.name + ' — ' + values.company
        });

        try {
          const res = await fetch(FORMSPREE_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(formspreePayload)
          });
          if (!res.ok) {
            const errText = await res.text();
            throw new Error('Formspree submission failed: ' + res.status + ' — ' + errText);
          }
          track('nashville_form_submitted', { product: product.slug });

          // Pixel lead event (browser + CAPI, dedupe via hash inside the helper)
          if (window.__metaCAPI) {
            window.__metaCAPI.track(
              'Lead',
              {
                content_name: 'nashville-contract',
                content_category: 'nashville-lp',
                product: product.slug
              },
              {
                em: values.email,
                ph: values.phone,
                fn: values.firstname,
                ln: values.lastname
              }
            );
          }

          loadContract(product, values);
          setStage('contract');
        } catch (err) {
          console.error('Nashville form submission error:', err);
          errorEl.textContent = "Something went wrong. Please try again, or email info@attorneyassistant.com and we'll send your contract over directly.";
          errorEl.hidden = false;
          submitBtn.disabled = false;
          submitBtn.querySelector('span').textContent = originalBtnText;
        }
      });

      track('nashville_lp_view');
    })();
  </script>

</ComicCampaignLayout>
