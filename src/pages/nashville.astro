      const form = document.getElementById('nash-form');
      const errorEl = form.querySelector('.nash-error');
      const submitBtn = form.querySelector('.nash-submit');
      const productHidden = document.getElementById('nash-form-product');
      const titleField = form.querySelector('[data-title-field]');
      const titleInput = titleField ? titleField.querySelector('input') : null;
      const contractProductEl = document.getElementById('nash-contract-product');
      const infoSub = document.getElementById('nash-info-sub');
      const infoBack = document.getElementById('nash-info-back');
      let currentProduct = null;
      let impactFlow = 'impact'; // 'impact' or 'both' — which flow opened the support-type picker

      // Track UTMs from the URL and default to "nashville" so attribution is clear.
      const UTM_DEFAULTS = {
        utm_source: 'nashville',
        utm_medium: 'landing-page',
        utm_campaign: 'nashville',
        utm_content: '',
        utm_term: ''
      };
      const utms = (function () {
        const p = new URLSearchParams(location.search);
        return ['utm_source','utm_medium','utm_campaign','utm_content','utm_term']
          .reduce(function (acc, k) { acc[k] = p.get(k) || UTM_DEFAULTS[k] || ''; return acc; }, {});
      })();

      function track(event, extra) {
        extra = extra || {};
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push(Object.assign({ event: event, lp: 'nashville' }, extra));
      }

      function setStage(name) {
        main.setAttribute('data-stage', name);
        // Re-enable the submit button when returning to the info form (e.g. via Back).
        if (name === 'info' && submitBtn) {
          submitBtn.disabled = false;
          const span = submitBtn.querySelector('span');
          if (span) span.textContent = 'Continue to Contract';
        }
        const target = document.querySelector('section[data-stage="' + name + '"]');
        if (target) requestAnimationFrame(function () { target.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
        track('nashville_stage', { stage: name });
      }

      // Apply a chosen product (or Impact support-type) to the info + contract
      // stages: Title-field visibility, pre-fill copy, and the hidden slug.
      function applyProductToInfo(product) {
        productHidden.value = product.slug;
        if (titleField) {
          if (product.askTitle) {
            titleField.hidden = false;
            if (titleInput) titleInput.required = true;
          } else {
            titleField.hidden = true;
            if (titleInput) { titleInput.required = false; titleInput.value = ''; }
          }
        }
        if (infoSub) {
          infoSub.textContent = product.contracts
            ? "We'll pre-fill both contracts so you don't have to re-type a thing."
            : "We'll pre-fill the " + product.name + " contract so you don't have to re-type a thing.";
        }
        if (contractProductEl) contractProductEl.textContent = product.name;
      }

      // Product selection ----------------------------------------------------
      document.querySelectorAll('[data-select-product]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const slug = this.getAttribute('data-select-product');
          const product = productById[slug];
          if (!product) return;
          track('nashville_product_selected', { product: slug });

          // Impact Assistant (and "Both") branch into the four support types first.
          if ((product.types && product.types.length) || product.needsImpactType) {
            impactFlow = slug; // 'impact' or 'both'
            if (infoBack) infoBack.setAttribute('data-go-stage', 'impact-type');
            setStage('impact-type');
            return;
          }

          currentProduct = product;
          applyProductToInfo(product);
          if (infoBack) infoBack.setAttribute('data-go-stage', 'select');
          setStage('info');
        });
      });

      // Impact Assistant support-type selection -------------------------------
      document.querySelectorAll('[data-select-impact-type]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const typeSlug = this.getAttribute('data-select-impact-type');
          const base = productById['impact'];
          const type = base && base.types ? base.types.find(function (t) { return t.slug === typeSlug; }) : null;
          if (!type) return;
          // The chosen Impact support-type contract.
          const impactContract = Object.assign({}, base, {
            slug: 'impact-' + type.slug,
            name: base.name + ' – ' + type.name,
            eformUrl: type.eformUrl
          });

          if (impactFlow === 'both') {
            // "Both" stacks the Intake360 contract + the chosen Impact contract.
            currentProduct = {
              slug: 'both-' + type.slug,
              name: 'Both Products',
              askTitle: true,
              contracts: [productById['intake360'], impactContract]
            };
            track('nashville_impact_type_selected', { type: typeSlug, flow: 'both' });
          } else {
            currentProduct = impactContract;
            track('nashville_impact_type_selected', { type: typeSlug });
          }

          applyProductToInfo(currentProduct);
          if (infoBack) infoBack.setAttribute('data-go-stage', 'impact-type');
          setStage('info');
        });
      });

      // Wire any data-go-stage triggers (Back buttons + the hero CTA). Reset to
      // the named stage and scroll to it — preventDefault so the hero anchor
      // doesn't try to jump to #start, which is display:none past the select stage.
      document.querySelectorAll('[data-go-stage]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          setStage(this.getAttribute('data-go-stage'));
        });
      });

      // Start Over — full reset back to the product picker (initial content).
      document.querySelectorAll('[data-start-over]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          form.reset();
          clearFieldErrors();
          currentProduct = null;
          impactFlow = 'impact';
          if (productHidden) productHidden.value = '';
          if (titleField) titleField.hidden = false;
          errorEl.hidden = true;
          errorEl.textContent = '';
          setStage('select');
        });
      });

      // Build the prefilled PandaDoc eform URL — the same &key=URL-encoded-JSON
      // payload the embed used. We open this in a NEW TAB rather than an iframe:
      // PandaDoc redirects the top window on completion/payment, which (a) broke
      // an inline iframe and (b) would wipe out a second stacked contract. In its
      // own tab that redirect is harmless and Stripe payment works normally.
      function buildContractUrl(contract, values) {
        const data = buildContractData(contract, values);
        const dataQs = Object.keys(data).map(function (k) {
          return '&' + k + '=' + encodeURIComponent(JSON.stringify(data[k]));
        }).join('');
        return contract.eformUrl + dataQs;
      }

      // Build the PandaDoc payload for one contract from the form values.
      function buildContractData(contract, values) {
        const variables = {};
        Object.keys(contract.variableMap).forEach(function (formKey) {
          variables[contract.variableMap[formKey]] = values[formKey] || '';
        });
        // Prefill the signer dialog (Email / First / Last). PandaDoc ignores
        // recipient keys whose role doesn't match the eform, so listing multiple
        // candidates is safe — whichever matches fires.
        const signerInfo = {
          Email:     values.email     || '',
          FirstName: values.firstname || '',
          LastName:  values.lastname  || ''
        };
        const recipients = {};
        (contract.recipientRoles || ['Client']).forEach(function (role) { recipients[role] = signerInfo; });
        return {
          recipients: recipients,
          variables: variables,
          metadata: { lead_source: 'Website Form', utm_campaign: utms.utm_campaign || 'nashville' }
        };
      }

      function loadContract(product, values) {
        // Normally one contract; "Both" carries an array of contracts to open.
        const contracts = (product.contracts && product.contracts.length) ? product.contracts : [product];
        const multi = contracts.length > 1;
        const list = document.getElementById('nash-embed-list');
        list.innerHTML = '';

        contracts.forEach(function (contract, idx) {
          const frame = document.createElement('div');
          frame.className = 'nash-embed-frame nash-open-frame';
          frame.innerHTML =
            '<span class="nash-embed-tape nash-embed-tape-tl" aria-hidden="true">★</span>' +
            '<span class="nash-embed-tape nash-embed-tape-tr" aria-hidden="true">★</span>';
          if (multi) {
            const label = document.createElement('p');
            label.className = 'nash-embed-label';
            label.textContent = contract.name;
            frame.appendChild(label);
          }
          const body = document.createElement('div');
          body.className = 'nash-open-body';

          const note = document.createElement('p');
          note.className = 'nash-open-note';
          note.textContent = multi
            ? "Opens in a new tab — review, sign, and pay. You can open both; they sign separately."
            : "Opens in a new tab — review, sign, and pay. Everything's already pre-filled.";
          body.appendChild(note);

          const link = document.createElement('a');
          link.className = 'nash-open-btn';
          link.href = buildContractUrl(contract, values);
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.innerHTML = (multi ? ('Open &amp; sign: ' + contract.name) : 'Open &amp; sign your contract') +
            ' <span aria-hidden="true">↗</span>';
          link.addEventListener('click', function () {
            link.classList.add('is-opened');
            track('nashville_contract_opened', { contract: (contract && contract.slug) || product.slug, index: idx });
          });
          body.appendChild(link);

          frame.appendChild(body);
          list.appendChild(frame);
        });
      }

      // ── HubSpot (best-effort lead capture) ──────────────────────────────
      // Forms Submission API — no auth, CORS-enabled, no embedded form UI needed.
      const HUBSPOT_ENDPOINT =
        'https://api.hsforms.com/submissions/v3/integration/submit/49161090/981bee78-0923-4718-a662-f035ea7c1fa0';

      function getCookie(name) {
        const m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
        return m ? decodeURIComponent(m[1]) : '';
      }

      function submitToHubSpot(values) {
        // Map our form values to the HubSpot form's contact properties.
        const map = [
          ['firstname', values.firstname], ['lastname', values.lastname],
          ['email', values.email], ['phone', values.phone],
          ['jobtitle', values.title], ['company', values.company],
          ['address', values.street], ['city', values.city],
          ['state', values.state], ['zip', values.zip]
        ];
        const fields = map
          .filter(function (f) { return f[1]; })
          .map(function (f) { return { name: f[0], value: f[1] }; });
        const context = { pageUri: location.href, pageName: document.title };
        const hutk = getCookie('hubspotutk'); // ties submission to the visitor if HS tracking loaded
        if (hutk) context.hutk = hutk;
        return fetch(HUBSPOT_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ fields: fields, context: context })
        }).then(function (r) { if (!r.ok) throw new Error('HubSpot ' + r.status); });
      }

      // ── State picklist (full name → 2-letter code) ──────────────────────
      const STATE_BY_NAME = {};
      const STATE_CODES = new Set();
      US_STATES.forEach(function (s) { STATE_BY_NAME[s.name.toLowerCase()] = s.code; STATE_CODES.add(s.code); });
      function resolveStateCode(raw) {
        if (!raw) return '';
        const byName = STATE_BY_NAME[raw.trim().toLowerCase()];
        if (byName) return byName;
        const up = raw.trim().toUpperCase();
        return STATE_CODES.has(up) ? up : '';
      }

      // ── Field validation ────────────────────────────────────────────────
      function clearFieldErrors() {
        form.querySelectorAll('.nash-field-invalid').forEach(function (el) { el.classList.remove('nash-field-invalid'); });
        form.querySelectorAll('.nash-field-msg').forEach(function (el) { el.remove(); });
      }

      function markInvalid(name, message) {
        const input = form.querySelector('[name="' + name + '"]');
        if (!input) return;
        input.classList.add('nash-field-invalid');
        const field = input.closest('.nash-field');
        if (field && !field.querySelector('.nash-field-msg')) {
          const msg = document.createElement('span');
          msg.className = 'nash-field-msg';
          msg.textContent = message;
          field.appendChild(msg);
        }
      }

      function validateForm(values, product) {
        clearFieldErrors();
        const errs = [];
        const required = ['firstname', 'lastname', 'email', 'phone', 'company', 'street', 'city', 'zip'];
        if (product.askTitle && titleField && !titleField.hidden) required.push('title');
        required.forEach(function (name) {
          if (!values[name]) { markInvalid(name, 'This field is required.'); errs.push(name); }
        });
        // Format checks (only when the field has a value, so we don't double-flag empties).
        if (values.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email)) {
          markInvalid('email', 'Enter a valid email address.'); errs.push('email');
        }
        if (values.phone && values.phone.replace(/\D/g, '').length < 7) {
          markInvalid('phone', 'Enter a valid phone number.'); errs.push('phone');
        }
        // State: required + must resolve to a 2-letter code from the picklist.
        const stateInput = form.querySelector('[name="state"]');
        const stateRaw = stateInput ? stateInput.value.trim() : '';
        if (!stateRaw) {
          markInvalid('state', 'This field is required.'); errs.push('state');
        } else if (!resolveStateCode(stateRaw)) {
          markInvalid('state', 'Choose your state from the list.'); errs.push('state');
        }
        if (values.zip && values.zip.replace(/\D/g, '').length < 4) {
          markInvalid('zip', 'Enter a valid ZIP code.'); errs.push('zip');
        }
        return errs;
      }

      // Clear a field's error the moment the user edits it.
      form.addEventListener('input', function (e) {
        const el = e.target;
        if (el.classList && el.classList.contains('nash-field-invalid')) {
          el.classList.remove('nash-field-invalid');
          const field = el.closest('.nash-field');
          const msg = field && field.querySelector('.nash-field-msg');
          if (msg) msg.remove();
        }
      });

      // Form submission ------------------------------------------------------
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        errorEl.hidden = true;
        errorEl.textContent = '';

        const formData = new FormData(form);
        const values = {
          product:   String(formData.get('product')   || ''),
          firstname: String(formData.get('firstname') || '').trim(),
          lastname:  String(formData.get('lastname')  || '').trim(),
          email:     String(formData.get('email')     || '').trim(),
          phone:     String(formData.get('phone')     || '').trim(),
          title:     String(formData.get('title')     || '').trim(),
          company:   String(formData.get('company')   || '').trim(),
          street:    String(formData.get('street')    || '').trim(),
          city:      String(formData.get('city')      || '').trim(),
          state:     resolveStateCode(String(formData.get('state') || '')),
          zip:       String(formData.get('zip')       || '').trim()
        };

        const product = currentProduct || productById[values.product];
        const hasContract = product && (product.eformUrl || (product.contracts && product.contracts.length));
        if (!hasContract) {
          errorEl.textContent = 'Please pick a contract before continuing.';
          errorEl.hidden = false;
          return;
        }

        // Validate before anything irreversible — bad data must not reach PandaDoc.
        const fieldErrors = validateForm(values, product);
        if (fieldErrors.length) {
          errorEl.textContent = 'Please fix the highlighted field' + (fieldErrors.length > 1 ? 's' : '') + ' to continue.';
          errorEl.hidden = false;
          const firstBad = form.querySelector('.nash-field-invalid');
          if (firstBad) { try { firstBad.focus(); } catch (e2) {} firstBad.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          return;
        }

        submitBtn.disabled = true;
        submitBtn.querySelector('span').textContent = 'Preparing your contract…';

        // Lead capture is BEST-EFFORT: fire Formspree + HubSpot, but NEVER block the
        // signer from reaching PandaDoc if either fails — fail silently and continue.
        const formspreePayload = Object.assign({}, values, utms, {
          landing_page: 'nashville',
          product_name: product.name,
          _subject: 'Nashville LP — ' + product.name + ' — ' + values.company
        });
        fetch(FORMSPREE_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(formspreePayload)
        }).then(function (r) { if (!r.ok) throw new Error('Formspree ' + r.status); })
          .catch(function (err) { console.warn('[nashville] Formspree submit failed (continuing):', err && err.message); });

        submitToHubSpot(values).catch(function (err) {
          console.warn('[nashville] HubSpot submit failed (continuing):', err && err.message);
        });

        track('nashville_form_submitted', { product: product.slug });

        // Pixel lead event (browser + CAPI, dedupe via hash inside the helper)
        if (window.__metaCAPI) {
          window.__metaCAPI.track(
            'Lead',
            { content_name: 'nashville-contract', content_category: 'nashville-lp', product: product.slug },
            { em: values.email, ph: values.phone, fn: values.firstname, ln: values.lastname }
          );
        }

        loadContract(product, values);
        setStage('contract');
      });

      track('nashville_lp_view');
    })();
  </script>

</ComicCampaignLayout>
