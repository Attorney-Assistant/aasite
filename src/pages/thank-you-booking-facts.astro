---
// FACTS campaign booking confirmation.
// Set as the redirect on the HubSpot `facts` meeting type so every completed booking
// lands here and fires the conversion stack below.
// NOTE: main pixel is intentionally NOT suppressed — this page must load fbq + MetaCAPI
// so PageView, Schedule, Lead, CompleteRegistration and the custom event all fire.
import SimpleCampaignLayout from "@layouts/SimpleCampaignLayout.astro";
---

<SimpleCampaignLayout
  title="You're Booked | Attorney Assistant"
  description="Your intake audit is confirmed. Here's what happens next."
  ogTitle="You're booked."
  ogDescription="Your free intake audit with Attorney Assistant is confirmed."
>

  <!-- ═══════════════════════════ CONFIRMED ═══════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-navy via-brand-900 to-brand-950 grain-overlay min-h-[68vh] flex items-center">
    <div class="absolute inset-0">
      <div class="absolute top-16 left-1/4 w-96 h-96 bg-brand-gold/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-8 right-1/3 w-80 h-80 bg-brand-blue/10 rounded-full blur-3xl"></div>
    </div>

    <div class="container-narrow relative z-10 py-20 md:py-28 text-center">
      <div class="reveal">
        <div class="w-20 h-20 rounded-full bg-brand-gold/10 border-2 border-brand-gold/30 flex items-center justify-center mx-auto mb-8">
          <svg class="w-10 h-10 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Confirmed</span>
        <h1 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          Somebody answered.
        </h1>
        <div class="divider-gold-center mt-4 mb-6"></div>
        <p class="text-lg text-white/65 max-w-lg mx-auto mb-4">
          Your intake audit is on the calendar. You'll get an invite by email in the next few minutes with the call details.
        </p>
        <p class="text-base text-white/40 max-w-lg mx-auto">
          Ironic, isn't it &mdash; that's the entire pitch.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ BEFORE THE CALL ═══════════════════════════ -->
  <section class="py-14 md:py-20 bg-white">
    <div class="container-narrow">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-display-xs font-heading text-gray-900 mb-8 text-center reveal">Before your call</h2>
        <div class="space-y-5">
          <div class="flex items-start gap-4 p-5 rounded-xl border border-gray-200 bg-white reveal" style="transition-delay: 100ms">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
            </div>
            <div>
              <p class="text-base font-semibold text-gray-900">Watch for the calendar invite</p>
              <p class="text-sm text-gray-500 mt-0.5">It lands within a few minutes. Accept it so the time is locked on both sides.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-5 rounded-xl border border-gray-200 bg-white reveal" style="transition-delay: 200ms">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-base font-semibold text-gray-900">Think about where calls actually go</p>
              <p class="text-sm text-gray-500 mt-0.5">After 5 PM, on weekends, when your intake person is on another line &mdash; that's where the audit starts.</p>
            </div>
          </div>
          <div class="flex items-start gap-4 p-5 rounded-xl border border-gray-200 bg-white reveal" style="transition-delay: 300ms">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>
            </div>
            <div>
              <p class="text-base font-semibold text-gray-900">No prep, no deck</p>
              <p class="text-sm text-gray-500 mt-0.5">Fifteen minutes on how your firm handles intake, follow-up, and admin today. Come as you are.</p>
            </div>
          </div>
        </div>

        <div class="text-center mt-10 reveal" style="transition-delay: 400ms">
          <a href="/" class="btn-ghost-light btn-lg inline-flex !text-brand-navy !border-gray-300 hover:!bg-gray-50">Back to attorneyassistant.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════ CONVERSION TRACKING ═══════════════════════════ -->
  <script is:inline>
    (function() {
      var NAME = 'FACTS Campaign Intake Audit Booked';
      var CATEGORY = 'facts_lp_booking';

      // ─── Meta: pixel + Conversions API with shared event IDs for dedup ───
      if (window.__metaCAPI) {
        window.__metaCAPI.track('Schedule',             { content_name: NAME, content_category: CATEGORY }, {});
        window.__metaCAPI.track('Lead',                 { content_name: NAME, content_category: CATEGORY }, {});
        window.__metaCAPI.track('CompleteRegistration', { content_name: NAME, content_category: CATEGORY, status: 'booked' }, {});
        window.__metaCAPI.trackCustom('invitee_meeting_scheduled', { content_name: NAME, content_category: CATEGORY }, {});
      } else if (typeof fbq !== 'undefined') {
        fbq('track', 'Schedule',             { content_name: NAME, content_category: CATEGORY });
        fbq('track', 'Lead',                 { content_name: NAME, content_category: CATEGORY });
        fbq('track', 'CompleteRegistration', { content_name: NAME, content_category: CATEGORY, status: 'booked' });
        fbq('trackCustom', 'invitee_meeting_scheduled', { content_name: NAME });
      }

      // ─── GTM / GA4 ───
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'call_booked',
        conversion_type: 'schedule',
        source: 'facts-campaign',
        campaign: 'facts',
        lp_name: 'FACTS Campaign'
      });
      window.dataLayer.push({
        event: 'booking_confirmed',
        conversion_type: 'schedule',
        source: 'facts-campaign',
        campaign: 'facts'
      });

      // ─── HubSpot: log the confirmation as a tracked page view event ───
      var _hsq = window._hsq = window._hsq || [];
      _hsq.push(['setPath', '/thank-you-booking-facts']);
      _hsq.push(['trackPageView']);
    })();
  </script>

</SimpleCampaignLayout>
