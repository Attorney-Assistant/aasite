---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import CTABanner from "@components/CTABanner.astro";
import YouTubeEmbed from "@components/YouTubeEmbed.astro";
import CareersPixel from "@components/CareersPixel.astro";

const perks = [
  {
    title: "Remote Environment",
    desc: "Be part of an innovative virtual team, constantly updating to the latest technologies.",
    icon: "/icons/law and legal_online law.svg",
  },
  {
    title: "Professional Growth",
    desc: "Continuous learning and professional development opportunities to advance your career.",
    icon: "/icons/buiness & finance_bullish.svg",
  },
  {
    title: "Collaborative Culture",
    desc: "Collaborate and thrive in a supportive work culture with experienced professionals.",
    icon: "/icons/buiness & finance_group.svg",
  },
  {
    title: "Competitive Pay",
    desc: "We believe in paying our employees fairly and treating people right.",
    icon: "/icons/buiness & finance_wallet.svg",
  },
];

const fitItems = [
  "Enjoy working in a fast-paced environment",
  "Have a passion for helping people achieve their goals",
  "Collaborate well with others",
  "Are goal-oriented and driven",
];

const videoIds = ["LWL_3pD5oWk", "Ood5iNtf7VY", "en3ZncZTeZQ"];
---

<BaseLayout title="Careers at Attorney Assistant" description="Join our mission to help law firms operate more efficiently. We're looking for passionate, driven people." suppressMainPixel={true}>

  <Hero
    badge="We're Hiring"
    title="Careers at Attorney Assistant"
    subtitle="Join our growing team. We're looking for passionate, driven people who want to make an impact in the legal industry."
    primaryCta={{ text: "View Open Positions", href: "#positions" }}
  />

  <!-- Company Video + Perks -->
  <section class="py-12 md:py-16 reveal" style="transition-delay: 0.1s;">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <div>
          <span class="badge badge-brand mb-3">Who We Are</span>
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">Discover What's Possible</h2>
          <YouTubeEmbed videoId="oISoqSqsHYU" title="Discover what's possible with Attorney Assistant" />
        </div>
        <div>
          <span class="badge badge-brand mb-3">Benefits</span>
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">Why Work With Us</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {perks.map((perk) => (
              <div class="card p-5 flex gap-4 items-start">
                <div class="featured-icon featured-icon-sm featured-icon-brand flex-shrink-0">
                  <img src={perk.icon} alt="" aria-hidden="true" class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-sm font-heading text-gray-900 mb-1">{perk.title}</h3>
                  <p class="text-xs text-gray-500 leading-relaxed">{perk.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Great Fit + Team Testimonials -->
  <section class="py-12 md:py-16 bg-gray-50 relative overflow-hidden reveal" style="transition-delay: 0.2s;">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">
            You're A Great Fit If You...
          </h2>
          <div class="space-y-3">
            {fitItems.map((item) => (
              <div class="card flex items-center gap-3 p-4">
                <div class="featured-icon featured-icon-sm featured-icon-brand flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <p class="text-sm text-gray-700 font-medium">{item}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="lg:col-span-3">
          <span class="badge badge-brand mb-3">Our Team</span>
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">Hear From Our Team</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {videoIds.map((id) => (
              <YouTubeEmbed videoId={id} title="Team testimonial" />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Positions -->
  <section id="positions" class="py-12 md:py-16 reveal" style="transition-delay: 0.3s;">
    <div class="container-wide">
      <div class="flex items-center gap-3 mb-6">
        <div class="featured-icon featured-icon-sm featured-icon-gold flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
        </div>
        <h2 class="text-display-xs font-heading text-gray-900">Open Positions</h2>
      </div>

      <div class="space-y-4">

        <!-- Case Signer -->
        <details id="job-case-signer" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">New</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">Case Signer</h3>
                <p class="text-xs text-gray-500 mt-0.5">Full-time &middot; In-house (Belize) or Remote (Belize) &middot; <span class="font-semibold text-brand-gold">$5.00/hr USD</span></p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-4">
            <p>Large PI firm seeking 15 Case Signers &mdash; both English-Only and Bilingual (English/Spanish). Work in-house at our Belize office or remote in Belize. Be part of a large team where top performers are recognized and rewarded. The firm fosters motivation and encourages team support and collaboration.</p>
            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">Daily Tasks</h4>
              <ul class="list-disc list-inside space-y-1 text-xs text-gray-600">
                <li>100 outbound calls, 100 texts, 100 emails per day</li>
                <li>Intake calls</li>
                <li>Goal: Sign a minimum of 30 cases per month; aim to sign 50 cases per month</li>
              </ul>
            </div>
            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">Skills Required</h4>
              <ul class="list-disc list-inside space-y-1 text-xs text-gray-600">
                <li>Skilled in gathering data and qualifying leads</li>
                <li>Excellent customer service skills</li>
                <li>Upselling and cross-selling experience</li>
                <li>Proactive sales approach</li>
                <li>Organized and detail-oriented</li>
                <li>Capable of providing first-call resolution</li>
                <li>CRM and data entry experience</li>
                <li>Must have clear pronunciation and accent</li>
                <li>PI experience a plus</li>
              </ul>
            </div>
            <div class="card p-4 bg-brand-gold/10 border-brand-gold/30">
              <h4 class="font-heading text-gray-900 text-sm mb-1">Compensation</h4>
              <p class="text-sm text-gray-800 font-semibold">$5.00/hour USD</p>
            </div>
            <a href="/apply?position=Case+Signer" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
          </div>
        </details>

        <!-- General Legal Impact Assistant -->
        <details id="job-impact-assistant" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">New</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">General Legal Impact Assistant (IA)</h3>
                <p class="text-xs text-gray-500 mt-0.5">Full-time &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-4">
            <p>Assist attorneys and other legal professionals with administrative support including document management, organizing case materials, handling basic client inquiries via email and phone, data entry, drafting letters, gathering important documentation, basic research, and other clerical tasks.</p>
            <a href="/apply?position=General+Legal+Impact+Assistant+(IA)" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
          </div>
        </details>

        <!-- Receptionist -->
        <details id="job-receptionist" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">New</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">Receptionist</h3>
                <p class="text-xs text-gray-500 mt-0.5">Full-time &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-4">
            <p>Answer incoming calls, assist clients with their inquiries, route calls as necessary, and maintain thorough documentation of client interactions. Create a positive first impression for law firm clients by delivering exceptional customer service, empathy, patience, and professionalism.</p>
            <a href="/apply?position=Receptionist" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
          </div>
        </details>

        <!-- Intake Specialist -->
        <details id="job-intake-specialist" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">New</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">Intake Specialist</h3>
                <p class="text-xs text-gray-500 mt-0.5">Full-time &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-4">
            <p>Work in a critical role as the first point of contact for potential clients responsible for handling client inquiries, gathering essential information, and qualifying potential cases for eligibility. Conduct detailed intake interviews to gather relevant client information in the CRM or case management software, schedule appointments, and follow up on leads.</p>
            <a href="/apply?position=Intake+Specialist" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
          </div>
        </details>

        <!-- Intake Specialist-Closer -->
        <details id="job-intake-closer" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">New</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">Intake Specialist-Closer</h3>
                <p class="text-xs text-gray-500 mt-0.5">Full-time &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-4">
            <p>Work as an Intake Specialist, but <strong>most importantly</strong> convert and close leads, sign clients up for services, and onboard them into the law firm system. Sales experience and a genuine interest in sales are paramount in this role.</p>
            <a href="/apply?position=Intake+Specialist-Closer" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
          </div>
        </details>

        <!-- Medical Records Retrieval -->
        <details id="job-medical-records" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">New</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">Medical Records Retrieval</h3>
                <p class="text-xs text-gray-500 mt-0.5">Full-time &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-4">
            <p>Request and retrieve medical records and bills from healthcare providers, hospitals, and insurance companies; track, monitor, and follow up on pending requests to ensure timely delivery of documents; maintain an organized database of records. Organization, attention to detail, and effective communication are the keys to success in this role.</p>
            <a href="/apply?position=Medical+Records+Retrieval" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
          </div>
        </details>

      </div>
    </div>
  </section>

  <CTABanner
    heading="Ready to Join Our Team?"
    body="Apply now and take the first step toward a rewarding career with Attorney Assistant."
    buttonText="Apply Now"
    buttonLink="/apply"
    variant="dark"
  />

  <CareersPixel event="ViewContent" />

  <!-- Salesforce Agentforce Chat (careers + apply only) -->
  <script is:inline>
    function initEmbeddedMessaging() {
      try {
        embeddedservice_bootstrap.settings.language = 'en_US';
        embeddedservice_bootstrap.init(
          '00D8c000005xL1L',
          'Agentforce_Service_Agent_https_attorneyassistant_com_careers',
          'https://turnkeyops.my.site.com/ESWAgentforceServiceAge1742499916572',
          {
            scrt2URL: 'https://turnkeyops.my.salesforce-scrt.com'
          }
        );
      } catch (err) {
        console.error('Error loading Embedded Messaging: ', err);
      }
    }
  </script>
  <script is:inline src="https://turnkeyops.my.site.com/ESWAgentforceServiceAge1742499916572/assets/js/bootstrap.min.js" onload="initEmbeddedMessaging()"></script>

</BaseLayout>
