---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import CTABanner from "@components/CTABanner.astro";
import YouTubeEmbed from "@components/YouTubeEmbed.astro";
import CareersPixel from "@components/CareersPixel.astro";

const perks = [
  {
    title: "Remote Environment",
    desc: "Be part of an innovative virtual team, constantly updating to the latest technologies.",
    icon: "/icons/law and legal_online law.svg",
  },
  {
    title: "Professional Growth",
    desc: "Continuous learning and professional development opportunities to advance your career.",
    icon: "/icons/buiness & finance_bullish.svg",
  },
  {
    title: "Collaborative Culture",
    desc: "Collaborate and thrive in a supportive work culture with experienced professionals.",
    icon: "/icons/buiness & finance_group.svg",
  },
  {
    title: "Competitive Pay",
    desc: "We believe in paying our employees fairly and treating people right.",
    icon: "/icons/buiness & finance_wallet.svg",
  },
];

const fitItems = [
  "Enjoy working in a fast-paced environment",
  "Have a passion for helping people achieve their goals",
  "Collaborate well with others",
  "Are goal-oriented and driven",
];

const videoIds = ["LWL_3pD5oWk", "Ood5iNtf7VY", "en3ZncZTeZQ"];
---

<BaseLayout title="Careers at Attorney Assistant" description="Join our mission to help law firms operate more efficiently. We're looking for passionate, driven people." suppressMainPixel={true}>

  <Hero
    badge="We're Hiring"
    title="Careers at Attorney Assistant"
    subtitle="Join our growing team. We're looking for passionate, driven people who want to make an impact in the legal industry."
    primaryCta={{ text: "View Open Positions", href: "#positions" }}
  />

  <!-- Open Positions -->
  <section id="positions" class="py-12 md:py-16 reveal" style="transition-delay: 0.1s;">
    <div class="container-wide">
      <div class="flex items-center gap-3 mb-6">
        <div class="featured-icon featured-icon-sm featured-icon-gold flex-shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
        </div>
        <h2 class="text-display-xs font-heading text-gray-900">Open Positions</h2>
      </div>

      <div class="space-y-4">

        <!-- Receptionist -->
        <details id="job-receptionist" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">Now Hiring</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">Receptionist</h3>
                <p class="text-xs text-gray-500 mt-0.5">Attorney Assistant &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-5">
            <p>Serve as the first point of contact for law firm clients by answering calls, handling inquiries, routing communications, and delivering an exceptional client experience with professionalism and empathy. This is a client-facing role requiring phone work.</p>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">What We're Looking For</h4>
              <p>We seek candidates who are reliable, professional, and proactive. The qualities that set our top performers apart are strong communication skills, attention to detail, the ability to work independently in a remote environment, and a genuine commitment to delivering excellent service.</p>
            </div>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">Schedule &amp; Compensation</h4>
              <p>Starts at $5 USD per hour for bilingual (English and Spanish) and $4 per hour for English-only. Schedule will vary based on your assigned client's needs and timezone.</p>
            </div>

            <div>
              <a href="/apply/receptionist" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
            </div>
          </div>
        </details>

        <!-- Medical Record Retrieval Specialist -->
        <details id="job-medical-record-retrieval-specialist" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">Now Hiring</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">Medical Record Retrieval Specialist</h3>
                <p class="text-xs text-gray-500 mt-0.5">Attorney Assistant &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-5">
            <p>Request, track, and retrieve medical records and bills from healthcare providers and insurance companies, maintain organized documentation, and follow up to ensure timely delivery. This role involves phone work contacting providers and clients.</p>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">What We're Looking For</h4>
              <p>We seek candidates who are reliable, professional, and proactive. The qualities that set our top performers apart are strong communication skills, attention to detail, the ability to work independently in a remote environment, and a genuine commitment to delivering excellent service.</p>
            </div>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">Schedule &amp; Compensation</h4>
              <p>Starts at $5 USD per hour for bilingual (English and Spanish) and $4 per hour for English-only. Schedule will vary based on your assigned client's needs and timezone.</p>
            </div>

            <div>
              <a href="/apply/medical-record-retrieval-specialist" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
            </div>
          </div>
        </details>

        <!-- General Legal Impact Assistant -->
        <details id="job-legal-impact-assistant" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">Now Hiring</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">General Legal Impact Assistant</h3>
                <p class="text-xs text-gray-500 mt-0.5">Attorney Assistant &middot; Remote</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-5">
            <p>Provide administrative support to attorneys and legal teams, including document management, case organization, client communication, data entry, drafting correspondence, and general clerical tasks.</p>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">What We're Looking For</h4>
              <p>We seek candidates who are reliable, professional, and proactive. The qualities that set our top performers apart are strong communication skills, attention to detail, the ability to work independently in a remote environment, and a genuine commitment to delivering excellent service. In this role, we are seeking candidates with proven administrative experience who are comfortable communicating with clients.</p>
            </div>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">Schedule &amp; Compensation</h4>
              <p>Starts at $5 USD per hour for bilingual (English and Spanish) and $4 per hour for English-only. Schedule will vary based on your assigned client's needs and timezone.</p>
            </div>

            <div>
              <a href="/apply/legal-impact-assistant" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
            </div>
          </div>
        </details>

        <!-- General Legal Impact Assistant — Belize -->
        <details id="job-legal-impact-assistant-belize" class="card overflow-hidden group">
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer select-none hover:bg-gray-25 transition-colors">
            <div class="flex items-center gap-3">
              <span class="badge badge-gold text-[10px]">Now Hiring</span>
              <div>
                <h3 class="text-sm font-heading text-gray-900">General Legal Impact Assistant — Belize</h3>
                <p class="text-xs text-gray-500 mt-0.5">Attorney Assistant &middot; Belize (San Ignacio office or remote within Belize)</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <div class="px-5 pb-5 border-t border-gray-100 pt-4 text-sm text-gray-600 leading-relaxed space-y-5">
            <p><strong>Roles in Belize are either in person in our San Ignacio office OR remote if you're located in other areas.</strong></p>

            <p>Provide administrative support to attorneys and legal teams, including document management, case organization, client communication, data entry, drafting correspondence, and general clerical tasks. The role may also include reception and client intake, which are client-facing tasks requiring phone work.</p>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">What We're Looking For</h4>
              <p>We seek candidates who are reliable, professional, and proactive. The qualities that set our top performers apart are strong communication skills, attention to detail, the ability to work independently in a remote environment, and a genuine commitment to delivering excellent service. In this role, we are seeking candidates with proven administrative experience who are comfortable communicating with clients.</p>
            </div>

            <div>
              <h4 class="font-heading text-gray-900 text-sm mb-2">Schedule &amp; Compensation</h4>
              <p>$5 USD per hour. Schedule will vary based on your assigned client's needs and time zone.</p>
            </div>

            <div>
              <a href="/apply/general-legal-impact-assistant-belize" class="btn-primary btn-sm inline-flex">Apply Now <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg></a>
            </div>
          </div>
        </details>

      </div>
    </div>
  </section>

  <!-- Company Video + Perks -->
  <section class="py-12 md:py-16 reveal" style="transition-delay: 0.1s;">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        <div>
          <span class="badge badge-brand mb-3">Who We Are</span>
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">Discover What's Possible</h2>
          <YouTubeEmbed videoId="oISoqSqsHYU" title="Discover what's possible with Attorney Assistant" />
        </div>
        <div>
          <span class="badge badge-brand mb-3">Benefits</span>
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">Why Work With Us</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {perks.map((perk) => (
              <div class="card p-5 flex gap-4 items-start">
                <div class="featured-icon featured-icon-sm featured-icon-brand flex-shrink-0">
                  <img src={perk.icon} alt="" aria-hidden="true" class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-sm font-heading text-gray-900 mb-1">{perk.title}</h3>
                  <p class="text-xs text-gray-500 leading-relaxed">{perk.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Great Fit + Team Testimonials -->
  <section class="py-12 md:py-16 bg-gray-50 relative overflow-hidden reveal" style="transition-delay: 0.2s;">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">
        <div class="lg:col-span-2">
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">
            You're A Great Fit If You...
          </h2>
          <div class="space-y-3">
            {fitItems.map((item) => (
              <div class="card flex items-center gap-3 p-4">
                <div class="featured-icon featured-icon-sm featured-icon-brand flex-shrink-0">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <p class="text-sm text-gray-700 font-medium">{item}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="lg:col-span-3">
          <span class="badge badge-brand mb-3">Our Team</span>
          <h2 class="text-display-xs font-heading text-gray-900 mb-5">Hear From Our Team</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {videoIds.map((id) => (
              <YouTubeEmbed videoId={id} title="Team testimonial" />
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Ready to Join Our Team?"
    body="Browse our open positions and take the first step toward a rewarding career with Attorney Assistant."
    buttonText="View Open Positions"
    buttonLink="#positions"
    variant="dark"
  />

  <CareersPixel event="ViewContent" />

  <!-- Auto-expand job details when linked from apply page -->
  <script is:inline>
    (function() {
      var hash = window.location.hash;
      if (!hash) return;
      var target = document.querySelector(hash);
      if (target && target.tagName === 'DETAILS') {
        target.open = true;
        setTimeout(function() { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 100);
      }
    })();
  </script>

  <!-- Salesforce Agentforce Chat (careers + apply only) -->
  <script is:inline>
    function initEmbeddedMessaging() {
      try {
        embeddedservice_bootstrap.settings.language = 'en_US';
        embeddedservice_bootstrap.init(
          '00D8c000005xL1L',
          'Agentforce_Service_Agent_https_attorneyassistant_com_careers',
          'https://turnkeyops.my.site.com/ESWAgentforceServiceAge1742499916572',
          {
            scrt2URL: 'https://turnkeyops.my.salesforce-scrt.com'
          }
        );
      } catch (err) {
        console.error('Error loading Embedded Messaging: ', err);
      }
    }
  </script>
  <script is:inline src="https://turnkeyops.my.site.com/ESWAgentforceServiceAge1742499916572/assets/js/bootstrap.min.js" onload="initEmbeddedMessaging()"></script>

</BaseLayout>
