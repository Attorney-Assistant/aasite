---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import FeatureCard from "@components/FeatureCard.astro";
import CTABanner from "@components/CTABanner.astro";

const deliverables = [
  { title: "Calendar & Inbox Management", description: "Court dates, depositions, client meetings, and internal calls coordinated without double-booking or missed details.", icon: "calendar" },
  { title: "Email Triage & Drafting", description: "Inbox filtered, replies drafted, priority messages flagged. You handle decisions, not message volume.", icon: "mail" },
  { title: "Travel & Logistics", description: "Flights, hotels, depositions, conferences, and backup plans — fully arranged with itineraries delivered.", icon: "globe" },
  { title: "Project & Initiative Tracking", description: "Track deliverables, deadlines, and stakeholders for firm initiatives. Status reports kept current without you asking.", icon: "chart" },
  { title: "Event & Meeting Planning", description: "Firm retreats, webinars, depositions — invites, RSVPs, venues, and follow-ups handled end to end.", icon: "users" },
  { title: "Research & Document Prep", description: "Reports, presentations, and research assistance — polished and ready when you need them.", icon: "document" },
];

const howItWorks = [
  { step: "1", title: "Working-style intake", desc: "We learn your preferences, priorities, and pet peeves." },
  { step: "2", title: "Inbox & calendar access", desc: "Set up under your firm's security and access policies." },
  { step: "3", title: "Daily rhythm", desc: "Inbox triage, calendar prep, and priority briefs every day." },
  { step: "4", title: "Weekly review", desc: "Standing weekly review with your assistant to recalibrate." },
];

const faqs = [
  { q: "Do they have access to my inbox and calendar?", a: "Yes — under your firm's security policies. Most clients grant delegated access through Microsoft 365 or Google Workspace, with full audit trails and the ability to revoke access at any time." },
  { q: "How is this different from a legal receptionist?", a: "A receptionist answers calls for the firm. An executive assistant is dedicated to an individual leader — your calendar, your inbox, your travel, your projects. The two roles complement each other but don't overlap." },
  { q: "Is this the right fit for a managing partner vs. an associate?", a: "Executive assistant support is built for managing partners, founding attorneys, and firm leaders — people whose calendar and inbox volume actually requires dedicated support. For associates, a shared admin assistant is usually a better fit." },
  { q: "Can they draft emails in my voice?", a: "Yes. Over the first few weeks, your assistant learns your tone, common responses, and decision patterns. Drafts come queued for your review until you trust them to send directly." },
  { q: "Which service delivers this work?", a: "Executive assistant support is delivered through Staffline — a dedicated team member integrated into your daily operations. Frontline is on-demand intake coverage and doesn't include EA work." },
];
---

<BaseLayout
  title="Virtual Executive Assistant for Law Firm Leaders"
  description="Dedicated executive assistant support for managing partners and firm leaders. Calendar, inbox, travel, and project management handled by a virtual right hand."
>

  <Hero
    badge="Admin & Back Office"
    title="Your Virtual Right Hand."
    subtitle="Stop running your own calendar and inbox. A dedicated executive assistant manages the day-to-day so you can focus on leading the firm."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    secondaryButtonText="See What We Handle"
    secondaryButtonLink="#deliverables"
    size="lg"
  />

  <!-- The Problem -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 reveal">
          <span class="badge badge-brand">The Problem</span>
          <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Managing partners shouldn't be managing their own inbox.</h2>
          <div class="divider-gold mt-5 mb-6"></div>
          <p class="text-lg text-gray-600 leading-relaxed mb-4">
            Founding attorneys and managing partners end up doing their own scheduling, inbox triage, travel booking, and follow-up — because hiring a full-time EA is expensive and the work fluctuates. So the highest-value person in the firm spends two hours a day on logistics.
          </p>
          <p class="text-base text-gray-500 leading-relaxed">
            Your billable rate doesn't match the work you're doing.
          </p>
        </div>
        <div class="lg:col-span-5 reveal" style="transition-delay: 100ms">
          <div class="card p-6 md:p-7 bg-white">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-gold mb-3">What you stop doing yourself</p>
            <ul class="space-y-3 text-sm text-gray-700">
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Negotiating scheduling back-and-forth across three calendars</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Triaging 200+ emails between meetings</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Booking flights and hotels for deposition travel</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Chasing your own follow-ups on firm initiatives</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Handle -->
  <section class="section-padding" id="deliverables">
    <div class="container-wide">
      <div class="text-center mb-12 md:mb-16 reveal">
        <span class="badge badge-brand">What We Handle</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Calendar to inbox to travel to projects</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">A dedicated assistant trained on your working style — running your day in the background.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {deliverables.map((d, i) => (
          <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
            <FeatureCard title={d.title} description={d.description} icon={d.icon} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Which Product Delivers This -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="text-center mb-12 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Which Product Delivers This</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Executive support is dedicated work — delivered by Staffline.</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto">
        <a href="/services/staffline" class="card card-hover p-7 md:p-8 bg-white border-brand-gold/40 ring-1 ring-brand-gold/30 group reveal">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-gold">Best Fit</span>
            <span class="text-xs font-semibold text-brand-gold uppercase tracking-wide">On-staff extension</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Staffline</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            A dedicated EA who learns your working style, your priorities, and your standing relationships — then runs your calendar, inbox, and projects in the background.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Explore Staffline <span aria-hidden="true">→</span></span>
        </a>
        <a href="/services/frontline" class="card card-hover p-7 md:p-8 bg-white opacity-90 group reveal" style="transition-delay: 100ms">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-brand">Different Fit</span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">On-demand coverage</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Frontline</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            Frontline is on-demand intake and reception coverage — not executive support. Pair it with a Staffline assistant for end-to-end coverage of the firm.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Learn about Frontline <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-brand">How It Works</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">From onboarding to your daily rhythm</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {howItWorks.map((s, i) => (
          <div class="text-center reveal" style={`transition-delay: ${i * 80}ms`}>
            <div class={`w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-lg border-2 ${i === howItWorks.length - 1 ? 'bg-brand-gold border-brand-gold text-brand-navy' : 'bg-white border-brand-navy text-brand-navy'}`}>
              {s.step}
            </div>
            <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide mb-2">{s.title}</h3>
            <p class="text-sm text-gray-500 leading-snug">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="section-padding bg-gray-25">
    <div class="container-wide">
      <div class="text-center mb-10 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Outcomes</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">What changes for you</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { title: "Hours back every week", body: "Calendar wrangling, inbox triage, and travel booking come off your plate. Those hours go back into client work, business development, or your family." },
          { title: "Less context switching", body: "Decisions queue up instead of pinging you constantly. Focus blocks actually stay focused." },
          { title: "Nothing slips", body: "Follow-ups, deadlines, and commitments tracked by someone whose job is tracking them." },
        ].map((item, i) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="text-base font-heading text-gray-900 mb-2">{item.title}</p>
            <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="text-center mb-10 reveal">
        <span class="badge badge-brand">FAQ</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Common questions</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-xl border border-gray-200 bg-white p-5 md:p-6 reveal" style={`transition-delay: ${i * 50}ms`}>
            <summary class="flex items-center justify-between cursor-pointer text-base font-heading text-gray-900 list-none">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="text-sm text-gray-600 leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Stop Running Your Own Calendar."
    body="See how a dedicated executive assistant fits your role — and pays for itself in attorney hours recovered."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    variant="brand"
  />

</BaseLayout>
