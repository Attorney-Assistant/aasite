---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import FeatureCard from "@components/FeatureCard.astro";
import CTABanner from "@components/CTABanner.astro";

const deliverables = [
  { title: "Opening Case Files", description: "New cases opened in your case management system within hours of signing — fully populated, properly coded, ready to work.", icon: "folder" },
  { title: "Letters of Representation", description: "LORs drafted, sent, and tracked to every adjuster, insurer, and provider on day one of representation.", icon: "document" },
  { title: "Pleadings & Motions", description: "Complaints, motions, responses, and routine filings drafted from your firm's templates and attorney direction.", icon: "scale" },
  { title: "Discovery Responses", description: "Interrogatories, requests for production, and requests for admission — drafted, organized, and ready for attorney review.", icon: "document" },
  { title: "Formal Demand Letters", description: "Demand packages assembled with chronology, exhibits, and supporting documentation — ready for negotiation.", icon: "mail" },
  { title: "Deadline & Calendar Tracking", description: "Statute, court, and discovery deadlines tracked across every active matter so nothing slips.", icon: "calendar" },
];

const howItWorks = [
  { step: "1", title: "Template integration", desc: "Your firm's pleadings, LORs, and demand templates loaded into our workflow." },
  { step: "2", title: "Matter intake", desc: "New cases opened and LORs sent same-day after signing." },
  { step: "3", title: "Drafting cadence", desc: "Pleadings, discovery, and demands drafted on your firm's schedule." },
  { step: "4", title: "Attorney review", desc: "Everything queued for attorney sign-off — never sent without you." },
];

const faqs = [
  { q: "Do your assistants draft pleadings from scratch?", a: "We draft from your firm's templates with attorney direction on the substance. Attorneys review and sign everything before it leaves the firm — we accelerate the drafting, never replace attorney judgment." },
  { q: "What practice areas do you support?", a: "We're built for contingency-fee firms — personal injury, mass tort, and similar. Our drafting workflows are tuned to PI matters, but Impact Assistants can be trained on your firm's specific practice areas and templates." },
  { q: "How do you handle confidentiality and conflicts?", a: "Every Impact Assistant signs strict confidentiality agreements and works inside your case management system. Conflict checks run on every new matter before intake." },
  { q: "Can you track court deadlines and statutes?", a: "Yes. Deadline tracking is part of standard litigation support — court dates, statute of limitations, discovery cutoffs, and response windows all live in your firm's calendar with redundant tracking on our side." },
  { q: "Which product handles this work?", a: "Litigation support is dedicated case work — delivered through Impact Assistants. Intake 360 handles intake and reception, not pleadings or discovery drafting." },
];
---

<BaseLayout
  title="Litigation Support — Pleadings, Discovery & Demands"
  description="Case file opening, letters of representation, pleadings, interrogatories, and formal demand letters drafted by a dedicated team trained on your firm's templates."
>

  <Hero
    badge="Case & Matter Support"
    title="Litigation Support That Keeps Cases Moving."
    subtitle="Open files, send LORs, draft pleadings, manage discovery, and chase deadlines. Your attorneys focus on the law — we handle the paper that makes a case move."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    secondaryButtonText="See What We Handle"
    secondaryButtonLink="#deliverables"
    size="lg"
  />

  <!-- The Problem -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 reveal">
          <span class="badge badge-brand">The Problem</span>
          <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Drafting work piles up. Cases stall behind it.</h2>
          <div class="divider-gold mt-5 mb-6"></div>
          <p class="text-lg text-gray-600 leading-relaxed mb-4">
            New cases sit unopened for days. LORs go out a week late. Discovery responses pile up against deadline. Demand packages don't get drafted because the paralegal who'd write them is buried in records requests.
          </p>
          <p class="text-base text-gray-500 leading-relaxed">
            The work isn't hard. It's relentless — and the firm's growth ceiling is the team's drafting bandwidth.
          </p>
        </div>
        <div class="lg:col-span-5 reveal" style="transition-delay: 100ms">
          <div class="card p-6 md:p-7 bg-white">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-gold mb-3">Where firms get stuck</p>
            <ul class="space-y-3 text-sm text-gray-700">
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>New signed cases sitting unopened for a week or more</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Demands going out months after they should have</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Discovery responses written under last-minute pressure</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Attorneys drafting routine paper instead of negotiating cases</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Handle -->
  <section class="section-padding" id="deliverables">
    <div class="container-wide">
      <div class="text-center mb-12 md:mb-16 reveal">
        <span class="badge badge-brand">What We Handle</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">From file open to formal demand</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Drafting and matter support — done from your firm's templates, queued for attorney review.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {deliverables.map((d, i) => (
          <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
            <FeatureCard title={d.title} description={d.description} icon={d.icon} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Which Product Delivers This -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="text-center mb-12 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Which Product Delivers This</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Litigation support is dedicated work — delivered by Impact Assistants.</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto">
        <a href="/services/impact-assistants" class="card card-hover p-7 md:p-8 bg-white border-brand-gold/40 ring-1 ring-brand-gold/30 group reveal">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-gold">Best Fit</span>
            <span class="text-xs font-semibold text-brand-gold uppercase tracking-wide">On-staff extension</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Impact Assistants</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            A dedicated assistant trained on your firm's templates and case criteria — drafting pleadings, discovery, and demands at your firm's pace.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Explore Impact Assistants <span aria-hidden="true">→</span></span>
        </a>
        <a href="/services/intake-360" class="card card-hover p-7 md:p-8 bg-white opacity-90 group reveal" style="transition-delay: 100ms">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-brand">Different Fit</span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">On-demand coverage</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Intake 360</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            Intake 360 covers intake and reception — not pleadings or discovery drafting. Pair it with Impact Assistants for end-to-end case coverage.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Learn about Intake 360 <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-brand">How It Works</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">From template integration to attorney sign-off</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {howItWorks.map((s, i) => (
          <div class="text-center reveal" style={`transition-delay: ${i * 80}ms`}>
            <div class={`w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-lg border-2 ${i === howItWorks.length - 1 ? 'bg-brand-gold border-brand-gold text-brand-navy' : 'bg-white border-brand-navy text-brand-navy'}`}>
              {s.step}
            </div>
            <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide mb-2">{s.title}</h3>
            <p class="text-sm text-gray-500 leading-snug">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="section-padding bg-gray-25">
    <div class="container-wide">
      <div class="text-center mb-10 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Outcomes</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">What changes for your firm</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { title: "Cases move faster", body: "Files open same-day. LORs send same-day. Demands go out when the file is ready — not when the team finally has bandwidth." },
          { title: "Attorneys back on negotiation", body: "Routine drafting comes off your attorneys' desks. They use their hours on the work only they can do." },
          { title: "Higher case throughput", body: "Your firm's drafting bandwidth stops being the ceiling on caseload. Growth doesn't require new hires." },
        ].map((item, i) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="text-base font-heading text-gray-900 mb-2">{item.title}</p>
            <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="text-center mb-10 reveal">
        <span class="badge badge-brand">FAQ</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Common questions</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-xl border border-gray-200 bg-white p-5 md:p-6 reveal" style={`transition-delay: ${i * 50}ms`}>
            <summary class="flex items-center justify-between cursor-pointer text-base font-heading text-gray-900 list-none">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="text-sm text-gray-600 leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Stop Letting the Drafting Pile Slow Your Firm Down."
    body="See how a dedicated case-support team moves files faster — without adding internal headcount."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    variant="brand"
  />

</BaseLayout>
