---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import FeatureCard from "@components/FeatureCard.astro";
import CTABanner from "@components/CTABanner.astro";

const deliverables = [
  { title: "Medical Record Retrieval", description: "We request, chase, and receive records from every provider on file. Subpoenas, HIPAA authorizations, repeated follow-ups — handled.", icon: "folder" },
  { title: "Medical Bill Retrieval", description: "Itemized bills pulled from every provider, hospital, ER, imaging center, and specialist that touched the case.", icon: "document" },
  { title: "Record Summaries & Chronologies", description: "Date-ordered medical chronologies and treatment summaries built for demand packages and case evaluation.", icon: "document" },
  { title: "Bill Balance Verification", description: "Outstanding balances confirmed against every provider before demand drafting — no surprises at settlement.", icon: "chart" },
  { title: "Child Support Lien Checks", description: "Statewide child-support lien verification on every plaintiff before disbursement.", icon: "shield" },
  { title: "Provider Follow-Up Cadence", description: "Weekly chase calls and faxes until the records arrive. No request is left to die in a hospital ROI department.", icon: "phone" },
];

const howItWorks = [
  { step: "1", title: "Provider list intake", desc: "You send us the providers; we set up the request matrix." },
  { step: "2", title: "Authorizations & requests", desc: "HIPAA-compliant requests sent same day, tracked in your CRM." },
  { step: "3", title: "Follow-up cadence", desc: "Weekly chase until records and bills are in hand." },
  { step: "4", title: "Summary delivered", desc: "Chronology + bill summary uploaded to your case file." },
];

const faqs = [
  { q: "How fast do you turn around a typical records request?", a: "First request goes out same day. Average provider turnaround is 14–30 days; we chase weekly until we have everything. Complex multi-provider cases typically wrap inside 60 days." },
  { q: "Do you handle subpoenas when providers won't respond?", a: "Yes. We draft and serve subpoenas through your firm when authorizations are ignored, and follow up until compliance." },
  { q: "Will summaries be ready for demand packages?", a: "Yes. Chronologies are formatted to drop directly into your demand template — dates, providers, diagnoses, treatments, and bill totals organized for adjuster review." },
  { q: "Do you bill providers for record fees?", a: "We coordinate fees through your firm's preferred billing process. ROI fees, copy charges, and certifications are itemized and tracked." },
  { q: "Which service handles this work?", a: "Medical records work is delivered through Staffline — a dedicated team member integrated into your case workflow. Frontline is on-demand intake coverage and doesn't include case-level records work." },
];
---

<BaseLayout
  title="Medical Records, Bills & Chronologies for Law Firms"
  description="Medical record retrieval, bill collection, chronologies, and lien checks for personal injury and contingency-fee firms. Records show up so cases can move."
>

  <Hero
    badge="Case & Matter Support"
    title="Medical Records, Handled."
    subtitle="From request to chronology, we collect every record and bill, run lien checks, and deliver demand-ready summaries — so your case team gets buildable files, not paper chases."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    secondaryButtonText="See What We Handle"
    secondaryButtonLink="#deliverables"
    size="lg"
  />

  <!-- The Problem -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 reveal">
          <span class="badge badge-brand">The Problem</span>
          <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Records aren't the work. Chasing them is.</h2>
          <div class="divider-gold mt-5 mb-6"></div>
          <p class="text-lg text-gray-600 leading-relaxed mb-4">
            Every PI case stalls in the same place: waiting on records. Providers ignore requests. ROI departments lose authorizations. Bills arrive missing line items. Your paralegals burn weeks on follow-up calls instead of building demand packages.
          </p>
          <p class="text-base text-gray-500 leading-relaxed">
            The work itself is simple. The volume kills you.
          </p>
        </div>
        <div class="lg:col-span-5 reveal" style="transition-delay: 100ms">
          <div class="card p-6 md:p-7 bg-white">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-gold mb-3">What it usually looks like</p>
            <ul class="space-y-3 text-sm text-gray-700">
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Authorizations sitting in a queue for 3+ weeks before going out</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Providers ignoring 2nd and 3rd requests</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Bills missing dates, providers, or line items</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Demand packages delayed for months waiting on one final record</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Handle -->
  <section class="section-padding" id="deliverables">
    <div class="container-wide">
      <div class="text-center mb-12 md:mb-16 reveal">
        <span class="badge badge-brand">What We Handle</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">From request to demand-ready summary</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Every deliverable below is part of the standard medical records workflow for our case-team clients.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {deliverables.map((d, i) => (
          <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
            <FeatureCard title={d.title} description={d.description} icon={d.icon} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Which Product Delivers This -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="text-center mb-12 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Which Product Delivers This</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Medical records is dedicated work — delivered by Staffline.</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto">
        <a href="/services/staffline" class="card card-hover p-7 md:p-8 bg-white border-brand-gold/40 ring-1 ring-brand-gold/30 group reveal">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-gold">Best Fit</span>
            <span class="text-xs font-semibold text-brand-gold uppercase tracking-wide">On-staff extension</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Staffline</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            A dedicated assistant who learns your providers, your record requirements, and your demand template — then runs your records pipeline end-to-end.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Explore Staffline <span aria-hidden="true">→</span></span>
        </a>
        <a href="/services/frontline" class="card card-hover p-7 md:p-8 bg-white opacity-90 group reveal" style="transition-delay: 100ms">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-brand">Different Fit</span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">On-demand coverage</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Frontline</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            Frontline is action-based intake and reception coverage — not case-level records work. Pair it with Staffline for full coverage from first call to settlement.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Learn about Frontline <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-brand">How It Works</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">From provider list to demand-ready file</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {howItWorks.map((s, i) => (
          <div class="text-center reveal" style={`transition-delay: ${i * 80}ms`}>
            <div class={`w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-lg border-2 ${i === howItWorks.length - 1 ? 'bg-brand-gold border-brand-gold text-brand-navy' : 'bg-white border-brand-navy text-brand-navy'}`}>
              {s.step}
            </div>
            <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide mb-2">{s.title}</h3>
            <p class="text-sm text-gray-500 leading-snug">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="section-padding bg-gray-25">
    <div class="container-wide">
      <div class="text-center mb-10 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Outcomes</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">What changes for your firm</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { title: "Demand-ready files, faster", body: "Cases reach demand stage in weeks, not quarters. Your paralegals stop chasing — they start building." },
          { title: "Cleaner financial picture", body: "Bill balances verified before demand. No nasty surprises during lien negotiation or final disbursement." },
          { title: "Attorneys back on the law", body: "Your team stops being the records department. They focus on case value, negotiation, and trial prep." },
        ].map((item, i) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="text-base font-heading text-gray-900 mb-2">{item.title}</p>
            <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="text-center mb-10 reveal">
        <span class="badge badge-brand">FAQ</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Common questions</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-xl border border-gray-200 bg-white p-5 md:p-6 reveal" style={`transition-delay: ${i * 50}ms`}>
            <summary class="flex items-center justify-between cursor-pointer text-base font-heading text-gray-900 list-none">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="text-sm text-gray-600 leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Stop Chasing Records. Start Closing Cases."
    body="See how a dedicated case-support team can move your demand packages off the back burner."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    variant="brand"
  />

</BaseLayout>
