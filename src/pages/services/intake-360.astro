---
import BaseLayout from "@layouts/BaseLayout.astro";
import CTABanner from "@components/CTABanner.astro";
import TestimonialCard from "@components/TestimonialCard.astro";
import { fetchFeaturedTestimonials } from "@lib/hubspot";

let testimonials: any[] = [];
try {
  testimonials = (await fetchFeaturedTestimonials()) || [];
} catch {}

const buckets = [
  {
    num: "1",
    title: "Intake Actions",
    items: [
      "New client intake completed",
      "Lead qualification and case screening",
      "Conflict checks and data validation",
      "Case signing for qualified clients",
      "Warm transfers to your team",
    ],
  },
  {
    num: "2",
    title: "Reception & Call Handling",
    items: [
      "Inbound calls answered",
      "After-hours and overflow coverage",
      "Message taking and documentation",
      "Missed-call recovery attempts",
    ],
  },
  {
    num: "3",
    title: "Follow-Up & Workflow",
    items: [
      "Callback attempts and re-engagement",
      "Appointment confirmations and scheduling",
      "Lead disposition updates",
      "Workflow tasks tied to completed actions",
    ],
  },
];

const journey = [
  { step: "1", title: "Sign Up & Integrate", desc: "Onboard with your case management system." },
  { step: "2", title: "Activate Coverage",   desc: "Fund credits. Access & Support Fee begins." },
  { step: "3", title: "Capture Every Lead",  desc: "We answer, qualify, sign cases, and follow up 24/7." },
  { step: "4", title: "Review Activity",     desc: "Track every action and signed case outcome." },
  { step: "5", title: "Sign More Cases",     desc: "Stop losing revenue to broken intake." },
];

const included = [
  { title: "Client Portal", desc: "Credit usage, signed agreements, feedback, comments, and data in one place." },
  { title: "English & Spanish", desc: "Bilingual agents serve your full client base." },
  { title: "AI + Human Pairing", desc: "Complete, around-the-clock coverage." },
  { title: "QA on Every Call", desc: "Every call we handle on your behalf is reviewed." },
  { title: "Recurring Meetings", desc: "Ongoing check-ins with your dedicated Success Manager." },
  { title: "Scales With You", desc: "Grow without adding internal hires." },
];
---

<BaseLayout
  title="Intake360 — 24/7 Intake Coverage for Contingency-Fee Firms"
  description="Intake360 is your firm's always-on intake and reception operation — built for contingency-fee firms. $997/month keeps your firm covered; $3,600 buys 360 action-based credits."
>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-950 via-brand-900 to-brand-navy py-16 md:py-24 border-b-4 border-brand-gold">
    <div class="grain-overlay"></div>
    <!-- Ambient gold orb -->
    <div class="hero-orb-gold" aria-hidden="true"></div>
    <div class="container-wide relative z-10">
      <!-- Brand mark + eyebrow -->
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8 reveal">
        <div>
          <div class="font-heading font-black text-2xl md:text-3xl text-white tracking-tight leading-none">
            Intake<span class="text-brand-gold">360</span>
          </div>
          <div class="mt-1.5 text-[10px] md:text-xs uppercase tracking-[0.2em] text-white/60 font-semibold">A service by Attorney Assistant</div>
        </div>
        <div class="flex items-center gap-2.5 text-[10px] md:text-xs uppercase tracking-[0.25em] text-white/70 font-semibold">
          <span class="w-8 h-0.5 bg-brand-gold inline-block"></span>
          <span>24/7 Intake &amp; Reception Coverage</span>
        </div>
      </div>

      <h1 class="font-heading font-extrabold text-white text-display-md md:text-display-lg leading-[1.05] tracking-tight max-w-5xl reveal" style="transition-delay: 80ms;">
        24/7 intake coverage that keeps leads from <span class="text-brand-gold">slipping through the cracks.</span>
      </h1>

      <p class="mt-6 text-base md:text-lg text-white/80 leading-relaxed max-w-4xl reveal" style="transition-delay: 160ms;">
        Intake360 is your firm's always-on intake and reception operation — built exclusively for contingency-fee firms. We answer, qualify, <strong class="text-brand-gold font-bold">sign cases on your behalf</strong>, and follow up on every lead the moment it comes in, so missed calls, after-hours leads, overflow, and weak follow-up stop turning into lost cases.
      </p>

      <div class="mt-8 flex flex-wrap gap-3 reveal" style="transition-delay: 240ms;">
        <a href="/contact" class="btn-primary btn-lg group">
          See What You're Missing After Hours
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
        </a>
        <a href="#pricing" class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-white border border-white/25 hover:border-brand-gold hover:text-brand-gold transition-colors">How Pricing Works</a>
      </div>
    </div>

    <style>
      .hero-orb-gold {
        position: absolute;
        top: -15%;
        right: -8%;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(249,166,48,0.18) 0%, rgba(249,166,48,0) 70%);
        pointer-events: none;
        z-index: 1;
      }
    </style>
  </section>

  <!-- The Differentiator: We Sign Cases -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-14 md:py-20 border-y-4 border-brand-gold">
    <div class="grain-overlay"></div>
    <div class="container-wide relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 reveal">
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">The Difference</span>
          <h2 class="text-display-sm md:text-display-md font-heading text-white leading-tight mb-5">
            We don't just answer the phone. <span class="text-brand-gold">We sign cases on your behalf.</span>
          </h2>
          <p class="text-lg text-white/80 leading-relaxed mb-5">
            Most intake services qualify a lead, take a message, and pass it back to your firm. Intake360 closes. Our intake specialists are trained to <strong class="text-white">sign retainer agreements for your firm</strong> — so qualified leads become signed clients the moment they're ready, not after a callback queue or an attorney's lunch break.
          </p>
          <p class="text-base text-white/60 leading-relaxed">
            That's the difference between a phone-answering service and an intake operation that actually moves your pipeline.
          </p>
        </div>
        <div class="lg:col-span-5 reveal" style="transition-delay: 100ms">
          <div class="space-y-4">
            <div class="flex items-start gap-4 p-5 rounded-xl border border-white/10 bg-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/15 text-brand-gold flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <p class="text-sm font-heading text-white mb-1">Signed before the lead cools off</p>
                <p class="text-sm text-white/60 leading-snug">We close while they're still on the line — not days later from a callback queue.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 rounded-xl border border-white/10 bg-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/15 text-brand-gold flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
              </div>
              <div>
                <p class="text-sm font-heading text-white mb-1">Qualified, conflict-checked, signed</p>
                <p class="text-sm text-white/60 leading-snug">By the time the lead lands in your case management system, it's already a client.</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-5 rounded-xl border border-white/10 bg-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-brand-gold/15 text-brand-gold flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              </div>
              <div>
                <p class="text-sm font-heading text-white mb-1">Your attorneys see signed clients</p>
                <p class="text-sm text-white/60 leading-snug">Not unqualified prospects to chase. They start with a retainer in hand.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="section-padding" id="pricing">
    <div class="container-wide">
      <div class="text-center mb-10 md:mb-12 reveal max-w-3xl mx-auto">
        <span class="badge badge-brand">How Intake360 Pricing Works</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">A flat fee for coverage. Credits for completed work.</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 leading-relaxed mt-6">
          <strong class="text-gray-900">$997/month</strong> keeps your firm covered. <strong class="text-gray-900">$3,600</strong> buys <strong class="text-gray-900">360 action-based credits</strong>. The fee and credits are separate — credits are used only when defined intake, case-signing, call handling, follow-up, or workflow actions are completed.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto">
        <!-- Access & Support Fee -->
        <div class="card p-7 md:p-8 bg-brand-gold/[0.04] border-brand-gold/40 reveal">
          <span class="badge badge-gold mb-4">Part 1 — The Foundation</span>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-1">Access &amp; Support Fee</h3>
          <p class="text-sm font-semibold text-brand-gold mb-5">Internally, we call it the &ldquo;Sleep Easy&rdquo; fee.</p>
          <div class="flex items-end gap-1 mb-5">
            <span class="text-2xl font-heading text-gray-900 -mb-1">$</span>
            <span class="text-5xl md:text-6xl font-heading text-gray-900 leading-none tracking-tight">997</span>
            <span class="text-sm font-bold text-gray-500 mb-2 ml-2">per month</span>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            No more wondering whether the after-hours leads got worked, the weekend calls got returned, or an overflow lead fell into a black hole. The Access &amp; Support Fee buys your firm <strong class="text-gray-900">operational peace of mind</strong> — a flat monthly fee that keeps your firm actively covered across nights, weekends, overflow, and follow-up.
          </p>
          <div class="border-t border-gray-200 pt-5">
            <ul class="space-y-2.5">
              {["Active enrollment and continuous opt-in to Intake360",
                "24/7 readiness of our intake team, systems, and routing",
                "Coverage of inbound calls, after-hours leads, and overflow",
                "Quality Assurance reviews to monitor service consistency",
                "Dedicated Client Success Manager for ongoing support",
                "Ongoing follow-up engagement on leads you've already sent us"].map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-700 leading-snug">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Credits -->
        <div class="card p-7 md:p-8 reveal" style="transition-delay: 100ms">
          <span class="badge badge-brand mb-4">Part 2 — Real Work, Tracked</span>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-1">Credits That Track Real Work Completed</h3>
          <p class="text-sm font-semibold text-gray-500 mb-5">You&rsquo;re billed by the action — never for idle time.</p>
          <div class="flex items-end gap-1 mb-5">
            <span class="text-2xl font-heading text-gray-900 -mb-1">$</span>
            <span class="text-5xl md:text-6xl font-heading text-gray-900 leading-none tracking-tight">3,600</span>
            <span class="text-sm font-bold text-gray-500 mb-2 ml-2">= 360 credits</span>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            Credits are spent only when our team completes a defined intake, case-signing, call handling, follow-up, or workflow action on your leads. <strong class="text-gray-900">Never for hold time, idle time, or just being on coverage.</strong> Credits scale with your volume.
          </p>
          <div class="border-t border-gray-200 pt-5">
            <ul class="space-y-2.5">
              {["Used only when defined actions are completed",
                "Same credit cost whether a human or AI completes the action",
                "Re-up anytime — credits roll forward until used",
                "Separate from and in addition to the Access & Support Fee"].map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-700 leading-snug">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-navy mt-2 flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Three Credit Buckets -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="text-center mb-10 md:mb-12 reveal">
        <span class="badge badge-brand">What Credits Cover</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">The Three Buckets</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-base text-gray-500 max-w-2xl mx-auto mt-5">Every credit-eligible action falls into one of three categories.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {buckets.map((bucket, i) => (
          <div class="card p-6 md:p-7 reveal" style={`transition-delay: ${i * 100}ms`}>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-9 h-9 rounded-lg bg-brand-navy text-brand-gold flex items-center justify-center font-heading text-lg flex-shrink-0">
                {bucket.num}
              </div>
              <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide">{bucket.title}</h3>
            </div>
            <ul class="space-y-2">
              {bucket.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-600 leading-snug">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Journey -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-brand">Your Intake360 Journey</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">From sign-up to signed cases</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 lg:gap-4 max-w-6xl mx-auto">
        {journey.map((step, i) => (
          <div class="relative text-center reveal" style={`transition-delay: ${i * 80}ms`}>
            <div class={`w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-lg border-2 ${i === journey.length - 1 ? 'bg-brand-gold border-brand-gold text-brand-navy' : 'bg-white border-brand-navy text-brand-navy'}`}>
              {step.step}
            </div>
            <h3 class="text-xs font-heading text-gray-900 uppercase tracking-wide mb-2">{step.title}</h3>
            <p class="text-xs text-gray-500 leading-snug">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AA Promise Band -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950 py-14 md:py-20 border-y-4 border-brand-gold">
    <div class="grain-overlay"></div>
    <div class="container-narrow relative z-10 text-center">
      <div class="reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">The Attorney Assistant Promise</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white leading-tight">
          We rescue law firms from chaos with our <span class="text-brand-gold">elite teams + AI solutions.</span>
        </h2>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">What's Included</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Built so missed leads stop becoming missed cases.</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {included.map((item, i) => (
          <div class="flex items-start gap-3 p-5 rounded-xl border border-gray-200 bg-white reveal" style={`transition-delay: ${i * 60}ms`}>
            <div class="flex-shrink-0 w-7 h-7 rounded-md bg-brand-gold/10 text-brand-gold flex items-center justify-center mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <p class="text-sm font-heading text-gray-900 mb-1">{item.title}</p>
              <p class="text-sm text-gray-500 leading-snug">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom Reassurance Band -->
  <section class="py-14 md:py-16 bg-gray-25">
    <div class="container-wide">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { title: "Always-on coverage", body: "Intake360 keeps the intake engine ready when your office is closed, overloaded, or stuck in callback purgatory." },
          { title: "Action-based billing", body: "Credits are tied to completed work, so the model stays clean, trackable, and painfully easy to explain." },
          { title: "Case-signing execution", body: "Dedicated teams and AI-supported workflows help capture, qualify, sign, and route more leads without adding internal headcount." },
        ].map((item, i) => (
          <div class="p-5 rounded-xl border border-gray-200 bg-white reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="text-base font-heading text-gray-900 mb-1.5">{item.title}</p>
            <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  {testimonials.length > 0 && (
    <section class="section-padding">
      <div class="container-wide">
        <div class="text-center mb-12 md:mb-16 reveal">
          <span class="badge badge-brand">Results</span>
          <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">Client Results</h2>
          <div class="divider-gold-center mt-5"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {testimonials.slice(0, 3).map((t: any) => <TestimonialCard {...t} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Better Together -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-narrow text-center relative">
      <div class="reveal">
        <span class="badge badge-brand">Better Together</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">
          Complete Coverage for Your Firm
        </h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 leading-relaxed max-w-2xl mx-auto mb-8">
          Intake360 captures every lead — and pairing it with a <a href="/services/impact-assistants" class="text-brand-600 font-semibold hover:text-brand-700 underline decoration-brand-200 hover:decoration-brand-600 transition-colors">dedicated assistant</a> gives your firm comprehensive coverage from first call to case resolution. Most of our clients benefit from this strategic combination, and our team will help you find the right mix.
        </p>
        <a href="/book-call" class="btn-primary btn-lg group">Build Your Custom Solution</a>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Start Capturing Every Lead"
    body="See for yourself what your firm is missing after hours."
    buttonText="Schedule a Demo"
    buttonLink="/contact"
    variant="brand"
  />

  <!-- Legal disclosure -->
  <section class="py-8 bg-brand-950">
    <div class="container-narrow">
      <p class="text-xs text-white/60 leading-relaxed text-center max-w-3xl mx-auto">
        <strong class="text-brand-gold">Access &amp; Support Fee</strong> renews every 30 days using the payment method on file until canceled in writing. The service fee is separate from credit purchases and does not include credits or guarantee a specific number of calls, transfers, or signed contracts.
      </p>
    </div>
  </section>

</BaseLayout>
