---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import CTABanner from "@components/CTABanner.astro";

const capabilities = [
  { eyebrow: "Intake & Client-Facing", items: ["Reception 24/7", "Overnight intake", "Qualifying & closing", "15-touch follow-up", "Warm transfers", "Client engagement"] },
  { eyebrow: "Case & Matter Support", items: ["Case file opening", "Medical record retrieval", "Bill & lien checks", "Lien reduction", "Pleadings & discovery", "Demand letters"] },
  { eyebrow: "Admin & Back Office", items: ["Mail sorting", "Data mining", "SOP build-out", "Calendar & inbox", "CRM hygiene", "Custom workflows"] },
];

const comparison = [
  {
    label: "Intake 360",
    tag: "On-demand coverage",
    summary: "Always-on intake and reception. We answer, qualify, sign cases, and follow up — 24/7.",
    fits: ["You're losing leads to missed calls or slow follow-up", "You need nights, weekends, and overflow coverage", "You want cases signed on first contact"],
    pricing: "$997/month, action-based credits",
    href: "/services/intake-360",
  },
  {
    label: "Impact Assistants",
    tag: "On-staff extension",
    summary: "A dedicated team member who runs your case, admin, or EA workflow as a seamless part of your firm.",
    fits: ["You're drowning in records, liens, pleadings, or admin", "You need consistent, dedicated coverage on case work", "You want headcount-quality work without hiring"],
    pricing: "Custom scoping based on role and hours",
    href: "/services/impact-assistants",
  },
];

const faqs = [
  { q: "What's the difference between a VLA and an in-house hire?", a: "A virtual legal assistant gives you the same work output as an in-house team member — without the recruiting, payroll, benefits, training, turnover, or office space. We hire, train, and manage the team. You get the work product." },
  { q: "Can a VLA actually integrate with my case management system?", a: "Yes. Impact Assistants work inside your existing case management system (Filevine, Litify, Clio, MyCase, SmartAdvocate, etc.) just like an internal employee. Intake 360 also writes back to your CMS so every action is logged." },
  { q: "Do I get the same person every day?", a: "With Impact Assistants, yes — you get a dedicated team member who knows your firm. With Intake 360, you get a trained team operating under shared QA and your firm's specific scripts and criteria, with consistent coverage 24/7." },
  { q: "Which one should I start with?", a: "If your biggest pain is at the front of the funnel — missed calls, slow follow-up, leads going cold — start with Intake 360. If your biggest pain is mid-case — records sitting, demands stalled, attorneys buried in admin — start with Impact Assistants. Most firms eventually pair both." },
  { q: "How fast can we get started?", a: "Intake 360 typically launches within 2–4 weeks of contract signing. Impact Assistants depend on the role — most placements are live within 30–45 days, including training on your templates and systems." },
];
---

<BaseLayout
  title="Virtual Legal Assistants for Law Firms"
  description="A virtual legal assistant gives your firm headcount-quality work without the headcount. Delivered two ways: Intake 360 for on-demand coverage, Impact Assistants for an on-staff extension."
>

  <Hero
    badge="Virtual Legal Assistants"
    title="A virtual legal team. Two ways to deliver it."
    subtitle="Virtual legal assistants give your firm headcount-quality work without the recruiting, payroll, training, and turnover. We deliver it through Intake 360 or Impact Assistants — depending on whether you need on-demand coverage or an on-staff extension."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    secondaryButtonText="Compare the Products"
    secondaryButtonLink="#compare"
    size="lg"
  />

  <!-- What a VLA Is -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 reveal">
          <span class="badge badge-brand">What a VLA Is</span>
          <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">A virtual legal assistant is a team member — without the hiring overhead.</h2>
          <div class="divider-gold mt-5 mb-6"></div>
          <p class="text-lg text-gray-600 leading-relaxed mb-4">
            A VLA does the work an in-house hire would do: answer calls, run intake, manage cases, draft pleadings, chase records, work down liens, keep your CRM clean. The difference is what surrounds the work.
          </p>
          <p class="text-base text-gray-500 leading-relaxed">
            We hire, train, manage, replace, and scale the team. You get the output without the operational burden of being an employer.
          </p>
        </div>
        <div class="lg:col-span-5 reveal" style="transition-delay: 100ms">
          <div class="card p-6 md:p-7 bg-white">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-gold mb-3">What you don't deal with</p>
            <ul class="space-y-3 text-sm text-gray-700">
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Recruiting, screening, hiring, onboarding</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Payroll, taxes, benefits, PTO management</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Turnover, retraining, performance management</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Office space, equipment, IT, security</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- The Two Products -->
  <section class="section-padding" id="compare">
    <div class="container-wide">
      <div class="text-center mb-12 md:mb-14 reveal max-w-3xl mx-auto">
        <span class="badge badge-brand">Two Products, One VLA Offering</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Pick the delivery model that fits your firm</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 leading-relaxed mt-6">
          Both products deliver virtual legal assistant work. The difference is whether you need an on-demand operation or a dedicated team member.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 max-w-6xl mx-auto">
        {comparison.map((p, i) => (
          <a href={p.href} class="card card-hover p-8 md:p-10 bg-white border-2 border-brand-gold/40 ring-1 ring-brand-gold/20 group flex flex-col reveal" style={`transition-delay: ${i * 100}ms`}>
            <div class="flex items-center justify-between mb-5">
              <span class="badge badge-gold">Product</span>
              <span class="text-xs font-bold uppercase tracking-wide text-brand-gold">{p.tag}</span>
            </div>
            <h3 class="font-heading text-2xl md:text-3xl text-gray-900 mb-3">{p.label}</h3>
            <p class="text-base text-gray-600 leading-relaxed mb-6">{p.summary}</p>
            <div class="border-t border-gray-200 pt-5 flex-1">
              <p class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-3">Best fit</p>
              <ul class="space-y-2 mb-5">
                {p.fits.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>{f}</span></li>
                ))}
              </ul>
            </div>
            <div class="border-t border-gray-200 pt-4 mt-4">
              <p class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-1">Commercial model</p>
              <p class="text-sm text-gray-700 mb-4">{p.pricing}</p>
              <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Explore {p.label} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Three Capability Tracks -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="text-center mb-12 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">What VLAs Handle</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Three capability tracks</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 leading-relaxed mt-6">
          Whatever the product, the work falls into three tracks. Most firms need at least two.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {capabilities.map((c, i) => (
          <div class="card p-6 md:p-7 bg-white reveal" style={`transition-delay: ${i * 100}ms`}>
            <p class="text-xs font-bold uppercase tracking-[0.15em] text-brand-gold mb-4">{c.eyebrow}</p>
            <ul class="space-y-2.5">
              {c.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-700 leading-snug"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>{item}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="text-center mt-10 text-sm text-gray-500 max-w-2xl mx-auto reveal">
        <a href="/services" class="text-brand-600 font-semibold hover:text-brand-700 underline decoration-brand-200 hover:decoration-brand-600">See the full services overview →</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="text-center mb-10 reveal">
        <span class="badge badge-brand">FAQ</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Common questions</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-xl border border-gray-200 bg-white p-5 md:p-6 reveal" style={`transition-delay: ${i * 50}ms`}>
            <summary class="flex items-center justify-between cursor-pointer text-base font-heading text-gray-900 list-none">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="text-sm text-gray-600 leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Get the Headcount Without the Headcount."
    body="We'll help you figure out which product fits — and which capability tracks need coverage first."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    variant="brand"
  />

</BaseLayout>
