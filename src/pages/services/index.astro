---
import BaseLayout from "@layouts/BaseLayout.astro";
import CTABanner from "@components/CTABanner.astro";

const categories = [
  {
    eyebrow: "Intake & Client-Facing",
    title: "Reception, intake & follow-up",
    desc: "Every call answered, every lead qualified, every follow-up completed — including nights, weekends, and overflow.",
    bullets: [
      "Reception, inbound & outbound 24/7",
      "Overnight intake (nights & weekends)",
      "Qualifying & closing — CFA, flat fee, retainer",
      "15-touch lead follow-up across 45 days",
      "Warm transfers & appointment setting",
      "Client engagement & check-ins",
    ],
    links: [
      { href: "/services/intake-360", label: "Intake 360 (product)", primary: true },
      { href: "/services/lead-recovery", label: "Lead Recovery" },
      { href: "/services/lead-follow-up", label: "Lead Follow-Up" },
      { href: "/services/after-hours", label: "After-Hours Coverage" },
      { href: "/services/legal-receptionist", label: "Legal Receptionist" },
    ],
    iconPath: "M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z",
  },
  {
    eyebrow: "Case & Matter Support",
    title: "Records, liens & litigation paper",
    desc: "Records retrieved, liens reduced, pleadings drafted. Cases move because the paper moves.",
    bullets: [
      "Opening case files & letters of rep",
      "Medical record & bill retrieval",
      "Medical record summaries",
      "Bill balance & child support lien checks",
      "Lien reduction requests & negotiation",
      "Pleadings, interrogatories, formal demands",
    ],
    links: [
      { href: "/services/medical-records", label: "Medical Records" },
      { href: "/services/lien-management", label: "Lien Management" },
      { href: "/services/litigation-support", label: "Litigation Support" },
    ],
    iconPath: "M12 3v17.25m0 0c-1.472 0-2.882.265-4.185.75M12 20.25c1.472 0 2.882.265 4.185.75M18.75 4.97A48.416 48.416 0 0012 4.5c-2.291 0-4.545.16-6.75.47m13.5 0c1.01.143 2.01.317 3 .52m-3-.52l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.988 5.988 0 01-2.031.352 5.988 5.988 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L18.75 4.971zm-16.5.52c.99-.203 1.99-.377 3-.52m0 0l2.62 10.726c.122.499-.106 1.028-.589 1.202a5.989 5.989 0 01-2.031.352 5.989 5.989 0 01-2.031-.352c-.483-.174-.711-.703-.59-1.202L5.25 4.971z",
  },
  {
    eyebrow: "Admin & Back Office",
    title: "Mail, data, calendars & CRM",
    desc: "The repeatable busywork that drags your team down — handled by people whose job is to handle it.",
    bullets: [
      "Mail sorting & labeling",
      "General admin & data mining",
      "Task training & SOP build-out",
      "Calendar & inbox management",
      "CRM hygiene & pipeline updates",
      "Custom workflows by request",
    ],
    links: [
      { href: "/services/admin-support", label: "Admin Support" },
      { href: "/services/executive-assistant", label: "Executive Assistant" },
      { href: "/services/marketing-support", label: "Marketing Support" },
    ],
    iconPath: "M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z",
  },
];
---

<BaseLayout
  title="Services — Virtual Legal Assistants for Law Firms"
  description="Virtual legal assistants for law firms — delivered two ways. Intake 360 for on-demand intake and reception coverage. Impact Assistants for on-staff case and admin support."
  schema={{
    "@type": "Service",
    "serviceType": "Legal Operations Support",
    "provider": { "@id": "https://attorneyassistant.com/#organization" },
    "areaServed": { "@type": "Country", "name": "United States" },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Law Firm Operations Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Intake 360", "url": "https://attorneyassistant.com/services/intake-360" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Impact Assistants", "url": "https://attorneyassistant.com/services/impact-assistants" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Lead Recovery", "url": "https://attorneyassistant.com/services/lead-recovery" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Lead Follow-Up", "url": "https://attorneyassistant.com/services/lead-follow-up" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "After-Hours Coverage", "url": "https://attorneyassistant.com/services/after-hours" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Legal Receptionist", "url": "https://attorneyassistant.com/services/legal-receptionist" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Medical Records", "url": "https://attorneyassistant.com/services/medical-records" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Lien Management", "url": "https://attorneyassistant.com/services/lien-management" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Litigation Support", "url": "https://attorneyassistant.com/services/litigation-support" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Admin Support", "url": "https://attorneyassistant.com/services/admin-support" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Executive Assistant", "url": "https://attorneyassistant.com/services/executive-assistant" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Marketing Support", "url": "https://attorneyassistant.com/services/marketing-support" } },
      ]
    }
  }}
>

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-950 via-brand-900 to-brand-navy py-16 md:py-24 border-b-4 border-brand-gold">
    <div class="grain-overlay"></div>
    <div class="container-wide relative z-10">
      <div class="max-w-4xl reveal">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold bg-brand-gold/10 text-brand-gold border border-brand-gold/20 mb-6">Our Services</span>
        <h1 class="font-heading font-extrabold text-white text-display-md md:text-display-lg leading-[1.05] tracking-tight">
          Virtual legal assistants for law firms, <span class="text-brand-gold">delivered two ways.</span>
        </h1>
        <p class="mt-6 text-base md:text-lg text-white/80 leading-relaxed max-w-3xl">
          You get a virtual legal team. We deliver it through one of two products — <strong class="text-white">Intake 360</strong> for on-demand intake and reception coverage, or <strong class="text-white">Impact Assistants</strong> for an on-staff extension that handles case work, admin, and everything in between.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn-primary btn-lg group">
            Schedule Consultation
            <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
          <a href="#products" class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold text-white border border-white/25 hover:border-brand-gold hover:text-brand-gold transition-colors">See Products</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products: Intake 360 + Impact Assistants -->
  <section class="section-padding" id="products">
    <div class="container-wide">
      <div class="text-center mb-12 md:mb-14 reveal max-w-3xl mx-auto">
        <span class="badge badge-brand">The Two Products</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Pick the model that fits your firm</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 leading-relaxed mt-6">
          Every capability we offer is delivered through one of these two products — or both, paired together for complete coverage.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 max-w-6xl mx-auto">
        <!-- Intake 360 product card -->
        <a href="/services/intake-360" class="card card-hover p-8 md:p-10 bg-white border-2 border-brand-gold/40 ring-1 ring-brand-gold/20 group flex flex-col reveal">
          <div class="flex items-center justify-between mb-5">
            <span class="badge badge-gold">Product</span>
            <span class="text-xs font-bold uppercase tracking-wide text-brand-gold">On-demand coverage</span>
          </div>
          <h3 class="font-heading text-2xl md:text-3xl text-gray-900 mb-1">Intake<span class="text-brand-gold">360</span></h3>
          <p class="text-sm font-semibold text-gray-500 mb-5">24/7 intake & reception, action-based pricing.</p>
          <p class="text-base text-gray-600 leading-relaxed mb-6 flex-1">
            Always-on intake operation that answers, qualifies, signs cases on your behalf, and follows up — 24/7. Built for contingency-fee firms that can't afford to lose a single lead. <strong class="text-gray-900">$997/month.</strong>
          </p>
          <div class="border-t border-gray-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-3">Best for</p>
            <ul class="space-y-2 mb-5">
              <li class="flex items-start gap-2.5 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Firms losing leads to missed calls and slow follow-up</span></li>
              <li class="flex items-start gap-2.5 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Firms that need nights, weekends, and overflow coverage</span></li>
              <li class="flex items-start gap-2.5 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Firms that want cases signed on first contact</span></li>
            </ul>
            <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Explore Intake 360 <span aria-hidden="true">→</span></span>
          </div>
        </a>

        <!-- Impact Assistants product card -->
        <a href="/services/impact-assistants" class="card card-hover p-8 md:p-10 bg-white border-2 border-brand-gold/40 ring-1 ring-brand-gold/20 group flex flex-col reveal" style="transition-delay: 100ms">
          <div class="flex items-center justify-between mb-5">
            <span class="badge badge-gold">Product</span>
            <span class="text-xs font-bold uppercase tracking-wide text-brand-gold">On-staff extension</span>
          </div>
          <h3 class="font-heading text-2xl md:text-3xl text-gray-900 mb-1">Impact <span class="text-brand-gold">Assistants</span></h3>
          <p class="text-sm font-semibold text-gray-500 mb-5">Dedicated team members, managed by legal ops experts.</p>
          <p class="text-base text-gray-600 leading-relaxed mb-6 flex-1">
            A dedicated assistant trained on your firm's templates, providers, and case criteria — integrated into your case management system as a seamless extension of your team. Case work, admin, drafting, calendar, CRM — they own it.
          </p>
          <div class="border-t border-gray-200 pt-5">
            <p class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-3">Best for</p>
            <ul class="space-y-2 mb-5">
              <li class="flex items-start gap-2.5 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Firms drowning in records, liens, pleadings, and admin</span></li>
              <li class="flex items-start gap-2.5 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Firms growing past their drafting and ops capacity</span></li>
              <li class="flex items-start gap-2.5 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Firms that want headcount-quality work without hiring</span></li>
            </ul>
            <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Explore Impact Assistants <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>

      <p class="text-center mt-10 text-sm text-gray-500 max-w-2xl mx-auto reveal">
        Most firms pair the two. Intake 360 captures every lead; Impact Assistants run the case once it's signed. <a href="/services/virtual-legal-assistants" class="text-brand-600 font-semibold hover:text-brand-700 underline decoration-brand-200 hover:decoration-brand-600">See how virtual legal assistants work →</a>
      </p>
    </div>
  </section>

  <!-- Capabilities by category -->
  <section class="section-padding bg-gray-25 relative overflow-hidden" id="capabilities">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="text-center mb-12 md:mb-14 reveal max-w-3xl mx-auto">
        <span class="badge badge-brand">What We Handle</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Three capability tracks. One coordinated team.</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 leading-relaxed mt-6">
          Whether you start with Intake 360, Impact Assistants, or both — your firm gets coverage across every part of the operation that drains attorney time.
        </p>
      </div>

      <div class="space-y-8 md:space-y-10 max-w-6xl mx-auto">
        {categories.map((cat, i) => (
          <div class="card p-7 md:p-9 bg-white reveal" style={`transition-delay: ${i * 100}ms`}>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              <!-- Left: header + description -->
              <div class="lg:col-span-5">
                <div class="flex items-center gap-3 mb-4">
                  <div class="featured-icon featured-icon-md featured-icon-brand">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d={cat.iconPath} />
                    </svg>
                  </div>
                  <span class="text-xs font-bold uppercase tracking-[0.15em] text-brand-gold">{cat.eyebrow}</span>
                </div>
                <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">{cat.title}</h3>
                <p class="text-sm md:text-base text-gray-500 leading-relaxed">{cat.desc}</p>
              </div>

              <!-- Middle: bullet list -->
              <div class="lg:col-span-4">
                <p class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-3">Included</p>
                <ul class="space-y-2.5">
                  {cat.bullets.map((b) => (
                    <li class="flex items-start gap-2.5 text-sm text-gray-700 leading-snug"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>{b}</span></li>
                  ))}
                </ul>
              </div>

              <!-- Right: subpage links -->
              <div class="lg:col-span-3">
                <p class="text-xs font-bold uppercase tracking-wide text-gray-500 mb-3">Learn more</p>
                <ul class="space-y-1.5">
                  {cat.links.map((link) => (
                    <li>
                      <a href={link.href} class:list={["inline-flex items-center gap-1.5 text-sm font-semibold transition-colors group/link", link.primary ? "text-brand-gold hover:text-brand-700" : "text-brand-600 hover:text-brand-700"]}>
                        <span>{link.label}</span>
                        <span class="transition-transform group-hover/link:translate-x-0.5" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Better Together -->
  <section class="section-padding">
    <div class="container-narrow text-center">
      <div class="reveal">
        <span class="badge badge-brand">Better Together</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">
          Most firms pair both products.
        </h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 leading-relaxed max-w-2xl mx-auto mb-8 mt-6">
          Intake 360 captures every lead 24/7. Impact Assistants run the case once it's signed. Together, your firm gets end-to-end coverage from first call to final disbursement — without adding a single internal hire.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/book-call" class="btn-primary btn-lg group">Build Your Custom Solution</a>
          <a href="/services/virtual-legal-assistants" class="btn-secondary btn-lg">How VLA Works</a>
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Stop Losing Revenue to Broken Operations"
    body="We'll diagnose the specific operational failures costing your firm money and build a co-managed solution around them — so you can grow without adding chaos."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    variant="brand"
  />

</BaseLayout>
