---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import FeatureCard from "@components/FeatureCard.astro";
import CTABanner from "@components/CTABanner.astro";

const deliverables = [
  { title: "Bill Balance & Lien Verification", description: "Every outstanding balance and lien identified, verified, and tracked before demand drafting.", icon: "chart" },
  { title: "Child Support Lien Checks", description: "Statewide child-support lien verification on every plaintiff — every time — before disbursement.", icon: "shield" },
  { title: "Medicare / Medicaid Verification", description: "Conditional payment checks with CMS and state Medicaid recovery contractors. Liens identified before they surprise you at settlement.", icon: "document" },
  { title: "Health Insurance Subrogation", description: "ERISA and private health plan reimbursement claims tracked, verified, and negotiated.", icon: "folder" },
  { title: "Lien Reduction Negotiation", description: "Reduction requests drafted, sent, and negotiated. We push providers and lien holders for the lowest defensible number.", icon: "scale" },
  { title: "Final Lien Letters", description: "Final, signed lien letters secured from every provider and recovery contractor before disbursement.", icon: "document" },
];

const howItWorks = [
  { step: "1", title: "Lien inventory", desc: "Full lien matrix built from intake records and bills." },
  { step: "2", title: "Verification + outreach", desc: "Verify amounts, file conditional payment requests, contact recovery contractors." },
  { step: "3", title: "Reduction negotiation", desc: "Draft and negotiate reductions with providers and lien holders." },
  { step: "4", title: "Final letters secured", desc: "Signed final lien letters in hand before disbursement." },
];

const faqs = [
  { q: "How much can lien reductions typically save per case?", a: "It varies by case and lien type, but disciplined reduction work routinely moves five-figure liens down by 25–50% and recovers thousands per case that would otherwise come out of the client's net." },
  { q: "Do you handle Medicare conditional payment letters?", a: "Yes. We file CMS conditional payment requests, track Final Demand letters, and dispute charges that aren't related to the injury." },
  { q: "What about ERISA plans with strong subrogation language?", a: "We verify the plan documents, push back on overreach, and negotiate where the plan terms allow. We escalate to your attorneys when plan language is unusually aggressive." },
  { q: "Can you handle liens on cases we didn't intake through you?", a: "Yes. Lien management is independent of intake — Staffline can pick up existing case files and run the lien pipeline." },
  { q: "Which service handles this work?", a: "Lien management is dedicated case work — delivered through Staffline. Frontline is on-demand intake coverage and does not include lien negotiation." },
];
---

<BaseLayout
  title="Lien Management & Reduction for Personal Injury Firms"
  description="Bill balance checks, child-support and Medicaid lien verification, ERISA subrogation, and lien reduction negotiation. More net to the client. More net to the firm."
>

  <Hero
    badge="Case & Matter Support"
    title="Lien Management That Pays for Itself."
    subtitle="We identify, verify, and reduce every lien on every case — from child support and Medicaid to ERISA and hospital balances. More money to your clients. More fee to your firm."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    secondaryButtonText="See What We Handle"
    secondaryButtonLink="#deliverables"
    size="lg"
  />

  <!-- The Problem -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 reveal">
          <span class="badge badge-brand">The Problem</span>
          <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Liens eat settlements. Especially the ones you didn't catch.</h2>
          <div class="divider-gold mt-5 mb-6"></div>
          <p class="text-lg text-gray-600 leading-relaxed mb-4">
            Most firms work liens at the last minute. Hospital balances aren't verified until the demand is out. Medicare conditional payments are chased after settlement. Reductions are skipped because nobody has the bandwidth to negotiate a $4,000 hospital bill.
          </p>
          <p class="text-base text-gray-500 leading-relaxed">
            Every dollar of un-reduced lien comes out of the client's net — or your fee.
          </p>
        </div>
        <div class="lg:col-span-5 reveal" style="transition-delay: 100ms">
          <div class="card p-6 md:p-7 bg-white">
            <p class="text-xs font-bold uppercase tracking-wide text-brand-gold mb-3">Common leakage</p>
            <ul class="space-y-3 text-sm text-gray-700">
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Child support liens caught at disbursement, blowing up the close</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Medicare Final Demand letters arriving 90 days after settlement</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>Hospital liens paid in full because nobody negotiated</span></li>
              <li class="flex items-start gap-2.5"><span class="w-1.5 h-1.5 rounded-full bg-brand-gold mt-2 flex-shrink-0"></span><span>ERISA plans overreaching on subrogation with no pushback</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Handle -->
  <section class="section-padding" id="deliverables">
    <div class="container-wide">
      <div class="text-center mb-12 md:mb-16 reveal">
        <span class="badge badge-brand">What We Handle</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">From first lien check to final letter</h2>
        <div class="divider-gold-center mt-5"></div>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Lien work runs in parallel with case work — so disbursement isn't held up by a missing reduction letter.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {deliverables.map((d, i) => (
          <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
            <FeatureCard title={d.title} description={d.description} icon={d.icon} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Which Product Delivers This -->
  <section class="section-padding bg-gray-25 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-40"></div>
    <div class="container-wide relative">
      <div class="text-center mb-12 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Which Product Delivers This</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Lien management is dedicated work — delivered by Staffline.</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto">
        <a href="/services/staffline" class="card card-hover p-7 md:p-8 bg-white border-brand-gold/40 ring-1 ring-brand-gold/30 group reveal">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-gold">Best Fit</span>
            <span class="text-xs font-semibold text-brand-gold uppercase tracking-wide">On-staff extension</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Staffline</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            A dedicated assistant who learns your providers, your lien holders, and your negotiation thresholds — then runs the lien pipeline in parallel with case work.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Explore Staffline <span aria-hidden="true">→</span></span>
        </a>
        <a href="/services/frontline" class="card card-hover p-7 md:p-8 bg-white opacity-90 group reveal" style="transition-delay: 100ms">
          <div class="flex items-center justify-between mb-4">
            <span class="badge badge-brand">Different Fit</span>
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">On-demand coverage</span>
          </div>
          <h3 class="text-xl md:text-2xl font-heading text-gray-900 mb-3">Frontline</h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-5">
            Frontline covers intake and reception — not lien negotiation. Pair it with Staffline for case coverage from first call through final disbursement.
          </p>
          <span class="text-brand-600 font-semibold text-sm group-hover:text-brand-700 inline-flex items-center gap-1">Learn about Frontline <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-brand">How It Works</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4">From inventory to final letter</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {howItWorks.map((s, i) => (
          <div class="text-center reveal" style={`transition-delay: ${i * 80}ms`}>
            <div class={`w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4 font-heading text-lg border-2 ${i === howItWorks.length - 1 ? 'bg-brand-gold border-brand-gold text-brand-navy' : 'bg-white border-brand-navy text-brand-navy'}`}>
              {s.step}
            </div>
            <h3 class="text-sm font-heading text-gray-900 uppercase tracking-wide mb-2">{s.title}</h3>
            <p class="text-sm text-gray-500 leading-snug">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="section-padding bg-gray-25">
    <div class="container-wide">
      <div class="text-center mb-10 reveal max-w-2xl mx-auto">
        <span class="badge badge-brand">Outcomes</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">What changes for your firm</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          { title: "More net to the client", body: "Reductions that would never have been pursued become standard practice. Clients walk away with more — and tell their friends." },
          { title: "Clean closes", body: "Final lien letters in hand before disbursement. No 90-day surprises. No held-up files." },
          { title: "Higher effective fee", body: "Reduced liens preserve the fee math. The firm captures more of the gross because the lien stack stops eating into it." },
        ].map((item, i) => (
          <div class="p-6 rounded-xl border border-gray-200 bg-white reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="text-base font-heading text-gray-900 mb-2">{item.title}</p>
            <p class="text-sm text-gray-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding">
    <div class="container-narrow">
      <div class="text-center mb-10 reveal">
        <span class="badge badge-brand">FAQ</span>
        <h2 class="text-display-xs md:text-display-sm font-heading text-gray-900 mt-4 mb-5">Common questions</h2>
        <div class="divider-gold-center mt-5"></div>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {faqs.map((f, i) => (
          <details class="group rounded-xl border border-gray-200 bg-white p-5 md:p-6 reveal" style={`transition-delay: ${i * 50}ms`}>
            <summary class="flex items-center justify-between cursor-pointer text-base font-heading text-gray-900 list-none">
              <span>{f.q}</span>
              <svg class="w-5 h-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <p class="text-sm text-gray-600 leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    heading="Stop Leaving Money on the Table at Disbursement."
    body="See how disciplined lien work moves more net to your clients — and more fee to your firm."
    buttonText="Schedule Consultation"
    buttonLink="/contact"
    variant="brand"
  />

</BaseLayout>
