---
import BaseLayout from "@layouts/BaseLayout.astro";

const BOOKING_SRC = "https://meet.attorneyassistant.com/meetings/attorney-assistant/the-stuff-you-hate-initial-audit?embed=true";

// Nicole: edit this one number to change the stated monthly cap in the Capacity section below.
const MONTHLY_AUDIT_CAP = 10;
---

<BaseLayout
  title="The Stuff You Hate Audit — A Free 7-Day Operations Audit for Law Firms"
  description="A free seven-day audit of your intake, your follow-up, and your back office. Seven days from now you get a one-page map of what your operations are costing you, and three fixes you can run yourself."
  noindex={true}
  schema={{
    "@type": "WebPage",
    "name": "The Stuff You Hate Audit",
    "description": "A free seven-day operational audit covering intake, follow-up, and back office, ending in a one-page Leak Map the firm keeps either way.",
    "publisher": {
      "@type": "Organization",
      "name": "Attorney Assistant"
    }
  }}
>

  <!-- ══════════════════════════════════════════════
       1. HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-brand-950 min-h-[88vh] md:min-h-[92vh] flex items-center">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-navy via-brand-900 to-brand-950"></div>
    <div class="syh-orb syh-orb--1" aria-hidden="true"></div>
    <div class="syh-orb syh-orb--2" aria-hidden="true"></div>
    <div class="grain-overlay"></div>
    <div class="absolute inset-0 z-[1] opacity-[0.03]" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <div class="container-wide relative z-10 py-20 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div class="reveal">
          <span class="syh-pulse-badge mb-5">
            <span class="syh-pulse-dot"></span>
            The Stuff You Hate Audit
          </span>
          <h1 class="text-display-md md:text-display-lg lg:text-display-xl font-heading text-white leading-tight mb-5">
            We will call your firm as a potential client.<br/>
            <span class="text-gradient-gold">You will not know when.</span>
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-8 leading-relaxed">
            A free seven-day audit of your intake, your follow-up, and your back office. Seven days from now you get a one-page map of what your operations are costing you, and three fixes you can run yourself.
          </p>

          <p class="syh-trust-line">
            <svg class="w-4 h-4 text-brand-gold flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            No cost. No purchase required. Twenty minutes of your time.
          </p>
        </div>

        <!-- Booking Widget, instance 1 -->
        <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal syh-widget-glow" style="transition-delay: 150ms" id="book-top">
          <div class="bg-white rounded-xl p-4 md:p-5">
            <div class="flex items-center gap-3 mb-3">
              <div class="featured-icon featured-icon-md featured-icon-gold">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h2 class="text-lg font-heading text-gray-900">Book Your Audit</h2>
                <p class="text-xs text-gray-500">Free &mdash; starts the 7-day clock</p>
              </div>
            </div>
            <div class="meetings-iframe-container" data-src={BOOKING_SRC}></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       2. THE TWENTY MINUTES
  ═══════════════════════════════════════════════ -->
  <section class="relative bg-white section-padding">
    <div class="container-narrow">
      <div class="max-w-3xl mx-auto text-center reveal">
        <span class="badge badge-navy mb-4">The Only Ask</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-10">
          Twenty minutes. That's the whole ask.
        </h2>

        <div class="syh-ask-row">
          <div class="syh-ask-card">
            <div class="syh-ask-number">5<span>min</span></div>
            <p class="syh-ask-label">A five-minute form</p>
          </div>
          <div class="syh-ask-plus" aria-hidden="true">+</div>
          <div class="syh-ask-card">
            <div class="syh-ask-number">15<span>min</span></div>
            <p class="syh-ask-label">Fifteen minutes with your team</p>
          </div>
          <div class="syh-ask-plus" aria-hidden="true">=</div>
          <div class="syh-ask-card syh-ask-card--total">
            <div class="syh-ask-number syh-ask-number--gold">20<span>min</span></div>
            <p class="syh-ask-label">That is the whole ask</p>
          </div>
        </div>

        <p class="text-lg text-gray-500 mt-10">
          You do nothing for the rest of the week while we go and look.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       3. WHAT WE ACTUALLY DO
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 section-padding">
    <div class="absolute inset-0">
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-brand-gold/5 rounded-full blur-[120px]"></div>
    </div>
    <div class="grain-overlay"></div>

    <div class="container-wide relative z-10">
      <div class="text-center mb-12 reveal">
        <span class="badge bg-brand-gold/15 text-brand-gold border-brand-gold/20 mb-4">The Evidence</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          This is what happens to someone else, this week.
        </h2>
      </div>

      <div class="grid sm:grid-cols-2 gap-5 reveal">
        <div class="syh-evidence-card">
          <span class="syh-evidence-num">1</span>
          <p class="text-white text-base leading-relaxed">Two calls during business hours, one after 6 PM or on a weekend.</p>
        </div>
        <div class="syh-evidence-card">
          <span class="syh-evidence-num">2</span>
          <p class="text-white text-base leading-relaxed">Your web form submitted and the reply timed to the minute.</p>
        </div>
        <div class="syh-evidence-card">
          <span class="syh-evidence-num">3</span>
          <p class="text-white text-base leading-relaxed">Every contact logged: pickup time, hold, greeting, qualification, whether anyone followed up at 24 and 72 hours.</p>
        </div>
        <div class="syh-evidence-card">
          <span class="syh-evidence-num">4</span>
          <p class="text-white text-base leading-relaxed">Fifteen minutes with your team about what they hate doing.</p>
        </div>
      </div>

      <div class="syh-quote-banner mt-10 max-w-2xl mx-auto reveal">
        &ldquo;Nobody at your firm knows when the calls are coming. That is the point.&rdquo;
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       4. THE THREE LEAKS
  ═══════════════════════════════════════════════ -->
  <section class="relative bg-white section-padding">
    <div class="container-wide">
      <div class="text-center mb-12 reveal">
        <span class="badge badge-navy mb-4">Where We Look</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          Three leaks. We score all three.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 reveal">
        <div class="syh-leak-card">
          <div class="syh-leak-icon syh-leak-icon--red">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          </div>
          <h3 class="text-xl font-heading text-gray-900 mt-5 mb-2">Intake</h3>
          <p class="text-gray-500 mb-4">Missed calls, hold time, qualification, speed to lead, after-hours coverage, whether anyone followed up at all.</p>
          <ul class="syh-leak-examples">
            <li>A caller on hold long enough to hang up and call the next firm on the list</li>
            <li>A web form that sits in an inbox overnight</li>
            <li>A call that gets answered but never gets qualified</li>
            <li>Nobody checking back at the 24-hour or 72-hour mark</li>
          </ul>
        </div>

        <div class="syh-leak-card">
          <div class="syh-leak-icon syh-leak-icon--amber">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" /></svg>
          </div>
          <h3 class="text-xl font-heading text-gray-900 mt-5 mb-2">Follow-Up</h3>
          <p class="text-gray-500 mb-4">What happens between a lead and a signed case. Lead ownership, retainer lag, no-shows, cadence, client status updates.</p>
          <ul class="syh-leak-examples">
            <li>A lead nobody owns, so three people assume someone else is calling</li>
            <li>Weeks between first contact and a signed retainer</li>
            <li>A consult booked and never confirmed, so the person doesn't show</li>
            <li>A client who hasn't heard a word about their own case in a month</li>
          </ul>
        </div>

        <div class="syh-leak-card syh-leak-card--highlight">
          <div class="syh-leak-icon syh-leak-icon--navy">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" /></svg>
          </div>
          <h3 class="text-xl font-heading text-gray-900 mt-5 mb-2">Back Office</h3>
          <p class="text-gray-500 mb-4">Records, liens, demands, e-filing, calendar, inbox, billing support, and the hours licensed people spend on work that needs no license.</p>
          <ul class="syh-leak-examples">
            <li>An associate on the phone with a records custodian for forty minutes</li>
            <li>A demand sitting half-built because the records aren't in yet</li>
            <li>A calendar and an inbox that only one person actually understands</li>
            <li>A partner proofreading a billing invoice a clerk could handle</li>
          </ul>
        </div>
      </div>

      <p class="text-center text-lg font-heading text-gray-900 mt-10 max-w-2xl mx-auto reveal">
        Two of the three have nothing to do with answering a phone.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       5. WHAT YOU GET ON DAY SEVEN
  ═══════════════════════════════════════════════ -->
  <section class="relative bg-gray-50 section-padding">
    <div class="container-narrow">
      <div class="text-center mb-10 reveal">
        <span class="badge badge-gold mb-4">Day Seven</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-gray-900 mb-4">
          A one-page Leak Map. Yours either way.
        </h2>
      </div>

      <div class="space-y-4 max-w-2xl mx-auto reveal">
        <div class="syh-get-row">
          <span class="syh-get-icon">1</span>
          <p class="text-gray-700">The one-page Leak Map, scored one to five across all three leaks.</p>
        </div>
        <div class="syh-get-row">
          <span class="syh-get-icon">2</span>
          <p class="text-gray-700">What each leak is costing, calculated with your own volume, your own close rate, and your own average fee.</p>
        </div>
        <div class="syh-get-row">
          <span class="syh-get-icon">3</span>
          <p class="text-gray-700">Your team's own words about the work they hate.</p>
        </div>
        <div class="syh-get-row">
          <span class="syh-get-icon">4</span>
          <p class="text-gray-700">Three fixes you can run this month without hiring anybody.</p>
        </div>
      </div>

      <p class="text-center text-lg font-heading text-gray-900 mt-10 reveal">
        It is yours to keep whether or not you ever work with us.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       6. A REAL EXAMPLE
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-navy via-brand-800 to-brand-navy section-padding grain-overlay">
    <div class="container-wide relative z-10">
      <div class="text-center mb-12 reveal">
        <span class="badge bg-white/10 text-white/80 border-white/10 mb-4">A Real Example</span>
        <h2 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          Here's what that looked like for one firm.
        </h2>
        <p class="text-white/50 text-sm max-w-xl mx-auto">Figures below are from our calculator for a sample firm, not a client. Your Leak Map runs on your own numbers.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 reveal">
        <div class="syh-sample-card">
          <span class="syh-sample-tag">Sample Firm</span>
          <p class="syh-sample-num syh-sample-num--red">$23,366<span>/mo</span></p>
          <p class="syh-sample-label">Lost revenue</p>
          <p class="syh-sample-desc">Callers who never call back.</p>
        </div>
        <div class="syh-sample-card">
          <span class="syh-sample-tag">Sample Firm</span>
          <p class="syh-sample-num syh-sample-num--amber">$48,000<span>/mo</span></p>
          <p class="syh-sample-label">Delayed cash</p>
          <p class="syh-sample-desc">Demands blocked on missing records.</p>
        </div>
        <div class="syh-sample-card">
          <span class="syh-sample-tag">Sample Firm</span>
          <p class="syh-sample-num syh-sample-num--blue">68 hrs<span>/wk</span></p>
          <p class="syh-sample-label">Capacity</p>
          <p class="syh-sample-desc">Licensed people doing clerk work.</p>
        </div>
      </div>

      <div class="syh-note-box max-w-3xl mx-auto mt-8 reveal">
        These three do not add together. One is revenue you never see, one is revenue arriving late, one is time. We price them separately on purpose.
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       7. WHY IT IS FREE
  ═══════════════════════════════════════════════ -->
  <section class="relative bg-white section-padding">
    <div class="container-narrow">
      <div class="max-w-2xl mx-auto text-center reveal">
        <span class="badge badge-gray mb-4">Why Free</span>
        <h2 class="text-display-sm font-heading text-gray-900 mb-5">Why there's no charge.</h2>
        <p class="text-lg text-gray-500 leading-relaxed">
          The day-seven walkthrough is our sales conversation. We'd rather earn it by showing you something true about your own firm than by pitching you. So there's no fee, and nothing to buy to get your Leak Map.
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       8. CAPACITY
  ═══════════════════════════════════════════════ -->
  <section class="syh-capacity-bar">
    <div class="container-narrow">
      <p class="text-center text-sm md:text-base text-brand-navy font-medium">
        We only run {MONTHLY_AUDIT_CAP} of these audits a month, so the seven-day clock holds for every firm on it.
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       9. THE SCHEDULER, AGAIN
  ═══════════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-navy via-brand-800 to-brand-navy grain-overlay">
    <div class="absolute inset-0">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-brand-gold/15 rounded-full blur-3xl syh-float-slow"></div>
      <div class="absolute bottom-10 right-1/3 w-80 h-80 bg-brand-blue/15 rounded-full blur-3xl syh-float-slow-reverse"></div>
    </div>
    <div class="container-narrow relative py-20 md:py-28">
      <div class="max-w-xl mx-auto text-center reveal mb-8">
        <span class="badge bg-white/10 text-white/80 border-white/10 mb-6">Last Step</span>
        <h2 class="text-display-sm md:text-display-lg font-heading text-white mb-5">
          Book the audit.
        </h2>
        <div class="divider-gold-center mb-6"></div>
        <p class="text-lg text-white/60">
          Twenty minutes of your time. We go look for seven days. You get the Leak Map either way.
        </p>
      </div>

      <div class="bg-white rounded-2xl p-1 shadow-2xl ring-1 ring-white/10 reveal syh-widget-glow max-w-xl mx-auto" style="transition-delay: 150ms" id="book-now">
        <div class="bg-white rounded-xl p-4 md:p-5">
          <div class="flex items-center gap-3 mb-3">
            <div class="featured-icon featured-icon-md featured-icon-gold">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <div>
              <h2 class="text-lg font-heading text-gray-900">Book Your Audit</h2>
              <p class="text-xs text-gray-500">Free &mdash; starts the 7-day clock</p>
            </div>
          </div>
          <div class="meetings-iframe-container" data-src={BOOKING_SRC}></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       10. METHOD FOOTER
  ═══════════════════════════════════════════════ -->
  <section class="bg-gray-50 border-t border-gray-200">
    <div class="container-narrow py-6">
      <p class="text-xs text-gray-400 max-w-3xl mx-auto text-center leading-relaxed">
        Volume, conversion, fee, and hour figures come from your own pipeline and the interview with your team. Intake quality comes from our own test contacts. Where we use an industry figure instead of yours, we label it. We will show you the math behind any number on request.
      </p>
    </div>
  </section>

  <!-- HubSpot Meetings Embed Script -->
  <script is:inline>
    window.__hsGeoReady.then(function(allowed) {
      if (allowed) {
        var s = document.createElement("script");
        s.src = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
        document.head.appendChild(s);
      } else {
        document.querySelectorAll(".meetings-iframe-container").forEach(function(el) {
          el.innerHTML = '<div style="padding:2rem;text-align:center;color:#667085;font-size:0.875rem;border:1px solid #e5e7eb;border-radius:0.75rem;background:#f9fafb;"><p style="margin:0;">This form is not available from your location.</p><p style="margin:0.75rem 0 0;font-size:0.8rem;">If you are seeking employment, please visit <a href="/careers" style="color:#f9a62d;text-decoration:underline;">attorneyassistant.com/careers</a> or email <a href="mailto:talent@attorneyassistant.com" style="color:#f9a62d;text-decoration:underline;">talent@attorneyassistant.com</a></p></div>';
        });
      }
    });
  </script>

  <style>
    /* HubSpot widget background fix */
    .meetings-iframe-container iframe { background: #ffffff !important; }
    .meetings-iframe-container { background: #ffffff !important; }

    /* Hero orbs */
    .syh-orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      will-change: transform;
      z-index: 1;
    }
    .syh-orb--1 {
      width: 700px;
      height: 700px;
      background: radial-gradient(circle, rgba(81,166,220,0.3) 0%, rgba(81,166,220,0) 70%);
      top: -30%;
      right: -15%;
      animation: syhFloat1 11s ease-in-out infinite;
    }
    .syh-orb--2 {
      width: 480px;
      height: 480px;
      background: radial-gradient(circle, rgba(249,166,45,0.28) 0%, rgba(249,166,45,0) 70%);
      bottom: -20%;
      left: -8%;
      animation: syhFloat2 13s ease-in-out infinite;
    }
    @keyframes syhFloat1 {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(-60px, 40px) scale(1.15); }
      100% { transform: translate(0, 0) scale(1); }
    }
    @keyframes syhFloat2 {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(50px, -35px) scale(1.1); }
      100% { transform: translate(0, 0) scale(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .syh-orb, .syh-float-slow, .syh-float-slow-reverse { animation: none !important; }
    }

    /* Pulse badge */
    .syh-pulse-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.375rem 0.875rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      background: rgba(249,166,45,0.1);
      color: #f9a62d;
      border: 1px solid rgba(249,166,45,0.2);
      backdrop-filter: blur(8px);
    }
    .syh-pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #f9a62d;
