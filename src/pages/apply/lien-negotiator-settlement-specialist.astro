---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: Lien Negotiator / Settlement Negotiation Specialist"
  description="Apply to join Attorney Assistant as a remote Lien Negotiator / Settlement Negotiation Specialist, reducing and resolving liens prior to settlement disbursement for U.S.-based legal teams."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Lien Negotiator / Settlement Negotiation Specialist
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Support legal teams in reducing and resolving liens prior to settlement disbursement, negotiating directly with providers, insurers, and third parties.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-5xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>Lien Negotiator / Settlement Negotiation Specialist (Remote) – Attorney Assistant</h2>

          <h3>About the Company</h3>
          <p>At Attorney Assistant, we're a fast-growing provider of virtual staffing solutions, supporting law firms, executives, and businesses across the United States. We also operate Turn Key Ops, our sister company under the same leadership, delivering high-quality virtual support across multiple industries.</p>

          <h3>Overview</h3>
          <p>We are seeking a Lien Negotiator / Settlement Negotiation Specialist to support legal teams in reducing and resolving liens prior to settlement disbursement.</p>
          <p>This role is ideal for someone with a strong sales or negotiation background who is confident in communicating with providers, insurance companies, and third parties to secure the best possible outcomes.</p>
          <p>Your work will directly impact client satisfaction, firm reputation, and overall case success.</p>

          <h3>Key Responsibilities</h3>
          <ul>
            <li>Identify and verify all liens (medical providers, insurance, government programs such as Medicare/Medicaid)</li>
            <li>Request balances, supporting documentation, and lien details</li>
            <li>Negotiate reductions with providers and insurers</li>
            <li>Coordinate with attorneys and case managers throughout the process</li>
            <li>Track deadlines and ensure compliance with all requirements</li>
            <li>Prepare final lien breakdowns prior to settlement disbursement</li>
            <li>Maintain accurate records and updates in case management systems</li>
          </ul>

          <h3>Why This Role Matters</h3>
          <ul>
            <li>Helps clients take home more from their settlements</li>
            <li>Ensures accurate and compliant case resolution</li>
            <li>Contributes to the firm's reputation and client experience</li>
          </ul>

          <h3>What We're Looking For</h3>
          <ul>
            <li>Strong negotiation and communication skills (sales background highly valued)</li>
            <li>Confident handling conversations involving money and settlements</li>
            <li>High attention to detail and organizational skills</li>
            <li>Comfortable working with numbers, balances, and spreadsheets</li>
            <li>Ability to manage multiple cases and deadlines</li>
            <li>Professional, proactive, and results-driven</li>
          </ul>

          <h3>Preferred (Not Required)</h3>
          <ul>
            <li>Experience with lien negotiation or legal case support</li>
            <li>Background in medical billing, collections, or insurance</li>
            <li>Familiarity with legal or settlement processes</li>
          </ul>

          <h3>What We Offer</h3>
          <ul>
            <li>Competitive hourly rate | $5/hr</li>
            <li>PTO and performance-based bonuses</li>
            <li>100% remote work environment</li>
            <li>Opportunity to work with U.S.-based legal teams</li>
            <li>Long-term growth potential</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/mjywvynn"
    screeningQuestions={[
      {
        label: "Do you have experience supporting US-based law firms?",
        type: "single",
        options: ["Yes", "No"],
        required: true,
        disqualifyOn: ["No"],
      },
      {
        label: "Have you handled lien negotiations as part of your experience supporting US-based law firms?",
        type: "single",
        options: ["Yes", "No"],
        required: true,
        disqualifyOn: ["No"],
      },
    ]}
    declineMessage="Thank you for your interest. This role requires experience supporting US-based law firms, including handling lien negotiations, so we're unable to move forward with your application at this time. We genuinely appreciate the time you took to apply and encourage you to explore our other openings."
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }

  /* prose-brand's prose-lg headings read oversized against this page's other
     section headers (e.g. "About this role" at text-lg) — scale them down
     here rather than touching the shared utility used by blog posts. */
  .job-description .prose-brand :where(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .job-description .prose-brand :where(h3) {
    font-size: 1.0625rem;
    margin-top: 1.5rem;
    margin-bottom: 0.375rem;
  }
</style>
