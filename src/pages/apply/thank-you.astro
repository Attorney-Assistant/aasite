---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
---

<BaseLayout
  title="Application Received — Attorney Assistant"
  description="Thank you for applying to Attorney Assistant. We've received your application and will be in touch soon."
  noindex={true}
  suppressMainPixel={true}
>

  <section class="relative overflow-hidden bg-gradient-to-b from-brand-navy via-brand-800 to-brand-navy grain-overlay">
    <div class="absolute inset-0">
      <div class="absolute top-20 left-1/4 w-96 h-96 bg-brand-gold/15 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-1/3 w-80 h-80 bg-brand-blue/15 rounded-full blur-3xl"></div>
    </div>
    <div class="container-narrow relative py-20 md:py-28">
      <div class="text-center reveal">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-success-500/15 mb-6">
          <svg class="w-8 h-8 text-success-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <span class="badge bg-white/10 text-white/80 border-white/10 mb-4">Application Received</span>
        <h1 class="text-display-sm md:text-display-md font-heading text-white mb-4">
          Thank You for Applying!
        </h1>
        <div class="divider-gold-center mt-4 mb-5"></div>
        <p class="text-lg text-white/60 max-w-xl mx-auto">
          We've received your application and are excited to learn more about you. Our team will review your information and reach out via your preferred communication method.
        </p>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container-narrow">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-display-xs font-heading text-gray-900 mb-4 text-center reveal">What Happens Next</h2>
        <div class="divider-gold-center mb-10"></div>

        <div class="space-y-4 mb-12 reveal" style="transition-delay: 0.15s;">
          <div class="flex gap-4 items-start p-4 rounded-xl bg-gray-50 border border-gray-100">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 flex items-center justify-center mt-0.5">
              <span class="text-sm font-heading font-bold text-brand-gold">1</span>
            </div>
            <div>
              <h3 class="font-heading text-gray-900 mb-1">Application Review</h3>
              <p class="text-sm text-gray-500">Our placement team will review your application, resume, and introduction video.</p>
            </div>
          </div>

          <div class="flex gap-4 items-start p-4 rounded-xl bg-gray-50 border border-gray-100">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 flex items-center justify-center mt-0.5">
              <span class="text-sm font-heading font-bold text-brand-gold">2</span>
            </div>
            <div>
              <h3 class="font-heading text-gray-900 mb-1">Skills Assessment Review</h3>
              <p class="text-sm text-gray-500">We'll evaluate your skills assessment answers and technology specifications.</p>
            </div>
          </div>

          <div class="flex gap-4 items-start p-4 rounded-xl bg-gray-50 border border-gray-100">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-gold/15 flex items-center justify-center mt-0.5">
              <span class="text-sm font-heading font-bold text-brand-gold">3</span>
            </div>
            <div>
              <h3 class="font-heading text-gray-900 mb-1">We'll Be in Touch</h3>
              <p class="text-sm text-gray-500">If you're a strong match, we'll contact you via your preferred communication method to discuss next steps.</p>
            </div>
          </div>
        </div>

        <div class="card p-5 bg-brand-25 border-brand-100 mb-12 reveal" style="transition-delay: 0.2s;">
          <div class="flex gap-3 items-start">
            <svg class="w-5 h-5 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
            <p class="text-sm text-brand-700">Make sure to monitor your email and WhatsApp (if selected) for updates from our team. If you have any questions, reach out to <a href="mailto:nicolehall@attorneyassistant.com" class="font-medium underline hover:text-brand-900">nicolehall@attorneyassistant.com</a>.</p>
          </div>
        </div>

        <div class="text-center reveal" style="transition-delay: 0.25s;">
          <a href="/careers" class="btn-secondary">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
            Back to Careers
          </a>
        </div>
      </div>
    </div>
  </section>

  <CareersPixel event="SubmitApplication" />

</BaseLayout>
