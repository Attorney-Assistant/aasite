---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: Bilingual Legal Intake Specialist — Attorney Assistant"
  description="Apply to join Attorney Assistant as a remote Bilingual Intake Specialist for Frontline — turning inbound and outbound calls into clients for law firms, in English and Spanish."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Apply: Bilingual Legal Intake Specialist
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Support Frontline by turning leads into clients — handling inbound and outbound calls for law firms in English and Spanish.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-5xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>Bilingual Legal Intake Specialist – Attorney Assistant | Remote</h2>
          <p class="text-sm font-semibold text-brand-gold">Bilingual (English/Spanish) · Remote · Frontline</p>

          <h3>About the Company</h3>
          <p>At Attorney Assistant, we're a fast-growing provider of virtual staffing solutions, supporting law firms, executives, and businesses across the United States. We also operate Turn Key Ops, our sister company under the same leadership, which focuses on delivering high-quality virtual support across a broader range of industries.</p>

          <h3>Overview</h3>
          <p>We are looking for a dynamic and client-focused Bilingual Intake Specialist to support Frontline, a service that handles inbound and outbound calls for law firms.</p>
          <p>This role is focused on helping turn leads into clients by handling calls, follow-ups, client conversations, consultation bookings, and agreement-related next steps. The ideal candidate is fluent in English and Spanish, has a warm and engaging phone presence, strong sales ability, and the confidence to continue conversations that may begin with an AI agent.</p>
          <p>This role is best suited for someone who can stay calm under pressure, think quickly, follow scripts, take detailed notes while speaking with callers, and communicate professionally across phone, SMS, email, and voicemail.</p>

          <h3>Key Responsibilities</h3>
          <ul>
            <li>Handle inbound and outbound calls for law firm clients in English and Spanish</li>
            <li>Continue conversations started by an AI agent and guide callers through the next step</li>
            <li>Help turn leads into clients by building trust and encouraging sign-ups</li>
            <li>Take messages, book consultations, and send agreements when needed</li>
            <li>Follow up with leads through SMS, email, and voicemail</li>
            <li>Use approved scripts while keeping conversations natural and engaging</li>
            <li>Take clear and detailed notes while speaking with callers</li>
            <li>Ask the right questions to understand caller needs and next steps</li>
            <li>Stay calm and professional during stressful or emotional conversations</li>
            <li>Use critical thinking to handle live caller situations appropriately</li>
            <li>Support intake workflows and help ensure leads are followed up on quickly</li>
          </ul>

          <h3>Required Skills and Experience</h3>
          <ul>
            <li>Bilingual in English and Spanish</li>
            <li>Strong verbal and written communication skills, especially over the phone</li>
            <li>Warm, engaging, and professional phone presence</li>
            <li>Sales experience or strong ability to convert leads into clients</li>
            <li>Experience with customer service, intake, call center, BPO, or legal support</li>
            <li>Experience handling inbound calls, outbound follow-ups, SMS, emails, or voicemails</li>
            <li>Ability to follow scripts while sounding natural and conversational</li>
            <li>Strong note-taking skills while actively speaking with callers</li>
            <li>Able to stay calm during stressful or sensitive situations</li>
            <li>Strong critical thinking and ability to respond quickly during live calls</li>
            <li>Quality assurance or leadership experience is a plus</li>
            <li>Reliable, responsive, and comfortable working in a fast-paced remote setup</li>
          </ul>

          <h3>Schedule, Compensation, and Benefits</h3>
          <ul>
            <li>Full-time position, 40 hours per week</li>
            <li>This role supports a 24/7 operation. Applicants must be willing to work weekends, holidays, and flexible shifts. Work schedules may change depending on business needs</li>
            <li>Must have a reliable device, stable internet connection, and quiet remote work setup</li>
            <li>PTO, referral incentives, and bonuses where applicable</li>
          </ul>

          <p class="text-xs text-gray-500"><em>Note: This posting is for a current hiring need. Applicants may also be considered for similar opportunities based on their qualifications, experience, availability, and client requirements.</em></p>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/xpqvekjk"
    screeningQuestions={[
      {
        label: "Do you have sales experience?",
        type: "single",
        options: ["Yes", "No"],
        required: true,
        disqualifyOn: ["No"],
      },
      {
        label: "Are you willing to work full-time in a 24/7 operation, including weekends, holidays, and flexible shifts depending on business needs?",
        type: "single",
        options: ["Yes", "No"],
        required: true,
      },
    ]}
    declineMessage="Thank you for your interest. This role requires prior sales experience, so we're unable to move forward with your application at this time. We genuinely appreciate the time you took to apply and encourage you to explore our other openings."
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }
</style>
