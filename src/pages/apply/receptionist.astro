---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: Receptionist — Attorney Assistant"
  description="Apply to join Attorney Assistant's bench as a remote Receptionist. We connect skilled professionals with law firms across the country."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Apply: Receptionist
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Join our bench of remote legal professionals and be considered for placement with our law firm clients.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-3xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>Receptionist – Attorney Assistant | Remote</h2>
          <p>Are you organized, detail-oriented, and passionate about making a difference in the legal space? Attorney Assistant is looking for talented professionals to support our growing network of law firm clients in a variety of roles. We are continuously seeking qualified candidates to join our bench and be considered for placement as opportunities arise.</p>

          <h3>About Attorney Assistant</h3>
          <p>Attorney Assistant connects skilled remote professionals with law firms across the country. When you join our bench, you'll be considered for placement with our clients based on your skills, experience, and availability. We have both English and Bilingual (English/Spanish) opportunities.</p>

          <h3>Available Role</h3>
          <p><strong>Receptionist</strong> — Serve as the first point of contact for law firm clients by answering calls, handling inquiries, routing communications, and delivering an exceptional client experience with professionalism and empathy. This is a client-facing role requiring phone work.</p>

          <h3>What We're Looking For</h3>
          <p>We seek candidates who are reliable, professional, and proactive. Across all roles, the qualities that set our top performers apart are strong communication skills, attention to detail, the ability to work independently in a remote environment, and a genuine commitment to delivering excellent service.</p>

          <h3>Schedule &amp; Compensation</h3>
          <p>Starts at $5 USD per hour for bilingual (English and Spanish) and $4 per hour for English-only. Schedule will vary based on your assigned client's needs and timezone.</p>

          <h3>How It Works</h3>
          <p>Joining our bench does not guarantee immediate placement — opportunities are based on client needs and how you present yourself when they arise. Candidates who stand out are those who come prepared, stay engaged, and take advantage of the resources we provide to put their best foot forward.</p>

          <h3>Ready to Apply?</h3>
          <p>If you're interested in joining our bench and being considered for one or more of these roles, we'd love to hear from you. Apply today to get started.</p>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/xnjrwdwv"
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }
</style>
