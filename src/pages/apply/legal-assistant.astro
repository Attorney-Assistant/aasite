---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: Legal Assistant — Attorney Assistant"
  description="Apply to join Attorney Assistant's bench as a remote Legal Assistant supporting U.S. law firms with case management, legal documentation, and client communication."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Apply: Legal Assistant
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Join our bench of remote legal professionals and be considered for placement with our law firm clients.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-3xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>Legal Assistant – Attorney Assistant | Remote</h2>
          <p class="text-sm font-semibold text-brand-gold">Philippines · English-Only · Remote</p>

          <h3>Overview</h3>
          <p>We are looking for a highly organized and detail-oriented Legal Assistant to support U.S. law firms with case management, legal documentation, client communication, and administrative tasks. The ideal candidate has prior legal support experience in any area of law, strong written and verbal communication skills, and the ability to manage multiple deadlines in a fast-paced legal environment.</p>

          <h3>Key Responsibilities</h3>
          <ul>
            <li>Manage and organize active case files and documentation</li>
            <li>Track deadlines, appointments, court dates, and attorney calendars</li>
            <li>Communicate with clients regarding case updates, document requests, and general information</li>
            <li>Prepare, review, and organize legal documents, correspondence, filings, and case materials</li>
            <li>Coordinate records requests, discovery, or other case-related documents as needed</li>
            <li>Communicate professionally with clients, attorneys, courts, government agencies, and other parties</li>
            <li>Maintain accurate case notes, records, and task updates in the firm's systems</li>
            <li>Support overall case management and administrative workflows</li>
            <li>Ensure tasks are completed accurately, efficiently, and on time</li>
            <li>Handle confidential information with professionalism and discretion</li>
          </ul>

          <h3>Qualifications</h3>
          <ul>
            <li>Prior legal assistant, legal administrative, or law firm support experience</li>
            <li>Experience in any legal practice area will be considered</li>
            <li>Strong written and verbal English communication skills</li>
            <li>Highly organized with strong attention to detail</li>
            <li>Able to manage multiple deadlines in a fast-paced legal environment</li>
            <li>Comfortable communicating with clients, attorneys, courts, and other involved parties</li>
            <li>Reliable, professional, and able to maintain strict confidentiality</li>
            <li>Tech-savvy and comfortable learning legal systems and administrative tools</li>
            <li>Able to work independently in a remote setup</li>
          </ul>

          <h3>Preferred Experience</h3>
          <ul>
            <li>Experience working in a legal office or law firm environment</li>
            <li>Experience with case management, legal documentation, filings, deadlines, and client communication</li>
            <li>Experience with legal CRMs or case management systems</li>
            <li>Experience coordinating records requests, discovery, or case-related materials</li>
            <li>Remote legal assistant or virtual assistant experience is a plus</li>
          </ul>

          <h3>Schedule, Compensation, and Benefits</h3>
          <ul>
            <li>Full-time schedule, Monday to Friday, with weekend availability depending on client needs</li>
            <li>Schedule will be within U.S. time zones</li>
            <li>Starts at $5 USD/hour, with a possibility of a pay increase from a performance evaluation</li>
          </ul>

          <h3>How It Works</h3>
          <p>Joining our bench does not guarantee immediate placement — opportunities are based on client needs and how you present yourself when they arise. Candidates who stand out are those who come prepared, stay engaged, and take advantage of the resources we provide to put their best foot forward.</p>

          <h3>Ready to Apply?</h3>
          <p>If you're interested in joining our bench and being considered for this role, we'd love to hear from you. Apply today to get started.</p>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/xeebqlgy"
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }
</style>
