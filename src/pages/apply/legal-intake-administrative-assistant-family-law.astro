---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: JD Legal Intake & Administrative Assistant (Family Law Experience Required)"
  description="Apply to join Attorney Assistant as a remote Legal Intake & Administrative Assistant based in the Philippines — supporting a New Jersey family law firm with client intake, case management, and administrative follow-ups."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        JD Legal Intake & Administrative Assistant (Family Law Experience Required)
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Support client intake, consultation scheduling, and case management for a New Jersey-based family law firm, as part of Attorney Assistant's growing remote team.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-5xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>JD Legal Intake & Administrative Assistant (Family Law Experience Required) – Attorney Assistant | Remote</h2>
          <p class="text-sm font-semibold text-brand-gold">Philippines (Remote)</p>

          <h3>About the Company</h3>
          <p>At Attorney Assistant, we help law firms manage the work that keeps cases moving and clients supported, including intake, follow-up, administration, legal support, and operations.</p>
          <p>Through Staffline and Frontline, formerly known as Intake360, we provide dedicated staffing and 24/7 live intake support for U.S.-based law firms. Our team helps firms respond faster, stay organized, and build reliable support systems around their daily work.</p>
          <p>We're growing our remote team and looking for reliable, skilled professionals who want to build long-term careers supporting law firms.</p>

          <h3>Overview</h3>
          <p>We are looking for a detail-oriented and organized Legal Intake & Administrative Assistant with prior family law experience to support a New Jersey-based family law firm.</p>
          <p>This role involves client intake, consultation scheduling, case management support, document organization, and administrative follow-ups. The Legal Intake & Administrative Assistant will help maintain accurate client records, coordinate with attorneys and staff, and ensure daily administrative tasks are completed efficiently.</p>
          <p>Prior professional experience supporting family law matters is required.</p>

          <h3>Key Responsibilities</h3>
          <ul>
            <li>Answer overflow calls and assist new and existing clients</li>
            <li>Conduct client intake, conflict checks, and schedule consultations</li>
            <li>Enter and maintain accurate client and case information in LEAP</li>
            <li>Organize client files, documents, and emails</li>
            <li>Follow up on missing client information and documentation</li>
            <li>Send new-client packets and update returned information</li>
            <li>Assist with file cleanup, archiving, and case tracking</li>
            <li>Communicate with attorneys and staff through Microsoft Teams</li>
            <li>Recognize urgent client concerns and escalate them appropriately</li>
          </ul>

          <h3>Required Skills and Experience</h3>
          <ul>
            <li>Prior professional experience supporting family law matters, such as divorce, child custody, child support, alimony, or related proceedings</li>
            <li>Strong English verbal and written communication skills</li>
            <li>Experience handling client inquiries, administrative tasks, documentation, and follow-ups</li>
            <li>Strong organizational skills and attention to detail, particularly when managing multiple client files and tasks</li>
            <li>Ability to handle confidential and sensitive client information professionally</li>
            <li>Proficiency in scheduling, email correspondence, document management, and general administrative processes</li>
            <li>Ability to work independently, prioritize responsibilities, and meet deadlines</li>
            <li>Comfortable communicating with clients, attorneys, and other team members in a remote environment</li>
          </ul>

          <h3>Preferred Qualifications</h3>
          <ul>
            <li>Previous experience working as a Legal Assistant, Paralegal, Legal Secretary, Intake Specialist, or in a similar legal support role</li>
            <li>Experience supporting a U.S.-based law firm or U.S. legal professionals</li>
            <li>Experience handling legal intake, conflict checks, and case management workflows</li>
          </ul>

          <h3>Schedule and Benefits</h3>
          <ul>
            <li>Full-time remote opportunity based in the Philippines</li>
            <li>Monday–Friday, 9:00 AM–5:00 PM Eastern Time, with a 30-minute paid lunch break</li>
            <li>English-only role</li>
            <li>PTO, referral incentives, and bonuses where applicable</li>
            <li>Must have a reliable laptop or desktop computer, stable internet connection, and a quiet, professional remote work setup</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/meagqazl"
    screeningQuestions={[
      {
        label: "Do you have experience in Family Law?",
        type: "single",
        options: ["Yes", "No"],
        required: true,
        disqualifyOn: ["No"],
      },
    ]}
    declineMessage="Thank you for your interest. This role requires prior professional experience supporting family law matters, so we're unable to move forward with your application at this time. We genuinely appreciate the time you took to apply and encourage you to explore our other openings."
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }

  /* prose-brand's prose-lg headings read oversized against this page's other
     section headers (e.g. "About this role" at text-lg) — scale them down
     here rather than touching the shared utility used by blog posts. */
  .job-description .prose-brand :where(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .job-description .prose-brand :where(h3) {
    font-size: 1.0625rem;
    margin-top: 1.5rem;
    margin-bottom: 0.375rem;
  }
</style>
