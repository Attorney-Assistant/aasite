---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: Case Manager (Immigration Firm)"
  description="Apply to join Attorney Assistant as a remote bilingual English-Spanish Case Manager supporting a U.S.-based immigration law firm with case management, USCIS filings, and EOIR removal defense support."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Case Manager (Immigration Firm)
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Support a U.S.-based immigration law firm with case management, USCIS filings, client communication, and attorney support across EOIR and removal defense matters.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-5xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>Case Manager (Immigration Firm) – Attorney Assistant | Remote</h2>
          <p class="text-sm font-semibold text-brand-gold">Latin America (Remote)</p>

          <h3>About the Company</h3>
          <p>At Attorney Assistant, we help law firms manage the work that keeps cases moving and clients supported, including intake, follow-up, admin, legal support, and operations.</p>
          <p>We provide dedicated staffing and 24/7 live intake support for U.S.-based law firms. Our team helps firms respond faster, stay organized, and build reliable support systems around their daily work.</p>
          <p>We're growing our remote team and looking for reliable, skilled professionals who want to build long-term careers supporting law firms.</p>

          <h3>Overview</h3>
          <p>We are looking for a bilingual English-Spanish Case Manager to support a U.S.-based immigration law firm with case management, immigration filings, client communication, deadline tracking, and attorney support.</p>
          <p>This role will manage immigration matters from intake or assignment through filing and post-filing follow-up. The Case Manager will work across USCIS matters and assist attorneys with EOIR and removal defense cases.</p>

          <h3>Key Responsibilities</h3>
          <ul>
            <li>Manage immigration cases from intake or assignment through filing and post-filing follow-up</li>
            <li>Prepare and review immigration forms, applications, petitions, declarations, supporting documentation, and filing packages</li>
            <li>Support USCIS matters, including family-based petitions, adjustment of status, naturalization, asylum, employment authorization, waivers, VAWA matters, consular processing, and other humanitarian or family-based immigration benefits</li>
            <li>Assist attorneys with EOIR and removal defense matters, including asylum, cancellation of removal, motions, court filings, pleadings, supporting evidence, and preparation for individual and master calendar hearings</li>
            <li>Review Notices to Appear, hearing notices, USCIS notices, RFEs, NOIDs, biometrics notices, interview notices, and other government correspondence</li>
            <li>Calendar and monitor USCIS, EOIR, attorney, and internal deadlines</li>
            <li>Prepare and file appropriate EOIR documentation, including appearances and supporting filings</li>
            <li>Regularly review case status, processing times, court information, and pending deadlines</li>
            <li>Communicate proactively with clients regarding case progress, missing documents, upcoming appointments, deadlines, and next steps</li>
            <li>Identify potential legal or procedural issues and promptly escalate them to the supervising attorney</li>
            <li>Conduct appropriate follow-up after filings and ensure cases continue moving forward</li>
            <li>Assist attorneys with hearing, interview, and trial preparation as needed</li>
            <li>Maintain organized electronic files and follow the firm's quality-control procedures</li>
            <li>Protect client confidentiality and exercise sound professional judgment at all times</li>
          </ul>

          <h3>Required Skills and Experience</h3>
          <ul>
            <li>Bilingual in English and Spanish, with strong written and verbal communication skills in both languages</li>
            <li>Prior experience supporting U.S. immigration matters or performing immigration case management work</li>
            <li>Experience preparing and reviewing immigration forms, applications, petitions, and supporting documentation</li>
            <li>Familiarity with USCIS processes and immigration case workflows</li>
            <li>Strong case management, organization, follow-up, and deadline-tracking skills</li>
            <li>Strong attention to detail and ability to manage multiple active matters and competing deadlines</li>
            <li>Ability to communicate professionally with clients regarding case status, documentation, deadlines, and next steps</li>
            <li>Ability to identify matters requiring attorney review and escalate them appropriately</li>
            <li>Prior professional experience working with U.S. immigration law case-management software and electronic filing systems is strongly preferred</li>
          </ul>

          <h3>Schedule and Benefits</h3>
          <ul>
            <li>Full-time remote opportunity</li>
            <li>Monday to Friday, 9:00 AM to 5:00 PM Eastern Time</li>
            <li>Must have a reliable device, stable internet connection, and quiet remote work setup</li>
            <li>PTO, referral incentives, and bonuses where applicable</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/xaeobvpk"
    screeningQuestions={[
      {
        label: "Do you have prior professional experience supporting U.S. immigration law matters?",
        type: "single",
        options: ["Yes", "No"],
        required: true,
        disqualifyOn: ["No"],
      },
    ]}
    declineMessage="Thank you for your interest. This role requires prior professional experience supporting U.S. immigration law matters, so we're unable to move forward with your application at this time. We genuinely appreciate the time you took to apply and encourage you to explore our other openings."
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }

  /* prose-brand's prose-lg headings read oversized against this page's other
     section headers (e.g. "About this role" at text-lg) — scale them down
     here rather than touching the shared utility used by blog posts. */
  .job-description .prose-brand :where(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .job-description .prose-brand :where(h3) {
    font-size: 1.0625rem;
    margin-top: 1.5rem;
    margin-bottom: 0.375rem;
  }
</style>
