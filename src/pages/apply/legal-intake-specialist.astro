---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: Legal Intake Specialist — Attorney Assistant"
  description="Apply to join Attorney Assistant's bench as a remote Legal Intake Specialist — the first point of contact for prospective clients."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Apply: Legal Intake Specialist
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Join our bench of remote legal professionals and be considered for placement with our law firm clients.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-5xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>Legal Intake Specialist – Attorney Assistant | Remote</h2>
          <p class="text-sm font-semibold text-brand-gold">English-Only · Remote</p>

          <h3>About the Company</h3>
          <p>At Attorney Assistant, we're a fast-growing provider of virtual staffing solutions, supporting law firms, executives, and businesses across the United States. We also operate Turn Key Ops, our sister company under the same leadership, which delivers high-quality virtual support across a broader range of industries.</p>

          <h3>Overview</h3>
          <p>We are seeking a Legal Intake Specialist to serve as the first point of contact for prospective clients. This role is ideal for someone with legal intake experience, strong communication skills, and a client-focused mindset. You'll be responsible for answering calls, collecting client information, nurturing leads, and ensuring a smooth transition to the legal team.</p>

          <h3>Key Responsibilities</h3>
          <ul>
            <li>Conduct detailed intake interviews to collect accurate client and case information</li>
            <li>Enter and maintain data in the CRM or case management system</li>
            <li>Nurture prospective clients and follow up as needed</li>
            <li>Prepare and explain retainer agreements when applicable</li>
            <li>Evaluate cases based on firm criteria and schedule attorney consultations</li>
          </ul>

          <h3>Qualifications</h3>
          <ul>
            <li>Clear, professional English communication (spoken and written)</li>
            <li>Prior experience in legal intake or legal support (Personal Injury experience is a plus)</li>
            <li>Strong verbal and written communication skills</li>
            <li>Professional, empathetic, and client-oriented</li>
          </ul>

          <h3>Preferred Experience</h3>
          <ul>
            <li>Personal Injury legal intake experience</li>
            <li>Familiarity with CRM or legal case management systems</li>
            <li>Experience working remotely</li>
          </ul>

          <h3>Compensation &amp; Benefits</h3>
          <ul>
            <li><strong>Pay Rate:</strong> $6 USD per hour</li>
            <li><strong>Payment:</strong> Weekly</li>
            <li>Performance-based pay increase opportunities</li>
            <li>PTO, referral incentives, and bonuses</li>
          </ul>

          <h3>How It Works</h3>
          <p>Joining our bench does not guarantee immediate placement — opportunities are based on client needs and how you present yourself when they arise. Candidates who stand out are those who come prepared, stay engaged, and take advantage of the resources we provide to put their best foot forward.</p>

          <h3>Ready to Apply?</h3>
          <p>If you're interested in joining our bench and being considered for this role, we'd love to hear from you. Apply today to get started.</p>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/mbdvlypg"
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }
</style>
