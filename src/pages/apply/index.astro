---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="No Open Positions at This Time | Attorney Assistant"
  description="We don't have any open positions right now, but we're always growing. Check back soon."
  noindex={true}
>

  <section class="relative bg-brand-900 py-20 md:py-28 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="absolute top-20 left-1/4 w-96 h-96 bg-brand-gold/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-1/3 w-80 h-80 bg-brand-blue/10 rounded-full blur-3xl"></div>

    <div class="container-narrow relative z-10 text-center">
      <div class="featured-icon featured-icon-lg featured-icon-gold mx-auto mb-6">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" />
        </svg>
      </div>
      <span class="badge bg-white/10 text-white/80 border-white/10 mb-4">Not Currently Hiring</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-4">
        No open positions at this time.
      </h1>
      <div class="divider-gold-center mt-4 mb-6"></div>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed mb-10">
        Thank you for your interest in joining Attorney Assistant. We don't have any roles open right now, but our team is always growing &mdash; check back soon.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary btn-lg">
          Return Home
        </a>
        <a href="/careers" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold text-white border-1.5 border-white/25 hover:bg-white/10 hover:border-white/50 transition-all">
          Learn About Our Team
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
