---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply Now — Attorney Assistant"
  description="Apply for a position with Attorney Assistant. Fill out our interview form to start your career in the legal industry."
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Interview Application
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Thank you for your interest in a role with our company. Please fill out this form to continue with the interview process.
      </p>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/mbdpakyp"
    showPositionPicker={true}
  />

  <CareersPixel event="ViewContent" />

  <!-- Salesforce Agentforce Chat (careers + apply only) -->
  <script is:inline>
    function initEmbeddedMessaging() {
      try {
        embeddedservice_bootstrap.settings.language = 'en_US';
        embeddedservice_bootstrap.init(
          '00D8c000005xL1L',
          'Agentforce_Service_Agent_https_attorneyassistant_com_careers',
          'https://turnkeyops.my.site.com/ESWAgentforceServiceAge1742499916572',
          {
            scrt2URL: 'https://turnkeyops.my.salesforce-scrt.com'
          }
        );
      } catch (err) {
        console.error('Error loading Embedded Messaging: ', err);
      }
    }
  </script>
  <script is:inline src="https://turnkeyops.my.site.com/ESWAgentforceServiceAge1742499916572/assets/js/bootstrap.min.js" onload="initEmbeddedMessaging()"></script>

</BaseLayout>
