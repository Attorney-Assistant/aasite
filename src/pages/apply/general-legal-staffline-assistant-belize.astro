---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: General Legal Staffline Assistant — Belize | Attorney Assistant"
  description="Apply to join Attorney Assistant as a General Legal Staffline Assistant in Belize — in person at our San Ignacio office or remote if you're located elsewhere in Belize."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Belize</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Apply: General Legal Staffline Assistant — Belize
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Support U.S. law firms with administrative and client-facing work — in person at our San Ignacio office, or remote if you're located elsewhere in Belize.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-5xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>General Legal Staffline Assistant – Belize</h2>
          <p class="text-sm font-semibold text-brand-gold">Roles in Belize are either in person in our San Ignacio office OR remote if you're located in other areas.</p>

          <h3>Overview</h3>
          <p>Provide administrative support to attorneys and legal teams, including document management, case organization, client communication, data entry, drafting correspondence, and general clerical tasks. The role may also include reception and client intake, which are client-facing tasks requiring phone work.</p>

          <h3>What We're Looking For</h3>
          <p>We seek candidates who are reliable, professional, and proactive. The qualities that set our top performers apart are strong communication skills, attention to detail, the ability to work independently in a remote environment, and a genuine commitment to delivering excellent service. In this role, we are seeking candidates with proven administrative experience who are comfortable communicating with clients.</p>

          <h3>Schedule &amp; Compensation</h3>
          <p>$5 USD per hour. Schedule will vary based on your assigned client's needs and time zone.</p>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/mkodgond"
    screeningQuestions={[
      {
        label: "Are you located in Belize?",
        type: "single",
        options: ["Yes", "No"],
        required: true,
        disqualifyOn: ["No"],
      },
    ]}
    declineMessage="Thank you for your interest. This role is open only to candidates located in Belize, so we're unable to move forward with your application at this time. We truly appreciate the time you took to apply and encourage you to explore our other openings."
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }
</style>
