---
import BaseLayout from "@layouts/BaseLayout.astro";
import CareersPixel from "@components/CareersPixel.astro";
import ApplicationForm from "@components/ApplicationForm.astro";
---

<BaseLayout
  title="Apply: Legal Assistant (LEAP Experience Required)"
  description="Apply to join Attorney Assistant as a remote Legal Assistant based in the Philippines — supporting a New Jersey family law firm with client intake, case management, and administrative follow-ups in LEAP Legal Software."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Hero -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-narrow relative z-10 text-center">
      <span class="badge badge-gold mb-4">We're Hiring · Remote</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Legal Assistant (LEAP Experience Required)
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl mx-auto leading-relaxed">
        Support client intake, consultation scheduling, and case management in LEAP Legal Software for a New Jersey-based family law firm, as part of Attorney Assistant's growing remote team.
      </p>
    </div>
  </section>

  <!-- Collapsible Job Description -->
  <section class="py-8 md:py-10 bg-gray-25">
    <div class="container-narrow max-w-5xl">
      <details class="job-description card p-5 md:p-6">
        <summary class="cursor-pointer flex items-center justify-between gap-4">
          <span class="text-base md:text-lg font-heading text-gray-900">About this role</span>
          <span class="text-xs text-brand-gold font-semibold uppercase tracking-wider flex items-center gap-2">
            <span class="jd-show">View full description</span>
            <span class="jd-hide hidden">Hide description</span>
            <svg class="jd-icon w-4 h-4 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </span>
        </summary>

        <div class="prose-brand mt-5 pt-5 border-t border-gray-200">
          <h2>Legal Assistant (LEAP Legal Software Experience Required) – Attorney Assistant | Remote</h2>
          <p class="text-sm font-semibold text-brand-gold">Philippines (Remote)</p>

          <h3>About the Company</h3>
          <p>At Attorney Assistant, we help law firms manage the work that keeps cases moving and clients supported, including intake, follow-up, admin, legal support, and operations.</p>
          <p>Through Staffline and Frontline, formerly known as Intake360, we provide dedicated staffing and 24/7 live intake support for U.S.-based law firms. Our team helps firms respond faster, stay organized, and build reliable support systems around their daily work.</p>
          <p>We're growing our remote team and looking for reliable, skilled professionals who want to build long-term careers supporting law firms.</p>

          <h3>Overview</h3>
          <p>We are looking for a detail-oriented and organized Legal Assistant with hands-on experience using LEAP Legal Software to support a New Jersey-based family law firm.</p>
          <p>This role involves client intake, consultation scheduling, case management support, document organization, and administrative follow-ups. The Legal Assistant will help maintain accurate client records, coordinate with attorneys and staff, and ensure that daily legal administrative tasks are completed efficiently.</p>
          <p>Prior hands-on experience with LEAP Legal Software is required. Previous law firm experience is strongly preferred, particularly in family law, but is not mandatory.</p>

          <h3>Key Responsibilities</h3>
          <ul>
            <li>Answer incoming and overflow calls, assisting prospective and existing clients professionally</li>
            <li>Conduct client intake, gather relevant information, and perform conflict checks following established procedures</li>
            <li>Schedule consultations and coordinate appointments with attorneys and clients</li>
            <li>Create, update, and maintain client and case information in LEAP Legal Software</li>
            <li>Organize and manage legal documents, client files, emails, and case-related correspondence</li>
            <li>Send new-client intake packets, track returned documents, and follow up on missing information</li>
            <li>Assist with case tracking, file cleanup, document management, and archiving</li>
            <li>Maintain accurate records of client communications, case updates, and outstanding administrative tasks</li>
            <li>Communicate with attorneys and team members through Microsoft Teams to coordinate daily activities and follow-ups</li>
            <li>Identify urgent client concerns or case-related issues and escalate them appropriately</li>
          </ul>

          <h3>Required Skills and Experience</h3>
          <ul>
            <li>Hands-on professional experience using LEAP Legal Software is required</li>
            <li>Strong English verbal and written communication skills</li>
            <li>Experience handling client inquiries, administrative tasks, documentation, and follow-ups</li>
            <li>Strong organizational skills and attention to detail, particularly when managing multiple client files and tasks</li>
            <li>Ability to handle confidential and sensitive client information professionally</li>
            <li>Proficiency in scheduling, email correspondence, document management, and general administrative processes</li>
            <li>Ability to work independently, prioritize responsibilities, and meet deadlines</li>
            <li>Comfortable communicating with clients, attorneys, and other team members in a remote environment</li>
          </ul>

          <h3>Preferred Qualifications</h3>
          <ul>
            <li>Previous experience working as a Legal Assistant, Paralegal, Legal Secretary, or in a similar legal support role</li>
            <li>Experience supporting a U.S.-based law firm or U.S. legal professionals</li>
            <li>Familiarity with family law matters, including divorce, child custody, child support, alimony, or related proceedings</li>
            <li>Experience handling legal intake, conflict checks, and case management workflows</li>
          </ul>

          <h3>Schedule and Benefits</h3>
          <ul>
            <li>Full-time remote opportunity based in the Philippines</li>
            <li>Monday to Friday, 9:00 AM to 5:00 PM Eastern Time, with a 30-minute paid lunch break</li>
            <li>English-only role</li>
            <li>Paid time off (PTO), referral incentives, and bonuses where applicable</li>
            <li>Must have a reliable laptop or desktop computer, stable internet connection, and a quiet, professional remote work setup. Equipment is not provided.</li>
          </ul>
        </div>
      </details>
    </div>
  </section>

  <ApplicationForm
    formspreeAction="https://formspree.io/f/mrppakqg"
    screeningQuestions={[
      {
        label: "Which of the following software platforms have you used hands-on in a professional work environment?",
        type: "multi",
        options: ["LEAP Legal Software", "AccuLynx", "Buildertrend", "Builder Prime", "None of the above"],
        required: true,
        disqualifyOn: ["None of the above"],
      },
    ]}
    declineMessage="Thank you for your interest. This role requires prior hands-on experience with at least one of our required software platforms (LEAP Legal Software, AccuLynx, Buildertrend, or Builder Prime), so we're unable to move forward with your application at this time. We genuinely appreciate the time you took to apply and encourage you to explore our other openings."
  />

  <CareersPixel event="ViewContent" />

</BaseLayout>

<style>
  details.job-description summary { list-style: none; }
  details.job-description summary::-webkit-details-marker { display: none; }
  details.job-description[open] .jd-show { display: none; }
  details.job-description[open] .jd-hide { display: inline; }
  details.job-description[open] .jd-icon { transform: rotate(180deg); }

  /* prose-brand's prose-lg headings read oversized against this page's other
     section headers (e.g. "About this role" at text-lg) — scale them down
     here rather than touching the shared utility used by blog posts. */
  .job-description .prose-brand :where(h2) {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .job-description .prose-brand :where(h3) {
    font-size: 1.0625rem;
    margin-top: 1.5rem;
    margin-bottom: 0.375rem;
  }
</style>
