const externalIcon = "M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25";
const qrIcon = "M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z";
---

<BaseLayout
  title="Nashville Resources — Attorney Assistant"
  description="Internal team reference for the Nashville campaign: links, resources, and QR codes."
  noindex={true}
  suppressMainPixel={true}
>

  <!-- Header -->
  <section class="relative bg-brand-900 py-12 md:py-16 grain-overlay overflow-hidden">
    <div class="absolute inset-0 bg-gradient-mesh opacity-30"></div>
    <div class="container-wide relative z-10">
      <span class="badge badge-gold mb-4">Internal · Team Reference</span>
      <h1 class="text-display-sm md:text-display-md font-heading text-white mb-3">
        Nashville Resources
      </h1>
      <p class="text-base md:text-lg text-brand-200 max-w-2xl leading-relaxed">
        Central hub for the Nashville campaign — run-of-show docs, slide decks, recorded calls, pricing, and key links for the team.
      </p>
    </div>
  </section>

  <!-- Resource Sections -->
  <section class="py-12 md:py-16">
    <div class="container-wide">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {groups.map((group) => (
          <div class="card p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class="featured-icon featured-icon-sm featured-icon-brand flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={group.icon} />
                </svg>
              </div>
              <h2 class="text-lg font-heading text-gray-900">{group.title}</h2>
            </div>
            <div class="space-y-2">
              {group.links.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between gap-3 p-3 rounded-lg border border-gray-200 hover:border-brand-gold/50 hover:bg-brand-25 transition-colors group"
                >
                  <span class="text-sm text-gray-700 group-hover:text-gray-900 font-medium">{link.label}</span>
                  <svg class="w-4 h-4 text-gray-400 group-hover:text-brand-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={externalIcon} />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        ))}

        <!-- QR Codes (placeholder until codes are added) -->
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class="featured-icon featured-icon-sm featured-icon-brand flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={qrIcon} />
              </svg>
            </div>
            <h2 class="text-lg font-heading text-gray-900">QR Codes</h2>
          </div>
          <div class="rounded-lg border-2 border-dashed border-gray-200 p-6 text-center">
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wider">Coming soon</p>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
