    icon: "M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z",
    links: [
      { label: "Live Calls — Run of Show", url: "https://turnkeyops-my.sharepoint.com/:w:/g/personal/nicolehall_attorneyassistant_com/IQByIct3nJqrSJcUbnrf9O1ZAUmizcXBZLdDe_uclmojcSk?e=IJhqzV" },
      { label: "Recorded Calls — Run of Show", url: "https://turnkeyops-my.sharepoint.com/:w:/g/personal/nicolehall_attorneyassistant_com/IQC7OVhMTEN3SKFRh8BhEsOfAfLsnBFirINPcRKoCFrPWuc?e=lUAedB" },
    ],
  },
  {
    title: "Slide Presentations",
    icon: "M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5",
    links: [
      { label: "Live Calls — Slide Deck", url: "https://docs.google.com/presentation/d/1VBvigYuyUdtTT7TF43UaP1w7Kpk-i1h_pdYz48BNG3Q/edit?usp=sharing" },
