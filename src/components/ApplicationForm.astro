---
export interface Props {
  formspreeAction: string;
  showPositionPicker?: boolean;
}

const { formspreeAction, showPositionPicker = false } = Astro.props;
const step2Name = showPositionPicker ? "Availability & Position" : "Availability";

const COUNTRIES = [
  "Afghanistan","Albania","Algeria","Andorra","Angola","Antigua and Barbuda","Argentina","Armenia","Australia","Austria","Azerbaijan",
  "Bahamas","Bahrain","Bangladesh","Barbados","Belarus","Belgium","Belize","Benin","Bhutan","Bolivia","Bosnia and Herzegovina","Botswana","Brazil","Brunei","Bulgaria","Burkina Faso","Burundi",
  "Cabo Verde","Cambodia","Cameroon","Canada","Central African Republic","Chad","Chile","China","Colombia","Comoros","Congo (Brazzaville)","Congo (Kinshasa)","Costa Rica","Côte d'Ivoire","Croatia","Cuba","Cyprus","Czechia",
  "Denmark","Djibouti","Dominica","Dominican Republic",
  "Ecuador","Egypt","El Salvador","Equatorial Guinea","Eritrea","Estonia","Eswatini","Ethiopia",
  "Fiji","Finland","France",
  "Gabon","Gambia","Georgia","Germany","Ghana","Greece","Grenada","Guatemala","Guinea","Guinea-Bissau","Guyana",
  "Haiti","Honduras","Hungary",
  "Iceland","India","Indonesia","Iran","Iraq","Ireland","Israel","Italy",
  "Jamaica","Japan","Jordan",
  "Kazakhstan","Kenya","Kiribati","Kosovo","Kuwait","Kyrgyzstan",
  "Laos","Latvia","Lebanon","Lesotho","Liberia","Libya","Liechtenstein","Lithuania","Luxembourg",
  "Madagascar","Malawi","Malaysia","Maldives","Mali","Malta","Marshall Islands","Mauritania","Mauritius","Mexico","Micronesia","Moldova","Monaco","Mongolia","Montenegro","Morocco","Mozambique","Myanmar",
  "Namibia","Nauru","Nepal","Netherlands","New Zealand","Nicaragua","Niger","Nigeria","North Korea","North Macedonia","Norway",
  "Oman",
  "Pakistan","Palau","Palestine","Panama","Papua New Guinea","Paraguay","Peru","Philippines","Poland","Portugal",
  "Qatar",
  "Romania","Russia","Rwanda",
  "Saint Kitts and Nevis","Saint Lucia","Saint Vincent and the Grenadines","Samoa","San Marino","São Tomé and Príncipe","Saudi Arabia","Senegal","Serbia","Seychelles","Sierra Leone","Singapore","Slovakia","Slovenia","Solomon Islands","Somalia","South Africa","South Korea","South Sudan","Spain","Sri Lanka","Sudan","Suriname","Sweden","Switzerland","Syria",
  "Taiwan","Tajikistan","Tanzania","Thailand","Timor-Leste","Togo","Tonga","Trinidad and Tobago","Tunisia","Turkmenistan","Turkey","Tuvalu",
  "Uganda","Ukraine","United Arab Emirates","United Kingdom","United States","Uruguay","Uzbekistan",
  "Vanuatu","Vatican City","Venezuela","Vietnam",
  "Yemen",
  "Zambia","Zimbabwe"
];
---

<!-- Progress Bar -->
<div class="sticky top-0 z-40 bg-white border-b border-gray-200 shadow-xs">
  <div class="container-narrow py-3">
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-medium text-gray-500" id="step-label">Step 1 of 3</span>
      <span class="text-xs font-medium text-brand-gold" id="step-name">Personal Information</span>
    </div>
    <div class="w-full bg-gray-100 rounded-full h-2 overflow-hidden">
      <div id="progress-bar" class="h-full bg-brand-gold rounded-full transition-all duration-500 ease-out" style="width: 33.33%"></div>
    </div>
    <div class="flex justify-between mt-2">
      {["Personal Info", step2Name, "Experience & Documents"].map((name, i) => (
        <button
          type="button"
          class="step-dot flex flex-col items-center gap-1 group"
          data-step-nav={i}
          disabled
        >
          <div class={`w-3 h-3 rounded-full border-2 transition-all duration-300 ${i === 0 ? 'bg-brand-gold border-brand-gold' : 'bg-white border-gray-300'}`}></div>
          <span class="text-[10px] text-gray-400 hidden sm:block group-disabled:text-gray-300">{name}</span>
        </button>
      ))}
    </div>
  </div>
</div>

<!-- Form -->
<section class="py-10 md:py-14" id="form-section">
  <div class="container-narrow max-w-3xl">
    <form
      id="application-form"
      method="POST"
      action={formspreeAction}
      enctype="multipart/form-data"
      novalidate
    >

      <!-- ============ STEP 1: Personal Information ============ -->
      <div class="form-step active" data-step="0">
        <div class="mb-8">
          <div class="featured-icon featured-icon-md featured-icon-brand mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" /></svg>
          </div>
          <h2 class="text-display-xs font-heading text-gray-900 mb-1">Personal Information</h2>
          <p class="text-sm text-gray-500">Let's start with your basic information.</p>
        </div>

        <div class="space-y-5">
          <div>
            <label for="full_name" class="label-base">What is your full name? <span class="text-error-500">*</span></label>
            <input type="text" id="full_name" name="full_name" data-required class="input-base" placeholder="Your full name" />
          </div>

          <div>
            <label for="date_of_birth" class="label-base">Date of Birth <span class="text-error-500">*</span></label>
            <input type="date" id="date_of_birth" name="date_of_birth" data-required class="input-base" />
          </div>

          <div>
            <label for="email" class="label-base">What is your email address? <span class="text-error-500">*</span></label>
            <input type="email" id="email" name="email" data-required class="input-base" placeholder="you@example.com" />
          </div>

          <div>
            <label for="street_address" class="label-base">What is your street address? <span class="text-error-500">*</span></label>
            <input type="text" id="street_address" name="street_address" data-required class="input-base" placeholder="123 Main Street" />
          </div>

          <div>
            <label for="city" class="label-base">What is your city of residence? <span class="text-error-500">*</span></label>
            <input type="text" id="city" name="city" data-required class="input-base" placeholder="City" />
          </div>

          <div>
            <label for="state_province" class="label-base">State / Province / Region</label>
            <input type="text" id="state_province" name="state_province" class="input-base" placeholder="e.g. California, Ontario, Cayo" />
          </div>

          <div>
            <label for="country" class="label-base">What is your country of residence? <span class="text-error-500">*</span></label>
            <p class="text-xs text-gray-400 mb-1.5">Start typing to search.</p>
            <input type="text" id="country" name="country" data-required class="input-base" placeholder="Choose" list="country-list" autocomplete="off" />
            <datalist id="country-list">
              {COUNTRIES.map((c) => <option value={c} />)}
            </datalist>
          </div>

          <div id="belize-question" class="card p-5 bg-brand-25 border-brand-100 hidden transition-all duration-300">
            <label class="label-base text-brand-700"><strong>FOR CANDIDATES FROM BELIZE ONLY:</strong> Are you interested in working at our San Ignacio, Belize office location at #3 Moriah Street, San Ignacio Town, Cayo District (in front of Codd's Drug Store)?</label>
            <div class="flex gap-6 mt-2">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="radio" name="belize_office" value="Yes" class="form-radio text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">Yes</span>
              </label>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="radio" name="belize_office" value="No" class="form-radio text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">No</span>
              </label>
            </div>
          </div>

          <div>
            <label for="referral" class="label-base">Were you referred by an existing Attorney Assistant employee? If yes, please put their name below.</label>
            <p class="text-xs text-gray-400 mb-1.5">Only one entry is allowed.</p>
            <input type="text" id="referral" name="referral" class="input-base" placeholder="Employee name (if applicable)" />
          </div>

          <fieldset>
            <legend class="label-base">What is your preferred communication method? <span class="text-error-500">*</span></legend>
            <p class="text-xs text-gray-400 mb-2">Please ensure you actively monitor this. Select all that apply.</p>
            <div class="flex gap-6">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="communication_method" value="Email" class="form-checkbox rounded text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">Email</span>
              </label>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="communication_method" value="WhatsApp" class="form-checkbox rounded text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">WhatsApp</span>
              </label>
            </div>
          </fieldset>

          <div id="whatsapp-field" class="hidden transition-all duration-300">
            <label for="whatsapp_number" class="label-base">If you selected WhatsApp above, please put your WhatsApp number.</label>
            <p class="text-xs text-gray-400 mb-1.5">Please make sure to provide your area code (e.g. +16101234567).</p>
            <input type="tel" id="whatsapp_number" name="whatsapp_number" class="input-base" placeholder="+16101234567" />
          </div>

          <fieldset>
            <legend class="label-base">What languages are you fluent in? <span class="text-error-500">*</span></legend>
            <p class="text-xs text-gray-400 mb-2">Select all that apply.</p>
            <div class="flex flex-wrap gap-4">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="languages" value="English" class="form-checkbox rounded text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">English</span>
              </label>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="languages" value="Spanish" class="form-checkbox rounded text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">Spanish</span>
              </label>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="checkbox" name="languages" value="Other" class="form-checkbox rounded text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">Other</span>
              </label>
            </div>
          </fieldset>
        </div>
      </div>

      <!-- ============ STEP 2: Availability (+ optional Position) ============ -->
      <div class="form-step" data-step="1">
        <div class="mb-8">
          <div class="featured-icon featured-icon-md featured-icon-brand mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
          </div>
          <h2 class="text-display-xs font-heading text-gray-900 mb-1">{step2Name}</h2>
          <p class="text-sm text-gray-500">{showPositionPicker ? "Tell us about your availability and the role(s) you're interested in." : "Tell us about your availability."}</p>
        </div>

        <div class="space-y-5">
          <fieldset>
            <legend class="label-base">Are you available to work full-time (at least 40 hours per week)? <span class="text-error-500">*</span></legend>
            <div class="flex gap-6 mt-1">
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="radio" name="full_time" value="Yes" data-required class="form-radio text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">Yes</span>
              </label>
              <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="radio" name="full_time" value="No" class="form-radio text-brand-gold focus:ring-brand-gold" />
                <span class="text-sm text-gray-700">No</span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend class="label-base">Are you available to work part-time?</legend>
            <div class="flex gap-6 mt-1">
              {["Yes", "No", "Maybe"].map((opt) => (
                <label class="inline-flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="part_time" value={opt} class="form-radio text-brand-gold focus:ring-brand-gold" />
                  <span class="text-sm text-gray-700">{opt}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div id="part-time-hours-field" class="hidden transition-all duration-300">
            <label for="part_time_hours" class="label-base">If you are open to part-time, how many hours a week are you interested in working?</label>
            <input type="text" id="part_time_hours" name="part_time_hours" class="input-base" placeholder="e.g. 20" />
          </div>

          <fieldset>
            <legend class="label-base">Pay rate is $5 USD per hour for bilingual (English and Spanish) and $4 per hour for English-only. Does that work for you? <span class="text-error-500">*</span></legend>
            <div class="flex gap-6 mt-1">
              {["Yes", "No", "Maybe"].map((opt) => (
                <label class="inline-flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="pay_rate_ok" value={opt} data-required class="form-radio text-brand-gold focus:ring-brand-gold" />
                  <span class="text-sm text-gray-700">{opt}</span>
                </label>
              ))}
            </div>
          </fieldset>

          {showPositionPicker && (
            <Fragment>
              <div class="card p-5 bg-gray-50 border-gray-200">
                <h3 class="text-sm font-heading text-gray-900 mb-3">We generally offer the following positions in our company:</h3>
                <ol class="text-xs text-gray-600 space-y-2 list-decimal list-inside">
                  <li><strong class="text-gray-900">General Legal Impact Assistant (IA):</strong> Assist attorneys and other legal professionals with administrative support including document management, organizing case materials, handling basic client inquiries via email and phone, data entry, drafting letters, gathering important documentation, basic research, and other clerical tasks.</li>
                  <li><strong class="text-gray-900">Receptionist:</strong> Answer incoming calls, assist clients with their inquiries, route calls as necessary, and maintain thorough documentation of client interactions. Create a positive first impression for law firm clients by delivering exceptional customer service, empathy, patience, and professionalism.</li>
                  <li><strong class="text-gray-900">Intake Specialist:</strong> Work in a critical role as the first point of contact for potential clients responsible for handling client inquiries, gathering essential information, and qualifying potential cases for eligibility. Conduct detailed intake interviews to gather relevant client information in the CRM or case management software, schedule appointments, and follow up on leads.</li>
                  <li><strong class="text-gray-900">Intake Specialist - Closer (Sales):</strong> Work as an Intake Specialist (described above), but MOST IMPORTANTLY convert and close leads, sign clients up for services, and onboard them into the law firm system. Sales experience and a genuine interest in sales are paramount in this role.</li>
                  <li><strong class="text-gray-900">Medical Records Retrieval:</strong> Request and retrieve medical records and bills from healthcare providers, hospitals, and insurance companies; track, monitor, and follow up on pending requests to ensure timely delivery of documents; maintain an organized database of records.</li>
                </ol>
              </div>

              <fieldset>
                <legend class="label-base">Check the position(s) for which you're most interested in applying. <span class="text-error-500">*</span></legend>
                <p class="text-xs text-gray-400 mb-2">Check all that apply.</p>
                <div class="space-y-2">
                  <label class="card-option flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-brand-gold/40 transition-colors">
                    <input type="checkbox" name="positions" value="General Legal Impact Assistant (IA)" class="mt-0.5 accent-brand-gold" />
                    <span class="text-sm text-gray-700">General Legal Impact Assistant (IA)</span>
                  </label>
                  <label class="card-option flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-brand-gold/40 transition-colors">
                    <input type="checkbox" name="positions" value="Receptionist" class="mt-0.5 accent-brand-gold" />
                    <span class="text-sm text-gray-700">Receptionist</span>
                  </label>
                  <label class="card-option flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-brand-gold/40 transition-colors">
                    <input type="checkbox" name="positions" value="Intake Specialist" class="mt-0.5 accent-brand-gold" />
                    <span class="text-sm text-gray-700">Intake Specialist</span>
                  </label>
                  <label class="card-option flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-brand-gold/40 transition-colors">
                    <input type="checkbox" name="positions" value="Intake Specialist - Closer (Sales)" class="mt-0.5 accent-brand-gold" />
                    <span class="text-sm text-gray-700">Intake Specialist - Closer (Sales)</span>
                  </label>
                  <label class="card-option flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:border-brand-gold/40 transition-colors">
                    <input type="checkbox" name="positions" value="Medical Records Retrieval" class="mt-0.5 accent-brand-gold" />
                    <span class="text-sm text-gray-700">Medical Records Retrieval</span>
                  </label>
                </div>
              </fieldset>
            </Fragment>
          )}

        </div>
      </div>

      <!-- ============ STEP 3: Experience & Documents ============ -->
      <div class="form-step" data-step="2">
        <div class="mb-8">
          <div class="featured-icon featured-icon-md featured-icon-brand mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" /></svg>
          </div>
          <h2 class="text-display-xs font-heading text-gray-900 mb-1">Experience, Requirements, Tools</h2>
          <p class="text-sm text-gray-500">In this section, we want to know about your experience and tool proficiency.</p>
        </div>

        <div class="card p-5 mb-6 bg-warning-25 border-warning-300">
          <div class="flex gap-3">
            <svg class="w-5 h-5 text-warning-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
            <div class="text-xs text-warning-700 leading-relaxed">
              <p class="font-semibold mb-1">IMPORTANT:</p>
              <p class="mb-2">If you are invited for an interview, you will be required to provide specifications for your computer through live screenshare to include operating system, memory, internet speed, and processor.</p>
              <p>Operating system needs to be at least macOS 11 or Windows 10 latest version or equivalent, no Pentium computers are allowed &mdash; should be at least i3 version or above, RAM must be at least 8 GB, and internet download speed minimum must be 50 Mbps and upload speed must be 20 Mbps.</p>
            </div>
          </div>
        </div>

        <div class="space-y-5">
          <fieldset>
            <legend class="label-base">Select the tools in which you are proficient. <span class="text-error-500">*</span></legend>
            <p class="text-xs text-gray-400 mb-2">Select all acceptable answers.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {["Microsoft Office", "Microsoft Teams", "Google Sheets", "Google Docs", "Advanced Excel", "Advanced Powerpoint"].map((tool) => (
                <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:border-brand-300 hover:bg-brand-25 transition-colors cursor-pointer">
                  <input type="checkbox" name="tools" value={tool} class="form-checkbox rounded text-brand-gold focus:ring-brand-gold" />
                  <span class="text-sm text-gray-700">{tool}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div>
            <label for="crm_systems" class="label-base">List any CRM systems in which you have experience.</label>
            <input type="text" id="crm_systems" name="crm_systems" class="input-base" placeholder="e.g. Salesforce, HubSpot, Clio..." />
          </div>

          <div>
            <label for="legal_software" class="label-base">List any legal software in which you have experience.</label>
            <input type="text" id="legal_software" name="legal_software" class="input-base" placeholder="e.g. Clio, MyCase, PracticePanther..." />
          </div>

          <div>
            <label for="resume" class="label-base">Please upload your resume/CV (must be in English). <span class="text-error-500">*</span></label>
            <p class="text-xs text-gray-400 mb-1.5">Use the provided <a href="https://www.canva.com/design/DAGmxFnMOn4/5ipdHqpm0-QfE430qolngw/view?utm_content=DAGmxFnMOn4&utm_campaign=designshare&utm_medium=link&utm_source=publishsharelink&mode=preview" target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">Canva template</a> to update your resume. Modify the information accordingly and send it back once completed. <strong>If you do not add this information, we will not move forward with considering your application.</strong> PDF, DOC, or DOCX only. Max 10 MB.</p>
            <div class="file-upload-area" id="resume-upload-area">
              <input type="file" id="resume" name="resume" data-required accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" class="file-input" />
              <div class="file-upload-content">
                <svg class="w-8 h-8 text-gray-400 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
                <p class="text-sm text-gray-600 font-medium">Click to upload or drag & drop</p>
                <p class="text-xs text-gray-400">PDF, DOC, or DOCX only — up to 10 MB</p>
              </div>
            </div>
            <p id="resume-filename" class="text-xs text-success-600 mt-1 hidden"></p>
          </div>

          <!-- Intro Video Section -->
          <div class="card p-5 bg-brand-25 border-brand-100">
            <h3 class="text-sm font-heading text-gray-900 mb-2">Record an Introduction Video <span class="text-error-500">*</span></h3>
            <p class="text-xs text-gray-600 mb-3">There are two options for submitting your intro video: Loom or Google Drive link. Click <a href="https://www.loom.com/" target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">here</a> to sign up for a FREE Loom account, or submit your video as a Google Drive link. <a href="https://drive.google.com/file/d/1cDarP9quVVQlKVWaNw2Ja2IMsZ35htan/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">Click here for a great example of an intro video</a>.</p>
            <p class="text-xs text-gray-900 font-bold uppercase mb-3">Please ensure your video link can be accessed for viewing by anyone. This helps to expedite our review process.</p>
            <ul class="text-xs text-gray-600 space-y-1.5 list-disc list-inside mb-3">
              <li>Ensure you have great lighting and a clear picture when you record. Record in a quiet, distraction-free environment.</li>
              <li>Eliminate background noise as much as possible. You can use a noise cancellation tool such as <a href="https://krisp.ai/noise-cancellation/" target="_blank" rel="noopener noreferrer" class="text-brand-600 hover:underline">Krisp</a> to assist.</li>
              <li>Dress to impress in business casual or professional attire.</li>
              <li>Briefly discuss your relevant work experience and why you think you are a good fit for a role with Attorney Assistant.</li>
            </ul>
            <p class="text-xs text-gray-700 font-semibold">YOU MUST ADD YOUR RECORDED VIDEO LINK IN THE SPACE BELOW TO BE CONSIDERED BY OUR RECRUITMENT TEAM.</p>
          </div>

          <div class="card overflow-hidden">
            <img src="/images/video-background.png" alt="Attorney Assistant virtual background for your video" class="w-full" loading="lazy" />
            <div class="p-4 bg-gray-50">
              <p class="text-xs text-gray-500">Use this image as your virtual background when recording your video.</p>
            </div>
          </div>

          <div>
            <label for="intro_video_url" class="label-base">Link to Your Introduction Video <span class="text-error-500">*</span></label>
            <p class="text-xs text-gray-400 mb-1.5">Paste your Loom or Google Drive share link.</p>
            <input type="url" id="intro_video_url" name="intro_video_url" data-required class="input-base" placeholder="https://www.loom.com/share/... or https://drive.google.com/file/d/..." />
          </div>

          <div>
            <label for="id_card" class="label-base">Please upload your Identification Card.</label>
            <p class="text-xs text-gray-400 mb-1.5">This ID card is intended solely for identification purposes and should not be used for any other transactions or representations. PDF, document, or image. Max 10 MB.</p>
            <div class="file-upload-area" id="id-upload-area">
              <input type="file" id="id_card" name="id_card" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp" class="file-input" />
              <div class="file-upload-content">
                <svg class="w-8 h-8 text-gray-400 mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" /></svg>
                <p class="text-sm text-gray-600 font-medium">Click to upload or drag & drop</p>
                <p class="text-xs text-gray-400">PDF, DOC, JPG, PNG up to 10 MB</p>
              </div>
            </div>
            <p id="id-filename" class="text-xs text-success-600 mt-1 hidden"></p>
          </div>
        </div>
      </div>

      <!-- Upload note -->
      <div id="upload-note" class="hidden mt-6 card p-4 bg-brand-25 border-brand-100">
        <div class="flex gap-3 items-start">
          <svg class="w-5 h-5 text-brand-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
          <p class="text-xs text-brand-700 leading-relaxed"><strong>Please note:</strong> Submission may take a moment while your files (resume and ID) are uploaded. Please don't close the page until you see the confirmation message.</p>
        </div>
      </div>

      <!-- Navigation Buttons -->
      <div class="flex items-center justify-between mt-6 pt-6 border-t border-gray-200">
        <button type="button" id="prev-btn" class="btn-secondary hidden">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
          Previous
        </button>
        <div class="ml-auto flex gap-3">
          <button type="button" id="next-btn" class="btn-primary btn-lg">
            Continue
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </button>
          <button type="submit" id="submit-btn" class="btn-primary btn-lg hidden">
            Submit Application
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          </button>
        </div>
      </div>

    </form>

    <!-- Success message (hidden by default) -->
    <div id="success-message" class="hidden text-center py-16">
      <div class="featured-icon featured-icon-lg featured-icon-success mx-auto mb-5">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
      </div>
      <h2 class="text-display-xs font-heading text-gray-900 mb-2">Application Submitted!</h2>
      <p class="text-base text-gray-500 max-w-md mx-auto mb-6">Thank you for your interest in joining Attorney Assistant. We'll review your application and be in touch via your preferred communication method.</p>
      <a href="/careers" class="btn-secondary">Back to Careers</a>
    </div>
  </div>
</section>

<style>
  .form-step {
    display: none;
  }
  .form-step.active {
    display: block;
    animation: fadeIn 0.4s ease-out;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .file-upload-area {
    position: relative;
    border: 2px dashed #D0D5DD;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .file-upload-area:hover,
  .file-upload-area.dragover {
    border-color: #F9A630;
    background-color: #fef6e8;
  }
  .file-upload-area .file-input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }
  .file-upload-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  /* Custom radio/checkbox styling */
  .form-radio,
  .form-checkbox {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    accent-color: #F9A630;
  }

  .field-error {
    border-color: #F04438 !important;
  }
  .field-error:focus {
    ring-color: rgba(240, 68, 56, 0.3) !important;
  }
  .error-message {
    color: #F04438;
    font-size: 0.75rem;
    margin-top: 0.25rem;
  }
</style>

<script is:inline define:vars={{ stepTwoName: step2Name }}>
  const TEST_MODE = false;

  const TOTAL_STEPS = 3;
  const STEP_NAMES = ["Personal Information", stepTwoName, "Experience & Documents"];
  let currentStep = 0;
  let highestVisited = 0;

  const form = document.getElementById('application-form');
  const steps = document.querySelectorAll('.form-step');
  const progressBar = document.getElementById('progress-bar');
  const stepLabel = document.getElementById('step-label');
  const stepName = document.getElementById('step-name');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const submitBtn = document.getElementById('submit-btn');
  const stepDots = document.querySelectorAll('.step-dot');
  const dots = document.querySelectorAll('.step-dot div');

  // ── Conditional field visibility ──

  // WhatsApp number: show when WhatsApp is checked
  document.querySelectorAll('input[name="communication_method"]').forEach(cb => {
    cb.addEventListener('change', () => {
      const whatsappChecked = document.querySelector('input[name="communication_method"][value="WhatsApp"]').checked;
      const field = document.getElementById('whatsapp-field');
      field.classList.toggle('hidden', !whatsappChecked);
      if (!whatsappChecked) document.getElementById('whatsapp_number').value = '';
    });
  });

  // Belize office: show when country = Belize (exact, case-insensitive)
  const countryInput = document.getElementById('country');
  function syncBelizeVisibility() {
    const isBelize = countryInput.value.trim().toLowerCase() === 'belize';
    const panel = document.getElementById('belize-question');
    panel.classList.toggle('hidden', !isBelize);
    if (!isBelize) {
      panel.querySelectorAll('input[name="belize_office"]').forEach(r => r.checked = false);
    }
  }
  countryInput.addEventListener('input', syncBelizeVisibility);
  countryInput.addEventListener('change', syncBelizeVisibility);

  // Part-time hours: show when part-time = Yes or Maybe
  document.querySelectorAll('input[name="part_time"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const val = document.querySelector('input[name="part_time"]:checked')?.value;
      const show = val === 'Yes' || val === 'Maybe';
      document.getElementById('part-time-hours-field').classList.toggle('hidden', !show);
      if (!show) document.getElementById('part_time_hours').value = '';
    });
  });

  // ── Step navigation ──

  function updateUI() {
    steps.forEach((step, i) => step.classList.toggle('active', i === currentStep));

    const pct = ((currentStep + 1) / TOTAL_STEPS) * 100;
    progressBar.style.width = pct + '%';
    stepLabel.textContent = `Step ${currentStep + 1} of ${TOTAL_STEPS}`;
    stepName.textContent = STEP_NAMES[currentStep];

    if (currentStep > highestVisited) highestVisited = currentStep;

    dots.forEach((dot, i) => {
      if (i < currentStep) {
        dot.className = 'w-3 h-3 rounded-full border-2 transition-all duration-300 bg-brand-gold border-brand-gold';
      } else if (i === currentStep) {
        dot.className = 'w-3 h-3 rounded-full border-2 transition-all duration-300 bg-brand-gold border-brand-gold ring-4 ring-brand-gold/20';
      } else {
        dot.className = 'w-3 h-3 rounded-full border-2 transition-all duration-300 bg-white border-gray-300';
      }
    });

    // Enable clicking on visited step dots
    stepDots.forEach((btn, i) => {
      btn.disabled = i > highestVisited;
    });

    prevBtn.classList.toggle('hidden', currentStep === 0);
    nextBtn.classList.toggle('hidden', currentStep === TOTAL_STEPS - 1);
    submitBtn.classList.toggle('hidden', currentStep !== TOTAL_STEPS - 1);
    document.getElementById('upload-note').classList.toggle('hidden', currentStep !== TOTAL_STEPS - 1);

    window.scrollTo({ top: document.querySelector('.sticky').offsetTop, behavior: 'smooth' });
  }

  // Click on step dots to navigate
  stepDots.forEach((btn, i) => {
    btn.addEventListener('click', () => {
      if (i <= highestVisited) {
        currentStep = i;
        updateUI();
      }
    });
  });

  // ── Validation ──

  function addError(container, message) {
    if (!container.querySelector('.error-message')) {
      const msg = document.createElement('p');
      msg.className = 'error-message';
      msg.textContent = message;
      container.appendChild(msg);
    }
  }

  function validateCurrentStep() {
    if (TEST_MODE) return true;

    const step = steps[currentStep];
    let valid = true;

    // Clear previous errors
    step.querySelectorAll('.field-error').forEach(el => el.classList.remove('field-error'));
    step.querySelectorAll('.error-message').forEach(el => el.remove());
    step.querySelectorAll('.file-upload-area').forEach(el => { el.style.borderColor = ''; });

    // Validate [data-required] inputs
    const reqInputs = step.querySelectorAll('[data-required]');
    const processed = new Set();

    reqInputs.forEach(input => {
      if (input.type === 'radio') {
        if (processed.has(input.name)) return;
        processed.add(input.name);
        const group = step.querySelectorAll(`input[name="${input.name}"]`);
        if (!Array.from(group).some(r => r.checked)) {
          valid = false;
          addError(input.closest('fieldset') || input.closest('div'), 'This field is required.');
        }
      } else if (input.type === 'file') {
        if (!input.files || input.files.length === 0) {
          valid = false;
          const area = input.closest('.file-upload-area');
          area.style.borderColor = '#F04438';
          addError(area.parentElement, 'Please upload the required file.');
        }
      } else {
        if (!input.value.trim()) {
          valid = false;
          input.classList.add('field-error');
          addError(input.parentElement, 'This field is required.');
        }
      }
    });

    // Email format check
    if (currentStep === 0) {
      const emailInput = step.querySelector('#email');
      if (emailInput && emailInput.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
        valid = false;
        emailInput.classList.add('field-error');
        addError(emailInput.parentElement, 'Please enter a valid email address.');
      }
    }

    // Checkbox group minimums (require at least one checked)
    // Guarded so pages without certain groups (e.g. job-specific pages without
    // the position picker) don't error.
    const checkboxGroups = {
      0: ['communication_method', 'languages'],
      1: ['positions'],
      2: ['tools'],
    };

    const groups = checkboxGroups[currentStep] || [];
    groups.forEach(name => {
      const firstInput = step.querySelector(`input[name="${name}"]`);
      if (!firstInput) return;
      const checked = step.querySelectorAll(`input[name="${name}"]:checked`);
      if (checked.length === 0) {
        valid = false;
        const fieldset = firstInput.closest('fieldset');
        if (fieldset) addError(fieldset, 'Please select at least one option.');
      }
    });

    if (!valid) {
      const firstError = step.querySelector('.field-error, .error-message');
      if (firstError) firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    return valid;
  }

  function nextStep() {
    if (!validateCurrentStep()) return;
    if (currentStep < TOTAL_STEPS - 1) {
      currentStep++;
      updateUI();
    }
  }

  function prevStep() {
    if (currentStep > 0) {
      currentStep--;
      updateUI();
    }
  }

  nextBtn.addEventListener('click', nextStep);
  prevBtn.addEventListener('click', prevStep);

  // ── File uploads ──

  const ALLOWED_RESUME_EXT = /\.(pdf|docx?)$/i;

  document.querySelectorAll('.file-input').forEach(input => {
    input.addEventListener('change', function() {
      const area = this.closest('.file-upload-area');
      const filenameEl = area.parentElement.querySelector('[id$="-filename"]');

      if (this.files.length === 0) return;
      const file = this.files[0];

      // Enforce PDF/DOC/DOCX only for the resume input.
      if (this.id === 'resume' && !ALLOWED_RESUME_EXT.test(file.name)) {
        alert('Resume must be a PDF, DOC, or DOCX file.');
        this.value = '';
        area.style.borderColor = '';
        area.style.backgroundColor = '';
        if (filenameEl) {
          filenameEl.textContent = '';
          filenameEl.classList.add('hidden');
        }
        return;
      }

      const sizeMB = (file.size / 1024 / 1024).toFixed(1);
      area.style.borderColor = '#17B26A';
      area.style.backgroundColor = '#F6FEF9';
      if (filenameEl) {
        filenameEl.textContent = `✓ ${file.name} (${sizeMB} MB)`;
        filenameEl.classList.remove('hidden');
      }
    });
  });

  document.querySelectorAll('.file-upload-area').forEach(area => {
    area.addEventListener('dragover', (e) => { e.preventDefault(); area.classList.add('dragover'); });
    area.addEventListener('dragleave', () => area.classList.remove('dragover'));
    area.addEventListener('drop', () => area.classList.remove('dragover'));
  });

  // ── Submission ──

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    if (!TEST_MODE && !validateCurrentStep()) return;

    // Store applicant data for CAPI SubmitApplication event on thank-you page
    try {
      sessionStorage.setItem('aa_applicant_data', JSON.stringify({
        email: (form.querySelector('#email')?.value || '').trim(),
        phone: (form.querySelector('#whatsapp_number')?.value || '').trim(),
        city: (form.querySelector('#city')?.value || '').trim()
      }));
    } catch(err) {}

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Uploading &amp; submitting&hellip;';
    document.getElementById('upload-note').innerHTML = '<div class="flex gap-3 items-start"><svg class="w-5 h-5 text-brand-gold flex-shrink-0 mt-0.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg><p class="text-xs text-brand-700 leading-relaxed"><strong>Uploading your files&hellip;</strong> This may take a minute depending on file sizes and your internet speed. Please don\'t close or refresh this page.</p></div>';

    try {
      const formData = new FormData(form);

      // Remove empty file fields — Formspree rejects empty file parts
      for (const [key, value] of [...formData.entries()]) {
        if (value instanceof File && value.size === 0) {
          formData.delete(key);
        }
      }

      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      const data = await response.json().catch(() => ({}));

      if (response.ok) {
        form.classList.add('hidden');
        document.querySelector('.sticky').classList.add('hidden');
        document.getElementById('success-message').classList.remove('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        // Conversion events fire on the /apply/thank-you page via CareersPixel
      } else {
        console.error('Formspree error:', response.status, data);
        throw new Error(data.error || data.errors?.map(e => e.message).join(', ') || `Server responded with ${response.status}`);
      }
    } catch (err) {
      console.error('Submission error:', err);
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Submit Application <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>';
      alert('Error: ' + err.message + '\n\nPlease try again or email talent@attorneyassistant.com directly.');
    }
  });

  // ── Keyboard: Enter to advance ──
  form.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && e.target.tagName !== 'TEXTAREA') {
      e.preventDefault();
      if (currentStep < TOTAL_STEPS - 1) nextStep();
    }
  });

  // ── Selected state styling for checkbox/radio cards ──
  form.addEventListener('change', (e) => {
    const input = e.target;
    if ((input.type === 'checkbox' || input.type === 'radio') && input.closest('.rounded-lg.border')) {
      // For radios, clear siblings first
      if (input.type === 'radio') {
        const group = form.querySelectorAll(`input[name="${input.name}"]`);
        group.forEach(r => {
          const card = r.closest('.rounded-lg.border');
          if (card) {
            card.classList.remove('border-brand-400', 'bg-brand-25');
            card.classList.add('border-gray-200');
          }
        });
      }
      const card = input.closest('.rounded-lg.border');
      if (card) {
        if (input.checked) {
          card.classList.remove('border-gray-200');
          card.classList.add('border-brand-400', 'bg-brand-25');
        } else {
          card.classList.remove('border-brand-400', 'bg-brand-25');
          card.classList.add('border-gray-200');
        }
      }
    }
  });

  // ── Inline field validation on blur/change ──

  function clearFieldError(input) {
    input.classList.remove('field-error');
    const errMsg = input.parentElement?.querySelector('.error-message');
    if (errMsg) errMsg.remove();
    // Clear file upload error styling
    const area = input.closest?.('.file-upload-area');
    if (area) area.style.borderColor = '';
  }

  function showFieldError(input, message) {
    input.classList.add('field-error');
    const container = input.parentElement;
    if (container && !container.querySelector('.error-message')) {
      const msg = document.createElement('p');
      msg.className = 'error-message';
      msg.textContent = message;
      container.appendChild(msg);
    }
  }

  // Validate text/email/url/date/tel on blur
  form.addEventListener('focusout', (e) => {
    if (TEST_MODE) return;
    const input = e.target;
    if (!input.matches('input, textarea')) return;
    if (input.type === 'radio' || input.type === 'checkbox' || input.type === 'file') return;

    clearFieldError(input);

    // Required check
    if (input.hasAttribute('data-required') && !input.value.trim()) {
      showFieldError(input, 'This field is required.');
      return;
    }

    if (!input.value.trim()) return;

    // Email format
    if (input.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value)) {
      showFieldError(input, 'Please enter a valid email address.');
      return;
    }

    // URL format
    if (input.type === 'url') {
      try { new URL(input.value); } catch {
        showFieldError(input, 'Please enter a valid URL (e.g. https://...)');
        return;
      }
    }

    // Phone format (WhatsApp)
    if (input.id === 'whatsapp_number' && input.value && !/^\+?\d[\d\s-]{7,}$/.test(input.value.trim())) {
      showFieldError(input, 'Please enter a valid phone number with country code (e.g. +16101234567).');
      return;
    }
  });

  // Clear errors on input (while typing)
  form.addEventListener('input', (e) => {
    const input = e.target;
    if (input.classList.contains('field-error')) {
      clearFieldError(input);
    }
  });

  // Clear checkbox group errors on change
  form.addEventListener('change', (e) => {
    const input = e.target;
    if (input.type === 'checkbox' || input.type === 'radio') {
      const fieldset = input.closest('fieldset');
      if (fieldset) {
        const errMsg = fieldset.querySelector('.error-message');
        if (errMsg) errMsg.remove();
      }
    }
  });

  updateUI();

  // Pre-select positions from query string (no-op if the position picker isn't rendered)
  (function() {
    var params = new URLSearchParams(window.location.search);
    var positions = params.getAll('position');
    if (!positions.length) return;
    positions.forEach(function(pos) {
      var cb = form.querySelector('input[name="positions"][value="' + pos + '"]');
      if (cb) {
        cb.checked = true;
        var label = cb.closest('.card-option');
        if (label) { label.style.borderColor = 'var(--brand-gold, #F9A630)'; label.style.background = 'rgba(249,166,48,0.06)'; }
      }
    });
  })();
</script>
