---
// Shared "The Proof" block. Internal Attorney Assistant figures only.
// Never mix third-party statistics into this block.
const stats = [
  { num: "109", label: "Cases signed by one of our staff members for a single client in 30 days" },
  { num: "97%", label: "Answer rate 24/7, up from 82% in-hours only" },
  { num: "15 min", label: "Max speed to lead, down from a 34 minute average" },
  { num: "6", label: "Follow-up touches in 3 days, was 2 then silence" },
];
---

<section class="py-14 md:py-20" style="background: var(--lt26-cream);">
  <div class="container-wide">
    <div class="text-center mb-10 reveal">
      <p class="lt26-eyebrow lt26-eyebrow--light">The proof</p>
      <div class="lt26-divider lt26-divider--center"></div>
      <h2 class="text-2xl md:text-4xl font-bold text-gray-900 mt-6">What this looks like in a real firm</h2>
      <p class="text-sm text-gray-500 mt-4 max-w-xl mx-auto">Internal Attorney Assistant figures from real client files. Identities protected.</p>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 max-w-5xl mx-auto">
      {stats.map((s, i) => (
        <div class="lt26-panel p-6 md:p-7 text-center reveal" style={`transition-delay: ${i * 70}ms`}>
          <p class="lt26-stat-num">{s.num}</p>
          <p class="mt-3 text-xs md:text-sm text-gray-600 leading-snug">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
