---
/**
 * Dark closing band. The button scrolls to the embedded scheduler (#booking).
 * badge + finePrint are for the free-trial family only.
 */
interface Props {
  heading: string;
  body?: string;
  ctaLabel: string;
  badge?: boolean;
  finePrint?: string;
}
const { heading, body, ctaLabel, badge = false, finePrint } = Astro.props;
---

<section class="lt26-band py-16 md:py-24">
  <div class="lt26-orb lt26-orb--orange" aria-hidden="true"></div>
  <div class="container-narrow relative z-10 text-center">
    {badge && (
      <div class="mb-8 reveal">
        <span class="lt26-badge">First 30 days free</span>
      </div>
    )}
    <h2 class="text-3xl md:text-5xl font-bold text-white reveal" style="font-family: 'Sora', sans-serif;">{heading}</h2>
    {body && <p class="mt-5 text-base md:text-lg max-w-xl mx-auto reveal" style="color: var(--lt26-hero-body);">{body}</p>}
    <div class="mt-9 reveal">
      <a href="#booking" class="lt26-btn" data-lt26-cta="final">
        {ctaLabel}
        <svg class="w-4 h-4 lt26-arrow" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
      </a>
      {finePrint && <p class="lt26-fineprint mt-4">{finePrint}</p>}
    </div>
  </div>
</section>
