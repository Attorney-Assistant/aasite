---
/**
 * Careers-specific Meta Pixel (ID: 1461622248739350)
 * Only loaded on: /careers, /apply/*, /apply/thank-you
 *
 * Page-level events (via the `event` prop):
 * - ViewContent        — careers + apply page views
 * - SubmitApplication  — /apply/thank-you page load (legacy path, not used by the form)
 *
 * Also exposes `window.__careersPixel` so client-side flows can fire careers-pixel
 * events at the exact moment they happen (no page navigation required):
 *
 *   window.__careersPixel.track('SubmitApplication', { content_name: 'Receptionist' }, { em, ph, ct });
 *   window.__careersPixel.trackCustom('ApplicationSubmitted', { ... }, { em, ph, ct });
 *
 * Both helpers fire the browser pixel and the server-side Conversions API with a
 * shared event ID so Meta deduplicates them. PII in the third argument is raw —
 * it is SHA-256 hashed here before it ever leaves the browser.
 *
 * The CAPI token is injected at build time from FB_CAREERS_PIXEL_DATA_ACCESS_TOKEN.
 * In production (GitHub Actions), it comes from the repo secret.
 */
export interface Props {
  event: "ViewContent" | "SubmitApplication";
}

const { event } = Astro.props;
const PIXEL_ID = "1461622248739350";
const CAPI_TOKEN = import.meta.env.FB_CAREERS_PIXEL_DATA_ACCESS_TOKEN || "";
---

<!-- Careers Meta Pixel -->
<script is:inline define:vars={{ PIXEL_ID, event, CAPI_TOKEN }}>
  // Load fbevents.js if not already loaded
  !function(f,b,e,v,n,t,s)
  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[];t=b.createElement(e);t.async=!0;
  t.src=v;s=b.getElementsByTagName(e)[0];
  s.parentNode.insertBefore(t,s)}(window, document,'script',
  'https://connect.facebook.net/en_US/fbevents.js');

  fbq('init', PIXEL_ID);
  fbq('track', 'PageView');

  (function() {
    'use strict';

    function genEventId() {
      return 'evt_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
    }

    // SHA-256 hash for PII fields
    async function sha256(str) {
      if (!str) return undefined;
      var buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(String(str).trim().toLowerCase()));
      return Array.from(new Uint8Array(buf)).map(function(b) { return b.toString(16).padStart(2, '0'); }).join('');
    }

    // Client IP for better event match quality (cached per page)
    var clientIpPromise = null;
    function getClientIp() {
      if (!clientIpPromise) {
        clientIpPromise = fetch('https://api.ipify.org?format=json')
          .then(function(r) { return r.json(); })
          .then(function(d) { return d.ip || ''; })
          .catch(function() { return ''; });
      }
      return clientIpPromise;
    }

    function getCookie(name) {
      var match = document.cookie.split(';').map(function(c) { return c.trim(); })
        .find(function(c) { return c.indexOf(name + '=') === 0; });
      return match ? match.split('=')[1] : undefined;
    }

    // ── Server-side Conversions API send ──
    // pii: { em, ph, fn, ln, ct, st, zp } raw/unhashed
    async function sendCapiEvent(eventName, pii, options) {
      if (!CAPI_TOKEN) return;
      options = options || {};

      var eventId = options.eventId || genEventId();
      var ip = await getClientIp();
      var ud = pii || {};

      var userData = {
        client_user_agent: navigator.userAgent,
        client_ip_address: ip
      };

      var fbp = getCookie('_fbp');
      var fbc = getCookie('_fbc');
      if (fbp) userData.fbp = fbp;
      if (fbc) userData.fbc = fbc;

      if (ud.em) userData.em = [await sha256(ud.em)];
      if (ud.ph) userData.ph = [await sha256(String(ud.ph).replace(/[\s\-\(\)]/g, ''))];
      if (ud.fn) userData.fn = [await sha256(ud.fn)];
      if (ud.ln) userData.ln = [await sha256(ud.ln)];
      if (ud.ct) userData.ct = [await sha256(ud.ct)];
      if (ud.st) userData.st = [await sha256(ud.st)];
      if (ud.zp) userData.zp = [await sha256(ud.zp)];

      var eventData = {
        event_name: eventName,
        event_time: Math.floor(Date.now() / 1000),
        event_id: eventId,
        event_source_url: window.location.href,
        action_source: 'website',
        user_data: userData
      };
      if (options.customData) eventData.custom_data = options.customData;

      try {
        fetch('https://graph.facebook.com/v21.0/' + PIXEL_ID + '/events?access_token=' + CAPI_TOKEN, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: [eventData] })
        }).then(function(res) {
          if (!res.ok) res.json().then(function(d) { console.warn('Careers CAPI error [' + eventName + ']:', d); });
        });
      } catch (e) {
        console.warn('Careers CAPI send failed [' + eventName + ']:', e);
      }

      return eventId;
    }

    function fire(method, eventName, pixelData, pii, options) {
      options = options || {};
      var eventId = options.eventId || genEventId();
      pixelData = pixelData || {};

      if (typeof fbq !== 'undefined') {
        fbq(method, eventName, pixelData, { eventID: eventId });
      }

      sendCapiEvent(eventName, pii || {}, { eventId: eventId, customData: pixelData });

      return eventId;
    }

    // ── Public API ──
    window.__careersPixel = {
      pixelId: PIXEL_ID,
      genEventId: genEventId,
      track: function(eventName, pixelData, pii, options) {
        return fire('track', eventName, pixelData, pii, options);
      },
      trackCustom: function(eventName, pixelData, pii, options) {
        return fire('trackCustom', eventName, pixelData, pii, options);
      }
    };

    // ── Page-level auto-fire ──
    if (event === 'ViewContent') {
      window.__careersPixel.track('ViewContent', {
        content_name: 'Careers Page',
        content_category: 'Careers'
      }, {});
    }

    if (event === 'SubmitApplication') {
      var applicantData = {};
      try { applicantData = JSON.parse(sessionStorage.getItem('aa_applicant_data') || '{}'); } catch (e) {}
      try { sessionStorage.removeItem('aa_applicant_data'); } catch (e) {}

      window.__careersPixel.track('SubmitApplication', {
        content_name: 'Job Application',
        status: 'submitted'
      }, {
        em: applicantData.email,
        ph: applicantData.phone,
        ct: applicantData.city
      });
    }
  })();
</script>
<noscript><img height="1" width="1" style="display:none" src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`} /></noscript>
