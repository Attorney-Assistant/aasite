---
/**
 * LinkedIn Conversions API (CAPI)
 * Server-side conversion tracking that complements the browser Insight Tag.
 *
 * Loaded globally via BaseLayout on all pages.
 *
 * Provides:
 * - window.__linkedinCAPI.track(conversionId, userData) — fires both browser + CAPI with dedup
 * - window.__linkedinCAPI.send(conversionId, userData) — fires CAPI only
 *
 * LinkedIn CAPI docs: https://learn.microsoft.com/en-us/linkedin/marketing/integrations/ads-reporting/conversions-api
 */
const LINKEDIN_TOKEN = import.meta.env.LINKEDIN_CONVERSION_API_KEY || "";
---

<script is:inline define:vars={{ LINKEDIN_TOKEN }}>
(function() {
  'use strict';

  // ── SHA-256 hashing for PII fields ──
  async function sha256(str) {
    if (!str) return undefined;
    var buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str.trim().toLowerCase()));
    return Array.from(new Uint8Array(buf)).map(function(b) { return b.toString(16).padStart(2, '0'); }).join('');
  }

  // ── Get client IP (cached per session) ──
  var clientIpPromise = null;
  function getClientIp() {
    if (!clientIpPromise) {
      clientIpPromise = fetch('https://api.ipify.org?format=json')
        .then(function(r) { return r.json(); })
        .then(function(d) { return d.ip || ''; })
        .catch(function() { return ''; });
    }
    return clientIpPromise;
  }

  // ── Get li_fat_id cookie (LinkedIn first-party cookie for enhanced matching) ──
  function getCookie(name) {
    var match = document.cookie.split(';').map(function(c) { return c.trim(); })
      .find(function(c) { return c.startsWith(name + '='); });
    return match ? match.split('=')[1] : undefined;
  }

  // ── Core CAPI send function ──
  // conversionId: string (e.g. "27448705")
  // userData: { email, firstName, lastName, title, company, countryCode }
  async function sendLinkedInConversion(conversionId, userData) {
    if (!LINKEDIN_TOKEN) {
      console.warn('LinkedIn CAPI: No API token configured');
      return;
    }

    var ip = await getClientIp();
    var ud = userData || {};

    // Build user identifiers array
    var userIds = [];

    // SHA-256 hashed email
    if (ud.email) {
      var hashedEmail = await sha256(ud.email);
      if (hashedEmail) {
        userIds.push({
          idType: 'SHA256_EMAIL',
          idValue: hashedEmail
        });
      }
    }

    // LinkedIn first-party ID (from Insight Tag cookie)
    var liFatId = getCookie('li_fat_id');
    if (liFatId) {
      userIds.push({
        idType: 'LINKEDIN_FIRST_PARTY_ADS_TRACKING_UUID',
        idValue: liFatId
      });
    }

    // Build user object
    var user = {};
    if (userIds.length > 0) {
      user.userIds = userIds;
    }
    user.userInfo = {};
    if (ud.firstName) user.userInfo.firstName = ud.firstName;
    if (ud.lastName) user.userInfo.lastName = ud.lastName;
    if (ud.title) user.userInfo.title = ud.title;
    if (ud.company) user.userInfo.companyName = ud.company;
    if (ud.countryCode) user.userInfo.countryCode = ud.countryCode;

    // Build conversion event
    var conversionEvent = {
      conversion: 'urn:lla:llaPartnerConversion:' + conversionId,
      conversionHappenedAt: Date.now(),
      user: user,
      eventId: 'li_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8)
    };

    var payload = {
      elements: [conversionEvent]
    };

    try {
      fetch('https://api.linkedin.com/rest/conversionEvents', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + LINKEDIN_TOKEN,
          'LinkedIn-Version': '202409',
          'X-Restli-Protocol-Version': '2.0.0'
        },
        body: JSON.stringify(payload)
      }).then(function(res) {
        if (!res.ok) {
          res.text().then(function(t) {
            console.warn('LinkedIn CAPI error [' + conversionId + ']:', res.status, t);
          });
        }
      });
    } catch(e) {
      console.warn('LinkedIn CAPI send failed [' + conversionId + ']:', e);
    }
  }

  // ── Expose global API ──
  window.__linkedinCAPI = {
    send: sendLinkedInConversion,

    // Fire both browser Insight Tag + CAPI together
    track: function(conversionId, userData) {
      // Browser-side Insight Tag
      if (typeof window.lintrk !== 'undefined') {
        window.lintrk('track', { conversion_id: parseInt(conversionId, 10) });
      }

      // Server-side CAPI
      sendLinkedInConversion(conversionId, userData || {});
    }
  };

})();
</script>
