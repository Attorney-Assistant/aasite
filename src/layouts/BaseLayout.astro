---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SEO from "@components/SEO.astro";
import MetaCAPI from "@components/MetaCAPI.astro";
import GeoGate from "@components/GeoGate.astro";
import "@/styles/global.css";
import "@/styles/wp-compat.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
  author?: string;
  noindex?: boolean;
  schema?: Record<string, any> | Record<string, any>[];
  suppressMainPixel?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, image, type, publishedDate, author, noindex, schema, suppressMainPixel = false, ogTitle, ogDescription } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    {!noindex && <meta name="robots" content="index, follow" />}
    <meta name="theme-color" content="#15385f" />
    <link rel="icon" type="image/svg+xml" href="/brand/logos/color_icon.svg?v=2" />
    <link rel="icon" type="image/png" href="/brand/logos/color_icon.png?v=2" />
    <link rel="apple-touch-icon" href="/brand/logos/color_icon.png?v=2" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="Attorney Assistant Blog" href="/rss.xml" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://js.hs-scripts.com" />
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link rel="dns-prefetch" href="https://csuxjmfbwmkxiegfpljm.supabase.co" />
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
      author={author}
      noindex={noindex}
      schema={schema}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
    />

    <!-- Site-wide Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "@id": "https://attorneyassistant.com/#organization",
      "name": "Attorney Assistant",
      "legalName": "Attorney Assistant LLC",
      "url": "https://attorneyassistant.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://attorneyassistant.com/brand/logos/long_color_logo.svg",
        "width": 600,
        "height": 120
      },
      "image": "https://attorneyassistant.com/brand/logos/long_color_logo.svg",
      "description": "Attorney Assistant solves the operational problems that prevent law firms from growing — intake failure, follow-up gaps, admin chaos, and scaling bottlenecks.",
      "telephone": "+1-215-337-2677",
      "email": "info@attorneyassistant.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "21 East 5th Avenue Suite 102",
        "addressLocality": "Conshohocken",
        "addressRegion": "PA",
        "postalCode": "19428",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 40.0795,
        "longitude": -75.3016
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
          "opens": "09:00",
          "closes": "18:00"
        }
      ],
      "priceRange": "$$",
      "areaServed": {
        "@type": "Country",
        "name": "United States"
      },
      "sameAs": [
        "https://www.youtube.com/@attorneyassistant",
        "https://www.linkedin.com/company/attorneyassistant/",
        "https://www.instagram.com/attorneyassistant",
        "https://web.facebook.com/attyassistant/"
      ],
      "foundingDate": "2021",
      "founder": [
        { "@type": "Person", "name": "Ethen Ostroff" },
        { "@type": "Person", "name": "James DiBitetto" }
      ],
      "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 200 },
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+1-215-337-2677",
        "contactType": "sales",
        "email": "info@attorneyassistant.com",
        "availableLanguage": ["English", "Spanish"]
      }
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://attorneyassistant.com/#website",
      "name": "Attorney Assistant",
      "url": "https://attorneyassistant.com",
      "publisher": { "@id": "https://attorneyassistant.com/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://attorneyassistant.com/blog?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    })} />

    <!-- Geo-gate: determine if visitor is in allowed region before loading HubSpot -->
    <GeoGate />

    <!-- Google Tag Manager (geo-gated, via Google tag gateway) -->
    <script is:inline>
      window.__hsGeoReady.then(function(allowed) {
        if (!allowed) return;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        '/metrics/?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-WCB9JXDC');
      });
    </script>

    <!-- HubSpot Tracking Code (geo-gated) -->
    <script is:inline>
      window.__hsGeoReady.then(function(allowed) {
        if (!allowed) return;
        var s = document.createElement('script');
        s.type = 'text/javascript';
        s.id = 'hs-script-loader';
        s.async = true;
        s.defer = true;
        s.src = '//js.hs-scripts.com/49161090.js';
        document.head.appendChild(s);
      });
    </script>

    <!-- Primer Analytics -->
    <script is:inline async src="https://analytics.sayprimer.com/primerAnalytics.js?clientId=3d1698e8-8efb-4b61-aec6-5526f6c43cc7"></script>

    <!-- LinkedIn Insight Tag — loaded via GTM, removed from hardcoded -->

    <!-- Meta Pixel (main site — suppressed on careers/apply pages which use their own pixel) -->
    {!suppressMainPixel && (
      <Fragment>
        <script is:inline>!function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '819356476465129');
        fbq('track', 'PageView');</script>
        <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=819356476465129&ev=PageView&noscript=1" /></noscript>
      </Fragment>
    )}

    {/* Conversions API — complements main pixel with server-side events */}
    {!suppressMainPixel && <MetaCAPI />}

  </head>
  <body class="flex flex-col min-h-screen">
    <!-- Skip to content link -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>
    <!-- GTM noscript removed — GTM is geo-gated so noscript fallback would bypass the gate -->
    <Header />
    <main class="flex-1" id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Scroll-triggered reveal animations -->
    <script is:inline>
      (function() {
        var reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-scale');
        if (!reveals.length) return;

        function showAll() {
          reveals.forEach(function(el) { el.classList.add('is-visible'); });
        }

        // No IntersectionObserver support → show everything immediately.
        if (!('IntersectionObserver' in window)) { showAll(); return; }

        // threshold 0 so any element entering the viewport reveals, regardless of
        // its height — a threshold > 0 never triggers for blocks far taller than
        // the viewport, which left long pages stuck invisible.
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0,
          rootMargin: '0px 0px -40px 0px'
        });

        reveals.forEach(function(el) { observer.observe(el); });

        // Safety net: never let content stay hidden if the observer misbehaves.
        setTimeout(showAll, 2000);
      })();
    </script>
  </body>
</html>
