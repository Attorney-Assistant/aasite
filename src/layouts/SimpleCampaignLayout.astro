---
import SEO from "@components/SEO.astro";
import MetaCAPI from "@components/MetaCAPI.astro";
import GeoGate from "@components/GeoGate.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import "@/styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  suppressMainPixel?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  /** Replace the full site header with a logo-only bar plus one on-page CTA (for sealed/unlinked offer pages). */
  minimalHeader?: boolean;
  headerCtaHref?: string;
  headerCtaLabel?: string;
  /** Drop the site footer (for sealed pages that render their own closing section). */
  hideFooter?: boolean;
  /** Override the footer's Book a Call CTA target, or null to hide it. */
  footerBookCallHref?: string | null;
}

const {
  title, description, image, noindex = true, suppressMainPixel = false, ogTitle, ogDescription,
  minimalHeader = false, headerCtaHref = "#booking", headerCtaLabel = "Book a Call", hideFooter = false,
  footerBookCallHref = "/book-call",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#15385f" />
    <link rel="icon" type="image/svg+xml" href="/brand/logos/color_icon.svg?v=2" />
    <link rel="icon" type="image/png" href="/brand/logos/color_icon.png?v=2" />
    <link rel="apple-touch-icon" href="/brand/logos/color_icon.png?v=2" />
    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
    />

    <slot name="head" />

    <!-- Geo-gate -->
    <GeoGate />

    <!-- Google Tag Manager (geo-gated) -->
    <script is:inline>
      window.__hsGeoReady.then(function(allowed) {
        if (!allowed) return;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        '/metrics/?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-WCB9JXDC');
      });
    </script>

    <!-- HubSpot Tracking Code (geo-gated) -->
    <script is:inline>
      window.__hsGeoReady.then(function(allowed) {
        if (!allowed) return;
        var s = document.createElement('script');
        s.type = 'text/javascript';
        s.id = 'hs-script-loader';
        s.async = true;
        s.defer = true;
        s.src = '//js.hs-scripts.com/49161090.js';
        document.head.appendChild(s);
      });
    </script>

    <!-- Meta Pixel -->
    {!suppressMainPixel && (
      <Fragment>
        <script is:inline>!function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '819356476465129');
        fbq('track', 'PageView');</script>
        <noscript><img height="1" width="1" alt="" style="display:none" src="https://www.facebook.com/tr?id=819356476465129&ev=PageView&noscript=1" /></noscript>
      </Fragment>
    )}
    {!suppressMainPixel && <MetaCAPI />}

  </head>
  <body class="simple-campaign">
    <slot name="above-header" />
    {minimalHeader ? (
      <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-200/60">
        <nav class="container-wide flex items-center justify-between h-16 lg:h-[72px]">
          <img src="/brand/logos/long_color_logo.svg" alt="Attorney Assistant" width="1463" height="293" class="h-9 lg:h-11 w-auto" />
          <a href={headerCtaHref} class="btn-primary">{headerCtaLabel}</a>
        </nav>
      </header>
    ) : (
      <Header />
    )}
    <main>
      <slot />
    </main>
    {!hideFooter && <Footer bookCallHref={footerBookCallHref} />}

    <!-- Scroll-triggered reveal animations -->
    <script is:inline>
      (function() {
        var reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-scale');
        if (!reveals.length) return;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(function(el) { observer.observe(el); });
      })();
    </script>
  </body>
</html>
