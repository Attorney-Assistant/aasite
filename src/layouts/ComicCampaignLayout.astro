---
import SEO from "@components/SEO.astro";
import MetaCAPI from "@components/MetaCAPI.astro";
import GeoGate from "@components/GeoGate.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import "@/styles/global.css";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  suppressMainPixel?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, image, noindex = true, suppressMainPixel = false, ogTitle, ogDescription } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a1628" />
    <link rel="icon" type="image/svg+xml" href="/brand/logos/color_icon.svg?v=2" />
    <link rel="icon" type="image/png" href="/brand/logos/color_icon.png?v=2" />
    <link rel="apple-touch-icon" href="/brand/logos/color_icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
    />

    <!-- Geo-gate -->
    <GeoGate />

    <!-- Google Tag Manager (geo-gated) -->
    <script is:inline>
      window.__hsGeoReady.then(function(allowed) {
        if (!allowed) return;
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        '/metrics/?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-WCB9JXDC');
      });
    </script>

    <!-- HubSpot Tracking Code (geo-gated) -->
    <script is:inline>
      window.__hsGeoReady.then(function(allowed) {
        if (!allowed) return;
        var s = document.createElement('script');
        s.type = 'text/javascript';
        s.id = 'hs-script-loader';
        s.async = true;
        s.defer = true;
        s.src = '//js.hs-scripts.com/49161090.js';
        document.head.appendChild(s);
      });
    </script>

    <!-- Meta Pixel -->
    {!suppressMainPixel && (
      <Fragment>
        <script is:inline>!function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '819356476465129');
        fbq('track', 'PageView');</script>
        <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=819356476465129&ev=PageView&noscript=1" /></noscript>
      </Fragment>
    )}
    {!suppressMainPixel && <MetaCAPI />}

    <!-- OpenAI Q Pixel -->
    <script is:inline>!function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");oaiq("init",{pixelId:"Kik3Z6qPWhURPiYR6S4NhN",debug:true});</script>

  </head>
  <body class="comic-campaign">
    <!-- Comic background layers -->
    <div class="comic-bg" aria-hidden="true"></div>
    <div class="comic-grid" aria-hidden="true"></div>

    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Scroll-triggered reveal animations -->
    <script is:inline>
      (function() {
        var reveals = document.querySelectorAll('.reveal, .reveal-left, .reveal-scale');
        if (!reveals.length) return;
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        reveals.forEach(function(el) { observer.observe(el); });
      })();
    </script>

    <style is:global>
      /* ── Comic Campaign Global Styles ── */
      .comic-campaign {
        background: #0a1628;
        color: #e2e8f0;
        font-family: 'Inter', -apple-system, sans-serif;
        overflow-x: hidden;
        position: relative;
      }

      /* ── Halftone background ── */
      .comic-bg {
        position: fixed; inset: 0; z-index: 0; pointer-events: none;
        background-image: radial-gradient(circle, rgba(249,166,45,0.04) 1px, transparent 1px);
        background-size: 24px 24px;
      }

      /* ── Grid overlay ── */
      .comic-grid {
        position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0.03;
        background-image:
          linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px);
        background-size: 60px 60px;
      }

      .comic-campaign main { position: relative; z-index: 1; }

      /* ── Comic fonts ── */
      .comic-title { font-family: 'Bangers', cursive; letter-spacing: 0.04em; }
      .comic-sub { font-family: 'Sora', sans-serif; }

      /* ── Comic panel base ── */
      .comic-panel {
        border: 3px solid rgba(255,255,255,0.15);
        border-radius: 12px;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(8px);
        position: relative;
        overflow: hidden;
      }
      .comic-panel::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0; height: 4px;
        border-radius: 12px 12px 0 0;
      }

      /* ── Comic burst/pow effects ── */
      .comic-pow {
        display: inline-block;
        font-family: 'Bangers', cursive;
        font-size: 1.125rem;
        letter-spacing: 0.1em;
        padding: 0.4rem 1rem;
        border-radius: 6px;
        transform: rotate(-3deg);
        text-transform: uppercase;
      }
      .comic-pow--red { background: #ef4444; color: white; }
      .comic-pow--amber { background: #f59e0b; color: #1a1a1a; }
      .comic-pow--blue { background: #51a6dc; color: white; }
      .comic-pow--gold { background: #f9a62d; color: #1a1a1a; }

      /* ── Comic eyebrow ── */
      .comic-eyebrow {
        font-family: 'Bangers', cursive;
        font-size: 0.875rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #f9a62d;
      }

      /* ── Section title ── */
      .comic-section-title {
        font-family: 'Bangers', cursive;
        font-size: clamp(2rem, 5vw, 3.5rem);
        line-height: 1.1;
        color: white;
        letter-spacing: 0.03em;
      }

      /* ── Gold text ── */
      .comic-gold { color: #f9a62d; }

      /* ── Container ── */
      .comic-container { max-width: 72rem; margin: 0 auto; padding: 0 1.5rem; }

      @media (prefers-reduced-motion: reduce) {
        .comic-campaign * { animation: none !important; transition: none !important; }
      }
    </style>
  </body>
</html>
