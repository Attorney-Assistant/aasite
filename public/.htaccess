# Redirect rules for Attorney Assistant
# Auto-generated - do not edit manually

ErrorDocument 404 /404.html

RewriteEngine On

# ── Google Tag Gateway for advertisers ──
# Routes /metrics/* through first-party proxy to gtm-wcb9jxdc.fps.goog
RewriteCond %{REQUEST_URI} ^/metrics/ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^metrics/(.*)$ /metrics/proxy.php [L,QSA]

# ── Force HTTPS and non-www ──
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://attorneyassistant.com%{REQUEST_URI} [R=301,L]

# ── Hero page redirects (old /lp/ path → /hero/) ──
RewriteRule ^lp/boardwalk-seminar-2026/?$ /hero/boardwalk-seminar-2026 [R=301,L]

# ── Landing page alias redirects ──
RewriteRule ^lp/stop-babysitting-your-firm-magnet/?$ /lp/stop-babysitting-your-firm-download [R=301,L]
RewriteRule ^lp/comic/medical-record/?$ /lp/comic/medical-records [R=301,L]
RewriteRule ^admin/chaos/?$ /lp/comic/admin [R=301,L]
RewriteRule ^case-management/?$ /lp/comic/case-management [R=301,L]
RewriteRule ^case-mgmt/?$ /lp/comic/case-management [R=301,L]
RewriteRule ^intake/?$ /lp/comic/intake [R=301,L]
RewriteRule ^intake/problem/?$ /lp/comic/intake [R=301,L]
RewriteRule ^case/problem/?$ /lp/comic/case-management [R=301,L]
RewriteRule ^medical/records/?$ /lp/comic/medical-records [R=301,L]
RewriteRule ^staffing/problem/?$ /lp/comic/staffing [R=301,L]
RewriteRule ^firm/chaos/?$ /lp/comic/law-firm-chaos [R=301,L]
RewriteRule ^firm/villain/?$ /lp/comic/biggest-villain [R=301,L]

# ── Landing page vanity redirects (case-insensitive) ──
RewriteRule ^Marketing-Waste/?$ /lp/marketing-waste [R=301,L,NC]
RewriteRule ^ForeverTaskMap/?$ /lp/forever-task-map [R=301,L,NC]
RewriteRule ^StopBabysitting/?$ /lp/stop-babysitting-your-firm [R=301,L,NC]
RewriteRule ^BurningMoney/?$ /lp/burning-money [R=301,L,NC]
RewriteRule ^LooksGoodRunsMessy/?$ /lp/looks-good-runs-messy [R=301,L,NC]
RewriteRule ^villain/?$ /lp/comic/biggest-villain [R=301,L,NC]
RewriteRule ^benchmark/?$ /lp/simple/benchmark [R=301,L,NC]

# ── Capital-B /Blog/ → lowercase /blog/ redirects ──
RewriteRule ^Blog/?$ /blog [R=301,L]
RewriteRule ^Blog/category/(.*)$ /blog/category/$1 [R=301,L]
RewriteRule ^Blog/page/(.*)$ /blog [R=301,L]
RewriteRule ^Blog/(.+)$ /blog/$1 [R=301,L]

# ── Landing page consolidation (landing/ → lp/) ──
RewriteRule ^landing/lp-marketing-waste/?$ /lp/marketing-waste [R=301,L]
RewriteRule ^landing/stop-marketing-waste/?$ /lp/stop-marketing-waste [R=301,L]
RewriteRule ^landing/(.+)$ /lp/$1 [R=301,L]

# ── 2026 rebrand redirects (Intake360 → Frontline, Impact Assistants → Staffline) ──
RewriteRule ^services/impact-assistants/?$ /services/staffline [R=301,L]
RewriteRule ^services/intake-360/?$ /services/frontline [R=301,L]
RewriteRule ^lp/intake360/?$ /lp/frontline [R=301,L]
RewriteRule ^intake-360-terms/?$ /frontline-terms [R=301,L]
RewriteRule ^impact-assistants/?$ /services/staffline [R=301,L]
